		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 36,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(236, 240, 244),
		TextStrokeTransparency = 0.55,
