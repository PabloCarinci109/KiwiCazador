					<Properties>
						<string name="Name">Actions</string>
						<ProtectedString name="Source">--[[
	Actions.lua  (servidor)
	Resuelve lo que pasa cuando un jugador usa una herramienta:
		red          -&gt; lanzar la red (captura o espanta)
		rifle        -&gt; disparar un dardo tranquilizante (proyectil real)
		rastreador   -&gt; ping con la direccion del kiwi
		trampa       -&gt; dejar una fruta trampa para el kiwi
		pintura      -&gt; disparar pintura a otros jugadores

	Todo se valida aca: distancias, conos de vision, recargas y estado
	del kiwi. El cliente solo pide la accion, nunca decide el resultado.
--]]

local Players = game:GetService("Players")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local ToolService = require(script.Parent.ToolService)

local Actions = {}

local DART_LENGTH = 0.9
local DART_THICKNESS = 0.22
local NET_HALF_ANGLE = math.rad(55)   -- medio cono de la red
local AIM_TOLERANCE = math.rad(75)    -- cuanto puede desviarse la mira del dardo

-- ===============================================================
-- Utilidades
-- ===============================================================
local function getRoot(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character, character:FindFirstChild("HumanoidRootPart")
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDistance(a, b)
	return flat(a - b).Magnitude
end

-- Direccion "hacia donde mira" el jugador: usamos la mira que manda el
-- cliente, pero saneada (nunca detras del personaje y con largo fijo).
local function aimDirection(player, root, data)
	local muzzle = root.Position + Vector3.new(0, 1.1, 0)
	local aim = data and data.aim
	local dir
	if typeof(aim) == "Vector3" and (aim - muzzle).Magnitude &gt; 0.2 then
		dir = (aim - muzzle).Unit
	else
		dir = root.CFrame.LookVector
	end

	-- Si el cliente manda una direccion ridicula, cae a la del personaje
	local look = root.CFrame.LookVector
	if flat(dir):Dot(flat(look)) &lt; math.cos(AIM_TOLERANCE) then
		dir = look
	end
	return muzzle, dir
end

function Actions.makeDartParams(character, dartPart)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, dartPart }
	params.IgnoreWater = true
	return params
end

-- ===============================================================
-- RED DE CAPTURA
-- ===============================================================
function Actions.net(session, player, data)
	local cfg = session.diff.red
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "red") &gt; 0 then
		return
	end
	ToolService.startCooldown(player, "red", cfg.cooldown)

	local muzzle, dir = aimDirection(player, root, data)
	session:event("netswing", { pos = root.Position, userId = player.UserId })

	local kiwi = session.kiwi
	if not kiwi or kiwi.defeated then
		return
	end

	local kiwiPos = kiwi:getPosition()

	-- 1) El kiwi esta escondido: buscamos en el escondite mas cercano
	if kiwi:isHidden() then
		local spot = session.arena:nearestSpot(root.Position, cfg.range + 8)
		if not spot then
			session:notify(player, Config.Text.FlushFail, Color3.fromRGB(180, 180, 180))
			return
		end

		local toSpot = flat(spot.hidePoint - root.Position)
		local inCone = toSpot.Magnitude &lt; 0.1 or flat(dir):Dot(toSpot.Unit) &gt; math.cos(NET_HALF_ANGLE)
		if inCone and kiwi.spotIndex == spot.id then
			kiwi:flush()
			session:notify(player, Config.Text.Flushed, Color3.fromRGB(255, 210, 120))
		else
			session:notify(player, Config.Text.FlushFail, Color3.fromRGB(180, 180, 180))
			session:event("rustle", { pos = spot.hidePoint })
		end
		return
	end

	-- 2) Kiwi a la vista: hay que estar cerca y apuntando
	local toKiwi = kiwiPos - (root.Position + Vector3.new(0, 1.1, 0))
	local distance = toKiwi.Magnitude
	local inCone = distance &lt; 0.1 or dir:Dot(toKiwi.Unit) &gt; math.cos(NET_HALF_ANGLE)

	if distance &gt; cfg.range or not inCone then
		return
	end

	if kiwi:isSedated() then
		session:capture(player, "red")
		return
	end

	if session.rng:NextNumber() &lt;= cfg.chance then
		session:capture(player, "red")
	else
		session:notify(player, Config.Text.NetMiss, Color3.fromRGB(255, 150, 140))
		kiwi:flush()
	end
end

-- ===============================================================
-- RIFLE TRANQUILIZANTE
-- ===============================================================
function Actions.rifle(session, player, data)
	local cfg = session.diff.rifle
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "rifle") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)

	local dartPart = Util.makePart({
		Name = "Dardo",
		ClassName = "Part",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(DART_LENGTH, DART_THICKNESS, DART_THICKNESS),
		Color = Color3.fromRGB(226, 232, 240),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.lookAt(muzzle + dir * 1.2, muzzle + dir * 2.2) * CFrame.Angles(0, math.rad(90), 0),
		Parent = workspace,
	})
	Util.destroyAfter(dartPart, 6)

	local dart = {
		kind = "dart",
		part = dartPart,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = 1.6,
		player = player,
		params = Actions.makeDartParams(character, dartPart),
	}

	table.insert(session.projectiles, dart)
	ToolService.startCooldown(player, "rifle", cfg.cooldown)
	session:event("dartshot", { pos = muzzle, dir = dir })
end

--[[
	RIFLE RALENTIZADOR (Kiwi Colosal): no lo duerme, lo frena unos segundos.
]]
function Actions.relente(session, player, data)
	local cfg = Config.Relente
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "relente") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)

	local dartPart = Util.makePart({
		Name = "Aguja",
		ClassName = "Part",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(DART_LENGTH, DART_THICKNESS, DART_THICKNESS),
		Color = Config.Tools.relente.color,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.lookAt(muzzle + dir * 1.2, muzzle + dir * 2.2) * CFrame.Angles(0, math.rad(90), 0),
		Parent = workspace,
	})
	Util.destroyAfter(dartPart, 6)

	local dart = {
		kind = "slow",
		part = dartPart,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		params = Actions.makeDartParams(character, dartPart),
	}

	table.insert(session.projectiles, dart)
	ToolService.startCooldown(player, "relente", cfg.cooldown)
	session:event("dartshot", { pos = muzzle, dir = dir })
end

-- ===============================================================
-- ARMAS DE BAUL (lanzamisiles, revolver, arco): proyectiles con empujon
-- ===============================================================
function Actions.fireWeapon(session, player, weaponId, data)
	local cfg = Config.Weapons[weaponId]
	if not cfg then
		return
	end

	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, weaponId) &gt; 0 then
		return
	end

	if ToolService.lootUses(player, weaponId) &lt;= 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)

	local dartPart = Util.makePart({
		Name = "Proyectil",
		ClassName = "Part",
		Size = cfg.size or Vector3.new(0.4, 0.4, 1.6),
		Color = cfg.color,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.lookAt(muzzle + dir * 1.2, muzzle + dir * 2.2),
		Parent = workspace,
	})
	Util.destroyAfter(dartPart, 6)

	local dart = {
		kind = "weapon",
		weaponId = weaponId,
		part = dartPart,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		params = Actions.makeDartParams(character, dartPart),
	}

	table.insert(session.projectiles, dart)
	ToolService.startCooldown(player, weaponId, cfg.cooldown)
	ToolService.consumeLoot(player, weaponId)
	session:event("dartshot", { pos = muzzle, dir = dir })
end

function Actions.weaponHit(session, dart, pos, victim)
	local cfg = Config.Weapons[dart.weaponId]
	if not cfg then
		return
	end

	-- El kiwi NO recibe daño: solo queda relentizado si le da cerca
	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated then
		local reach = math.max(cfg.blast or 0, 8)
		if (kiwi:getPosition() - pos).Magnitude &lt;= reach then
			if kiwi:slow(cfg.slowFactor or 0.4, cfg.slowTime or 2) then
				session:notify(dart.player, string.format(Config.Text.BoomHit, cfg.name), cfg.color, 3)
			end
		end
	end

	local damage = cfg.damage or 0

	-- Golpe directo: el cazador alcanzado se lleva el daño completo
	if victim and victim ~= dart.player and damage &gt; 0 then
		session:damagePlayer(victim, dart.player, cfg.name, damage, pos)
	end

	-- Onda expansiva: empuja a todos (tambien al que disparo) y hiere un poco
	if (cfg.blast or 0) &gt; 0 then
		for _, other in ipairs(session.players) do
			local _, otherRoot = getRoot(other)
			if otherRoot then
				local away = otherRoot.Position - pos
				local distance = away.Magnitude
				if distance &lt;= cfg.blast and distance &gt; 0.05 then
					local push = away.Unit * (cfg.knockback or 30)
					otherRoot.AssemblyLinearVelocity = Vector3.new(push.X, 24, push.Z)
					if damage &gt; 0 and other ~= dart.player and other ~= victim then
						local falloff = math.clamp(1 - (distance / cfg.blast) * 0.65, 0.35, 1)
						session:damagePlayer(other, dart.player, cfg.name, damage * falloff, pos)
					end
				end
			end
		end
	end

	session:event("boom", { pos = pos, weapon = dart.weaponId })
	local shooterName = dart.player.DisplayName ~= "" and dart.player.DisplayName or dart.player.Name
	if (cfg.blast or 0) &gt;= 10 then
		session:notifyAll(string.format(Config.Text.BoomShout, shooterName, cfg.name), cfg.color, 3)
	end
end

function Actions.stepProjectiles(session, dt)
	local projectiles = session.projectiles
	for i = #projectiles, 1, -1 do
		local dart = projectiles[i]
		local stepLen = dart.speed * dt
		dart.life = dart.life - dt

		local hit = workspace:Raycast(dart.pos, dart.dir * stepLen, dart.params)
		local remove = false

		if hit then
			remove = true
			if dart.kind == "paint" then
				local character = hit.Instance:FindFirstAncestorOfClass("Model")
				local victim = character and Players:GetPlayerFromCharacter(character)
				Actions.resolvePaint(session, dart, hit, victim)
			elseif dart.kind == "slow" then
				local kiwi = session.kiwi
				if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
					kiwi:slow(Config.Relente.factor, Config.Relente.time)
					local shooterName = dart.player.DisplayName ~= "" and dart.player.DisplayName or dart.player.Name
					session:notify(dart.player, string.format(Config.Text.SlowHit, Config.Relente.time), Config.Tools.relente.color)
					session:notifyAll(string.format(Config.Text.SlowAll, shooterName), Config.Tools.relente.color)
					session:event("slowhit", { pos = hit.Position })
				else
					session:event("dartmiss", { pos = hit.Position, normal = hit.Normal })
					session:notify(dart.player, Config.Text.SlowMiss, Color3.fromRGB(200, 200, 200))
				end
			elseif dart.kind == "weapon" then
				local character = hit.Instance:FindFirstAncestorOfClass("Model")
				local victim = character and Players:GetPlayerFromCharacter(character)
				Actions.weaponHit(session, dart, hit.Position, victim)
			else
				local kiwi = session.kiwi
				if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
					if kiwi:sedate(session.diff.kiwi.sedateTime, dart.player) then
						session:notify(dart.player, Config.Text.DartHit, Color3.fromRGB(160, 230, 170))
						session:event("darthit", { pos = hit.Position })
					end
				else
					session:event("dartmiss", { pos = hit.Position, normal = hit.Normal })
					session:notify(dart.player, Config.Text.DartMiss, Color3.fromRGB(200, 200, 200))
					ToolService.startCooldown(dart.player, "rifle", session.diff.rifle.cooldownOnMiss)
				end
			end
		else
			dart.pos = dart.pos + dart.dir * stepLen
			if dart.life &lt;= 0 then
				remove = true
			elseif dart.kind == "paint" then
				dart.part.CFrame = CFrame.new(dart.pos)
			elseif dart.kind == "weapon" then
				dart.part.CFrame = CFrame.lookAt(dart.pos, dart.pos + dart.dir)
			else
				dart.part.CFrame = CFrame.lookAt(dart.pos, dart.pos + dart.dir) * CFrame.Angles(0, math.rad(90), 0)
			end
		end

		if remove then
			dart.part:Destroy()
			table.remove(projectiles, i)
		end
	end
end

-- ===============================================================
-- RIFLE DE PINTURA (molesta a otros jugadores)
-- ===============================================================
function Actions.paint(session, player, data)
	local cfg = Config.PaintRifle
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "pintura") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)
	local color = Config.Tools.pintura.color

	local ball = Util.makePart({
		Name = "BolaPintura",
		ClassName = "Part",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.34, 0.34, 0.34),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(muzzle + dir * 1.2),
		Parent = workspace,
	})
	Util.destroyAfter(ball, 6)

	local shot = {
		kind = "paint",
		part = ball,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		color = color,
		params = Actions.makeDartParams(character, ball),
	}

	table.insert(session.projectiles, shot)
	ToolService.startCooldown(player, "pintura", cfg.cooldown)
	session:event("paintshot", { pos = muzzle, dir = dir })
end

-- Mancha brillante visible a traves de las paredes (marca al pintado)
function Actions.markCharacter(character, color, duration, labelText, scale)
	if not character or not character.Parent then
		return
	end

	local oldHighlight = character:FindFirstChild("MarcaPintura")
	if oldHighlight then
		oldHighlight:Destroy()
	end
	local oldTag = character:FindFirstChild("EtiquetaPintura")
	if oldTag then
		oldTag:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MarcaPintura"
	highlight.FillColor = color or Config.Tools.pintura.color
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local anchor = character:FindFirstChild("Head") or character.PrimaryPart or character:FindFirstChildWhichIsA("BasePart")
	local tag
	if anchor then
		tag = Instance.new("BillboardGui")
		tag.Name = "EtiquetaPintura"
		tag.Size = UDim2.fromScale(3.6 * (scale or 1), 1.2 * (scale or 1))
		tag.StudsOffsetWorldSpace = Vector3.new(0, 3.4 * (scale or 1), 0)
		tag.AlwaysOnTop = true
		tag.Parent = anchor

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBlack
		text.TextScaled = true
		text.TextColor3 = color or Config.Tools.pintura.color
		text.TextStrokeTransparency = 0.25
		text.Text = labelText or "¡PINTADO!"
		text.Parent = tag
	end

	task.delay(duration, function()
		if highlight.Parent then
			highlight:Destroy()
		end
		if tag and tag.Parent then
			tag:Destroy()
		end
	end)
end

function Actions.paintPlayer(session, victim, shooter, pos, color)
	local character = victim.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid:SetAttribute("Pintado", true)
		humanoid.WalkSpeed = Config.Player.walkSpeed * Config.PaintRifle.slowFactor
		task.delay(Config.PaintRifle.slowTime, function()
			if humanoid.Parent then
				humanoid:SetAttribute("Pintado", false)
				humanoid.WalkSpeed = Config.Player.walkSpeed
			end
		end)
	end

	Actions.markCharacter(character, color, Config.PaintRifle.markTime)

	local function nameOf(target)
		return target.DisplayName ~= "" and target.DisplayName or target.Name
	end

	session:notify(shooter, string.format(Config.Text.PaintHit, nameOf(victim)), color)
	session:notify(victim, string.format(Config.Text.PaintVictim, nameOf(shooter)), color)
end

function Actions.resolvePaint(session, shot, hit, victim)
	-- Al kiwi lo deja marcado un rato: mas facil de seguir
	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
		Actions.markCharacter(kiwi.model, shot.color, Config.PaintRifle.kiwiMarkTime, "¡KIWI PINTADO!", 1)
		session:event("painthit", { pos = hit.Position, color = Util.colorToTable(shot.color) })
		session:notify(shot.player, Config.Text.PaintKiwiMark, Config.Tools.pintura.color)
		return
	end

	if victim and victim ~= shot.player and session.stats[victim] then
		Actions.paintPlayer(session, victim, shot.player, hit.Position, shot.color)
		session:event("painthit", { pos = hit.Position, color = Util.colorToTable(shot.color) })
		return
	end

	-- Si le pegaste a algo (piso, pared), solo queda la mancha
	session:event("paintmiss", { pos = hit.Position, normal = hit.Normal, color = Util.colorToTable(shot.color) })
end

-- ===============================================================
-- TRAMPA DE FRUTA
-- ===============================================================
function Actions.makeTrapModel(pos)
	local model = Instance.new("Model")
	model.Name = "TrampaDeFruta"
	model.Parent = workspace

	local base = Util.makePart({
		Name = "Base",
		Size = Vector3.new(2.0, 0.22, 2.0),
		Color = Color3.fromRGB(120, 92, 60),
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.11, 0)),
		Parent = model,
	})

	for i = 1, 4 do
		local angle = math.rad(45 + (i - 1) * 90)
		Util.makePart({
			Name = "Varilla" .. i,
			Size = Vector3.new(0.14, 2.1, 0.14),
			Color = Color3.fromRGB(150, 118, 80),
			Material = Enum.Material.Wood,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.new(pos + Vector3.new(math.cos(angle) * 0.85, 1.0, math.sin(angle) * 0.85))
				* CFrame.Angles(math.rad(18), 0, math.rad(-18)),
			Parent = model,
		})
	end

	Util.makePart({
		Name = "Fruta",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		Color = Color3.fromRGB(226, 70, 80),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.55, 0)),
		Parent = model,
	})

	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 130, 120)
	glow.Range = 10
	glow.Brightness = 0.8
	glow.Parent = base

	return model
end

function Actions.trap(session, player, data)
	local cfg = Config.Trampa
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "trampa") &gt; 0 then
		return
	end

	local muzzle = root.Position + Vector3.new(0, 1.1, 0)
	local aim = data and data.aim
	local target
	if typeof(aim) == "Vector3" then
		target = aim
	else
		target = muzzle + root.CFrame.LookVector * 10
	end

	local toTarget = flat(target - muzzle)
	if toTarget.Magnitude &gt; cfg.placeRange then
		toTarget = toTarget.Unit * cfg.placeRange
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { session.arena.ground }
	params.IgnoreWater = true

	local probe = root.Position + toTarget + Vector3.new(0, 12, 0)
	local groundHit = workspace:Raycast(probe, Vector3.new(0, -90, 0), params)

	local groundPos
	if groundHit then
		groundPos = groundHit.Position
	else
		local fallback = root.Position + flat(root.CFrame.LookVector) * 8
		groundPos = Vector3.new(fallback.X, session.arena.floorY, fallback.Z)
	end
	groundPos = session.arena:clampToBounds(groundPos)

	ToolService.startCooldown(player, "trampa", cfg.cooldown)
	session:placeTrap(player, groundPos)
	session:notify(player, Config.Text.TrapPlaced, Config.Tools.trampa.color)
	session:event("trap", { pos = groundPos, userId = player.UserId })
end

-- ===============================================================
-- RASTREADOR
-- ===============================================================
function Actions.tracker(session, player)
	local trackerCfg = Config.Tracker
	if ToolService.getRemaining(player, "rastreador") &gt; 0 then
		return
	end

	ToolService.startCooldown(player, "rastreador", trackerCfg.cooldown)

	local kiwi = session.kiwi
	local _, root = getRoot(player)
	if not kiwi or kiwi.defeated or not root then
		session:notify(player, Config.Text.TrackerNothing, Color3.fromRGB(200, 200, 200))
		return
	end

	local kiwiPos = kiwi:getPosition()
	local distance = flatDistance(kiwiPos, root.Position)
	if distance &gt; trackerCfg.range then
		session:notify(player, Config.Text.TrackerNothing, Color3.fromRGB(200, 200, 200))
		return
	end

	Net.get("TrackerPing"):FireClient(player, {
		pos = kiwiPos,
		hidden = kiwi:isHidden(),
		state = session.diff.showKiwiState and kiwi:getStateHint() or nil,
		distance = distance,
		duration = trackerCfg.duration,
	})

	session:notify(player, Config.Text.TrackerFound, Color3.fromRGB(120, 220, 170))
	session:event("ping", { pos = kiwiPos, userId = player.UserId })
end

-- ===============================================================
-- Punto de entrada
-- ===============================================================
local function hasTool(player, toolId)
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in ipairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					return true
				end
			end
		end
	end
	return false
end

function Actions.run(session, player, toolId, data)
	if session.phase ~= "playing" then
		return
	end

	local alive, root = getRoot(player)
	if not root or not alive:FindFirstChildOfClass("Humanoid") then
		return
	end

	if not hasTool(player, toolId) then
		return
	end

	data = data or {}

	if toolId == "red" then
		Actions.net(session, player, data)
	elseif toolId == "rifle" then
		Actions.rifle(session, player, data)
	elseif toolId == "rastreador" then
		Actions.tracker(session, player, data)
	elseif toolId == "trampa" then
		Actions.trap(session, player, data)
	elseif toolId == "pintura" then
		Actions.paint(session, player, data)
	elseif toolId == "relente" then
		Actions.relente(session, player, data)
	elseif Config.Weapons[toolId] then
		Actions.fireWeapon(session, player, toolId, data)
	end
end

return Actions
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX018">
					<Properties>
						<string name="Name">GameManager</string>
						<ProtectedString name="Source">--[[
	GameManager.lua  (servidor)
	Maneja las partidas: quien entra, en que arena, fases de la ronda
	(cuenta regresiva / caza / resultados), el kiwi de cada sesion, los
	premios y el regreso al lobby.

	Modos:
		facil / normal / dificil  -&gt; individual, hay que atrapar N kiwis
		colosal                   -&gt; sobrevive al kiwi gigante escondiéndote
		multi                     -&gt; todos juntos, gana el primero
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local WorldBuilder = require(script.Parent.WorldBuilder)
local KiwiController = require(script.Parent.KiwiController)
local ToolService = require(script.Parent.ToolService)
local Actions = require(script.Parent.Actions)

local GameManager = {}

local Session = {}
Session.__index = Session

local world
local sessions = {}
local playerSession = {}
local sessionCounter = 0

local COLOR = {
	good = Color3.fromRGB(102, 209, 130),
	bad = Color3.fromRGB(232, 108, 100),
	warn = Color3.fromRGB(238, 196, 92),
	info = Color3.fromRGB(200, 214, 226),
	fx = Color3.fromRGB(160, 200, 255),
}

-- ===============================================================
-- Iluminacion (cambia segun el mapa y se restaura al salir)
-- ===============================================================
local function applyLighting(preset)
	if not preset then
		return
	end
	Lighting.Ambient = preset.ambient
	Lighting.OutdoorAmbient = preset.outdoor
	Lighting.Brightness = preset.brightness
	Lighting.FogColor = preset.fog
	Lighting.FogStart = preset.fogStart
	Lighting.FogEnd = preset.fogEnd
	Lighting.ClockTime = preset.clock
end

local function applyZoneLighting(arena)
	local zone = arena and arena.zone
	local preset = zone and Config.ZoneLight[zone.theme or "bosque"]
	applyLighting(preset or Config.LightDefault)
end

-- ===============================================================
-- Utilidades de jugador
-- ===============================================================
local function getRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function setFrozen(player, frozen)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = frozen and 0 or Config.Player.walkSpeed
		humanoid.JumpPower = frozen and 0 or 50
		humanoid.UseJumpPower = true
	end
end

-- Oculta el cuerpo entero dentro de un escondite (invisible para todos)
local function setBodyHidden(player, hidden)
	local character = player.Character
	if not character then
		return
	end
	for _, item in ipairs(character:GetDescendants()) do
		if item:IsA("BasePart") then
			if hidden then
				if item:GetAttribute("HideT") == nil then
					item:SetAttribute("HideT", item.Transparency)
					item.Transparency = 1
				end
			else
				local saved = item:GetAttribute("HideT")
				if saved ~= nil then
					item.Transparency = saved
					item:SetAttribute("HideT", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = hidden and Enum.HumanoidDisplayDistanceType.None
			or Enum.HumanoidDisplayDistanceType.Viewer
	end
end

local function leaderstatsFor(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end

	local function stat(name, default)
		local value = stats:FindFirstChild(name)
		if not value then
			value = Instance.new("IntValue")
			value.Name = name
			value.Value = default
			value.Parent = stats
		end
		return value
	end

	return {
		stats = stats,
		caught = stat("Kiwis", 0),
		coins = stat("Monedas", 0),
	}
end

local function addCoins(player, amount)
	local stats = leaderstatsFor(player)
	stats.coins.Value = stats.coins.Value + amount
	return stats.coins.Value
end

local function addCaught(player, amount)
	local stats = leaderstatsFor(player)
	stats.caught.Value = stats.caught.Value + amount
end

-- ===============================================================
-- SESION
-- ===============================================================
function Session.new(modeId, rng)
	local self = setmetatable({}, Session)
	sessionCounter = sessionCounter + 1
	self.id = sessionCounter
	self.rng = rng or Random.new()
	self.modeId = modeId
	self.players = {}
	self.stats = {}
	self.projectiles = {}
	self.finished = false
	self.needRespawn = false
	self.respawnAt = 0
	self.kiwi = nil
	self.winner = nil
	self.arena = nil
	self.updateTimer = 0
	self.traps = {}
	self.hidden = {}
	self.hideSpot = {}
	self.isColosal = modeId == "colosal"
	self.mapVote = {}
	self.chosenMap = nil
	self.voteDone = false
	self.knocked = {}

	if modeId == "multi" then
		self.isMulti = true
		self.diff = Config.Difficulties[Config.Multiplayer.baseDifficulty]
		self.name = Config.Multiplayer.name
		self.tag = Config.Multiplayer.tag
		self.color = Config.Multiplayer.color
		self.timeLimit = Config.Multiplayer.timeLimit
		-- La espera inicial es la votacion de mapa: votan todos y arranca.
		self.phase = "vote"
		self.phaseEnds = os.clock() + Config.Vote.multiTime
	else
		self.isMulti = false
		self.diff = Config.Difficulties[modeId] or Config.Difficulties.normal
		self.name = self.diff.name
		self.tag = self.diff.tag
		self.color = self.diff.color
		self.timeLimit = self.diff.round.timeLimit
		-- Modo solo: elige el mapa el jugador y arranca enseguida.
		self.phase = "vote"
		self.phaseEnds = os.clock() + Config.Vote.soloTime
	end

	return self
end

function Session:modeColorTable()
	return Util.colorToTable(self.color)
end

function Session:notify(player, text, color, duration)
	Net.get("Notify"):FireClient(player, text, Util.colorToTable(color or COLOR.info), duration or 4)
end

function Session:notifyAll(text, color, duration)
	for _, player in ipairs(self.players) do
		self:notify(player, text, color, duration)
	end
end

function Session:event(kind, data)
	Net.get("WorldEvent"):FireAllClients(kind, data)
end

-- ---------------- herramientas / trampas ----------------
-- Entrega las herramientas segun el modo (colosal solo el rastreador,
-- multijugador suma el rifle de pintura).
function Session:giveTools(player)
	local only = self.diff.tools
	if self.isMulti then
		only = Config.Multiplayer.tools
	end
	ToolService.give(player, only)
	if not only and not self.isColosal and not self.isMulti and #self.players &gt;= 2 then
		ToolService.giveTool(player, "pintura")
	end
end

function Session:placeTrap(player, pos)
	if self.isColosal then
		return
	end

	local cfg = Config.Trampa
	local mine = {}
	for _, trap in ipairs(self.traps) do
		if trap.owner == player then
			table.insert(mine, trap)
		end
	end

	if #mine &gt;= cfg.maxActive then
		self:removeTrap(mine[1])
	end

	local trap = {
		model = Actions.makeTrapModel(pos),
		pos = Vector3.new(pos.X, pos.Y, pos.Z),
		owner = player,
		armed = true,
	}
	table.insert(self.traps, trap)
end

function Session:removeTrap(trap)
	for index, other in ipairs(self.traps) do
		if other == trap then
			table.remove(self.traps, index)
			break
		end
	end
	trap.armed = false
	if trap.model then
		trap.model:Destroy()
		trap.model = nil
	end
end

function Session:removeTrapsOf(player)
	for index = #self.traps, 1, -1 do
		local trap = self.traps[index]
		if trap.owner == player then
			self:removeTrap(trap)
		end
	end
end

function Session:clearTraps()
	for _, trap in ipairs(self.traps) do
		trap.armed = false
		if trap.model then
			trap.model:Destroy()
			trap.model = nil
		end
	end
	self.traps = {}
end

-- ---------------- kiwi gigante ----------------
function Session:giantCatch(player)
	if not player or self.phase ~= "playing" or not self.stats[player] then
		return
	end

	self.eaten = self.eaten or {}
	if self.eaten[player] then
		return
	end
	self.eaten[player] = true

	local name = player.DisplayName ~= "" and player.DisplayName or player.Name
	self:notifyAll(string.format(Config.Text.GiantEaten, name), COLOR.bad, 5)
	self:notify(player, Config.Text.DeathSubtitle, COLOR.bad, 4)
	self:event("giantcatch", { pos = self.kiwi and self.kiwi:getPosition(), userId = player.UserId })

	-- Queda "siendo comido" dos segundos (congelado) antes de volver al lobby
	setFrozen(player, true)

	task.delay(Config.Round.EatHold, function()
		self.eaten[player] = nil
		if self.stats[player] then
			setFrozen(player, false)
			self:removePlayer(player, true)
			-- De vuelta al lobby con el menu a la vista: asi elige otro modo facil
			Net.get("SessionUpdate"):FireClient(player, { active = false })
			Net.get("Notify"):FireClient(player, Config.Text.EatenMenu, Util.colorToTable(COLOR.info), 5)
		end
	end)
end

function Session:trapCatch(bait)
	if not bait then
		return
	end

	local owner = bait.owner
	self:removeTrap(bait)

	if not owner or not self.stats[owner] then
		self:notifyAll(Config.Text.TrapEaten, COLOR.info)
		return
	end

	local name = owner.DisplayName ~= "" and owner.DisplayName or owner.Name
	self:notifyAll(string.format(Config.Text.TrapStuck, name, Config.Trampa.holdTime), COLOR.good)
	self:event("trapcatch", { pos = bait.pos })

	if self.kiwi and not self.kiwi.defeated then
		self.kiwi:trapHold(Config.Trampa.holdTime)
	end
end

-- ---------------- daño entre cazadores ----------------
-- Las armas de baul hieren a los jugadores. Al kiwi SOLO lo relentizan.
function Session:damagePlayer(victim, attacker, weaponName, amount, pos)
	if not self.stats[victim] or self.phase ~= "playing" then
		return
	end
	if self.knocked[victim] then
		return
	end

	local data = self.stats[victim]
	amount = math.max(1, math.floor(amount + 0.5))
	data.hp = math.max(0, (data.hp or Config.Player.maxHealth) - amount)
	data.lastHurt = os.clock()

	local attackerName = "el mapa"
	if attacker and attacker ~= victim then
		attackerName = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
	end
	self:notify(victim, string.format(Config.Text.HurtMsg, attackerName, weaponName, amount), COLOR.bad, 3)
	self:event("hurt", { pos = pos, userId = victim.UserId, amount = amount })
	self:sendUpdate(victim)

	if data.hp &lt;= 0 then
		self:knockout(victim, attacker)
	end
end

function Session:knockout(victim, attacker)
	if self.knocked[victim] or not self.stats[victim] then
		return
	end
	self.knocked[victim] = true

	local vname = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
	local aname = "la reserva"
	if attacker and attacker ~= victim then
		aname = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
	end
	self:notifyAll(string.format(Config.Text.KoedAll, aname, vname), COLOR.warn, 5)
	self:event("ko", { userId = victim.UserId })
	setFrozen(victim, true)

	task.delay(Config.Round.KoHold, function()
		self.knocked[victim] = nil
		if self.stats[victim] then
			setFrozen(victim, false)
			self:removePlayer(victim, true)
			-- Igual que cuando te come el kiwi: al lobby con el menu listo
			Net.get("SessionUpdate"):FireClient(victim, { active = false })
			Net.get("Notify"):FireClient(victim, Config.Text.KoMenu, Util.colorToTable(COLOR.info), 5)
		end
	end)
end

function Session:stepHealth(dt)
	local max = Config.Player.maxHealth
	local now = os.clock()
	for _, player in ipairs(self.players) do
		local data = self.stats[player]
		if data and data.hp and data.hp &lt; max and now - (data.lastHurt or 0) &gt;= Config.Player.regenDelay then
			data.hp = math.min(max, data.hp + Config.Player.regen * dt)
		end
	end
end

-- ---------------- jugadores ----------------
function Session:isFull()
	if not self.isMulti then
		return #self.players &gt;= 1
	end
	return #self.players &gt;= Config.Multiplayer.maxPlayers
end

function Session:addPlayer(player)
	if self.stats[player] then
		return
	end

	self.stats[player] = { caught = 0, hp = Config.Player.maxHealth }
	table.insert(self.players, player)
	playerSession[player] = self
	ToolService.reset(player)

	if self.phase == "vote" then
		if self.voteDone then
			self:notify(player, "Entraste a la partida. Está por comenzar...", COLOR.good, 5)
		else
			self:notify(player, "Entraste a la partida. Vota el mapa para arrancar.", COLOR.good, 6)
		end
	elseif self.phase == "countdown" then
		local seconds = math.floor(self.phaseEnds - os.clock())
		self:notify(player, string.format("Entraste a la partida. Comienza en %d s", math.max(0, seconds)), COLOR.good)
		self:teleportToArena(player)
		self:giveTools(player)
	elseif self.phase ~= "ended" then
		self:teleportToArena(player)
		self:giveTools(player)
		if not self.isColosal then
			for _, other in ipairs(self.players) do
				if other ~= player then
					ToolService.giveTool(other, "pintura")
					self:notify(other, Config.Text.PvpRifleOn, Config.Tools.pintura.color, 6)
				end
			end
		end
		self:notify(player, "¡Te uniste a una partida en curso!", COLOR.warn)
	end

	self:sendUpdate(player)
end

function Session:removePlayer(player, silent)
	if not self.stats[player] then
		return
	end

	if self.hideSpot[player] then
		self:exitSpot(player, true)
	end

	self.stats[player] = nil
	for index, other in ipairs(self.players) do
		if other == player then
			table.remove(self.players, index)
			break
		end
	end

	if playerSession[player] == self then
		playerSession[player] = nil
	end

	self:removeTrapsOf(player)
	ToolService.clear(player)
	GameManager.returnToLobby(player, not silent)

	if not self.isColosal and not self.isMulti then
		for _, other in ipairs(self.players) do
			if ToolService.takeTool(other, "pintura") then
				self:notify(other, Config.Text.PvpRifleOff, COLOR.info, 4)
			end
		end
	end

	-- Multijugador: si solo queda uno, es el ganador de la ronda
	if self.isMulti and self.phase == "playing" then
		if #self.players == 1 then
			local last = self.players[1]
			local lastName = last.DisplayName ~= "" and last.DisplayName or last.Name
			self:notifyAll(string.format(Config.Text.LastAlive, lastName), COLOR.good, 6)
			self:endRound(last, "last")
		elseif #self.players == 0 then
			self:endRound(nil, "timeout")
		end
	end

	-- Votacion: si se fue un jugador y ya votaron todos, arranca la partida
	if self.phase == "vote" and not self.voteDone and #self.players &gt; 0 and self:allVoted() then
		self:pickVoteWinner()
	end
end

function Session:prunePlayers()
	for index = #self.players, 1, -1 do
		local player = self.players[index]
		if not self.stats[player] then
			table.remove(self.players, index)
		end
	end
end

-- ---------------- votacion de mapa ----------------
local function zoneById(id)
	for _, zone in ipairs(Config.Zones) do
		if zone.id == id then
			return zone
		end
	end
	return nil
end

function Session:allVoted()
	if #self.players == 0 then
		return false
	end
	for _, player in ipairs(self.players) do
		if not self.mapVote[player] then
			return false
		end
	end
	return true
end

function Session:castVote(player, mapId)
	if self.phase ~= "vote" or self.voteDone or not self.stats[player] then
		return
	end
	if mapId ~= "random" and not zoneById(mapId) then
		return
	end
	self.mapVote[player] = mapId
	self:sendUpdate(player)
	if self:allVoted() then
		self:pickVoteWinner()
	end
end

function Session:pickVoteWinner()
	if self.voteDone then
		return
	end
	self.voteDone = true

	local counts = {}
	local leader, leaderCount = nil, 0
	for _, player in ipairs(self.players) do
		local pick = self.mapVote[player]
		if pick then
			counts[pick] = (counts[pick] or 0) + 1
			if counts[pick] &gt; leaderCount then
				leader, leaderCount = pick, counts[pick]
			end
		end
	end

	-- Empate: se decide al azar entre los mas votados
	if leader then
		local top = {}
		for id, count in pairs(counts) do
			if count == leaderCount then
				table.insert(top, id)
			end
		end
		leader = top[self.rng:NextInteger(1, #top)]
	end

	local zone = zoneById(leader)
	if not zone then
		zone = Config.Zones[self.rng:NextInteger(1, #Config.Zones)]
	end

	self.chosenMap = zone.id
	self.phaseEnds = os.clock() + Config.Vote.revealTime
	self:notifyAll(string.format(Config.Text.MapPickNotify, zone.name), COLOR.good, 4)
	self:sendUpdates(true)
end

-- ---------------- arenas ----------------
function Session:allocateArena(mapId)
	if self.arena then
		return true
	end
	local fallback
	for _, arena in ipairs(world.arenas) do
		if not arena.busy then
			if not fallback then
				fallback = arena
			end
			if not mapId or arena.mapId == mapId then
				arena.busy = true
				self.arena = arena
				return true
			end
		end
	end
	if fallback then
		fallback.busy = true
		self.arena = fallback
		return true
	end
	return false
end

function Session:spawnsFor(player)
	local index = 1
	for i, other in ipairs(self.players) do
		if other == player then
			index = i
			break
		end
	end
	local spawns = self.arena.spawns
	local spawn = spawns[((index - 1) % #spawns) + 1]
	return spawn + Vector3.new(0, 4, 0)
end

function Session:teleportToArena(player)
	if not self.arena then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	character:PivotTo(self:spawnsFor(player))
	local root = getRoot(player)
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end

function Session:returnAllToLobby()
	for _, player in ipairs(self.players) do
		GameManager.returnToLobby(player)
	end
end

-- ---------------- fases ----------------
function Session:startCountdown()
	self.phase = "countdown"
	self.phaseEnds = os.clock() + Config.Round.Countdown

	for _, player in ipairs(self.players) do
		self:teleportToArena(player)
		self:giveTools(player)
		setFrozen(player, true)
	end

	self:event("countdown", { pos = self.arena.spawns[1].Position, phase = self.phase })
	self:notifyAll(string.format("Partida %s en %s", self.name, self.arena.name), self.color, Config.Round.Countdown)
	self:sendUpdates(true)
end

function Session:startPlaying()
	self.phase = "playing"
	self.startedAt = os.clock()
	self.safeAttract = 0
	applyZoneLighting(self.arena)
	local enterList = self.arena and self.arena.enterList
	if enterList then
		for _, spot in ipairs(enterList) do
			spot.occupied = nil
			spot.sniffCooldownUntil = nil
		end
	end
	local chests = self.arena and self.arena.chests
	if chests then
		for _, chest in ipairs(chests) do
			chest.used = false
			chest.lid.CFrame = chest.lidClosed
			chest.light.Brightness = 1.4
			chest.prompt.Enabled = true
		end
	end
	local zone = self.arena and self.arena.safeZone
	if zone then
		zone.active = false
		if zone.ring then
			zone.ring.Color = Color3.fromRGB(90, 110, 130)
			zone.ring.Transparency = 0.4
		end
		if zone.beam then
			zone.beam.Transparency = 0.85
		end
		if zone.light then
			zone.light.Brightness = 0
		end
		if zone.label then
			zone.label.Text = "ZONA SEGURA (se activa mas tarde)"
			zone.label.TextColor3 = Color3.fromRGB(150, 200, 220)
		end
	end
	self:spawnKiwi()
	self:sendUpdates(true)
	for _, player in ipairs(self.players) do
		setFrozen(player, false)
		if self.isColosal or self.isMulti then
			self:notify(player, "¡Escóndete! El kiwi gigante ya salió a buscar.", COLOR.warn, 6)
		else
			self:notify(player, "¡A cazar al kiwi!", COLOR.good)
		end
	end
	self:event("start", { pos = self.arena.spawns[1].Position })
end

function Session:endRound(winner, reason)
	if self.phase == "ended" then
		return
	end

	self.phase = "ended"
	self.phaseEnds = os.clock() + Config.Round.EndScreen
	self.winner = winner
	self.reason = reason

	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end
	for _, dart in ipairs(self.projectiles) do
		dart.part:Destroy()
	end
	self.projectiles = {}
	self:clearTraps()

	for _, player in ipairs(self.players) do
		if self.hideSpot[player] then
			self:exitSpot(player, true)
		end
		setFrozen(player, true)
		Net.get("SessionEnd"):FireClient(player, self:buildResult(player))
	end
end

function Session:buildResult(player)
	local data = self.stats[player] or { caught = 0 }
	local lines = {}
	local title, subtitle
	local won = false
	local coins = data.caught * self.diff.round.reward

	if self.isMulti then
		if self.reason == "last" and self.winner then
			local winnerName = self.winner.DisplayName ~= "" and self.winner.DisplayName or self.winner.Name
			title = "¡Ganó " .. winnerName .. "!"
			subtitle = "Último cazador en pie: el kiwi gigante se comió a los demás."
			won = (self.winner == player)
			if won then
				coins = coins + self.diff.round.winBonus
			end
		elseif self.winner then
			local winnerName = self.winner.DisplayName ~= "" and self.winner.DisplayName or self.winner.Name
			title = "Ganó " .. winnerName
			subtitle = "Ronda terminada."
			won = (self.winner == player)
			if won then
				coins = coins + self.diff.round.winBonus
			end
		else
			title = "Sobrevivieron los últimos"
			subtitle = "Se acabó el tiempo y el kiwi gigante no llegó a terminarlos."
			won = true
			coins = coins + self.diff.round.reward
		end
	elseif self.isColosal then
		if self.reason == "safe" then
			title = "¡Llegaste al refugio!"
			subtitle = "Esquivaste al kiwi y entraste a la zona segura."
			won = true
			coins = coins + self.diff.round.reward + self.diff.round.winBonus
			table.insert(lines, string.format("Recompensa del refugio: %d monedas",
				self.diff.round.reward + self.diff.round.winBonus))
		elseif self.reason == "timeout" then
			title = "¡Sobreviviste!"
			subtitle = Config.Text.GiantSafe
			won = true
			coins = coins + self.diff.round.reward + self.diff.round.winBonus
			table.insert(lines, string.format("Recompensa por sobrevivir: %d monedas",
				self.diff.round.reward + self.diff.round.winBonus))
		else
			title = "El kiwi gigante te encontró"
			subtitle = "La próxima vez, escóndete mejor."
		end
	else
		local quota = self.diff.round.quota
		if self.reason == "quota" then
			title = "¡Cacería completada!"
			subtitle = string.format("Atrapaste %d de %d kiwis", data.caught, quota)
			won = true
			coins = coins + self.diff.round.winBonus
			local bonus = self:remainingSeconds()
			if bonus &gt; 0 then
				coins = coins + math.floor(bonus * self.diff.round.timeBonus)
				table.insert(lines, string.format("Bono por tiempo: +%d monedas", math.floor(bonus * self.diff.round.timeBonus)))
			end
		else
			title = "Se escapó el kiwi"
			subtitle = string.format("Atrapaste %d de %d kiwis antes de que se acabara el tiempo", data.caught, quota)
		end
	end

	table.insert(lines, string.format("Kiwis atrapados: %d", data.caught))
	table.insert(lines, string.format("Monedas ganadas: %d", coins))

	local ranking = {}
	for _, other in ipairs(self.players) do
		local otherStats = self.stats[other]
		table.insert(ranking, {
			name = other.DisplayName ~= "" and other.DisplayName or other.Name,
			caught = otherStats and otherStats.caught or 0,
			isWinner = other == self.winner,
			isSelf = other == player,
		})
	end

	addCoins(player, coins)

	return {
		title = title,
		subtitle = subtitle,
		won = won,
		lines = lines,
		ranking = ranking,
		color = Util.colorToTable(won and COLOR.good or COLOR.bad),
		modeName = self.name,
		arenaName = self.arena and self.arena.name or "?",
	}
end

function Session:remainingSeconds()
	if self.phase == "playing" then
		return math.max(0, self.startedAt + self.timeLimit - os.clock())
	elseif self.phase == "vote" or self.phase == "countdown" or self.phase == "ended" then
		return math.max(0, self.phaseEnds - os.clock())
	end
	return 0
end

function Session:finish()
	if self.finished then
		return
	end
	self.finished = true
	applyLighting(Config.LightDefault)

	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end
	for _, dart in ipairs(self.projectiles) do
		dart.part:Destroy()
	end
	self.projectiles = {}
	self:clearTraps()

	if Config.Round.HubReturn then
		self:returnAllToLobby()
	end
	for _, player in ipairs(self.players) do
		ToolService.clear(player)
		Net.get("SessionUpdate"):FireClient(player, { active = false })
		if playerSession[player] == self then
			playerSession[player] = nil
		end
	end

	if self.arena then
		self.arena.busy = false
		self.arena = nil
	end
end

-- ---------------- kiwi ----------------
function Session:spawnKiwi()
	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end

	local cfg = self.diff.kiwi
	local opts
	if self.isColosal or self.isMulti then
		if self.isMulti then
			cfg = Config.Difficulties.colosal.kiwi
		end
		opts = { brain = "seeker", scale = cfg.scale or 4 }
	end

	self.kiwi = KiwiController.new(self.arena, cfg, self.rng, {
		onEvent = function(kind, data)
			self:onKiwiEvent(kind, data)
		end,
		onTouchCapture = function(kiwi, player)
			self:onKiwiTouch(kiwi, player)
		end,
	}, opts)
end

function Session:onKiwiEvent(kind, data)
	local pos = data and (data.pos or (data.spot and data.spot.hidePoint))
	if kind == "flush" then
		self:notifyAll(Config.Text.KiwiRunning, COLOR.warn)
		self:event("flush", { pos = pos })
	elseif kind == "sedate" then
		self:notifyAll(Config.Text.KiwiSleeping, COLOR.good)
		self:event("sedate", { pos = pos })
	elseif kind == "wake" then
		self:notifyAll(Config.Text.WakeUp, COLOR.bad)
		self:event("wake", { pos = pos })
	elseif kind == "tired" then
		self:notifyAll("¡El kiwi está agotado!", COLOR.info)
	elseif kind == "capture" then
		self:event("captured", { pos = pos })
	elseif kind == "trapcatch" then
		self:trapCatch(data and data.bait)
	elseif kind == "trapescape" then
		self:notifyAll(Config.Text.TrapEscaped, COLOR.warn)
		self:event("trapescape", { pos = pos })
	elseif kind == "slowend" then
		self:notifyAll(Config.Text.SlowEnd, COLOR.info)
	elseif kind == "hunt" then
		self:notifyAll("¡El kiwi gigante te escuchó! Corre.", COLOR.bad, 4)
		self:event("hunt", { pos = pos })
	elseif kind == "roar" then
		self:event("roar", { pos = pos })
	elseif kind == "chomp" then
		self:event("chomp", { pos = pos })
	elseif kind == "sniffstart" then
		self:event("sniffstart", { pos = pos, index = data and data.index })
		local victim = data and data.player
		if victim and self.stats[victim] then
			self:notify(victim, "¡El kiwi te está husmeando! Sal con E y corre", COLOR.bad, 4)
		end
	elseif kind == "sniff" then
		self:event("sniff", { pos = pos, index = data and data.index })
	elseif kind == "sniffmiss" then
		self:event("sniffmiss", { pos = pos, index = data and data.index })
	elseif kind == "sniffcatch" then
		local victim = data and data.player
		if victim and self.stats[victim] and self.hidden[victim] then
			self:exitSpot(victim, true)
			local name = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
			self:notifyAll(string.format(Config.Text.SniffCaught, name), COLOR.bad, 5)
		end
		self:event("sniffcatch", { pos = pos, index = data and data.index })
		if victim and self.stats[victim] then
			self:giantCatch(victim)
		end
	elseif kind == "catch" then
		self:giantCatch(data and data.player)
	end
end

function Session:onKiwiTouch(kiwi, player)
	if self.phase ~= "playing" or self.kiwi ~= kiwi then
		return
	end
	if not self.stats[player] then
		return
	end
	if kiwi.state == "trapped" then
		self:capture(player, "fruta")
	else
		self:capture(player, "manos")
	end
end

function Session:capture(player, method)
	if self.phase ~= "playing" or not self.kiwi or self.kiwi.defeated then
		return
	end
	local data = self.stats[player]
	if not data then
		return
	end

	self.kiwi:capture(player)
	data.caught = data.caught + 1
	addCaught(player, 1)
	addCoins(player, self.diff.round.reward)

	local name = player.DisplayName ~= "" and player.DisplayName or player.Name
	if method == "manos" then
		self:notifyAll(name .. " atrapó al kiwi dormido!", COLOR.good)
	elseif method == "trampa" then
		self:notifyAll(string.format(Config.Text.TrapCaptured, name), COLOR.good)
	elseif method == "fruta" then
		self:notifyAll(name .. " aprovechó que estaba enganchado en la fruta!", COLOR.good)
	else
		self:notifyAll(name .. " atrapó al kiwi con la red!", COLOR.good)
	end
	self:event("captured", { pos = self.kiwi and self.kiwi:getPosition() })

	if self.isMulti then
		self:endRound(player, "captured")
		return
	end

	if data.caught &gt;= self.diff.round.quota then
		self:endRound(player, "quota")
	else
		self.needRespawn = true
		self.respawnAt = os.clock() + Config.Round.KiwiRespawnDelay
		self:notify(player, string.format("Tienes %d de %d. El próximo kiwi ya casi aparece...", data.caught, self.diff.round.quota), COLOR.info)
	end
end

-- ---------------- escondites de jugador ----------------
function Session:enterSpot(player, index)
	if self.phase ~= "playing" then
		return
	end
	local arena = self.arena
	local spot = arena and arena.enterList and arena.enterList[index]
	if not spot or not spot.enter then
		return
	end

	local character = player.Character
	local root = getRoot(player)
	if not character or not root or self.hidden[player] then
		return
	end

	if spot.occupied and spot.occupied ~= player then
		self:notify(player, Config.Text.HideBusy, COLOR.warn, 3)
		return
	end

	if (root.Position - spot.enter.inside.Position).Magnitude &gt; Config.Hide.enterRange then
		return
	end

	spot.occupied = player
	self.hidden[player] = true
	self.hideSpot[player] = index

	local prompt = spot.enter.prompt
	if prompt then
		prompt.ActionText = "Salir"
	end

	setFrozen(player, true)
	setBodyHidden(player, true)
	root.CFrame = spot.enter.inside
	root.AssemblyLinearVelocity = Vector3.zero
	if spot.enter.door and spot.enter.doorOpen then
		spot.enter.door.CFrame = spot.enter.doorOpen
	end

	local kiwi = self.kiwi
	if kiwi and kiwi.state == "sniff" and kiwi.sniffIndex == index then
		self:notify(player, "¡El kiwi ya estaba husmeando aquí! Aguanta o sal y corre", COLOR.bad, 4)
	end

	self:event("hidestart", { pos = spot.hidePoint, index = index })
	self:sendUpdate(player)
end

function Session:exitSpot(player, caught)
	local index = self.hideSpot[player]
	if not index then
		return
	end
	local arena = self.arena
	local spot = arena and arena.enterList and arena.enterList[index]

	self.hideSpot[player] = nil
	self.hidden[player] = nil
	if spot then
		spot.occupied = nil
		if spot.enter.door and spot.enter.doorClosed then
			spot.enter.door.CFrame = spot.enter.doorClosed
		end
		if spot.enter.wobble and spot.enter.wobbleCF then
			spot.enter.wobble.CFrame = spot.enter.wobbleCF
		end
		if spot.enter.prompt then
			spot.enter.prompt.ActionText = "Esconderse"
		end
	end

	setBodyHidden(player, false)
	local root = getRoot(player)
	if root and spot and spot.enter.exit then
		root.CFrame = spot.enter.exit
		root.AssemblyLinearVelocity = Vector3.zero
	end

	local kiwi = self.kiwi
	local sniffed = kiwi and kiwi.state == "sniff" and kiwi.sniffIndex == index
	if caught then
		setFrozen(player, true)
		return
	end

	setFrozen(player, false)
	self:event("hidestop", { index = index, pos = spot and spot.hidePoint })
	if sniffed then
		-- Salio justo mientras lo husmeaban: premio y el kiwi le sale
		-- al paso al instante (el "casi" clasico del escondite)
		addCoins(player, Config.Hide.escapeCoins)
		self:notify(player, string.format(Config.Text.HideEscape, Config.Hide.escapeCoins), COLOR.good, 4)
		kiwi:sniffMiss(root and root.Position or nil)
	end
	self:sendUpdate(player)
end

-- ---------------- baules de armas ----------------
function Session:openChest(player, index)
	local chest = self.arena and self.arena.chests and self.arena.chests[index]
	if not chest or chest.used then
		return
	end
	if self.phase ~= "playing" or self.hidden[player] then
		return
	end
	local root = getRoot(player)
	if not root or (root.Position - chest.center).Magnitude &gt; Config.Loot.pickupRange then
		return
	end

	chest.used = true
	chest.lid.CFrame = chest.lidOpen
	chest.light.Brightness = 0
	chest.prompt.Enabled = false

	local weapons = Config.Loot.weapons
	local total = 0
	for _, entry in ipairs(weapons) do
		total = total + (entry.weight or 1)
	end
	local roll = self.rng:NextInteger(1, math.max(total, 1))
	local pick = weapons[1]
	for _, entry in ipairs(weapons) do
		roll = roll - (entry.weight or 1)
		if roll &lt;= 0 then
			pick = entry
			break
		end
	end

	-- Un arma de baul a la vez: la anterior se pierde
	for _, entry in ipairs(weapons) do
		ToolService.takeTool(player, entry.id)
	end
	ToolService.giveLoot(player, pick.id, Config.Loot.uses)

	local cfg = Config.Weapons[pick.id]
	self:notify(player, string.format(Config.Text.ChestLoot, cfg.name, Config.Loot.uses), cfg.color, 5)
	self:event("chestopen", { pos = chest.center })
	self:sendUpdate(player)
end

-- ---------------- bucle ----------------
function Session:buildPlayerList()
	local list = {}
	for _, player in ipairs(self.players) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health &gt; 0 then
			local hidden = self.hidden[player] == true
			local indoor = false
			if not hidden and self.arena and self.arena.indoors then
				for _, room in ipairs(self.arena.indoors) do
					local rel = room.cf:PointToObjectSpace(root.Position)
					if math.abs(rel.X) &lt;= room.size.X * 0.5
						and math.abs(rel.Z) &lt;= room.size.Z * 0.5
						and rel.Y &gt;= -2 and rel.Y &lt;= room.size.Y + 3 then
						indoor = true
						break
					end
				end
			end
			local velocity = root.AssemblyLinearVelocity
			local speed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
			local noise = math.clamp((speed - 6) / 14, 0, 1)
			if humanoid.FloorMaterial == Enum.Material.Air then
				noise = math.min(1, noise + 0.35)
			end
			if indoor then
				noise = noise * Config.Hide.smellIndoor
			end
			table.insert(list, {
				player = player,
				pos = root.Position,
				noise = noise,
				speed = speed,
				hidden = hidden,
				indoor = indoor,
			})
		end
	end
	return list
end

function Session:stepSafeZone(dt)
	local zone = self.arena and self.arena.safeZone
	if not zone then
		return
	end

	if not zone.active then
		local elapsed = os.clock() - (self.startedAt or os.clock())
		if elapsed &gt;= Config.SafeZone.activateAfter then
			zone.active = true
			if zone.ring then
				zone.ring.Color = Color3.fromRGB(120, 255, 190)
				zone.ring.Transparency = 0.1
			end
			if zone.beam then
				zone.beam.Transparency = 0.35
			end
			if zone.light then
				zone.light.Brightness = 2.6
			end
			if zone.label then
				zone.label.Text = "¡ENTRA PARA GANAR!"
				zone.label.TextColor3 = Color3.fromRGB(150, 255, 200)
			end
			self.safeAttract = 0
			self:notifyAll(Config.Text.SafeActive, COLOR.good, 6)
			self:event("safeactive", { pos = zone.center })
		end
		return
	end

	local player = self.players[1]
	local root = player and getRoot(player)
	if not player or not root then
		return
	end

	-- Llego al refugio: gana al instante
	local offset = zone.center - root.Position
	offset = Vector3.new(offset.X, 0, offset.Z)
	if offset.Magnitude &lt;= zone.radius then
		self:endRound(player, "safe")
		return
	end

	-- El kiwi le corta el paso: se planta entre el cazador y el refugio
	self.safeAttract = (self.safeAttract or 0) - dt
	if self.safeAttract &lt;= 0 and self.kiwi and not self.kiwi.defeated then
		self.safeAttract = Config.SafeZone.attractEvery
		local blockPoint = root.Position
		if offset.Magnitude &gt; 0.1 then
			blockPoint = root.Position + offset.Unit * math.min(offset.Magnitude * 0.5, 22)
		end
		self.kiwi:goHuntZone(blockPoint)
	end
end

function Session:step(dt)
	local now = os.clock()
	self:prunePlayers()

	if #self.players == 0 and self.phase ~= "ended" then
		self:finish()
		return
	end

	if self.phase == "vote" then
		if not self.voteDone then
			if self:allVoted() or now &gt;= self.phaseEnds then
				self:pickVoteWinner()
			end
		elseif now &gt;= self.phaseEnds then
			if self:allocateArena(self.chosenMap) then
				if self.chosenMap and self.arena.mapId ~= self.chosenMap then
					self:notifyAll(string.format(Config.Text.MapFallback, self.arena.name), COLOR.warn, 5)
				end
				self:startCountdown()
			else
				self.phaseEnds = now + 6
				self:notifyAll(Config.Text.NoArena, COLOR.warn, 5)
			end
		end
	elseif self.phase == "countdown" then
		if now &gt;= self.phaseEnds then
			self:startPlaying()
		end
	elseif self.phase == "playing" then
		if self.timeLimit and now &gt;= self.startedAt + self.timeLimit then
			self:notifyAll("¡Se acabó el tiempo!", COLOR.bad)
			self:endRound(nil, "timeout")
		else
			self:stepHealth(dt)
			if self.isColosal then
				self:stepSafeZone(dt)
			end
			if self.phase == "playing" then
				if self.needRespawn and now &gt;= self.respawnAt then
					self.needRespawn = false
					self:spawnKiwi()
				end
				if self.kiwi then
					self.kiwi:step(dt, self:buildPlayerList(), self.traps)
				end
				Actions.stepProjectiles(self, dt)
			end
		end
	elseif self.phase == "ended" then
		if now &gt;= self.phaseEnds then
			self:finish()
		end
	end

	self.updateTimer = self.updateTimer + dt
	if self.updateTimer &gt;= Config.Round.UpdateInterval then
		self:sendUpdates()
	end
end

-- ---------------- estado hacia el cliente ----------------
function Session:sendUpdate(player)
	if not self.stats[player] then
		return
	end

	local data = self.stats[player]
	local quota = self.isMulti and 1 or self.diff.round.quota
	local objective
	local progressText
	if self.phase == "vote" then
		if self.isMulti then
			objective = "¡Voten el mapa de la partida!"
		else
			objective = "¡Elige el mapa de la partida!"
		end
		progressText = self.voteDone and "¡Arrancando!" or string.format("Votación: %d s",
			math.max(0, math.ceil(self.phaseEnds - os.clock())))
	elseif self.isMulti then
		objective = "Sobrevive al kiwi gigante: gana el último en pie"
		local kiwi = self.kiwi
		local root = getRoot(player)
		if kiwi and not kiwi.defeated and root and (kiwi:getPosition() - root.Position).Magnitude &lt; 70 then
			progressText = "¡El kiwi gigante está cerca de ti!"
		else
			progressText = string.format("Cazadores vivos: %d", #self.players)
		end
	elseif self.isColosal then
		local zone = self.arena and self.arena.safeZone
		if zone and zone.active then
			objective = "¡Corre a la ZONA SEGURA!"
			local kiwi = self.kiwi
			local root = getRoot(player)
			if kiwi and not kiwi.defeated and root and (kiwi:getPosition() - root.Position).Magnitude &lt; 45 then
				progressText = "¡El kiwi te corta el paso! Frénalo y esquívalo"
			else
				progressText = "Entra al círculo para ganar"
			end
		else
			objective = "Escóndete del kiwi gigante"
			local kiwi = self.kiwi
			local root = getRoot(player)
			if kiwi and not kiwi.defeated and root then
				local distance = (kiwi:getPosition() - root.Position).Magnitude
				if distance &lt; 70 then
					progressText = "¡Está muy cerca de ti!"
				else
					progressText = string.format("Cazadores escondidos: %d", #self.players)
				end
			else
				progressText = "¡Corre y escóndete!"
			end
		end
	else
		objective = string.format("Atrapa %d kiwis", quota)
	end

	if self.hidden[player] then
		progressText = "Escondido: pulsa E para salir"
	end

	local voteCounts = nil
	if self.phase == "vote" then
		voteCounts = {}
		for _, other in ipairs(self.players) do
			local pick = self.mapVote[other]
			if pick then
				voteCounts[pick] = (voteCounts[pick] or 0) + 1
			end
		end
	end

	local ranking = {}
	for _, other in ipairs(self.players) do
		local otherStats = self.stats[other]
		table.insert(ranking, {
			name = other.DisplayName ~= "" and other.DisplayName or other.Name,
			caught = otherStats and otherStats.caught or 0,
			isSelf = other == player,
		})
	end
	table.sort(ranking, function(a, b)
		if a.caught == b.caught then
			return a.name &lt; b.name
		end
		return a.caught &gt; b.caught
	end)

	Net.get("SessionUpdate"):FireClient(player, {
		active = true,
		modeId = self.modeId,
		modeName = self.name,
		modeTag = self.tag,
		modeColor = self:modeColorTable(),
		phase = self.phase,
		timeLeft = self:remainingSeconds(),
		objective = objective,
		caught = data.caught,
		quota = quota,
		kiwiState = self.diff.showKiwiState and self.kiwi and self.kiwi:getStateHint() or nil,
		arenaName = self.arena and self.arena.name or nil,
		players = ranking,
		playerCount = #self.players,
		isMulti = self.isMulti,
		waiting = self.phase == "vote",
		vote = self.phase == "vote" and {
			done = self.voteDone or false,
			chosen = self.chosenMap,
			mine = self.mapVote[player],
			total = #self.players,
			left = math.max(0, math.ceil(self.phaseEnds - os.clock())),
			counts = voteCounts,
		} or nil,
		hp = math.floor(data.hp or Config.Player.maxHealth),
		maxHp = Config.Player.maxHealth,
		progressText = progressText,
		hidden = self.hidden[player] == true or nil,
		hideSpot = self.hideSpot[player] or nil,
		limitedTools = self.diff.tools,
		paint = not self.isColosal and (self.isMulti or #self.players &gt;= 2),
	})
end

function Session:sendUpdates(forced)
	if forced then
		self.updateTimer = 0
	end
	for _, player in ipairs(self.players) do
		self:sendUpdate(player)
	end
end

-- ===============================================================
-- GAME MANAGER
-- ===============================================================
function GameManager.init()
	Net.init()
	world = WorldBuilder.build(Config)
	ToolService.build()

	workspace.Gravity = Config.World.Gravity

	GameManager.world = world

	Players.PlayerAdded:Connect(function(player)
		GameManager.setupPlayer(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		GameManager.setupPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local session = playerSession[player]
		if session then
			session:removePlayer(player, true)
		end
		playerSession[player] = nil
	end)

	Net.get("RequestJoin").OnServerEvent:Connect(function(player, modeId)
		GameManager.requestJoin(player, modeId)
	end)

	Net.get("RequestLeave").OnServerEvent:Connect(function(player)
		GameManager.requestLeave(player)
	end)

	Net.get("RequestState").OnServerEvent:Connect(function(player)
		local session = playerSession[player]
		if session then
			session:sendUpdate(player)
		else
			Net.get("SessionUpdate"):FireClient(player, { active = false })
		end
	end)

	Net.get("VoteMap").OnServerEvent:Connect(function(player, mapId)
		local session = playerSession[player]
		if session and type(mapId) == "string" then
			session:castVote(player, mapId)
		end
	end)

	Net.get("ToolAction").OnServerEvent:Connect(function(player, toolId, data)
		local session = playerSession[player]
		if not session or type(toolId) ~= "string" then
			return
		end
		if toolId ~= "red" and toolId ~= "rifle" and toolId ~= "rastreador"
			and toolId ~= "trampa" and toolId ~= "pintura" and toolId ~= "relente"
			and Config.Weapons[toolId] == nil then
			return
		end
		local ok, err = pcall(Actions.run, session, player, toolId, data)
		if not ok then
			warn("[Kiwi Cazador] error en herramienta: " .. tostring(err))
		end
	end)

	-- Escondites y baules: cada arena conecta los avisos de sus prompts
	for _, arena in ipairs(world.arenas) do
		for _, spot in ipairs(arena.enterList or {}) do
			local prompt = spot.enter and spot.enter.prompt
			if prompt then
				local spotIndex = spot.enterIndex
				prompt.Triggered:Connect(function(who)
					local session = playerSession[who]
					if not session then
						return
					end
					if session.hideSpot[who] == spotIndex then
						session:exitSpot(who)
					elseif not session.hidden[who] then
						session:enterSpot(who, spotIndex)
					end
				end)
			end
		end
		for chestIndex, chest in ipairs(arena.chests or {}) do
			chest.prompt.Triggered:Connect(function(who)
				local session = playerSession[who]
				if session then
					session:openChest(who, chestIndex)
				end
			end)
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		GameManager.step(dt)
	end)

	print("[Kiwi Cazador] iniciado con " .. #world.arenas .. " arenas")
end

function GameManager.setupPlayer(player)
	leaderstatsFor(player)

	local function onCharacter(character)
		local session = playerSession[player]
		task.wait(0.6)
		if session and playerSession[player] == session then
			if session.hideSpot[player] then
				session:exitSpot(player, true)
			end
			if session.phase == "playing" or session.phase == "countdown" then
				session:teleportToArena(player)
				session:giveTools(player)
				setFrozen(player, session.phase == "countdown")
			else
				GameManager.sendToLobbySpawn(player)
			end
			session:sendUpdate(player)
		else
			GameManager.sendToLobbySpawn(player)
		end
	end

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	-- Estado inicial del menu
	Net.get("SessionUpdate"):FireClient(player, { active = false })
end

function GameManager.sendToLobbySpawn(player)
	local character = player.Character
	if not character then
		return
	end
	local spawn = world.lobby.spawn
	character:PivotTo(CFrame.new(spawn.Position + Vector3.new(0, 3, 0)))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end

function GameManager.returnToLobby(player, keepInPlace)
	if player.Parent then
		ToolService.clear(player)
		if not keepInPlace then
			GameManager.sendToLobbySpawn(player)
		end
	end
end

function GameManager.requestJoin(player, modeId)
	local current = playerSession[player]
	if current then
		if current.phase == "ended" then
			current:removePlayer(player, true)
		else
			Net.get("Notify"):FireClient(player, Config.Text.AlreadyIn, Util.colorToTable(COLOR.warn), 4)
			return
		end
	end

	if modeId == "multi" then
		local session
		for _, candidate in ipairs(sessions) do
			if candidate.modeId == "multi" and not candidate.finished
				and candidate.phase ~= "ended" and not candidate:isFull() then
				session = candidate
				break
			end
		end
		if not session then
			session = Session.new("multi", Random.new())
			table.insert(sessions, session)
		end
		session:addPlayer(player)
		return
	end

	if not Config.Difficulties[modeId] then
		return
	end

	local session = Session.new(modeId, Random.new())
	table.insert(sessions, session)
	session:addPlayer(player)
	session:sendUpdate(player)
end

function GameManager.requestLeave(player)
	local session = playerSession[player]
	if not session then
		return
	end
	session:removePlayer(player, true)
	Net.get("SessionUpdate"):FireClient(player, { active = false })
end

function GameManager.step(dt)
	dt = math.min(dt, 0.1)

	for index = #sessions, 1, -1 do
		local session = sessions[index]
		local ok, err = pcall(function()
			session:step(dt)
		end)
		if not ok then
			warn("[Kiwi Cazador] error en la sesion " .. tostring(session.id) .. ": " .. tostring(err))
		end
		if session.finished then
			table.remove(sessions, index)
		end
	end

	-- Rescate de jugadores que caen al vacio
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getRoot(player)
		if root and root.Position.Y &lt; Config.World.VoidY then
			local session = playerSession[player]
			if session and session.phase ~= "ended" then
				session:teleportToArena(player)
			else
				GameManager.sendToLobbySpawn(player)
			end
		end
	end
end

function GameManager.getSession(player)
	return playerSession[player]
end

return GameManager
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX019">
		<Properties>
			<string name="Name">StarterPlayer</string>
			<float name="CharacterWalkSpeed">16</float>
			<bool name="EnableMouseLockOption">true</bool>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX020">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX021">
				<Properties>
					<string name="Name">KiwiClient</string>
				</Properties>
				<Item class="LocalScript" referent="RBX022">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source">--[[
	Main.client.lua  (cliente)
	Une todo del lado del jugador:
		- menu del lobby y HUD
		- teclas de correr (Shift) y sigilo (Ctrl)
		- uso de las herramientas (red, rifle, rastreador, trampa, pintura)
		- efectos, sonidos y brujula del rastreador
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("KiwiShared", 30)
if not Shared then
	error("[Kiwi Cazador] Falta ReplicatedStorage.KiwiShared (revisa el README)")
end

local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local HUD = require(script.Parent.modules.HUD)

local player = Players.LocalPlayer
local remotes = Net.init()

local state = { active = false, phase = "none", diff = nil }
local sprinting = false
local sneaking = false
local cooldowns = {
	red = { left = 0, total = 1 },
	rifle = { left = 0, total = 1 },
	rastreador = { left = 0, total = 1 },
	trampa = { left = 0, total = 1 },
	pintura = { left = 0, total = 1 },
	relente = { left = 0, total = 1 },
}
local eatCam = nil

-- ===============================================================
-- Sonidos y efectos
-- ===============================================================
local function soundAt(soundId, position, volume, pitch)
	if not soundId or soundId == "" then
		return
	end

	local holder = Instance.new("Part")
	holder.Name = "FxSonido"
	holder.Size = Vector3.new(1, 1, 1)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Position = position
	holder.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 1
	sound.RollOffMaxDistance = 260
	sound.RollOffMinDistance = 8
	if pitch then
		sound.PlaybackSpeed = pitch
	end
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 5)
end

local function sound2D(soundId, volume, pitch)
	if not soundId or soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 1
	sound.Parent = player:FindFirstChildOfClass("PlayerGui") or workspace
	if pitch then
		sound.PlaybackSpeed = pitch
	end
	sound:Play()
	Debris:AddItem(sound, 5)
end

local function burst(position, color, count)
	local holder = Instance.new("Part")
	holder.Name = "FxParticulas"
	holder.Size = Vector3.new(1, 1, 1)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Position = position
	holder.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.6),
		NumberSequenceKeypoint.new(1, 0.15),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.35, 0.75)
	emitter.Speed = NumberRange.new(10, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.LightEmission = 0.3
	emitter.Parent = holder
	emitter:Emit(count or 22)

	Debris:AddItem(holder, 2)
end

local function distanceToLocal(position)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

-- ===============================================================
-- Velocidad y estado del personaje
-- ===============================================================
local function humanoid()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local hiddenNow = false -- escondido en un armario/barril/pajar: no te moves

local function applySpeed()
	local hum = humanoid()
	if not hum then
		return
	end

	-- Escondido en un escondite: quieto hasta que salgas con E
	if hiddenNow then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	-- Manchado de pintura: el servidor controla la velocidad lenta
	if hum:GetAttribute("Pintado") then
		return
	end

	if not state.active then
		if hum.WalkSpeed ~= Config.Player.walkSpeed then
			hum.WalkSpeed = Config.Player.walkSpeed
		end
		return
	end

	if state.phase ~= "playing" then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	hum.JumpPower = 50
	hum.UseJumpPower = true
	if sneaking then
		hum.WalkSpeed = Config.Player.sneakSpeed
	elseif sprinting then
		hum.WalkSpeed = Config.Player.sprintSpeed
	else
		hum.WalkSpeed = Config.Player.walkSpeed
	end
end

-- ===============================================================
-- Mira del rifle (clic derecho para apuntar)
-- ===============================================================
local scoped = false
local equippedId = nil
local firstPerson = false -- vista en primera persona (tecla V)

local function applyCameraMode()
	local first = scoped or (firstPerson and state.active and state.phase == "playing")
	local mode = first and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
	if player.CameraMode ~= mode then
		player.CameraMode = mode
	end
end

-- Al apuntar se oculta el arma para ver limpio por la mira
local function setWeaponHidden(hidden)
	local character = player.Character
	if not character then
		return
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			for _, part in ipairs(child:GetDescendants()) do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = hidden and 1 or 0
				end
			end
		end
	end
end

local function setScope(enabled)
	enabled = enabled and true or false
	if scoped == enabled then
		return
	end
	scoped = enabled
	HUD.setScope(scoped)
	setWeaponHidden(scoped)
	UserInputService.MouseIconEnabled = not scoped

	local hum = humanoid()
	if hum then
		hum.AutoRotate = not scoped
	end

	local camera = workspace.CurrentCamera
	if camera then
		local zoom = (Config.Scope.weapons and Config.Scope.weapons[equippedId]) or Config.Scope.fov
		local goal = scoped and zoom or 70
		TweenService:Create(camera, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = goal,
		}):Play()
	end

	-- Apuntando se pasa a primera persona: la mira ya no tapa la cabeza
	UserInputService.MouseBehavior = scoped and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
	applyCameraMode()

	sound2D(Config.Sounds.ui, 0.25, scoped and 1.5 or 1.1)
end

-- Que herramienta tiene el jugador en la mano ahora mismo
local function refreshEquipped()
	local found = nil
	local character = player.Character
	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ToolId") then
				found = child:GetAttribute("ToolId")
				break
			end
		end
	end
	equippedId = found
	if equippedId ~= "rifle" and equippedId ~= "pintura" and equippedId ~= "relente"
		and equippedId ~= "revolver" and equippedId ~= "arco" and equippedId ~= "sniper" then
		setScope(false)
	end
	setWeaponHidden(scoped)
end

-- ===============================================================
-- Herramientas
-- ===============================================================
local function diffFor(modeId)
	if modeId == "multi" then
		return Config.Difficulties[Config.Multiplayer.baseDifficulty]
	end
	return Config.Difficulties[modeId] or Config.Difficulties.normal
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	if scoped then
		-- Con la mira puesta, el objetivo es el centro de la camara
		return camera.CFrame.Position + camera.CFrame.LookVector * 260
	end

	if UserInputService.MouseEnabled then
		local mouse = player:GetMouse()
		if mouse and mouse.Hit then
			return mouse.Hit.Position
		end
	end

	return camera.CFrame.Position + camera.CFrame.LookVector * 220
end

local function fireTool(toolId)
	if not state.active or state.phase ~= "playing" then
		sound2D(Config.Sounds.denied, 0.5)
		return
	end

	local cooldown = cooldowns[toolId]
	if cooldown and cooldown.left &gt; 0 then
		sound2D(Config.Sounds.denied, 0.4)
		return
	end

	remotes.ToolAction:FireServer(toolId, { aim = aimPoint() })

	local total = cooldown and cooldown.total or 1
	if cooldown then
		cooldown.left = total
	end

	if toolId == "red" then
		sound2D(Config.Sounds.netSwing, 0.8)
	elseif toolId == "rifle" then
		sound2D(Config.Sounds.dartShot, 0.8)
	elseif toolId == "trampa" then
		sound2D(Config.Sounds.trapSet, 0.6, 0.8)
	elseif toolId == "pintura" then
		sound2D(Config.Sounds.paintShot, 0.7)
	elseif toolId == "relente" then
		sound2D(Config.Sounds.dartShot, 0.8, 1.2)
	elseif toolId == "cohete" then
		sound2D(Config.Sounds.dartShot, 1, 0.55)
	elseif toolId == "revolver" then
		sound2D(Config.Sounds.dartHit, 0.5, 1.6)
	elseif toolId == "arco" then
		sound2D(Config.Sounds.netSwing, 0.6, 1.4)
	end
end

local hookedTools = {}

local function hookTool(tool)
	if not tool:IsA("Tool") then
		return
	end
	local toolId = tool:GetAttribute("ToolId")
	if not toolId or hookedTools[tool] then
		return
	end
	hookedTools[tool] = true

	tool.Activated:Connect(function()
		fireTool(toolId)
	end)

	tool.Destroying:Connect(function()
		hookedTools[tool] = nil
	end)
end

local function hookContainer(container)
	if not container then
		return
	end
	for _, child in ipairs(container:GetChildren()) do
		hookTool(child)
	end
	container.ChildAdded:Connect(function(child)
		hookTool(child)
		refreshEquipped()
	end)
	container.ChildRemoved:Connect(refreshEquipped)
end

player.CharacterAdded:Connect(function(character)
	task.wait(0.2)
	hookContainer(player:FindFirstChildOfClass("Backpack"))
	hookContainer(character)
	refreshEquipped()
	applySpeed()
	remotes.RequestState:FireServer()
end)

-- ===============================================================
-- Teclas
-- ===============================================================
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		-- Clic derecho: mira (rifle tranquilizante y rifle de pintura)
		if (equippedId == "rifle" or equippedId == "pintura" or equippedId == "relente"
			or equippedId == "revolver" or equippedId == "arco" or equippedId == "sniper")
			and state.active and state.phase == "playing" then
			setScope(not scoped)
		end
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift then
		sprinting = true
		applySpeed()
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftAlt then
		sneaking = true
		applySpeed()
	elseif input.KeyCode == Enum.KeyCode.V then
		if state.active and state.phase == "playing" then
			firstPerson = not firstPerson
			applyCameraMode()
			sound2D(Config.Sounds.ui, 0.35)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		sprinting = false
		applySpeed()
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftAlt then
		sneaking = false
		applySpeed()
	end
end)

-- ===============================================================
-- Avisos del servidor
-- ===============================================================
remotes.SessionUpdate.OnClientEvent:Connect(function(newState)
	local wasActive = state.active
	local previousPhase = state.phase

	if not newState or not newState.active then
		state = { active = false, phase = "none", diff = nil }
		hiddenNow = false
		sprinting = false
		sneaking = false
		setScope(false)
		HUD.hideResult()
		HUD.hideVote()
		HUD.setMenuVisible(true)
		HUD.setMenuStatus("")
		HUD.fade(false, 0.5)
		applySpeed()
		return
	end

	state.active = true
	state.phase = newState.phase
	state.modeId = newState.modeId
	state.diff = diffFor(newState.modeId)
	state.hidden = newState.hidden == true
	state.hideSpot = newState.hideSpot
	if newState.vote then
		HUD.showVote(newState.vote)
	else
		HUD.hideVote()
	end
	applyCameraMode()
	if state.hidden ~= hiddenNow then
		hiddenNow = state.hidden
		firstPerson = state.hidden
		if hiddenNow then
			setScope(false)
			sound2D(Config.Sounds.rustle, 0.5)
		else
			sound2D(Config.Sounds.ui, 0.35)
		end
		applyCameraMode()
		applySpeed()
	end

	HUD.setMenuVisible(false)
	HUD.setMenuStatus("")

	if not wasActive or previousPhase ~= newState.phase then
		if newState.phase == "vote" then
			HUD.hideResult()
			HUD.fade(false, 0.4)
		elseif newState.phase == "countdown" then
			HUD.hideResult()
			HUD.fade(true, 0.25)
			task.delay(0.6, function()
				if state.phase == "countdown" or state.phase == "playing" then
					HUD.fade(false, 0.6)
				end
			end)
		elseif newState.phase == "playing" then
			HUD.hideResult()
			HUD.fade(false, 0.5)
		end
	end

	if state.diff then
		-- Algunos modos (Colosal) no tienen red ni rifle tranquilizante
		local redTotal = (state.diff.red and state.diff.red.cooldown) or 1
		local rifleTotal = (state.diff.rifle and state.diff.rifle.cooldown) or 1
		HUD.setToolTotals({
			red = redTotal,
			rifle = rifleTotal,
			rastreador = Config.Tracker.cooldown,
			trampa = Config.Trampa.cooldown,
			pintura = Config.PaintRifle.cooldown,
			relente = Config.Relente.cooldown,
		})
		cooldowns.red.total = redTotal
		cooldowns.rifle.total = rifleTotal
		cooldowns.rastreador.total = Config.Tracker.cooldown
		cooldowns.trampa.total = Config.Trampa.cooldown
		cooldowns.pintura.total = Config.PaintRifle.cooldown
		cooldowns.relente.total = Config.Relente.cooldown
	end

	HUD.updateState(newState)
	applySpeed()
end)

remotes.SessionEnd.OnClientEvent:Connect(function(result)
	HUD.showResult(result, Config.Round.EndScreen)
	sound2D(result.won and Config.Sounds.win or Config.Sounds.lose, 0.9)
	task.delay(1.5, function()
		HUD.fade(true, 1)
	end)
end)

remotes.Notify.OnClientEvent:Connect(function(text, colorTable, duration)
	HUD.notify(text, Util.colorFromTable(colorTable), duration)
end)

remotes.TrackerPing.OnClientEvent:Connect(function(data)
	HUD.setTracker(data)
	sound2D(Config.Sounds.ui, 0.5, 1.4)
end)

remotes.WorldEvent.OnClientEvent:Connect(function(kind, data)
	data = data or {}
	local position = data.pos

	if kind == "countdown" then
		sound2D(Config.Sounds.countdown, 0.7)
	elseif kind == "start" then
		sound2D(Config.Sounds.start, 0.9)
		HUD.notify("A cazar al kiwi!", Color3.fromRGB(102, 209, 130), 3)
	elseif kind == "netswing" then
		if position and distanceToLocal(position) &lt; 90 then
			soundAt(Config.Sounds.netSwing, position, 0.7)
		end
	elseif kind == "dartshot" then
		soundAt(Config.Sounds.dartShot, position or Vector3.new(), 0.9)
	elseif kind == "darthit" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 1)
			burst(position, Color3.fromRGB(160, 240, 190), 26)
		end
	elseif kind == "dartmiss" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt("rbxasset://sounds/impact_water.mp3", position, 0.5, 1.6)
			burst(position, Color3.fromRGB(200, 200, 200), 8)
		end
	elseif kind == "flush" then
		if position then
			if distanceToLocal(position) &lt; 120 then
				soundAt(Config.Sounds.flush, position, 0.9)
			end
			burst(position, Color3.fromRGB(140, 180, 110), 18)
		end
		HUD.notify(Config.Text.KiwiRunning, Color3.fromRGB(238, 196, 92), 3)
	elseif kind == "rustle" then
		if position and distanceToLocal(position) &lt; 45 then
			soundAt(Config.Sounds.rustle, position, 0.6)
			burst(position, Color3.fromRGB(120, 160, 90), 10)
		end
	elseif kind == "sedate" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 0.6, 1.2)
			burst(position, Color3.fromRGB(180, 220, 255), 16)
		end
	elseif kind == "wake" then
		if position then
			soundAt(Config.Sounds.flush, position, 0.6, 1.2)
		end
	elseif kind == "captured" then
		if position then
			soundAt(Config.Sounds.netHit, position, 1)
			burst(position, Color3.fromRGB(255, 235, 160), 40)
		end
	elseif kind == "trap" then
		if position then
			soundAt(Config.Sounds.trapSet, position, 0.6, 0.8)
			burst(position, Color3.fromRGB(238, 170, 120), 12)
		end
	elseif kind == "trapcatch" then
		if position then
			soundAt(Config.Sounds.trapCatch, position, 1)
			burst(position, Color3.fromRGB(255, 120, 140), 34)
		end
	elseif kind == "trapescape" then
		if position then
			soundAt(Config.Sounds.trapCatch, position, 0.9, 0.7)
			burst(position, Color3.fromRGB(238, 170, 120), 18)
		end
	elseif kind == "paintshot" then
		soundAt(Config.Sounds.paintShot, position or Vector3.new(), 0.8)
	elseif kind == "painthit" then
		if position then
			soundAt(Config.Sounds.paintHit, position, 0.8)
			burst(position, Util.colorFromTable(data.color) or Color3.fromRGB(230, 120, 190), 26)
		end
	elseif kind == "slowhit" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 0.9, 1.15)
			burst(position, Config.Tools.relente.color, 30)
		end
	elseif kind == "chomp" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 1, 0.6)
			burst(position, Color3.fromRGB(232, 108, 100), 14)
		end
		if eatCam then
			eatCam.shakeUntil = os.clock() + 0.35
		end
	elseif kind == "hidestart" then
		if position and distanceToLocal(position) &lt; 40 then
			soundAt(Config.Sounds.rustle, position, 0.7)
		end
	elseif kind == "hidestop" then
		if position and distanceToLocal(position) &lt; 40 then
			soundAt(Config.Sounds.rustle, position, 0.5, 0.9)
		end
	elseif kind == "sniffstart" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.rustle, position, 0.8, 0.7)
		end
		if state.hidden and data.index == state.hideSpot then
			HUD.notify("¡El kiwi te está husmeando! Sal con E y corre", Color3.fromRGB(238, 150, 100), 4)
			sound2D(Config.Sounds.denied, 0.7)
		end
	elseif kind == "sniff" then
		if position and distanceToLocal(position) &lt; 48 then
			soundAt(Config.Sounds.rustle, position, 0.5, 1.1)
			burst(position, Color3.fromRGB(198, 170, 86), 6)
		end
	elseif kind == "sniffmiss" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.rustle, position, 0.4, 0.8)
		end
	elseif kind == "sniffcatch" then
		if position then
			soundAt(Config.Sounds.roar, position, 1, 0.5)
			burst(position, Color3.fromRGB(232, 108, 100), 30)
		end
	elseif kind == "boom" then
		if position then
			local cfg = data.weapon and Config.Weapons[data.weapon]
			soundAt(Config.Sounds.dartHit, position, 1, 0.6)
			burst(position, (cfg and cfg.color) or Color3.fromRGB(255, 186, 120), 46)
			if distanceToLocal(position) &lt; 70 then
				sound2D(Config.Sounds.roar, 0.5, 0.7)
			end
		end
	elseif kind == "chestopen" then
		if position then
			soundAt(Config.Sounds.win, position, 0.7)
			burst(position, Color3.fromRGB(255, 214, 120), 40)
		end
	elseif kind == "safeactive" then
		sound2D(Config.Sounds.win, 0.8)
		if position then
			soundAt(Config.Sounds.countdown, position, 1)
			burst(position, Color3.fromRGB(140, 255, 200), 60)
		end
	elseif kind == "paintmiss" then
		if position and distanceToLocal(position) &lt; 70 then
			soundAt(Config.Sounds.paintHit, position, 0.35, 1.5)
			burst(position, Util.colorFromTable(data.color) or Color3.fromRGB(230, 120, 190), 8)
		end
	elseif kind == "hunt" then
		if position and distanceToLocal(position) &lt; 150 then
			soundAt(Config.Sounds.roar, position, 0.9, 0.55)
		end
	elseif kind == "roar" then
		if position then
			local distance = distanceToLocal(position)
			if distance &lt; 200 then
				soundAt(Config.Sounds.roar, position, math.clamp(1.1 - distance / 260, 0.2, 1), 0.45)
				HUD.notify("¡El kiwi gigante ruge cerca!", Color3.fromRGB(232, 108, 100), 2)
			end
		end
	elseif kind == "giantcatch" then
		if position then
			soundAt(Config.Sounds.roar, position, 1, 0.4)
			burst(position, Color3.fromRGB(232, 108, 100), 44)
		end
		if data.userId == player.UserId then
			sound2D(Config.Sounds.lose, 0.8)
			-- Camara en tercera persona para ver como te come
			setScope(false)
			firstPerson = false
			local now = os.clock()
			eatCam = {
				start = now,
				until_ = now + (Config.Round.EatHold or 2.6) + 0.15,
				kiwiPos = position,
				shakeUntil = 0,
			}
			-- El cartel de muerte entra un poco despues, para no tapar la escena
			task.delay(1.05, function()
				if eatCam then
					HUD.death(Config.Text.DeathTitle, Config.Text.DeathSubtitle)
				end
			end)
		end
	elseif kind == "hurt" then
		if data.userId == player.UserId then
			HUD.hurt(data.amount)
			sound2D(Config.Sounds.paintHit, 0.5, 0.8)
		elseif position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.dartHit, position, 0.35, 1.4)
		end
	elseif kind == "ko" then
		if position then
			burst(position, Color3.fromRGB(232, 108, 100), 30)
		end
		if data.userId == player.UserId then
			setScope(false)
			firstPerson = false
			sound2D(Config.Sounds.lose, 0.8)
			HUD.death("¡TE NOQUEARON!", "Vuelves al lobby...")
		end
	end
end)

-- ===============================================================
-- Botones del menu
-- ===============================================================
HUD.init(player:WaitForChild("PlayerGui"), {
	onJoin = function(modeId)
		sound2D(Config.Sounds.ui, 0.6)
		HUD.setMenuStatus("Entrando a la partida...", Color3.fromRGB(238, 196, 92))
		remotes.RequestJoin:FireServer(modeId)
	end,
	onVote = function(mapId)
		sound2D(Config.Sounds.ui, 0.5)
		remotes.VoteMap:FireServer(mapId)
	end,
	onLeave = function()
		sound2D(Config.Sounds.ui, 0.5)
		remotes.RequestLeave:FireServer()
	end,
})

-- ===============================================================
-- Bucle del cliente
-- ===============================================================
RunService.Heartbeat:Connect(function(dt)
	-- Si te esta comiendo el kiwi: camara de cine en tercera persona
	if eatCam then
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local now = os.clock()
		if camera and root and now &lt; eatCam.until_ then
			camera.CameraType = Enum.CameraType.Scriptable
			-- La camara se acerca de golpe: primer plano del kiwi comiendote
			local p = math.clamp((now - (eatCam.start or now)) / 0.55, 0, 1)
			local target = root.Position + Vector3.new(0, 1.5, 0)
			local away = target - (eatCam.kiwiPos or target)
			away = Vector3.new(away.X, 0, away.Z)
			if away.Magnitude &lt; 0.1 then
				away = Vector3.new(0, 0, 1)
			end
			local flatAway = away.Unit
			local cf = CFrame.lookAt(
				target + flatAway * (15 - 6.5 * p) + Vector3.new(0, 5.6 - 2.6 * p, 0),
				target + flatAway * 1.6 + Vector3.new(0, 0.4, 0))
			if now &lt; (eatCam.shakeUntil or 0) then
				cf = cf * CFrame.new((math.random() - 0.5) * 0.55, (math.random() - 0.5) * 0.45, 0)
			end
			camera.CFrame = cf
		else
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
			eatCam = nil
			applyCameraMode()
		end
	end

	-- Con la mira puesta, el personaje gira junto con la camara
	if scoped and state.active and state.phase == "playing" then
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if camera and root then
			local look = camera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude &gt; 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
			end
		end
	end

	local remaining = {}
	for toolId, data in pairs(cooldowns) do
		data.left = math.max(0, data.left - dt)
		remaining[toolId] = data.left
	end
	HUD.setCooldowns(remaining)
	HUD.updateTracker()
end)

hookContainer(player:WaitForChild("Backpack"))
if player.Character then
	hookContainer(player.Character)
end
remotes.RequestState:FireServer()
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX023">
					<Properties>
						<string name="Name">modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX024">
						<Properties>
							<string name="Name">HUD</string>
							<ProtectedString name="Source">--[[
	HUD.lua  (cliente)
	Construye TODA la interfaz por codigo: menu del lobby, HUD de la
	partida, avisos, panel de resultados y brujula del rastreador.

	Nada de esto necesita que armes GUIs en Studio.
--]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("KiwiShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local HUD = {}

local player = Players.LocalPlayer
local gui
local parts = {}
local tracker = { active = false, until_ = 0, pos = nil, hidden = false }
local callbacks = {}

local COLOR = {
	panel = Color3.fromRGB(14, 16, 20),
	panelSoft = Color3.fromRGB(26, 30, 36),
	accent = Color3.fromRGB(102, 209, 130),
	text = Color3.fromRGB(238, 241, 244),
	muted = Color3.fromRGB(148, 156, 164),
}

local function new(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(radius, parent)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(color, thickness, transparency, parent)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function padding(px, parent)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	}, parent)
end

-- ===============================================================
-- MENU DEL LOBBY
-- ===============================================================
local function buildMenu(parent)
	local menu = new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 660, 0, 690),
		BackgroundColor3 = COLOR.panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, parent)
	corner(18, menu)
	stroke(COLOR.accent, 1.5, 0.45, menu)
	padding(22, menu)

	new("TextLabel", {
		Name = "Titulo",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = COLOR.text,
		Text = "KIWI CAZADOR",
	}, menu)

	new("TextLabel", {
		Name = "Subtitulo",
		Position = UDim2.new(0, 0, 0, 48),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 15,
		TextColor3 = COLOR.muted,
		Text = "Atrapa al kiwi de Nueva Zelanda antes de que se esconda otra vez",
	}, menu)

	local grid = new("Frame", {
		Name = "Modos",
		Position = UDim2.new(0, 0, 0, 82),
		Size = UDim2.new(1, 0, 0, 384),
		BackgroundTransparency = 1,
	}, menu)

	new("UIGridLayout", {
		CellSize = UDim2.new(0.485, 0, 0, 118),
		CellPadding = UDim2.new(0.03, 0, 0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)

	parts.modeButtons = {}
	for index, modeId in ipairs(Config.ModeOrder) do
		local info
		if modeId == "multi" then
			info = Config.Multiplayer
		else
			info = Config.Difficulties[modeId]
		end

		local button = new("TextButton", {
			Name = modeId,
			LayoutOrder = index,
			BackgroundColor3 = COLOR.panelSoft,
			BackgroundTransparency = 0.05,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, grid)
		corner(12, button)
		local border = stroke(info.color, 1.5, 0.35, button)

		new("TextLabel", {
			Name = "Nombre",
			Position = UDim2.new(0, 14, 0, 10),
			Size = UDim2.new(1, -28, 0, 24),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = info.color,
			Text = info.name,
		}, button)

		new("TextLabel", {
			Name = "Etiqueta",
			Position = UDim2.new(0, 14, 0, 34),
			Size = UDim2.new(1, -28, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = COLOR.muted,
			Text = info.tag,
		}, button)

		new("TextLabel", {
			Name = "Descripcion",
			Position = UDim2.new(0, 14, 0, 52),
			Size = UDim2.new(1, -28, 0, 56),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = COLOR.text,
			TextTransparency = 0.15,
			Text = info.blurb,
		}, button)

		if callbacks.onJoin then
			button.MouseButton1Click:Connect(function()
				callbacks.onJoin(modeId)
			end)
		end
		button.MouseEnter:Connect(function()
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(40, 46, 54) }):Play()
		end)
		button.MouseLeave:Connect(function()
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = COLOR.panelSoft }):Play()
		end)

		parts.modeButtons[modeId] = { button = button, border = border }
	end

	local status = new("TextLabel", {
		Name = "Estado",
		Position = UDim2.new(0, 0, 0, 470),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = COLOR.accent,
		Text = "",
	}, menu)
	parts.status = status

	local help = new("Frame", {
		Name = "Ayuda",
		Position = UDim2.new(0, 0, 0, 498),
		Size = UDim2.new(1, 0, 0, 138),
		BackgroundColor3 = COLOR.panelSoft,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	}, menu)
	corner(12, help)
	padding(14, help)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR.accent,
		Text = "CÓMO JUGAR",
	}, help)

	new("TextLabel", {
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 1, -22),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = COLOR.text,
		TextTransparency = 0.2,
		Text = "1) Red: atrapa al kiwi de cerca.\n"
			.. "2) Rifle tranquilizante: clic derecho para apuntar con la mira; lo duerme y lo recoges al tocarlo.\n"
			.. "3) Rastreador: te dice dirección y distancia.\n"
			.. "4) Trampa de fruta (1 por jugador): el kiwi queda atrapado 3 s; ve por él o disparale.\n"
			.. "5) Rifle de pintura: mancha, marca (se ve entre las paredes) y frena. Clic derecho: mira.\n"
			.. "En Kiwi Colosal llevas rastreador y rifle ralentizador (frena al gigante, no lo duerme).\n"
			.. "V: vista en primera persona. Caminar despacio (Ctrl) hace menos ruido. Correr (Shift) lo espanta.",
	}, help)

	return menu
end

-- ===============================================================
-- HUD DE PARTIDA
-- ===============================================================
local function buildSessionHud(parent)
	local hud = new("Frame", {
		Name = "Partida",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
	}, parent)
	parts.hud = hud

	-- Barra superior
	local top = new("Frame", {
		Name = "Barra",
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, -20, 0, 64),
		BackgroundColor3 = COLOR.panel,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
	}, hud)
	parts.hud = hud
	corner(14, top)
	stroke(Color3.fromRGB(60, 70, 80), 1, 0.5, top)

	local modeLabel = new("TextLabel", {
		Name = "Modo",
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(0, 260, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR.accent,
		Text = "",
	}, top)
	parts.modeLabel = modeLabel

	local arenaLabel = new("TextLabel", {
		Name = "Arena",
		Position = UDim2.new(0, 16, 0, 32),
		Size = UDim2.new(0, 300, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR.muted,
		Text = "",
	}, top)
	parts.arenaLabel = arenaLabel

	-- Vida del cazador (las armas de baul de los baules hacen daño)
	local hpBack = new("Frame", {
		Name = "Vida",
		Position = UDim2.new(0, 16, 0, 52),
		Size = UDim2.new(0, 240, 0, 10),
		BackgroundColor3 = Color3.fromRGB(52, 58, 66),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	}, top)
	corner(5, hpBack)
	local hpFill = new("Frame", {
		Name = "Relleno",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(102, 209, 130),
		BorderSizePixel = 0,
	}, hpBack)
	corner(5, hpFill)
	parts.hpFill = hpFill
	parts.hpText = new("TextLabel", {
		Name = "VidaTexto",
		Position = UDim2.new(0, 264, 0, 47),
		Size = UDim2.new(0, 60, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
