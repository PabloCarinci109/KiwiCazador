	SlowEnd = "El kiwi gigante recuperó su velocidad.",
	PvpRifleOn = "¡Llegó otro cazador! Recibiste el Rifle de Pintura (tecla 5).",
	PvpRifleOff = "Quedaste solo: el Rifle de Pintura se guardó.",
}

-- Sonidos incluidos en el cliente de Roblox (no requieren subir nada).
-- Si alguno no carga en tu version de Roblox, cambia el id por uno tuyo.
Config.Sounds = {
	countdown = "rbxasset://sounds/electronicpingshort.wav",
	start = "rbxasset://sounds/switch.wav",
	netSwing = "rbxasset://sounds/swordslash.wav",
	netHit = "rbxasset://sounds/snap.wav",
	dartShot = "rbxasset://sounds/unsheath.mp3",
	dartHit = "rbxasset://sounds/impact_explosion_03.mp3",
	flush = "rbxasset://sounds/swordlunge.wav",
	rustle = "rbxasset://sounds/action_footsteps_plastic.mp3",
	win = "rbxasset://sounds/electronicpingshort.wav",
	lose = "rbxasset://sounds/uuhhh.mp3",
	ui = "rbxasset://sounds/button.wav",
	denied = "rbxasset://sounds/switch.wav",
	trapSet = "rbxasset://sounds/switch.wav",
	trapCatch = "rbxasset://sounds/snap.wav",
	paintShot = "rbxasset://sounds/unsheath.mp3",
	paintHit = "rbxasset://sounds/impact_explosion_03.mp3",
	roar = "rbxasset://sounds/uuhhh.mp3",
}

return Config
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX006">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source">--[[
	Util.lua
	Ayudantes pequenos y sin estado que usan tanto el servidor como el cliente.
--]]

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Util = {}

function Util.clamp(value, min, max)
	if value &lt; min then
		return min
	elseif value &gt; max then
		return max
	end
	return value
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

function Util.round(n)
	return math.floor(n + 0.5)
end

function Util.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local minutes = math.floor(seconds / 60)
	return string.format("%d:%02d", minutes, seconds % 60)
end

-- Distancia ignorando el eje Y: casi siempre queremos distancia "en el suelo"
function Util.flatDistance(a, b)
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Util.newRandom(seed)
	return Random.new(seed or os.time())
end

function Util.shuffle(list, rng)
	rng = rng or Random.new()
	for i = #list, 2, -1 do
		local j = rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.pick(list, rng)
	rng = rng or Random.new()
	return list[rng:NextInteger(1, #list)]
end

--[[
	Util.makePart{ ClassName = "Part", Name = ..., Size = ..., ... }
	Crea una instancia y le aplica todas las propiedades indicadas.
	Parent se asigna al final (es mas rapido y evita que la parte
	provoque replicacion a medio configurar).
--]]
function Util.makePart(props)
	local className = props.ClassName or "Part"
	local instance = Instance.new(className)

	for key, value in pairs(props) do
		if key ~= "ClassName" and key ~= "Parent" then
			instance[key] = value
		end
	end

	if props.Parent then
		instance.Parent = props.Parent
	end

	return instance
end

-- Parte "sosa": anclada, sin colisiones raras y sin caras con textura
function Util.makeSolid(props)
	props = props or {}
	if props.Anchored == nil then props.Anchored = true end
	props.CanCollide = props.CanCollide == true
	props.CanQuery = props.CanQuery ~= false
	props.CanTouch = props.CanTouch == true
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	return Util.makePart(props)
end

function Util.hideStuds(part)
	if part:IsA("BasePart") then
		if part.TopSurface ~= nil and (part:IsA("Part") or part:IsA("WedgePart")) then
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth
		end
	end
	return part
end

function Util.tween(instance, goal, time, style, direction)
	local info = TweenInfo.new(
		time or 0.25,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

function Util.destroyAfter(instance, seconds)
	Debris:AddItem(instance, seconds)
	return instance
end

-- Color3 -&gt; {r, g, b} en 0..255 (util para mandar color por RemoteEvent)
function Util.colorToTable(color)
	return { math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255) }
end

function Util.colorFromTable(t)
	if type(t) ~= "table" then
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(t[1] or 255, t[2] or 255, t[3] or 255)
end

return Util
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX007">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source">--[[
	Net.lua
	Un solo lugar para crear y obtener los RemoteEvents del juego.
	El servidor llama a Net.init() al arrancar; el cliente llama a
	Net.init() tambien (encuentra lo que ya replico el servidor).
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "KiwiRemotes"

-- Remotes con direccion. Si agregas uno, anotalo aqui.
local REMOTE_NAMES = {
	-- Cliente -&gt; Servidor
	"RequestJoin",     -- (modeId)
	"RequestLeave",    -- ()
	"RequestState",    -- ()
	"ToolAction",      -- (toolId, data)
	"VoteMap",         -- (mapId)
	-- Servidor -&gt; Cliente
	"SessionUpdate",   -- (state)
	"SessionEnd",      -- (result)
	"Notify",          -- (text, colorTable, duration)
	"WorldEvent",      -- (kind, data)
	"TrackerPing",     -- (data)
}

local Net = {}
Net.remotes = {}

local function ensureFolder()
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	return folder
end

-- Espera la carpeta (el cliente puede llegar antes que el servidor)
local function waitFolder()
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder and not RunService:IsServer() then
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME, 15)
	end
	return folder or ensureFolder()
end

function Net.init()
	local folder = waitFolder()

	for _, name in ipairs(REMOTE_NAMES) do
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		Net.remotes[name] = remote
	end

	return Net.remotes
end

function Net.get(name)
	local remote = Net.remotes[name]
	if remote then
		return remote
	end

	local folder = waitFolder()
	remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	Net.remotes[name] = remote
	return remote
end

-- Envia a todos los clientes
function Net.broadcast(name, ...)
	Net.get(name):FireAllClients(...)
end

return Net
</ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX008">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Folder" referent="RBX009">
			<Properties>
				<string name="Name">KiwiServer</string>
			</Properties>
			<Item class="Script" referent="RBX010">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source">--[[
	Main.server.lua  (servidor)
	Arranca el juego: construye el mapa, crea las herramientas y
	levanta el GameManager que maneja las partidas.
--]]

local GameManager = require(script.Parent.modules.GameManager)
local Shared = require(script.Parent.modules.Shared)

GameManager.init()

print("[Kiwi Cazador] v" .. require(Shared.Config).Version .. " listo para cazar")
</ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX011">
				<Properties>
					<string name="Name">modules</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX012">
					<Properties>
						<string name="Name">Shared</string>
						<ProtectedString name="Source">--[[
	Shared.lua  (servidor)
	Devuelve la carpeta ReplicatedStorage.KiwiShared con un error claro
	si el juego no se instalo como corresponde.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = ReplicatedStorage:FindFirstChild("KiwiShared")
if not folder then
	folder = ReplicatedStorage:WaitForChild("KiwiShared", 20)
end

if not folder then
	error(
		"[Kiwi Cazador] Falta la carpeta ReplicatedStorage.KiwiShared. "
		.. "Crea una Folder con ese nombre dentro de ReplicatedStorage y "
		.. "mete ahi Config, Util y Net (mira el README).",
		0
	)
end

return folder
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX013">
					<Properties>
						<string name="Name">WorldBuilder</string>
						<ProtectedString name="Source">--[[
	WorldBuilder.lua  (servidor)
	Genera TODO el mapa por codigo: el lobby, las arenas y los
	escondites del kiwi. No hace falta construir nada en Studio.

	Cada arena devuelve una tabla con:
		center, halfSize, floorY, folder, ground, propsFolder,
		spots   -&gt; lista de escondites
		spawns  -&gt; CFrames donde aparecen los jugadores
		kiwiSpawn, bounds, clampToBounds()
--]]

local Shared = require(script.Parent.Shared)
local Util = require(Shared.Util)

local WorldBuilder = {}

local Arena = {}
Arena.__index = Arena

local function clamp(v, min, max)
	if v &lt; min then return min end
	if v &gt; max then return max end
	return v
end

function Arena:clampToBounds(pos)
	local pad = 26
	local minX = self.center.X - self.halfSize + pad
	local maxX = self.center.X + self.halfSize - pad
	local minZ = self.center.Z - self.halfSize + pad
	local maxZ = self.center.Z + self.halfSize - pad
	return Vector3.new(clamp(pos.X, minX, maxX), pos.Y, clamp(pos.Z, minZ, maxZ))
end

function Arena:randomPoint(rng, margin)
	local m = margin or (self.halfSize - 30)
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = rng:NextNumber(15, m)
	return self:clampToBounds(self.center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
end

-- Escondite mas cercano a un punto (para saber donde "buscar" con la red)
function Arena:nearestSpot(position, maxDistance)
	local best, bestDist = nil, maxDistance or math.huge
	for _, spot in ipairs(self.spots) do
		local d = (spot.hidePoint - position).Magnitude
		if d &lt; bestDist then
			best, bestDist = spot, d
		end
	end
	return best, bestDist
end

-- ===============================================================
-- Helpers de construccion
-- ===============================================================
local function part(props)
	return Util.makeSolid(props)
end

local function makeRustle(parentPart, color)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Rustle"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(120, 160, 90))
	emitter.LightEmission = 0.2
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(1, 0.05),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.45, 0.9)
	emitter.Speed = NumberRange.new(4, 9)
	emitter.SpreadAngle = Vector2.new(60, 60)
	emitter.Rate = 14
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Enabled = false
	emitter.Parent = parentPart
	return emitter
end

local function billboardText(adornee, text, color, size)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Letrero"
	gui.Size = UDim2.fromScale(size or 14, (size or 14) * 0.28)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 320
	gui.Adornee = adornee
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = color or Color3.fromRGB(240, 240, 240)
	label.TextStrokeTransparency = 0.35
	label.Text = text
	label.Parent = gui
	return gui
end

-- ===============================================================
-- LOBBY
-- ===============================================================
local function buildLobby(cfg, parent, rng)
	local size = cfg.Lobby.Size
	local lobby = { folder = Instance.new("Folder") }
	lobby.folder.Name = "Lobby"
	lobby.folder.Parent = parent

	local floor = part({
		Name = "PisoLobby",
		Size = Vector3.new(size * 2, 6, size * 2),
		Position = Vector3.new(0, cfg.World.FloorY - 3, 0),
		Color = Color3.fromRGB(120, 128, 132),
		Material = Enum.Material.Cobblestone,
		CanCollide = true,
		Parent = lobby.folder,
	})
	lobby.floor = floor

	-- Borde de madera
	for i = 0, 3 do
		local angle = i * math.pi * 0.5
		part({
			Name = "Borde",
			Size = Vector3.new(size * 2 + 6, 3, 4),
			CFrame = CFrame.new(0, cfg.World.FloorY + 1.5, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -size),
			Color = Color3.fromRGB(96, 70, 48),
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = lobby.folder,
		})
	end

	-- Spawn de los jugadores
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SpawnLobby"
	spawnLocation.Size = Vector3.new(16, 1, 16)
	spawnLocation.CFrame = CFrame.new(cfg.Lobby.SpawnOffset)
	spawnLocation.Anchored = true
	spawnLocation.CanCollide = true
	spawnLocation.TopSurface = Enum.SurfaceType.Smooth
	spawnLocation.Material = Enum.Material.WoodPlanks
	spawnLocation.Color = Color3.fromRGB(150, 120, 80)
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Transparency = 0.25
	spawnLocation.Parent = lobby.folder
	lobby.spawn = CFrame.new(cfg.Lobby.SpawnOffset + Vector3.new(0, 4, 0))
	lobby.spawnLocation = spawnLocation

	-- Cartel principal
	local board = part({
		Name = "Cartel",
		Size = Vector3.new(46, 14, 1.4),
		CFrame = CFrame.new(0, cfg.World.FloorY + 16, -52),
		Color = Color3.fromRGB(38, 34, 30),
		Material = Enum.Material.WoodPlanks,
		Parent = lobby.folder,
	})
	part({
		Name = "PosteI",
		Size = Vector3.new(2, 18, 2),
		CFrame = CFrame.new(-18, cfg.World.FloorY + 8, -52),
		Color = Color3.fromRGB(72, 54, 38),
		Material = Enum.Material.Wood,
		CanCollide = true,
		Parent = lobby.folder,
	})
	part({
		Name = "PosteD",
		Size = Vector3.new(2, 18, 2),
		CFrame = CFrame.new(18, cfg.World.FloorY + 8, -52),
		Color = Color3.fromRGB(72, 54, 38),
		Material = Enum.Material.Wood,
		CanCollide = true,
		Parent = lobby.folder,
	})

	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(460, 140)
	surface.LightInfluence = 0.4
	surface.Parent = board

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.62)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(240, 235, 225)
	title.Text = "KIWI CAZADOR"
	title.Parent = surface

	local subtitle = Instance.new("TextLabel")
	subtitle.Position = UDim2.fromScale(0, 0.62)
	subtitle.Size = UDim2.fromScale(1, 0.3)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.Gotham
	subtitle.TextScaled = true
	subtitle.TextColor3 = Color3.fromRGB(150, 210, 160)
	subtitle.Text = cfg.GameTagline
	subtitle.Parent = surface

	-- Decoracion: unos kauris y helechos alrededor
	for i = 1, 10 do
		local angle = (i / 10) * math.pi * 2
		local radius = size + 12 + rng:NextNumber(0, 10)
		local pos = Vector3.new(math.cos(angle) * radius, cfg.World.FloorY, math.sin(angle) * radius)
		local height = rng:NextNumber(26, 40)
		part({
			Name = "Tronco",
			Size = Vector3.new(3.2, height, 3.2),
			Position = pos + Vector3.new(0, height * 0.5 - 1, 0),
			Color = Color3.fromRGB(84, 60, 44),
			Material = Enum.Material.Wood,
			Parent = lobby.folder,
		})
		for leaf = 1, 3 do
			local leafSize = 18 - leaf * 3
			part({
				Name = "Copa",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(leafSize, leafSize * 0.7, leafSize),
				Position = pos + Vector3.new(0, height - 4 + leaf * 3, 0),
				Color = Color3.fromRGB(58 + leaf * 4, 104 + leaf * 5, 62),
				Material = Enum.Material.LeafyGrass,
				Parent = lobby.folder,
			})
		end
	end

	return lobby
end

-- ===============================================================
-- ARENAS
-- ===============================================================
local function buildArena(index, zone, cfg, parent, rng)
	local self = setmetatable({}, Arena)
	self.index = index
	self.name = zone.name
	self.mapId = zone.id or ("map" .. index)
	self.zone = zone
	self.center = Vector3.new(index * cfg.World.ArenaSpacing, cfg.World.FloorY, 0)
	self.halfSize = cfg.World.ArenaSize * 0.5
	self.floorY = cfg.World.FloorY
	self.spots = {}
	self.spawns = {}
	self.indoors = {}
	self.enterList = {}
	self.chests = {}
	self.busy = false

	local folder = Instance.new("Folder")
	folder.Name = "Arena" .. index
	folder.Parent = parent
	self.folder = folder

	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = folder
	self.propsFolder = props

	local half = self.halfSize
	local center = self.center
	local floorY = self.floorY

	local function local3(dx, dz, y)
		return center + Vector3.new(dx, (y or 0), dz)
	end

	-- ---------------- Suelo ----------------
	self.ground = part({
		Name = "Terreno",
		Size = Vector3.new(half * 2, 10, half * 2),
		Position = center + Vector3.new(0, -5, 0),
		Color = zone.grass,
		Material = zone.ground or Enum.Material.LeafyGrass,
		CanCollide = true,
		Parent = folder,
	})

	-- ---------------- Limites ----------------
	for i = 0, 3 do
		part({
			Name = "MuroInvisible",
			Size = Vector3.new(half * 2 + 8, 40, 3),
			CFrame = CFrame.new(center + Vector3.new(0, 19, 0))
				* CFrame.Angles(0, i * math.pi * 0.5, 0)
				* CFrame.new(0, 0, -half),
			Transparency = 1,
			CanCollide = true,
			CanQuery = true,
			Parent = folder,
		})
	end

	-- ---------------- Limites del mapa (no se puede salir) ----------------
	-- Ciudad: murallones tipo edificio. Duna/naturaleza: montañas y arboles.
	local theme = zone.theme or "bosque"

	if theme == "ciudad" then
		-- Muralla de edificio alrededor de toda la manzana
		local wallH = 48
		local wallCol = Color3.fromRGB(148, 148, 152)
		local wallTrim = Color3.fromRGB(110, 112, 118)
		local glassCol = Color3.fromRGB(96, 132, 148)
		for i = 0, 3 do
			local side = CFrame.new(center) * CFrame.Angles(0, i * math.pi * 0.5, 0)
			part({
				Name = "MuroCiudad",
				Size = Vector3.new(half * 2 + 10, wallH, 5),
				CFrame = side * CFrame.new(0, wallH * 0.5, -half + 4),
				Color = wallCol,
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = props,
			})
			part({
				Name = "CornisaCiudad",
				Size = Vector3.new(half * 2 + 12, 2.4, 6.6),
				CFrame = side * CFrame.new(0, wallH + 1, -half + 4),
				Color = wallTrim,
				Material = Enum.Material.Concrete,
				CanCollide = true,
				Parent = props,
			})
			-- Tiras de ventanas (dos pisos de oficinas)
			for row = 0, 1 do
				for w = -6, 6 do
					local wx = w * 40
					if math.abs(wx) &lt; half - 20 then
						part({
							Name = "VentanaCiudad",
							Size = Vector3.new(26, 9, 0.6),
							CFrame = side * CFrame.new(wx, 14 + row * 17, -half + 6.6),
							Color = glassCol,
							Material = Enum.Material.Glass,
							CanCollide = false,
							Parent = props,
						})
					end
				end
			end
		end
		-- Torres en las esquinas
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				part({
					Name = "TorreEsquina",
					Size = Vector3.new(18, 62, 18),
					CFrame = CFrame.new(center + Vector3.new(sx * (half - 8), 31, sz * (half - 8))),
					Color = wallTrim,
					Material = Enum.Material.Concrete,
					CanCollide = true,
					Parent = props,
				})
			end
		end
		-- Skyline: edificios de fondo (afuera del area jugable)
		for i = 1, 16 do
			local a = (i / 16) * math.pi * 2
			local dist = half + rng:NextNumber(55, 130)
			local h = rng:NextNumber(70, 170)
			local w = rng:NextNumber(30, 56)
			part({
				Name = "Skyline",
				Size = Vector3.new(w, h, w),
				CFrame = CFrame.new(center + Vector3.new(math.cos(a) * dist, h * 0.5 - 6, math.sin(a) * dist)),
				Color = i % 3 == 0 and Color3.fromRGB(96, 102, 116) or Color3.fromRGB(74, 78, 90),
				Material = Enum.Material.Concrete,
				CanCollide = false,
				Parent = props,
			})
		end
	else
		-- Montañas de roca que cierran el mapa
		local palettes = {
			bosque = { Color3.fromRGB(92, 100, 84), Color3.fromRGB(112, 116, 98), Color3.fromRGB(74, 118, 72), Enum.Material.LeafyGrass },
			dunas = { Color3.fromRGB(188, 156, 106), Color3.fromRGB(208, 178, 128), Color3.fromRGB(226, 200, 148), Enum.Material.Sand },
			costa = { Color3.fromRGB(108, 98, 86), Color3.fromRGB(130, 118, 102), Color3.fromRGB(104, 122, 92), Enum.Material.Ground },
			alpes = { Color3.fromRGB(112, 120, 132), Color3.fromRGB(138, 148, 160), Color3.fromRGB(238, 244, 252), Enum.Material.Snow },
		}
		local pal = palettes[theme] or palettes.bosque
		local snowy = theme == "alpes"
		local sideLen = half * 2
		local count = math.floor(sideLen / 26)
		local ringDist = half - 9
		for side = 0, 3 do
			local sideCF = CFrame.new(center) * CFrame.Angles(0, side * math.pi * 0.5, 0)
			for i = 1, count do
				local x = -half + (i - 0.5) * (sideLen / count) + rng:NextNumber(-3, 3)
				local base = sideCF * CFrame.new(x, 0, -(ringDist + rng:NextNumber(-2, 4)))
				local h = rng:NextNumber(22, 48)
				local w = rng:NextNumber(26, 42)
				local d = rng:NextNumber(14, 22)
				part({
					Name = "Montana",
					Size = Vector3.new(w, h, d),
					CFrame = base * CFrame.new(0, h * 0.5 - 2, 0)
						* CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(-0.12, 0.12), rng:NextNumber(-0.08, 0.08)),
					Color = i % 2 == 0 and pal[1] or pal[2],
					Material = Enum.Material.Rock,
					CanCollide = true,
					Parent = props,
				})
				if snowy and i % 2 == 0 then
					part({
						Name = "NieveMontana",
						Size = Vector3.new(w * 0.68, h * 0.3, d * 0.68),
						CFrame = base * CFrame.new(0, h - h * 0.12 - 2, 0),
						Color = Color3.fromRGB(240, 246, 252),
						Material = Enum.Material.Snow,
						CanCollide = false,
						Parent = props,
					})
				end
			end
		end
		-- Esquinas montañosas (sin huecos)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				part({
					Name = "MontanaEsquina",
					Size = Vector3.new(44, 48, 44),
					CFrame = CFrame.new(center + Vector3.new(sx * (half - 8), 21, sz * (half - 8))),
					Color = pal[2],
					Material = Enum.Material.Rock,
					CanCollide = true,
					Parent = props,
				})
			end
		end
		-- Picos de fondo (paisaje)
		for i = 1, 14 do
			local a = (i / 14) * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
			local dist = half + rng:NextNumber(50, 140)
			local size = rng:NextNumber(110, 210)
			part({
				Name = "PicoFondo",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(size, size * rng:NextNumber(0.8, 1.2), size),
				Position = center + Vector3.new(math.cos(a) * dist, -size * 0.28, math.sin(a) * dist),
				Color = pal[3],
				Material = pal[4],
				CanCollide = false,
				Parent = props,
			})
		end
		-- En el bosque ademas hay una linea de kauris gigantes
		if theme == "bosque" then
			for i = 1, 26 do
				local a = (i / 26) * math.pi * 2 + rng:NextNumber(-0.06, 0.06)
				local dist = half - 22 + rng:NextNumber(-6, 6)
				local pos = center + Vector3.new(math.cos(a) * dist, 0, math.sin(a) * dist)
				local hh = rng:NextNumber(40, 62)
				part({
					Name = "KauriGigante",
					Size = Vector3.new(4.4, hh, 4.4),
					Position = pos + Vector3.new(0, hh * 0.5, 0),
					Color = zone.tree,
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = props,
				})
				part({
					Name = "CopaKauri",
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(26, 20, 26),
					Position = pos + Vector3.new(0, hh + 6, 0),
					Color = Color3.fromRGB(58, 104, 60),
					Material = Enum.Material.LeafyGrass,
					CanCollide = false,
					Parent = props,
				})
			end
		end
	end

	-- ---------------- Colinas suaves (arena, nieve y medanos) ----------------
	if zone.theme ~= "ciudad" then
		for i = 1, 3 do
			local angle = rng:NextNumber(0, math.pi * 2)
			local radius = rng:NextNumber(half * 0.35, half * 0.7)
			local hillSize = rng:NextNumber(70, 110)
			part({
				Name = "Colina",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(hillSize, hillSize * 0.9, hillSize),
				Position = center + Vector3.new(math.cos(angle) * radius, -hillSize * 0.32, math.sin(angle) * radius),
				Color = Color3.fromRGB(zone.grass.R * 240, zone.grass.G * 240, zone.grass.B * 240),
				Material = zone.ground or Enum.Material.Ground,
				Parent = props,
			})
		end
	end

	-- ---------------- Agua del mapa (con fondo y borde de piedra) ----------------
	local pondCfg = zone.pond
	if pondCfg ~= false then
		local water = pondCfg or {}
		local scale = water.scale or 1
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(half * 0.25, half * 0.55)
		local pondPos = center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local pondR = 26 * scale
		local icy = zone.theme == "alpes"

		-- Fondo (para que no se vea el pasto a traves del agua)
		part({
			Name = "FondoEstanque",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, pondR * 2 - 1.2, pondR * 2 - 1.2),
			CFrame = CFrame.new(pondPos + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = icy and Color3.fromRGB(178, 200, 214) or Color3.fromRGB(56, 66, 70),
			Material = icy and Enum.Material.Ice or Enum.Material.Slate,
			CanCollide = false,
			Parent = props,
		})

		-- Espejo de agua finito (antes era un cilindro grueso que parecia flotar)
		local pond = part({
			Name = "Estanque",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, pondR * 2, pondR * 2),
			CFrame = CFrame.new(pondPos + Vector3.new(0, 0.42, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = water.color or Color3.fromRGB(64, 122, 150),
			Material = water.material or Enum.Material.Water,
			Transparency = 0.25,
			CanCollide = false,
			Parent = props,
		})

		-- Borde de piedras: contiene el agua y se ve natural
		local rimColor = icy and Color3.fromRGB(212, 226, 236) or Color3.fromRGB(122, 118, 110)
		local rimMaterial = icy and Enum.Material.Ice or Enum.Material.Rock
		local rimCount = math.clamp(math.floor(pondR / 3), 10, 22)
		for i = 1, rimCount do
			local a = (i - 1) / rimCount * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
			local size = rng:NextNumber(2.6, 4.8)
			part({
				Name = "BordeEstanque",
				Size = Vector3.new(size, rng:NextNumber(1.4, 2.6), size),
				CFrame = CFrame.new(pondPos + Vector3.new(math.cos(a) * (pondR - 1.4), 0.5, math.sin(a) * (pondR - 1.4)))
					* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
				Color = rimColor,
				Material = rimMaterial,
				CanCollide = true,
				Parent = props,
			})
		end

		for i = 1, 10 do
			local a = rng:NextNumber(0, math.pi * 2)
			part({
				Name = "Junco",
				Size = Vector3.new(0.5, rng:NextNumber(4, 7), 0.5),
				Position = pondPos + Vector3.new(math.cos(a) * (pondR + 2.5), 2.5, math.sin(a) * (pondR + 2.5)),
				Color = Color3.fromRGB(110, 132, 74),
				Material = Enum.Material.Grass,
				Parent = props,
			})
		end
		pond.CanQuery = true
	end

	-- ===============================================================
	-- Constructores de props / escondites
	-- ===============================================================
	local function addSpot(kind, name, mainPart, hidePoint, radius, cover)
		local point = Vector3.new(hidePoint.X, math.max(floorY + 0.1, hidePoint.Y or floorY), hidePoint.Z)

		-- Anclaje invisible en el punto exacto donde se mete el kiwi: ahi
		-- viven las particulas de "algo se mueve entre las hojas".
		local anchor = part({
			Name = "RustleAnchor",
			Size = Vector3.new(1, 1, 1),
			Position = point,
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			Parent = props,
		})

		local spot = {
			id = #self.spots + 1,
			arena = self,
			kind = kind,
			name = name,
			hidePoint = point,
			radius = radius,
			cover = cover,
			part = mainPart,
			anchor = anchor,
		}
		spot.emitter = makeRustle(anchor)
		table.insert(self.spots, spot)
		return spot
	end

	--[[
		Escondite en el que el JUGADOR puede meterse (armario, barril, pajar):
		ademas del escondite del kiwi guarda como entrar, salir y la puerta.
	]]
	local function registerEnter(spot, opts)
		spot.enter = {
			inside = opts.inside,
			exit = opts.exit,
			door = opts.door,
			doorClosed = opts.doorClosed,
			doorOpen = opts.doorOpen,
			wobble = opts.wobble,
			wobbleCF = opts.wobble and opts.wobble.CFrame or nil,
			label = opts.label or "Escondite",
		}
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EntrarEscondite"
		prompt.ActionText = "Esconderse"
		prompt.ObjectText = spot.enter.label
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = opts.anchorPart or spot.part
		spot.enter.prompt = prompt
		spot.enterIndex = #self.enterList + 1
		table.insert(self.enterList, spot)
		return spot
	end

	-- Zona de interior: dentro de una casa el kiwi te huele menos
	local function addIndoor(cf, size)
		table.insert(self.indoors, { cf = cf, size = size })
	end

	-- Arbusto (escondite clasico)
	local function makeBush(pos, scale)
		scale = scale or rng:NextNumber(0.9, 1.35)
		local green = Color3.fromRGB(62 + rng:NextInteger(-8, 12), 112 + rng:NextInteger(-10, 14), 66)
		local main
		for i = 1, 4 do
			local ballSize = rng:NextNumber(4.5, 7) * scale
			local offset = Vector3.new(rng:NextNumber(-2.4, 2.4), rng:NextNumber(0.6, 2.2), rng:NextNumber(-2.4, 2.4)) * scale
			local ball = part({
				Name = "Arbusto",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(ballSize, ballSize * 0.85, ballSize),
				Position = pos + offset,
				Color = green,
				Material = Enum.Material.LeafyGrass,
				Parent = props,
			})
			if not main then
				main = ball
			end
		end
		return addSpot("arbusto", "Arbusto de manuka", main, pos + Vector3.new(0, 1.6, 0), 5.5 * scale, 0.72)
	end

	-- Helecho plateado
	local function makeFern(pos, scale)
		scale = scale or rng:NextNumber(0.9, 1.4)
		part({
			Name = "TroncoHelecho",
			Size = Vector3.new(0.9 * scale, 5 * scale, 0.9 * scale),
			Position = pos + Vector3.new(0, 2.5 * scale, 0),
			Color = Color3.fromRGB(92, 68, 46),
			Material = Enum.Material.Wood,
			Parent = props,
		})
		local main
		for i = 1, 7 do
			local angle = (i / 7) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
			local frond = part({
				Name = "Fronda",
				Size = Vector3.new(1.1 * scale, 0.3, 8 * scale),
				CFrame = CFrame.new(pos + Vector3.new(0, 5.2 * scale, 0))
					* CFrame.Angles(math.rad(-28), angle, 0)
					* CFrame.new(0, 0, -4 * scale),
				Color = Color3.fromRGB(96 + rng:NextInteger(-10, 10), 138 + rng:NextInteger(-12, 12), 88),
				Material = Enum.Material.Grass,
				Parent = props,
			})
			if not main then
				main = frond
			end
		end
		return addSpot("helecho", "Helecho gigante", main, pos + Vector3.new(0, 2, 0), 5 * scale, 0.6)
	end

	-- Tronco hueco
	local function makeLog(pos, angle)
		angle = angle or rng:NextNumber(0, math.pi)
		local axis = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local main = part({
			Name = "TroncoHueco",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(15, 3.4, 3.4),
			CFrame = CFrame.new(pos + Vector3.new(0, 1.9, 0)) * CFrame.Angles(0, -angle, 0),
			Color = Color3.fromRGB(84, 62, 44),
			Material = Enum.Material.Wood,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "Hueco",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 2.4, 2.4),
			CFrame = CFrame.new(pos + axis * 7.6 + Vector3.new(0, 1.9, 0)) * CFrame.Angles(0, -angle, 0),
			Color = Color3.fromRGB(28, 22, 18),
			Material = Enum.Material.Slate,
			Parent = props,
		})
		return addSpot("tronco", "Tronco hueco", main, pos, 6, 0.85)
	end

	-- Grieta de rocas
	local function makeRocks(pos, scale)
		scale = scale or rng:NextNumber(1, 1.6)
		local main
		for i = 1, 3 do
			local ballSize = rng:NextNumber(6, 10) * scale
			local offset = Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(1.5, 3.5), rng:NextNumber(-4, 4))
			local rock = part({
				Name = "Roca",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(ballSize, ballSize * 0.8, ballSize),
				Position = pos + offset,
				Color = Color3.fromRGB(122, 124, 126),
				Material = Enum.Material.Rock,
				CanCollide = true,
				Parent = props,
			})
			if not main then
				main = rock
			end
		end
		return addSpot("roca", "Grieta entre rocas", main, pos + Vector3.new(0, 1.4, 0), 6 * scale, 0.9)
	end

	-- Madriguera
	local function makeBurrow(pos)
		local main = part({
			Name = "Monticulo",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(11, 6, 11),
			Position = pos + Vector3.new(0, 1.2, 0),
			Color = Color3.fromRGB(92, 74, 52),
			Material = Enum.Material.Ground,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "Entrada",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 3.6, 3.6),
			CFrame = CFrame.new(pos + Vector3.new(0, 1.5, -2.5)) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(24, 20, 16),
			Material = Enum.Material.Slate,
			Parent = props,
		})
		return addSpot("madriguera", "Madriguera", main, pos, 6.5, 1.0)
	end

	-- Pasto alto
	local function makeGrassPatch(pos, scale)
		scale = scale or rng:NextNumber(1, 1.5)
		local main
		for i = 1, 8 do
			local blade = part({
				Name = "Pasto",
				Size = Vector3.new(rng:NextNumber(0.7, 1.6) * scale, rng:NextNumber(4, 6.5) * scale, rng:NextNumber(0.7, 1.6) * scale),
				CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(1.5, 3), rng:NextNumber(-5, 5)))
					* CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, 6), rng:NextNumber(-0.15, 0.15)),
				Color = Color3.fromRGB(126, 142 + rng:NextInteger(-14, 14), 84),
				Material = Enum.Material.Grass,
				Transparency = 0.12,
				Parent = props,
			})
			if not main then
				main = blade
			end
		end
		return addSpot("pasto", "Pasto alto", main, pos + Vector3.new(0, 1, 0), 7 * scale, 0.5)
	end

	-- Cabana del guardabosques
	local function makeHut(pos, angle)
		angle = angle or 0
		local base = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
		local wood = Color3.fromRGB(112, 84, 56)
		part({
			Name = "PisoCabana",
			Size = Vector3.new(20, 1, 16),
			CFrame = base * CFrame.new(0, 0.5, 0),
			Color = Color3.fromRGB(96, 88, 78),
			Material = Enum.Material.Slate,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "ParedFondo",
			Size = Vector3.new(20, 9, 1),
			CFrame = base * CFrame.new(0, 4.8, -8),
			Color = wood,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "ParedIzq",
			Size = Vector3.new(1, 9, 16),
			CFrame = base * CFrame.new(-10, 4.8, 0),
			Color = wood,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "ParedDer",
			Size = Vector3.new(1, 9, 16),
			CFrame = base * CFrame.new(10, 4.8, 0),
			Color = wood,
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		local main = part({
			Name = "Techo",
			Size = Vector3.new(23, 1.2, 19),
			CFrame = base * CFrame.new(0, 9.4, 0),
			Color = Color3.fromRGB(70, 52, 38),
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "Viga",
			Size = Vector3.new(20, 1, 1),
			CFrame = base * CFrame.new(0, 9.9, -7),
			Color = Color3.fromRGB(60, 44, 32),
			Material = Enum.Material.Wood,
			Parent = props,
		})
		return addSpot("cabana", "Cabaña del guardabosques", main, pos, 10, 0.8)
	end

	-- Torre de observacion
	local function makeTower(pos)
		local wood = Color3.fromRGB(126, 96, 62)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				part({
					Name = "PataTorre",
					Size = Vector3.new(1.4, 16, 1.4),
					Position = pos + Vector3.new(sx * 5, 8, sz * 5),
					Color = wood,
					Material = Enum.Material.Wood,
					CanCollide = true,
					Parent = props,
				})
			end
		end
		local platform = part({
			Name = "PlataformaTorre",
			Size = Vector3.new(16, 1.2, 16),
			Position = pos + Vector3.new(0, 16.6, 0),
			Color = Color3.fromRGB(104, 78, 52),
			Material = Enum.Material.WoodPlanks,
			Parent = props,
		})
		part({
			Name = "Baranda",
			Size = Vector3.new(16, 3, 0.6),
			Position = pos + Vector3.new(0, 18.4, -8),
			Color = wood,
			Material = Enum.Material.Wood,
			Parent = props,
		})
		return addSpot("torre", "Bajo la torre", platform, pos, 8, 0.45)
	end

	-- Arbol decorativo (no es escondite, es obstaculo)
	local function makeTree(pos)
		local height = rng:NextNumber(22, 36)
		part({
			Name = "Tronco",
			Size = Vector3.new(2.8, height, 2.8),
			Position = pos + Vector3.new(0, height * 0.5, 0),
			Color = zone.tree,
			Material = Enum.Material.Wood,
			CanCollide = true,
			Parent = props,
		})
		for leaf = 1, 2 do
			local leafSize = rng:NextNumber(14, 20) - leaf * 2
			part({
				Name = "Copa",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(leafSize, leafSize * 0.72, leafSize),
				Position = pos + Vector3.new(rng:NextNumber(-2, 2), height - 3 + leaf * 3.5, rng:NextNumber(-2, 2)),
				Color = Color3.fromRGB(58 + leaf * 6, 104 + leaf * 6, 60),
				Material = Enum.Material.LeafyGrass,
				Parent = props,
			})
		end
	end

	-- Medano de arena (Dunas): limita la vista y da volumen
	local function makeDuneMound(pos, scale)
		scale = scale or rng:NextNumber(0.9, 1.5)
		for i = 1, 3 do
			local s = rng:NextNumber(16, 26) * scale
			part({
				Name = "Medano",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(s, s * 0.42, s),
				Position = pos + Vector3.new(rng:NextNumber(-7, 7), -s * 0.22 + rng:NextNumber(0, 2), rng:NextNumber(-7, 7)),
				Color = Color3.fromRGB(224, 200, 150),
				Material = Enum.Material.Sand,
				CanCollide = false,
				Parent = props,
			})
		end
	end

	-- Cactus (Dunas): escondite chico
	local function makeCactus(pos, scale)
		scale = scale or rng:NextNumber(0.85, 1.35)
		local green = Color3.fromRGB(96, 138, 84)
		local trunk = part({
			Name = "Cactus",
			Size = Vector3.new(2.2 * scale, 9 * scale, 2.2 * scale),
			Position = pos + Vector3.new(0, 4.5 * scale, 0),
			Color = green,
			Material = Enum.Material.Grass,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "CactusBrazo",
			Size = Vector3.new(1.4 * scale, 4 * scale, 1.4 * scale),
			Position = pos + Vector3.new(1.7 * scale, 5.6 * scale, 0),
			Color = green,
			Material = Enum.Material.Grass,
			CanCollide = true,
			Parent = props,
		})
		return addSpot("arbusto", "Cactus", trunk, pos + Vector3.new(0, 1.6, 0), 4.6 * scale, 0.65)
	end

	-- Palmera (Costa)
	local function makePalm(pos, scale)
		scale = scale or rng:NextNumber(0.9, 1.3)
		local height = rng:NextNumber(20, 28) * scale
		part({
			Name = "TroncoPalmera",
			Size = Vector3.new(1.8 * scale, height, 1.8 * scale),
			CFrame = CFrame.new(pos + Vector3.new(0, height * 0.5, 0)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06)),
			Color = zone.tree,
			Material = Enum.Material.Wood,
			CanCollide = true,
			Parent = props,
		})
		local top = pos + Vector3.new(0, height, 0)
		for i = 1, 5 do
			local a = (i - 1) * (math.pi * 2 / 5) + rng:NextNumber(-0.2, 0.2)
			part({
				Name = "HojaPalmera",
				Size = Vector3.new(12 * scale, 0.5, 2.6 * scale),
				CFrame = CFrame.new(top + Vector3.new(math.cos(a) * 4.6 * scale, rng:NextNumber(-1.5, 0.6), math.sin(a) * 4.6 * scale))
					* CFrame.Angles(0, -a, math.rad(-14)),
				Color = Color3.fromRGB(64, 122, 66),
				Material = Enum.Material.LeafyGrass,
				CanCollide = false,
				Parent = props,
			})
		end
	end

	-- Pino de nieve (Alpes)
	local function makePine(pos, scale)
		scale = scale or rng:NextNumber(0.9, 1.3)
		local height = rng:NextNumber(24, 34) * scale
		part({
			Name = "TroncoPino",
			Size = Vector3.new(2.4, height * 0.5, 2.4),
			Position = pos + Vector3.new(0, height * 0.25, 0),
			Color = zone.tree,
			Material = Enum.Material.Wood,
			CanCollide = true,
			Parent = props,
		})
		for level = 1, 3 do
			local width = (20 - level * 4) * scale
			part({
				Name = "CopaPino",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(width, width * 0.75, width),
				Position = pos + Vector3.new(0, height * (0.38 + level * 0.16), 0),
				Color = Color3.fromRGB(52 + level * 6, 88 + level * 6, 62),
				Material = Enum.Material.LeafyGrass,
				CanCollide = level == 1,
				Parent = props,
			})
		end
	end

	-- Poste de luz (Ciudad)
	local function makeLampPost(pos)
		part({
			Name = "Poste",
			Size = Vector3.new(0.7, 16, 0.7),
			Position = pos + Vector3.new(0, 8, 0),
			Color = Color3.fromRGB(58, 60, 66),
			Material = Enum.Material.Metal,
			CanCollide = true,
			Parent = props,
		})
		local lamp = part({
			Name = "Farol",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.6, 2.6, 2.6),
			Position = pos + Vector3.new(0, 16.6, 0),
			Color = Color3.fromRGB(255, 232, 168),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = props,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 226, 158)
		light.Range = 34
		light.Brightness = 1.1
		light.Parent = lamp
	end

	-- Banco de plaza (Ciudad)
	local function makeBench(pos)
		local base = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		part({
			Name = "BancoAsiento",
			Size = Vector3.new(6, 0.6, 1.8),
			CFrame = base * CFrame.new(0, 2.2, 0),
			Color = Color3.fromRGB(126, 96, 62),
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		for _, dx in ipairs({ -2.4, 2.4 }) do
			part({
				Name = "PatasBanco",
				Size = Vector3.new(0.6, 2.2, 1.4),
				CFrame = base * CFrame.new(dx, 1.1, 0),
				Color = Color3.fromRGB(74, 76, 82),
				Material = Enum.Material.Metal,
				CanCollide = true,
				Parent = props,
			})
		end
	end

	-- Torre mirador de la ciudad (estilo Sky Tower)
	local function makeSkyTower(pos)
		local shaft = part({
			Name = "TorreFuste",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(120, 13, 13),
			CFrame = CFrame.new(pos + Vector3.new(0, 60, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(206, 214, 222),
			Material = Enum.Material.Concrete,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "TorreMirador",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(26, 26, 26),
			Position = pos + Vector3.new(0, 108, 0),
			Color = Color3.fromRGB(120, 150, 180),
			Material = Enum.Material.Glass,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "TorreAguja",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(46, 2.2, 2.2),
			CFrame = CFrame.new(pos + Vector3.new(0, 145, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(180, 190, 200),
			Material = Enum.Material.Metal,
			CanCollide = false,
			Parent = props,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 120, 110)
		light.Range = 60
		light.Brightness = 2
		light.Parent = shaft
	end

	-- ===============================================================
	-- Casas con interiores (escondites de verdad) y baules de armas
	-- ===============================================================
	local HOUSE_WOOD = Color3.fromRGB(122, 92, 62)
	local HOUSE_WALL = zone.wall or Color3.fromRGB(204, 190, 166)
	local HOUSE_ROOF = zone.roof or Color3.fromRGB(148, 76, 54)
	local HOUSE_FLOOR = zone.floor or Color3.fromRGB(104, 84, 64)

	local function box(name, cf, size, color, material)
		return part({
			Name = name,
			Size = size,
			CFrame = cf,
			Color = color,
			Material = material or Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
	end

	local function makeCloset(base, label)
		local body = box("Armario", base * CFrame.new(0, 3.6, 0), Vector3.new(2.8, 7.2, 2.2), HOUSE_WOOD, Enum.Material.WoodPlanks)
		box("TapaArmario", base * CFrame.new(0, 7.1, 0), Vector3.new(3.0, 0.3, 2.4), Color3.fromRGB(92, 68, 46), Enum.Material.Wood)
		local hinge = base * CFrame.new(-1.35, 3.55, 1.18)
		local doorClosed = hinge * CFrame.new(1.35, 0, 0)
		local doorOpen = hinge * CFrame.Angles(0, math.rad(86), 0) * CFrame.new(1.35, 0, 0)
		local door = box("PuertaArmario", doorClosed, Vector3.new(2.7, 6.8, 0.3), Color3.fromRGB(110, 80, 54), Enum.Material.WoodPlanks)
		local spot = addSpot("armario", "Armario", body, base.Position, 2.6, 0.95)
		return registerEnter(spot, {
			inside = base * CFrame.new(0, 3.7, -0.1) * CFrame.Angles(0, math.rad(180), 0),
			exit = base * CFrame.new(0, 3.7, 3.6) * CFrame.Angles(0, math.rad(180), 0),
			door = door,
			doorClosed = doorClosed,
			doorOpen = doorOpen,
			label = label or "Armario",
			anchorPart = body,
		})
	end

	local function makeBarrelHide(base, label)
		local body = part({
			Name = "Barril",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(6.4, 3.6, 3.6),
			CFrame = base * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(128, 90, 56),
			Material = Enum.Material.WoodPlanks,
			CanCollide = true,
			Parent = props,
		})
		for _, y in ipairs({ 1.5, 5.0 }) do
			part({
				Name = "AroBarril",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.5, 3.8, 3.8),
				CFrame = base * CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(84, 84, 92),
				Material = Enum.Material.Metal,
				CanCollide = false,
				Parent = props,
			})
		end
		local spot = addSpot("barril", "Barril", body, base.Position, 2.4, 0.95)
		return registerEnter(spot, {
			inside = base * CFrame.new(0, 3.4, 0),
			exit = base * CFrame.new(0, 3.4, 3.4),
			wobble = body,
			label = label or "Barril",
			anchorPart = body,
		})
	end

	local function makeHayProp(base, label)
		local main = part({
			Name = "Pajar",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(8, 7.4, 8),
			CFrame = base * CFrame.new(0, 2.4, 0),
			Color = Color3.fromRGB(198, 170, 86),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "PajarChico",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(4.8, 4, 4.8),
			CFrame = base * CFrame.new(2.7, 1.3, 1.9),
			Color = Color3.fromRGB(208, 182, 98),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = true,
			Parent = props,
		})
		local spot = addSpot("pajar", "Pajar", main, base.Position, 3.0, 1)
		return registerEnter(spot, {
			inside = base * CFrame.new(0, 3.3, 0),
			exit = base * CFrame.new(0, 3.3, 4.8),
			wobble = main,
			label = label or "Pajar",
			anchorPart = main,
		})
	end

	local function makeChestProp(base, label)
		local body = box("Baul", base * CFrame.new(0, 1.3, 0), Vector3.new(4.2, 2.6, 3.0), Color3.fromRGB(124, 84, 48), Enum.Material.WoodPlanks)
		box("AdornoBaul", base * CFrame.new(0, 1.3, 0), Vector3.new(4.35, 0.55, 3.15), Color3.fromRGB(214, 178, 74), Enum.Material.Metal, false)
		local hinge = base * CFrame.new(0, 2.6, -1.5)
		local lidClosed = hinge * CFrame.new(0, 0.25, 1.5)
		local lidOpen = hinge * CFrame.Angles(math.rad(-78), 0, 0) * CFrame.new(0, 0.25, 1.5)
		local lid = box("TapaBaul", lidClosed, Vector3.new(4.2, 0.5, 3.0), Color3.fromRGB(136, 96, 56), Enum.Material.WoodPlanks)
		local light = Instance.new("PointLight")
		light.Name = "BrilloBaul"
		light.Color = Color3.fromRGB(255, 214, 120)
		light.Range = 18
		light.Brightness = 1.4
		light.Parent = body
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "AbrirBaul"
		prompt.ActionText = "Abrir"
		prompt.ObjectText = label or "Baúl"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = body
		local chest = {
			body = body,
			lid = lid,
			lidClosed = lidClosed,
			lidOpen = lidOpen,
			light = light,
			prompt = prompt,
			used = false,
			center = base.Position,
		}
		table.insert(self.chests, chest)
		return chest
	end

	local function makeTable(cf, wood)
		box("Mesa", cf * CFrame.new(0, 2.4, 0), Vector3.new(4.6, 0.4, 2.6), wood, Enum.Material.Wood)
		for _, dx in ipairs({ -1.8, 1.8 }) do
			for _, dz in ipairs({ -0.9, 0.9 }) do
				box("PataMesa", cf * CFrame.new(dx, 1.15, dz), Vector3.new(0.4, 2.3, 0.4), wood, Enum.Material.Wood)
			end
		end
	end

	local function makeChair(cf, wood)
		box("Asiento", cf * CFrame.new(0, 1.4, 0), Vector3.new(1.8, 0.35, 1.8), wood, Enum.Material.Wood)
		box("Respaldo", cf * CFrame.new(0, 2.7, -0.75), Vector3.new(1.8, 2.4, 0.3), wood, Enum.Material.Wood)
		for _, dx in ipairs({ -0.7, 0.7 }) do
			for _, dz in ipairs({ -0.7, 0.7 }) do
				box("PataSilla", cf * CFrame.new(dx, 0.6, dz), Vector3.new(0.3, 1.2, 0.3), wood, Enum.Material.Wood)
			end
		end
	end

	local function makeBed(cf, wood)
		box("Cama", cf * CFrame.new(0, 1.1, 0), Vector3.new(6.4, 1.2, 3.2), wood, Enum.Material.Wood)
		box("Colchon", cf * CFrame.new(0, 2.0, 0), Vector3.new(6.0, 0.9, 2.9), Color3.fromRGB(226, 224, 216), Enum.Material.Fabric)
		box("Almohada", cf * CFrame.new(-2.2, 2.7, 0), Vector3.new(1.6, 0.5, 2.4), Color3.fromRGB(240, 240, 236), Enum.Material.Fabric)
	end

	local function makeShelfProp(cf, wood)
		box("Estante", cf * CFrame.new(0, 2.8, 0), Vector3.new(4.4, 5.6, 1.0), wood, Enum.Material.Wood)
	end

	local function makeCrateProp(cf, size, wood)
		box("Caja", cf * CFrame.new(0, size.Y * 0.5, 0), size, Color3.fromRGB(126, 94, 60), Enum.Material.WoodPlanks)
	end

	local function makeHouse(pos, angle, variant)
		local base = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
		local big = variant == "farm"
		local W = big and 30 or 26
		local D = big and 22 or 19
		local floorH = 9.4
		local totalH = floorH * 2
		local wood = HOUSE_WOOD
		local floorPart = box("PisoCasa", base * CFrame.new(0, 0.3, 0), Vector3.new(W + 1.6, 0.6, D + 1.6), HOUSE_FLOOR, Enum.Material.Slate)

		-- Escalinata y toldo de entrada
		box("EscalonEntrada", base * CFrame.new(0, 0.3, D * 0.5 + 1.5), Vector3.new(8, 0.6, 3), HOUSE_FLOOR, Enum.Material.Slate)
		box("Toldo", base * CFrame.new(0, 7.9, D * 0.5 + 1.4), Vector3.new(9, 0.4, 3.0), wood, Enum.Material.WoodPlanks)

		local doorW = 6.4
		local sideW = (W - doorW) * 0.5
		box("ParedFrenteA", base * CFrame.new(-(doorW * 0.5 + sideW * 0.5), totalH * 0.5 + 0.6, D * 0.5), Vector3.new(sideW, totalH, 0.8), HOUSE_WALL, Enum.Material.Concrete)
		box("ParedFrenteB", base * CFrame.new(doorW * 0.5 + sideW * 0.5, totalH * 0.5 + 0.6, D * 0.5), Vector3.new(sideW, totalH, 0.8), HOUSE_WALL, Enum.Material.Concrete)
		box("DintelFrente", base * CFrame.new(0, floorH - 0.5, D * 0.5), Vector3.new(doorW, 2.2, 0.8), HOUSE_WALL, Enum.Material.Concrete)
		box("ParedFrenteC", base * CFrame.new(0, floorH + 0.6 + floorH * 0.5, D * 0.5), Vector3.new(doorW, floorH, 0.8), HOUSE_WALL, Enum.Material.Concrete)
		box("ParedFondo", base * CFrame.new(0, totalH * 0.5 + 0.6, -D * 0.5), Vector3.new(W, totalH, 0.8), HOUSE_WALL, Enum.Material.Concrete)
		box("ParedIzq", base * CFrame.new(-W * 0.5, totalH * 0.5 + 0.6, 0), Vector3.new(0.8, totalH, D), HOUSE_WALL, Enum.Material.Concrete)
		box("ParedDer", base * CFrame.new(W * 0.5, totalH * 0.5 + 0.6, 0), Vector3.new(0.8, totalH, D), HOUSE_WALL, Enum.Material.Concrete)

		-- Ventanas en las dos plantas
		box("VentanaA", base * CFrame.new(-W * 0.5, 5.4, D * 0.2), Vector3.new(1.0, 3.0, 3.4), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)
		box("VentanaB", base * CFrame.new(W * 0.5, 5.4, -D * 0.2), Vector3.new(1.0, 3.0, 3.4), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)
		box("VentanaC", base * CFrame.new(W * 0.22, 5.4, -D * 0.5), Vector3.new(3.2, 3.0, 1.0), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)
		box("VentanaAltaA", base * CFrame.new(-W * 0.5, floorH + 5.4, D * 0.2), Vector3.new(1.0, 3.0, 3.4), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)
		box("VentanaAltaB", base * CFrame.new(W * 0.5, floorH + 5.4, -D * 0.2), Vector3.new(1.0, 3.0, 3.4), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)
		box("VentanaAltaC", base * CFrame.new(W * 0.3, floorH + 5.4, D * 0.5), Vector3.new(3.2, 3.0, 1.0), Color3.fromRGB(88, 116, 128), Enum.Material.Glass)

		box("MarcoIzq", base * CFrame.new(-doorW * 0.5 - 0.25, 3.9, D * 0.5), Vector3.new(0.5, 7.0, 1.1), wood, Enum.Material.Wood)
		box("MarcoDer", base * CFrame.new(doorW * 0.5 + 0.25, 3.9, D * 0.5), Vector3.new(0.5, 7.0, 1.1), wood, Enum.Material.Wood)

		-- Piso del segundo piso con hueco para la escalera
		local holeW = 5.8
		local holeZEnd = -D * 0.5 + D * 0.62
		local slabY = floorH + 0.55
		box("PisoAltoDerecha", base * CFrame.new(holeW * 0.5, slabY, 0), Vector3.new(W - holeW, 0.5, D), wood, Enum.Material.WoodPlanks)
		box("PisoAltoFrente", base * CFrame.new(-W * 0.5 + holeW * 0.5, slabY, (holeZEnd + D * 0.5) * 0.5), Vector3.new(holeW, 0.5, D * 0.5 - holeZEnd), wood, Enum.Material.WoodPlanks)
		box("BarandaEscalera", base * CFrame.new(-W * 0.5 + holeW + 0.2, slabY + 1.6, (-3.0 + holeZEnd) * 0.5), Vector3.new(0.3, 2.6, holeZEnd + 3.0), wood, Enum.Material.Wood)
		box("BarandaFrente", base * CFrame.new(-W * 0.5 + holeW * 0.5, slabY + 1.6, holeZEnd + 0.15), Vector3.new(holeW, 2.6, 0.3), wood, Enum.Material.Wood)

		-- Escalera de 12 escalones contra la pared izquierda
		local steps = 12
		local stepRise = floorH / steps
		local stepRun = (D - 5.5) / steps
		local stairX = -W * 0.5 + 2.9
		local stairZ0 = D * 0.5 - 2.5
		for i = 1, steps do
			box("Escalon", base * CFrame.new(stairX, 0.6 + i * stepRise - stepRise * 0.5, stairZ0 - (i - 1) * stepRun),
				Vector3.new(5.0, stepRise, stepRun + 0.25), wood, Enum.Material.WoodPlanks)
		end

		box("TechoCasa", base * CFrame.new(0, totalH + 1.1, 0), Vector3.new(W + 1.8, 0.6, D + 1.8), wood, Enum.Material.WoodPlanks)
		box("Chimenea", base * CFrame.new(W * 0.24, totalH + 3.6, -D * 0.18), Vector3.new(2.4, 6, 2.4), Color3.fromRGB(128, 84, 70), Enum.Material.Brick)
		local slope = math.rad(26)
		local slab = (W * 0.5 + 1.6) / math.cos(slope)
		part({
			Name = "TejadoA",
			Size = Vector3.new(slab, 0.7, D + 2.6),
			CFrame = base * CFrame.new(-W * 0.25 - 0.5, totalH + 2.4, 0) * CFrame.Angles(0, 0, slope),
			Color = HOUSE_ROOF,
			Material = Enum.Material.Slate,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "TejadoB",
			Size = Vector3.new(slab, 0.7, D + 2.6),
			CFrame = base * CFrame.new(W * 0.25 + 0.5, totalH + 2.4, 0) * CFrame.Angles(0, 0, -slope),
			Color = HOUSE_ROOF,
			Material = Enum.Material.Slate,
			CanCollide = true,
			Parent = props,
		})

		-- Planta baja: comedor y living del lado derecho (la escalera usa la izquierda)
		makeTable(base * CFrame.new(3, 0.6, -1), wood)
		makeChair(base * CFrame.new(3, 0.6, 2), wood)
		makeChair(base * CFrame.new(3, 0.6, -4), wood)
		makeBed(base * CFrame.new(W * 0.3, 0.6, -D * 0.32), wood)
		makeShelfProp(base * CFrame.new(8, 0.6, 0.5), wood)
		makeCrateProp(base * CFrame.new(6.5, 0.6, D * 0.3), Vector3.new(4.4, 4.4, 4.4), wood)
		if big then
			makeCrateProp(base * CFrame.new(0.5, 0.6, -D * 0.36), Vector3.new(4, 3.2, 4), wood)
			makeBarrelHide(base * CFrame.new(-4.5, 0.6, -D * 0.05), "Barril")
		end
		makeShelfProp(base * CFrame.new(-4, 0.6, -D * 0.4), wood)
		makeCloset(base * CFrame.new(W * 0.36, 0.6, D * 0.1) * CFrame.Angles(0, math.rad(-90), 0), "Armario")
		makeChestProp(base * CFrame.new(-4, 0.6, D * 0.36), "Baúl")

		addSpot("casa", "Casa", floorPart, (base * CFrame.new(-3, 0, -D * 0.3)).Position, 2.8, 0.9)
		addSpot("casa", "Casa", floorPart, (base * CFrame.new(5, 0, D * 0.05)).Position, 2.8, 0.9)

		-- Planta alta: dormitorio y baul propios. No hay escondite (armario)
		-- aca arriba: el kiwi no sabe subir escaleras y seria una zona segura.
		local upY = floorH + 0.8
		makeBed(base * CFrame.new(W * 0.3, upY, -D * 0.3), wood)
		makeShelfProp(base * CFrame.new(2, upY, -D * 0.42), wood)
		makeCrateProp(base * CFrame.new(-3.5, upY, D * 0.3), Vector3.new(4, 3.6, 4), wood)
		makeShelfProp(base * CFrame.new(W * 0.34, upY, D * 0.08), wood)
		makeChestProp(base * CFrame.new(2.5, upY, D * 0.34), "Baúl del piso")

		addIndoor(base, Vector3.new(W - 2, totalH, D - 2))
	end

	local function makeBarn(pos, angle)
		local base = CFrame.new(pos) * CFrame.Angles(0, angle, 0)
		local W, D, wallH = 23, 17, 11
		local wood = HOUSE_WOOD
		local barnRed = zone.barn or (theme == "ciudad" and Color3.fromRGB(118, 110, 102) or Color3.fromRGB(140, 62, 52))
		local floorPart = box("PisoGranero", base * CFrame.new(0, 0.3, 0), Vector3.new(W + 1.6, 0.6, D + 1.6), HOUSE_FLOOR, Enum.Material.Slate)

		local doorW = 10
		local sideW = (W - doorW) * 0.5
		box("GraneroFrenteA", base * CFrame.new(-(doorW * 0.5 + sideW * 0.5), wallH * 0.5 + 0.6, D * 0.5), Vector3.new(sideW, wallH, 0.8), barnRed, Enum.Material.WoodPlanks)
		box("GraneroFrenteB", base * CFrame.new(doorW * 0.5 + sideW * 0.5, wallH * 0.5 + 0.6, D * 0.5), Vector3.new(sideW, wallH, 0.8), barnRed, Enum.Material.WoodPlanks)
		box("GraneroDintel", base * CFrame.new(0, wallH - 1.4 + 0.6, D * 0.5), Vector3.new(doorW, 2.8, 0.8), barnRed, Enum.Material.WoodPlanks)
		box("GraneroFondo", base * CFrame.new(0, wallH * 0.5 + 0.6, -D * 0.5), Vector3.new(W, wallH, 0.8), barnRed, Enum.Material.WoodPlanks)
		box("GraneroIzq", base * CFrame.new(-W * 0.5, wallH * 0.5 + 0.6, 0), Vector3.new(0.8, wallH, D), barnRed, Enum.Material.WoodPlanks)
		box("GraneroDer", base * CFrame.new(W * 0.5, wallH * 0.5 + 0.6, 0), Vector3.new(0.8, wallH, D), barnRed, Enum.Material.WoodPlanks)
		box("GraneroTecho", base * CFrame.new(0, wallH + 1.1, 0), Vector3.new(W + 1.8, 0.6, D + 1.8), wood, Enum.Material.WoodPlanks)
		local slope = math.rad(24)
		local slab = (W * 0.5 + 1.6) / math.cos(slope)
		part({
			Name = "GraneroTejadoA",
			Size = Vector3.new(slab, 0.7, D + 2.6),
			CFrame = base * CFrame.new(-W * 0.25 - 0.5, wallH + 2.3, 0) * CFrame.Angles(0, 0, slope),
			Color = Color3.fromRGB(120, 64, 48),
			Material = Enum.Material.Slate,
			CanCollide = true,
			Parent = props,
		})
		part({
			Name = "GraneroTejadoB",
			Size = Vector3.new(slab, 0.7, D + 2.6),
			CFrame = base * CFrame.new(W * 0.25 + 0.5, wallH + 2.3, 0) * CFrame.Angles(0, 0, -slope),
			Color = Color3.fromRGB(120, 64, 48),
			Material = Enum.Material.Slate,
			CanCollide = true,
			Parent = props,
		})

		-- Silos de metal al lado del granero
		for _, side in ipairs({ -1, 1 }) do
			if rng:NextNumber(0, 1) &lt; 0.6 then
				local sPos = base * CFrame.new(side * (W * 0.5 + 9), 0, -D * 0.2)
				part({
					Name = "Silo",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(26, 15, 15),
					CFrame = sPos * CFrame.new(0, 13, 0) * CFrame.Angles(0, 0, math.rad(90)),
					Color = Color3.fromRGB(196, 190, 178),
					Material = Enum.Material.Metal,
					CanCollide = true,
					Parent = props,
				})
				part({
					Name = "SiloTecho",
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(15.5, 8, 15.5),
					CFrame = sPos * CFrame.new(0, 25.4, 0),
					Color = Color3.fromRGB(150, 74, 58),
					Material = Enum.Material.Metal,
					CanCollide = true,
					Parent = props,
				})
			end
		end

		makeHayProp(base * CFrame.new(-W * 0.24, 0.6, -D * 0.2), "Pajar")
		makeHayProp(base * CFrame.new(W * 0.24, 0.6, -D * 0.22), "Pajar")
		makeCrateProp(base * CFrame.new(W * 0.2, 0.6, D * 0.26), Vector3.new(5, 4.6, 5), wood)
		makeCrateProp(base * CFrame.new(W * 0.03, 0.6, D * 0.3), Vector3.new(4, 3.6, 4), wood)
		makeBarrelHide(base * CFrame.new(-W * 0.36, 0.6, D * 0.3), "Barril")
		makeChestProp(base * CFrame.new(-W * 0.04, 0.6, -D * 0.34), "Baúl del granero")

		addSpot("granero", "Granero", floorPart, (base * CFrame.new(-W * 0.3, 0, -D * 0.32)).Position, 3.0, 0.9)
		addSpot("granero", "Granero", floorPart, (base * CFrame.new(W * 0.3, 0, 0)).Position, 3.0, 0.9)
		addIndoor(base, Vector3.new(W - 2, wallH, D - 2))
	end

	-- ===============================================================
	-- Distribucion de props
	-- ===============================================================
	local occupied = {}

	local function freeSpot(minDist, margin)
		margin = margin or 34
		for _ = 1, 70 do
			local point = self:randomPoint(rng, half - margin)
			local ok = true
			for _, other in ipairs(occupied) do
				if (point - other).Magnitude &lt; minDist then
					ok = false
					break
				end
			end
			if ok then
				table.insert(occupied, point)
				return point
			end
		end
		return nil
	end

	-- Zona central despejada para que aparezca el kiwi
	table.insert(occupied, center + Vector3.new(0, 0, 0))

	if theme == "bosque" then
		for i = 1, 34 do
			local p = freeSpot(22)
			if p then
				makeBush(p)
			end
		end

		for i = 1, 16 do
			local p = freeSpot(24)
			if p then
				makeFern(p)
			end
		end

		for i = 1, 12 do
			local p = freeSpot(26)
			if p then
				makeLog(p)
			end
		end

		for i = 1, 15 do
			local p = freeSpot(26)
			if p then
				makeRocks(p)
			end
		end

		for i = 1, 12 do
			local p = freeSpot(28)
			if p then
				makeBurrow(p)
			end
		end

		for i = 1, 18 do
			local p = freeSpot(26)
			if p then
				makeGrassPatch(p)
			end
		end

		for i = 1, 40 do
			local p = freeSpot(18)
			if p then
				makeTree(p)
			end
		end
	elseif theme == "dunas" then
		for i = 1, 14 do
			local p = freeSpot(24)
			if p then
				makeCactus(p)
			end
		end

		for i = 1, 16 do
			local p = freeSpot(26)
			if p then
				makeDuneMound(p)
			end
		end

		for i = 1, 16 do
			local p = freeSpot(24)
			if p then
				makeRocks(p)
			end
		end

		for i = 1, 8 do
			local p = freeSpot(28)
			if p then
				makeBurrow(p)
			end
		end

		for i = 1, 6 do
			local p = freeSpot(26)
			if p then
				makeGrassPatch(p)
			end
		end
	elseif theme == "ciudad" then
		for i = 1, 14 do
			local p = freeSpot(22)
			if p then
				makeTree(p)
			end
		end

		for i = 1, 8 do
			local p = freeSpot(22)
			if p then
				makeBush(p)
			end
		end

		for i = 1, 14 do
			local p = freeSpot(20)
			if p then
				makeLampPost(p)
			end
		end

		for i = 1, 8 do
			local p = freeSpot(22)
			if p then
				makeBench(p)
			end
		end

		for i = 1, 6 do
			local p = freeSpot(26)
			if p then
				makeRocks(p)
			end
		end
	elseif theme == "costa" then
		for i = 1, 20 do
			local p = freeSpot(22)
			if p then
				makePalm(p)
			end
		end

		for i = 1, 10 do
			local p = freeSpot(22)
			if p then
				makeBush(p)
			end
		end

		for i = 1, 12 do
			local p = freeSpot(26)
			if p then
				makeLog(p)
			end
		end

		for i = 1, 10 do
			local p = freeSpot(26)
			if p then
				makeRocks(p)
			end
		end

		for i = 1, 10 do
			local p = freeSpot(26)
			if p then
				makeGrassPatch(p)
			end
		end
	elseif theme == "alpes" then
		for i = 1, 30 do
			local p = freeSpot(20)
			if p then
				makePine(p)
			end
		end

		for i = 1, 12 do
			local p = freeSpot(26)
			if p then
				makeRocks(p)
			end
		end

		for i = 1, 8 do
			local p = freeSpot(26)
			if p then
				makeLog(p)
			end
		end

		for i = 1, 6 do
			local p = freeSpot(28)
			if p then
				makeBurrow(p)
			end
		end
	end

	do
		local function freeSpotFallback(minDist, margins)
			for _, margin in ipairs(margins) do
				local point = freeSpot(minDist, margin)
				if point then
					return point
				end
			end
			return nil
		end

		local function faceCenter(point)
			return math.atan2(center.X - point.X, center.Z - point.Z)
		end

		local function placeNear(origin, gaps, minClear, build)
			local dir = rng:NextNumber(0, math.pi * 2)
			for _, gap in ipairs(gaps) do
				local cand = origin + Vector3.new(math.cos(dir) * gap, 0, math.sin(dir) * gap)
				if (cand - center).Magnitude &lt; half - 58 then
					local clear = true
					for _, other in ipairs(occupied) do
						if (Vector3.new(cand.X, 0, cand.Z) - Vector3.new(other.X, 0, other.Z)).Magnitude &lt; minClear then
							clear = false
							break
						end
					end
					if clear then
						table.insert(occupied, cand)
						build(cand)
						return cand
					end
				end
			end
			return nil
		end

		-- La aldea: casa, casona y granero (con interiores y baules)
		local anchor = freeSpotFallback(56, { 78, 56, 36, 22 })
		if anchor then
			makeHouse(anchor, faceCenter(anchor), "cabin")
			placeNear(anchor, { 48, 54, 60, 40 }, 46, function(cand)
				makeHouse(cand, faceCenter(cand), "farm")
			end)
			placeNear(anchor, { 56, 60, 66, 48 }, 50, function(cand)
				makeBarn(cand, faceCenter(cand))
			end)
		end

		-- Una casa mas lejos para variar el mapa
		local farHouse = freeSpotFallback(52, { 72, 52, 34, 20 })
		if farHouse then
			makeHouse(farHouse, faceCenter(farHouse), rng:NextNumber(0, 1) &lt; 0.5 and "cabin" or "farm")
		end

		-- La ciudad suma una casa mas y su torre mirador
		if theme == "ciudad" and anchor then
			placeNear(anchor, { 64, 74, 50, 36 }, 48, function(cand)
				makeHouse(cand, faceCenter(cand), "farm")
			end)
			local skySpot = freeSpotFallback(54, { 82, 60, 40, 24 })
			if skySpot then
				makeSkyTower(skySpot)
			end
		end

		-- Baules sueltos por el mapa
		for i = 1, 2 do
			local chestSpot = freeSpotFallback(30, { 60, 42, 26 })
			if chestSpot then
				makeChestProp(CFrame.new(chestSpot) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), "Baúl")
			end
		end

		-- Torre mirador de madera (en la ciudad la reemplaza la torre alta)
		if theme ~= "ciudad" then
			local towerPos = freeSpotFallback(44, { 70, 48, 30, 18 })
			if towerPos then
				makeTower(towerPos)
			end
		end
	end

	-- ===============================================================
	-- Spawns y punto de aparicion del kiwi
	-- ===============================================================
	for i = 1, 4 do
		local baseAngle = (i - 1) * math.pi * 0.5 + math.rad(45)
		local dist = half - 45
		-- Busca un angulo donde no haya props solidos cerca (roca, cabana, etc.)
		local bestAngle = baseAngle
		for attempt = 0, 11 do
			local angle = baseAngle + attempt * math.rad(9)
			local candidate = center + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			local clear = true
			for _, other in ipairs(occupied) do
				if (Vector3.new(other.X, 0, other.Z) - candidate).Magnitude &lt; 24 then
					clear = false
					break
				end
			end
			if clear then
				bestAngle = angle
				break
			end
		end
		local pos = center + Vector3.new(math.cos(bestAngle) * dist, 4, math.sin(bestAngle) * dist)
		table.insert(self.spawns, CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)))
	end

	self.kiwiSpawn = center + Vector3.new(rng:NextNumber(-45, 45), 0, rng:NextNumber(-45, 45))

	local sign = part({
		Name = "LetreroZona",
		Size = Vector3.new(1, 12, 22),
		CFrame = CFrame.new(center + Vector3.new(0, 6, -half + 26)),
		Color = Color3.fromRGB(42, 38, 34),
		Material = Enum.Material.WoodPlanks,
		CanCollide = true,
		Parent = folder,
	})
	billboardText(sign, zone.name, Color3.fromRGB(236, 230, 214), 16)

	-- Zona segura (meta del modo Colosal): el refugio circular del centro
	local zoneRadius = (cfg.SafeZone and cfg.SafeZone.radius) or 15
	local function zonePart(name, shape, size, cf, color, transparency)
		local piecePart = Instance.new("Part")
		piecePart.Name = name
		piecePart.Shape = shape
		piecePart.Size = size
		piecePart.CFrame = cf
		piecePart.Color = color
		piecePart.Material = Enum.Material.Neon
		piecePart.Transparency = transparency
		piecePart.Anchored = true
		piecePart.CanCollide = false
		piecePart.CanQuery = false
		piecePart.CanTouch = false
		piecePart.Parent = folder
		return piecePart
	end

	local zoneRing = zonePart("ZonaSegura", Enum.PartType.Cylinder,
		Vector3.new(0.3, zoneRadius * 2, zoneRadius * 2),
		CFrame.new(center + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(90, 110, 130), 0.4)

	local zoneBeam = zonePart("HazZona", Enum.PartType.Cylinder,
		Vector3.new(130, 3, 3),
		CFrame.new(center + Vector3.new(0, 65, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(120, 255, 190), 0.85)

	local zoneLight = Instance.new("PointLight")
	zoneLight.Name = "LuzZona"
	zoneLight.Color = Color3.fromRGB(120, 255, 190)
	zoneLight.Range = 42
	zoneLight.Brightness = 0
	zoneLight.Parent = zoneRing

	local zoneLabelPart = Instance.new("Part")
	zoneLabelPart.Name = "RotuloZona"
	zoneLabelPart.Size = Vector3.new(1, 1, 1)
	zoneLabelPart.CFrame = CFrame.new(center + Vector3.new(0, 7, 0))
	zoneLabelPart.Transparency = 1
	zoneLabelPart.Anchored = true
	zoneLabelPart.CanCollide = false
	zoneLabelPart.CanQuery = false
	zoneLabelPart.CanTouch = false
	zoneLabelPart.Parent = folder

	local zoneGui = Instance.new("BillboardGui")
	zoneGui.Name = "RotuloZona"
	zoneGui.Size = UDim2.fromScale(14, 3)
	zoneGui.AlwaysOnTop = true
	zoneGui.Parent = zoneLabelPart

	local zoneLabel = Instance.new("TextLabel")
	zoneLabel.Size = UDim2.fromScale(1, 1)
	zoneLabel.BackgroundTransparency = 1
	zoneLabel.Font = Enum.Font.GothamBlack
	zoneLabel.TextScaled = true
	zoneLabel.TextColor3 = Color3.fromRGB(150, 200, 220)
	zoneLabel.TextStrokeTransparency = 0.25
	zoneLabel.Text = "ZONA SEGURA (se activa mas tarde)"
	zoneLabel.Parent = zoneGui

	self.safeZone = {
		center = center,
		radius = zoneRadius,
		active = false,
		ring = zoneRing,
		beam = zoneBeam,
		light = zoneLight,
		label = zoneLabel,
	}

	return self
end

-- ===============================================================
-- API principal
-- ===============================================================
function WorldBuilder.build(cfg)
	-- Mapas aleatorios: cada servidor arma una reserva distinta
	local seed = cfg.World.Seed or 1
	if cfg.World.RandomMaps ~= false then
		seed = seed * 7919 + os.time() % 1000003 + math.random(0, 9999)
	end
	local rng = Random.new(seed)

	local root = Instance.new("Folder")
	root.Name = "KiwiWorld"
	root.Parent = workspace

	local lobby = buildLobby(cfg, root, rng)

	local arenas = {}
	for i = 1, cfg.World.ArenaCount do
		local zone = cfg.Zones[((i - 1) % #cfg.Zones) + 1]
		arenas[i] = buildArena(i, zone, cfg, root, rng)
	end

	-- Iluminacion de reserva natural
	local Lighting = game:GetService("Lighting")
	Lighting.Brightness = 2.6
	Lighting.ClockTime = 15.5
	Lighting.GeographicLatitude = -41.5
	Lighting.Ambient = Color3.fromRGB(82, 88, 96)
	Lighting.OutdoorAmbient = Color3.fromRGB(122, 132, 140)
	Lighting.FogColor = Color3.fromRGB(178, 198, 205)
	Lighting.FogEnd = 1400
	Lighting.FogStart = 320
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.35

	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.28
		atmosphere.Offset = 0.15
		atmosphere.Color = Color3.fromRGB(210, 220, 225)
		atmosphere.Decay = Color3.fromRGB(106, 112, 116)
		atmosphere.Glare = 0.25
		atmosphere.Haze = 1.1
		atmosphere.Parent = Lighting
	end

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.45
	bloom.Size = 22
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	return {
		root = root,
		lobby = lobby,
		arenas = arenas,
	}
end

return WorldBuilder
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX014">
					<Properties>
						<string name="Name">KiwiModel</string>
						<ProtectedString name="Source">--[[
	KiwiModel.lua  (servidor)
	Construye el kiwi usando puras Parts (sin meshes ni animaciones
	externas) y expone :update() para posarlo cuadro a cuadro.

	El modelo mira hacia -Z, que es la direccion "adelante" de Roblox,
	asi que funciona directo con CFrame.lookAt().
--]]

local KiwiModel = {}
KiwiModel.__index = KiwiModel

local COLORS = {
	body = Color3.fromRGB(112, 84, 62),
	head = Color3.fromRGB(122, 94, 70),
	beak = Color3.fromRGB(216, 196, 168),
	leg = Color3.fromRGB(198, 172, 138),
	eye = Color3.fromRGB(22, 18, 16),
}

local BODY_SIZE = Vector3.new(2.2, 2.1, 2.9)
local HEAD_OFFSET = Vector3.new(0, 0.80, -1.15)
local HEAD_SIZE = Vector3.new(1.5, 1.35, 1.5)
local LEG_LENGTH = 1.0
local HIP_OFFSET = Vector3.new(0.5, -0.70, 0.10)

-- Altura a la que debe ir el centro del cuerpo para que las patas toquen el suelo
KiwiModel.RideHeight = 1.78

local function piece(className, name, size, color, material, shape, parent)
	local part = Instance.new(className)
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = true
	part.CanTouch = false
	if shape then
		part.Shape = shape
	end
	if part:IsA("Part") then
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
	end
	part.Parent = parent
	return part
end

function KiwiModel.build(parent, scale)
	local self = setmetatable({}, KiwiModel)
	local S = scale or 1

	local model = Instance.new("Model")
	model.Name = "Kiwi"
	model.Parent = parent

	local body = piece("Part", "Cuerpo", BODY_SIZE * S, COLORS.body, Enum.Material.Fabric, Enum.PartType.Ball, model)
	local head = piece("Part", "Cabeza", HEAD_SIZE * S, COLORS.head, Enum.Material.Fabric, Enum.PartType.Ball, model)
	local beak = piece("Part", "Pico", Vector3.new(1.25, 0.26, 0.26) * S, COLORS.beak, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, model)

	local eyes = {}
	for i = 1, 2 do
		local eye = piece("Part", "Ojo" .. i, Vector3.new(0.26, 0.26, 0.26) * S, COLORS.eye, Enum.Material.SmoothPlastic, Enum.PartType.Ball, model)
		eyes[i] = eye
	end

	local legs = {}
	for i = 1, 2 do
		local side = (i == 1) and -1 or 1
		local legPart = piece("Part", "Pata" .. i, Vector3.new(0.18 * S, LEG_LENGTH * S, 0.18 * S), COLORS.leg, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder, model)
		legPart.Shape = Enum.PartType.Block
		local foot = piece("Part", "Pie" .. i, Vector3.new(0.42, 0.14, 0.78) * S, COLORS.leg, Enum.Material.SmoothPlastic, Enum.PartType.Block, model)
		legs[i] = {
			part = legPart,
			foot = foot,
			hip = Vector3.new(HIP_OFFSET.X * side * S, HIP_OFFSET.Y * S, HIP_OFFSET.Z * S),
			phaseOffset = (i == 1) and 0 or math.pi,
		}
	end

	-- Cola: un mechon chiquito, los kiwis no tienen cola de verdad
	local tail = piece("Part", "Cola", Vector3.new(0.8, 0.4, 0.5) * S, COLORS.body, Enum.Material.Fabric, Enum.PartType.Ball, model)

	local parts = { body, head, beak, eyes[1], eyes[2], legs[1].part, legs[1].foot, legs[2].part, legs[2].foot, tail }

	self.model = model
	self.body = body
	self.head = head
	self.beak = beak
	self.eyes = eyes
	self.legs = legs
	self.tail = tail
	self.parts = parts
	self.scale = S
	self.legLength = LEG_LENGTH * S
	self.rideHeight = KiwiModel.RideHeight * S

	model.PrimaryPart = body
	self:setVisible(false)
	return self
end

--[[
	Visibilidad / interaccion. Cuando el kiwi esta escondido se vuelve
	invisible y deja de ser detectable por rayos (los dardos pasan de largo).
--]]
function KiwiModel:setVisible(visible, camoAlpha)
	self.visible = visible
	local alpha = 0
	if not visible then
		alpha = camoAlpha or 1
	end
	for _, part in ipairs(self.parts) do
		part.Transparency = alpha
		part.CanQuery = visible
	end
	self.body.CanTouch = false
end

function KiwiModel:setTouchable(touchable)
	self.body.CanTouch = touchable
end

function KiwiModel:setColorTint(color)
	self.body.Color = color
	self.head.Color = color
	self.tail.Color = color
end

function KiwiModel:getPosition()
	return self.body.CFrame.Position
end

--[[
	update(rootCF, pose)
	rootCF : CFrame del centro del cuerpo (posicion + giro + balanceo)
	pose   : {
		phase     = angulo de animacion de las patas,
		legSwing  = 0..1 amplitud del paso,
		headPitch = radianes (positivo = mira al suelo),
		legFold   = 0..1 patas encogidas (dormido),
		beak      = radianes (abre el pico al comer),
	}
--]]
function KiwiModel:update(rootCF, pose)
	pose = pose or {}
	local S = self.scale or 1

	local bodyCF = rootCF
	self.body.CFrame = bodyCF
	self.tail.CFrame = bodyCF * CFrame.new(0, 0.15 * S, 1.45 * S)

	local legSwing = pose.legSwing or 0
	local legFold = pose.legFold or 0

	local headCF = bodyCF * CFrame.new(HEAD_OFFSET * S) * CFrame.Angles(pose.headPitch or 0, 0, 0)
	self.head.CFrame = headCF
	self.beak.CFrame = headCF * CFrame.new(0, -0.16 * S, -0.72 * S) * CFrame.Angles(math.rad(-12), math.rad(90), 0)
		* CFrame.Angles(0, pose.beak or 0, 0)
	self.eyes[1].CFrame = headCF * CFrame.new(-0.42 * S, 0.16 * S, -0.52 * S)
	self.eyes[2].CFrame = headCF * CFrame.new(0.42 * S, 0.16 * S, -0.52 * S)

	for _, leg in ipairs(self.legs) do
		local angle = math.sin((pose.phase or 0) + leg.phaseOffset) * legSwing
		local hip = bodyCF * CFrame.new(leg.hip)
		local full = hip * CFrame.Angles(angle, 0, 0)
		local length = self.legLength * (1 - 0.45 * legFold)
		leg.part.CFrame = full * CFrame.new(0, -length * 0.5, 0)
		leg.part.Size = Vector3.new(0.18 * S, length, 0.18 * S)
		leg.foot.CFrame = full * CFrame.new(0, -length, -0.16 * S)
	end
end

function KiwiModel:destroy()
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
end

return KiwiModel
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX015">
					<Properties>
						<string name="Name">KiwiController</string>
						<ProtectedString name="Source">--[[
	KiwiController.lua  (servidor)
	El cerebro del kiwi: percibe jugadores, se esconde, huye, se cansa
	y se duerme con el tranquilizante.

	Maquina de estados:
		wander  -&gt; camina tranquilo (a veces rumbo a un escondite)
		flee    -&gt; corre asustado hacia un escondite lejano (gasta energia)
		tired   -&gt; se cansa, camina lento y es facil de alcanzar
		hidden  -&gt; adentro de un escondite, invisible
		sedated -&gt; dormido por un dardo
		caught  -&gt; capturado, fin de la historia
--]]

local Players = game:GetService("Players")

local KiwiModel = require(script.Parent.KiwiModel)

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)

local KiwiController = {}
KiwiController.__index = KiwiController

local WHISKER_ANGLES = { 0, math.rad(38), math.rad(-38), math.rad(75), math.rad(-75) }

local function clamp(v, min, max)
	if v &lt; min then
		return min
	elseif v &gt; max then
		return max
	end
	return v
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function rotateFlat(dir, radians)
	local cos, sin = math.cos(radians), math.sin(radians)
	return Vector3.new(dir.X * cos - dir.Z * sin, 0, dir.X * sin + dir.Z * cos)
end

function KiwiController.new(arena, kiwiCfg, rng, callbacks, opts)
	local self = setmetatable({}, KiwiController)

	opts = opts or {}
	self.arena = arena
	self.cfg = kiwiCfg
	self.rng = rng or Random.new()
	self.callbacks = callbacks or {}
	self.brain = opts.brain or "hider"
	self.giant = self.brain == "seeker"

	self.rig = KiwiModel.build(arena.folder, opts.scale)
	self.model = self.rig.model
	self.rideHeight = self.rig.rideHeight or KiwiModel.RideHeight

	self.pos = arena.kiwiSpawn or arena.center
	self.pos = Vector3.new(self.pos.X, arena.floorY + self.rideHeight, self.pos.Z)
	self.facing = Vector3.new(0, 0, 1)
	self.lastGroundY = arena.floorY
	self.animPhase = 0
	self.alert = 0
	self.stamina = kiwiCfg.stamina or 10
	self.state = "wander"
	self.stateTime = 0
	self.hideTimer = 0
	self.noHideTimer = 0
	self.sedateLeft = 0
	self.spotIndex = nil
	self.lastSpotIndex = nil
	self.goalSpot = nil
	self.goalPos = self.pos
	self.threat = nil
	self.threatDist = math.huge
	self.defeated = false
	self.travelTime = 0
	self.playersInArena = {}
	self.goalBait = nil
	self.baitTimer = 0
	self.trapTimer = 0
	self.trapScare = 0
	self.slowLeft = 0
	self.slowFactor = 1
	self.searchQueue = nil
	self.biteIndex = 0
	self.huntUntil = 0
	self.roarAt = 0
	self.sniffIndex = nil
	self.sniffUntil = 0
	self.sniffStep = 0

	self.moveParams = RaycastParams.new()
	self.moveParams.FilterType = Enum.RaycastFilterType.Include
	self.moveParams.FilterDescendantsInstances = { arena.ground, arena.propsFolder }
	self.moveParams.IgnoreWater = true

	-- Cartelito de "Z z z" cuando esta dormido
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Dormido"
	billboard.Size = UDim2.fromScale(6, 3)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.6 * (opts.scale or 1), 0)
	billboard.AlwaysOnTop = false
	billboard.Enabled = false
	billboard.Parent = self.rig.body

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(235, 240, 255)
	label.TextStrokeTransparency = 0.2
	label.Text = "z Z z"
	label.Parent = billboard
	self.sleepGui = billboard

	self.touchConn = self.rig.body.Touched:Connect(function(hit)
		if self.state ~= "sedated" or self.defeated then
			return
		end
		local character = hit and hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and self.callbacks.onTouchCapture then
			self.callbacks.onTouchCapture(self, player)
		end
	end)

	if self.brain == "seeker" then
		self:applyGiantLook()
		self.rig:setVisible(true)
		self.state = "patrol"
		self.goalPos = self:randomPointInArena()
	else
		self:goWander()
	end
	return self
end

-- ===============================================================
-- Consultas
-- ===============================================================
function KiwiController:isHidden()
	return self.state == "hidden"
end

function KiwiController:isSedated()
	return self.state == "sedated"
end

function KiwiController:getPosition()
	return self.pos
end

function KiwiController:getStateHint()
	if self.brain == "seeker" then
		if self.slowLeft &gt; 0 then
			return "¡ralentizado!"
		elseif self.state == "eat" then
			return "comiéndose a alguien"
		elseif self.state == "sniff" then
			return "husmeando un escondite"
		elseif self.state == "hunt" then
			return "te anda buscando"
		elseif self.state == "busy" then
			return "satisfecho"
		end
		return "paseando"
	end
	if self.defeated then
		return "capturado"
	elseif self.state == "hidden" then
		return "escondido"
	elseif self.state == "sedated" then
		return "dormido"
	elseif self.state == "flee" then
		return "huyendo"
	elseif self.state == "tired" then
		return "cansado"
	elseif self.state == "trapped" then
		return "¡atrapado en una fruta!"
	end
	return "al acecho"
end

function KiwiController:setState(state)
	if self.state == state then
		return
	end
	self.state = state
	self.stateTime = 0
	if self.callbacks.onStateChange then
		self.callbacks.onStateChange(self, state)
	end
end

function KiwiController:emit(kind, data)
	if self.callbacks.onEvent then
		self.callbacks.onEvent(kind, data or {})
	end
end

-- ===============================================================
-- Percepcion
-- ===============================================================
function KiwiController:sense(dt, players)
	local cfg = self.cfg
	local threat, threatDist = nil, math.huge

	for _, p in ipairs(players) do
		local d = (p.pos - self.pos).Magnitude
		if d &lt; threatDist then
			threat, threatDist = p, d
		end
	end
	self.threat = threat
	self.threatDist = threatDist

	local stimulus = 0
	if threat then
		local dist = threatDist
		local radius = cfg.detectionRadius
		local visual = 0

		if dist &lt;= radius then
			local toPlayer = (threat.pos - self.pos).Magnitude &gt; 0.01
				and (threat.pos - self.pos).Unit or Vector3.new(0, 0, 1)
			local facing = flat(self.facing).Magnitude &gt; 0.01 and flat(self.facing).Unit or Vector3.new(0, 0, 1)
			local dot = facing:Dot(flat(toPlayer))
			local limit = math.cos(math.rad(cfg.fieldOfView * 0.5))
			if dot &gt;= limit or dist &lt; radius * 0.35 then
				visual = 1 - (dist / radius)
			end
		end

		local audio = 0
		if threat.noise &gt; 0.05 then
			local hearRange = radius * 1.5
			audio = threat.noise * math.max(0, 1 - (dist / hearRange))
		end

		stimulus = math.max(visual, audio)
	end

	if stimulus &gt; 0.001 then
		self.alert = math.min(1, self.alert + stimulus * cfg.alertGain * 3 * dt)
	else
		self.alert = math.max(0, self.alert - cfg.alertDecay * dt)
	end
end

function KiwiController:panicRadius()
	local noise = self.threat and self.threat.noise or 0
	return self.cfg.flushBase + noise * 12
end

-- ===============================================================
-- Movimiento
-- ===============================================================
function KiwiController:groundY(pos)
	-- Rayo corto justo arriba del kiwi: si mira desde muy arriba "engancha"
	-- techos o pisos altos (casas de dos pisos) y se teletransporta arriba.
	local origin = Vector3.new(pos.X, pos.Y + 2.2, pos.Z)
	local result = workspace:Raycast(origin, Vector3.new(0, -70, 0), self.moveParams)
	if result then
		self.lastGroundY = result.Position.Y
	end
	return self.lastGroundY
end

function KiwiController:whiskers(dir)
	local reach = 4.6 * math.max(1, (self.rig.scale or 1) * 0.55)
	local origin = self.pos + Vector3.new(0, 1.6 * (self.rig.scale or 1), 0)
	for _, angle in ipairs(WHISKER_ANGLES) do
		local probe = rotateFlat(dir, angle)
		local hit = workspace:Raycast(origin, probe * reach, self.moveParams)
		if not hit then
			return probe
		end
	end
	-- Todo bloqueado: seguimos derecho. El kiwi es chico y puede colarse;
	-- girar en redondo aqui solo lo dejaria trabado.
	return nil
end

function KiwiController:currentSpeed()
	local speed
	if self.brain == "seeker" then
		if self.state == "hunt" then
			speed = self.cfg.huntSpeed or 26
		else
			speed = self.cfg.patrolSpeed or 12
		end
	elseif self.state == "flee" then
		speed = self.cfg.fleeSpeed
	elseif self.state == "tired" then
		speed = self.cfg.tiredSpeed
	else
		speed = self.cfg.wanderSpeed
	end
	if self.slowLeft &gt; 0 then
		speed = speed * self.slowFactor
	end
	return speed
end

function KiwiController:moveToward(goal, speed, dt)
	local toGoal = flat(goal - self.pos)
	local dist = toGoal.Magnitude
	if dist &lt; 1.6 then
		return true
	end

	local dir = toGoal.Unit
	local avoid = self:whiskers(dir)
	local finalDir = dir
	if avoid ~= nil and avoid ~= dir then
		finalDir = dir:Lerp(flat(avoid), 0.85)
		if finalDir.Magnitude &gt; 0.01 then
			finalDir = finalDir.Unit
		else
			finalDir = flat(avoid)
		end
	end

	-- Separacion del jugador mas cercano: instinto de no chocar con el.
	-- (El kiwi gigante si quiere chocar: persigue a proposito.)
	if self.brain ~= "seeker" and self.threat and self.threatDist &lt; 12 then
		local away = flat(self.pos - self.threat.pos)
		if away.Magnitude &gt; 0.01 then
			finalDir = (finalDir + away.Unit * 0.9)
			if finalDir.Magnitude &gt; 0.01 then
				finalDir = finalDir.Unit
			else
				finalDir = away.Unit
			end
		end
	end

	self.pos = self.arena:clampToBounds(self.pos + finalDir * speed * dt)
	local gy = self:groundY(self.pos)
	self.pos = Vector3.new(self.pos.X, gy + self.rideHeight, self.pos.Z)

	-- Giro suave hacia la direccion de movimiento
	local blend = math.min(1, dt * 6)
	local newFacing = flat(self.facing):Lerp(finalDir, blend)
	if newFacing.Magnitude &gt; 0.01 then
		self.facing = newFacing.Unit
	end

	return false
end

-- ===============================================================
-- Escondites
-- ===============================================================
function KiwiController:chooseSpot(needsClear)
	local bestIndex, bestScore = nil, -math.huge

	for index, spot in ipairs(self.arena.spots) do
		local clear = true
		local nearestPlayer = math.huge
		for _, p in ipairs(self.playersInArena or {}) do
			local d = (p.pos - spot.hidePoint).Magnitude
			if d &lt; nearestPlayer then
				nearestPlayer = d
			end
		end
		if nearestPlayer &lt; spot.radius + 14 then
			clear = false
		end
		if spot == self.arena.spots[self.spotIndex] then
			clear = false
		end

		if clear or not needsClear then
			local score = 0
			score = score - (spot.hidePoint - self.pos).Magnitude * 0.55
			score = score + spot.cover * 70 * self.cfg.coverPreference
			if index == self.lastSpotIndex then
				score = score - 18
			end
			if needsClear and clear then
				score = score + 40
			end
			if nearestPlayer &lt; 45 then
				score = score - (45 - nearestPlayer) * 1.2
			end
			score = score + self.rng:NextNumber() * 10
			if score &gt; bestScore then
				bestIndex, bestScore = index, score
			end
		end
	end

	return bestIndex
end

function KiwiController:randomPointInArena()
	local half = self.arena.halfSize - 30
	local angle = self.rng:NextNumber(0, math.pi * 2)
	local radius = self.rng:NextNumber(20, half)
	local point = self.arena.center + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	return self.arena:clampToBounds(point)
end

function KiwiController:goWander()
	self.goalBait = nil
	self:setRustle(self.spotIndex, false)
	-- Nunca se esconde donde hay un jugador parado al lado: si no hay
	-- ningun escondite limpio, camina a campo abierto (y es tu oportunidad).
	local spotIndex = self:chooseSpot(true)
	if spotIndex and self.noHideTimer &lt;= 0 and self.rng:NextNumber() &lt; 0.8 then
		local spot = self.arena.spots[spotIndex]
		self.goalSpot = spotIndex
		self.goalPos = spot.hidePoint
	else
		self.goalSpot = nil
		self.goalPos = self:randomPointInArena()
	end
	self.travelTime = 0
	self:setState("wander")
end

--[[
	Las particulas de "algo se mueve entre las hojas" viven en el
	escondite, asi que las prendemos y apagamos desde aca.
--]]
function KiwiController:setRustle(index, enabled)
	local spot = index and self.arena.spots[index]
	if spot and spot.emitter then
		spot.emitter.Enabled = enabled
	end
end

-- Salir del escondite por las buenas (se le acabo la paciencia)
function KiwiController:leaveSpot()
	self:setRustle(self.spotIndex, false)
	self.spotIndex = nil
	self.rig:setVisible(true)
	self.noHideTimer = math.max(self.noHideTimer, 0.5)
	self:emit("leave", { pos = self.pos })
	self:goWander()
end

-- Busca la fruta trampa mas cercana que valga la pena (sin jugadores pegados)
function KiwiController:findBait(players, baits)
	if not baits or (self.trapScare and self.trapScare &gt; 0) then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, bait in ipairs(baits) do
		if bait.armed then
			local d = (bait.pos - self.pos).Magnitude
			if d &lt; bestD then
				local clear = true
				for _, p in ipairs(players) do
					if (p.pos - bait.pos).Magnitude &lt; Config.Trampa.playerAvoid then
						clear = false
						break
					end
				end
				if clear then
					best, bestD = bait, d
				end
			end
		end
	end
	return best
end

-- Sale del escondite directo a la fruta (el hambre puede mas)
function KiwiController:leaveForBait(bait)
	self:setRustle(self.spotIndex, false)
	self.spotIndex = nil
	self.rig:setVisible(true)
	self.noHideTimer = math.max(self.noHideTimer, 1.5)
	self:emit("leave", { pos = self.pos })
	self.goalBait = bait
	self.goalSpot = nil
	self.goalPos = bait.pos
	self.travelTime = 0
	self:setState("wander")
end

-- Cayo en una fruta trampa: forcejea enganchado unos segundos y despues zafa
function KiwiController:trapHold(seconds)
	self.trapTimer = seconds
	self.goalBait = nil
	self.goalSpot = nil
	self.travelTime = 0
	self:setRustle(self.spotIndex, false)
	self.spotIndex = nil
	self.rig:setVisible(true)
	self.rig:setTouchable(true)
	self:setState("trapped")
end

function KiwiController:hide(index)
	local spot = self.arena.spots[index]
	if not spot then
		self:goWander()
		return
	end

	self:setRustle(self.spotIndex, false)
	self.spotIndex = index
	self.lastSpotIndex = index
	self.pos = spot.hidePoint
	self.hideTimer = self.rng:NextNumber(self.cfg.hideMin, self.cfg.hideMax)
	self.goalSpot = nil
	self.goalPos = self.pos
	self.alert = math.min(self.alert, 0.35)
	self.travelTime = 0
	self:setRustle(index, true)
	self.rig:setVisible(false)
	self:setState("hidden")
	self:emit("hide", { spot = spot, pos = self.pos })
end

function KiwiController:flush()
	local spot = self.arena.spots[self.spotIndex]
	self.spotIndex = nil
	self.noHideTimer = self.cfg.noHideAfterFlush
	self.alert = 1
	self:setRustle(spot and spot.id, false)
	self.rig:setVisible(true)
	self:emit("flush", { spot = spot, pos = self.pos })
	self:startFlee(self.threat)
end

-- ===============================================================
-- Huida / cansancio
-- ===============================================================
function KiwiController:startFlee(threat)
	self.goalBait = nil
	local bestIndex, bestScore = nil, -math.huge
	local threatPos = threat and threat.pos or (self.pos + self.facing * 50)

	for index, spot in ipairs(self.arena.spots) do
		-- Un escondite con gente encima no sirve de nada
		local nearestPlayer = math.huge
		for _, p in ipairs(self.playersInArena or {}) do
			local d = (p.pos - spot.hidePoint).Magnitude
			if d &lt; nearestPlayer then
				nearestPlayer = d
			end
		end

		if nearestPlayer &gt;= spot.radius + 10 then
			local away = (spot.hidePoint - threatPos).Magnitude
			local travel = (spot.hidePoint - self.pos).Magnitude
			local score = away * 1.0 - travel * 0.45 + spot.cover * 45 * self.cfg.coverPreference
			if index == self.spotIndex or index == self.lastSpotIndex then
				score = score - 30
			end
			score = score + self.rng:NextNumber() * 12
			if score &gt; bestScore then
				bestIndex, bestScore = index, score
			end
		end
	end

	if bestIndex and (self.arena.spots[bestIndex].hidePoint - threatPos).Magnitude &gt; 45 then
		self.goalSpot = bestIndex
		self.goalPos = self.arena.spots[bestIndex].hidePoint
	else
		-- Sin escondites libres: corre a campo abierto (y ahi lo ves)
		self.goalSpot = nil
		local away = flat(self.pos - threatPos)
		local dir = away.Magnitude &gt; 0.1 and away.Unit or Vector3.new(1, 0, 0)
		if self.rng:NextNumber() &lt; 0.5 then
			self.goalPos = self:randomPointInArena()
		else
			self.goalPos = self.arena:clampToBounds(self.pos + dir * 90)
		end
	end

	self.travelTime = 0
	self:setState("flee")
end

function KiwiController:staminaUpdate(dt)
	local cfg = self.cfg
	if self.state == "flee" then
		self.stamina = self.stamina - dt
		if self.stamina &lt;= 0 then
			self.stamina = 0
			self:setState("tired")
			self:emit("tired")
		end
	elseif self.state == "tired" then
		self.stamina = math.min(cfg.stamina, self.stamina + cfg.staminaRegen * 0.75 * dt)
		if self.stamina &gt;= cfg.stamina * 0.6 then
			self.goalSpot = nil
			self:goWander()
		end
	else
		self.stamina = math.min(cfg.stamina, self.stamina + cfg.staminaRegen * dt)
	end
end

-- ===============================================================
-- Dormir / capturar
-- ===============================================================
function KiwiController:sedate(seconds, player)
	if self.defeated or self.state == "sedated" then
		return false
	end

	self.rig:setVisible(true)
	self.rig:setTouchable(true)
	self.state = "sedated"
	self.stateTime = 0
	self.sedateLeft = seconds
	self.spotIndex = nil
	self.goalSpot = nil
	self.sleepGui.Enabled = true
	self.alert = 0
	if self.callbacks.onStateChange then
		self.callbacks.onStateChange(self, "sedated")
	end
	self:emit("sedate", { player = player })
	return true
end

function KiwiController:wake()
	self.sleepGui.Enabled = false
	self.rig:setTouchable(false)
	self.noHideTimer = 1.5
	self.alert = 1
	self.stamina = math.max(self.cfg.stamina * 0.45, 2)
	self:emit("wake")
	self:startFlee(self.threat)
end

function KiwiController:capture(player)
	if self.defeated then
		return false
	end
	self.defeated = true
	self.state = "caught"
	self.sleepGui.Enabled = false
	self.rig:setTouchable(false)
	self:setRustle(self.spotIndex, false)
	self.spotIndex = nil
	self.goalSpot = nil
	self:emit("capture", { player = player, pos = self.pos })
	return true
end

-- ===============================================================
-- Bucle principal
-- ===============================================================
function KiwiController:step(dt, players, baits)
	if self.defeated then
		return
	end

	self.playersInArena = players
	self.stateTime = self.stateTime + dt
	self.noHideTimer = math.max(0, self.noHideTimer - dt)

	if self.slowLeft &gt; 0 then
		self.slowLeft = self.slowLeft - dt
		if self.slowLeft &lt;= 0 then
			self.slowLeft = 0
			self:slowEnd()
		end
	end

	if self.brain == "seeker" then
		self:stepSeeker(dt, players)
		return
	end

	if self.state == "trapped" then
		self.trapTimer = self.trapTimer - dt
		-- Forcejea enganchado en la fruta (ventana para atraparlo)
		local wiggle = math.sin(self.stateTime * 22) * 0.25
		local cf = CFrame.lookAt(self.pos, self.pos + self.facing) * CFrame.Angles(0, wiggle, 0)
		self.rig:update(cf, {
			phase = self.stateTime * 8,
			legSwing = 0.55 * math.sin(self.stateTime * 18),
			headPitch = -0.15 + wiggle * 0.5,
		})
		if self.trapTimer &lt;= 0 then
			-- Zafo: escapa asustado y por un rato no vuelve a pisar fruta
			self.trapScare = Config.Trampa.escapeScare
			self.alert = 1.2
			self.rig:setTouchable(false)
			self:emit("trapescape", { pos = self.pos })
			self:startFlee(nil)
		end
		return
	end

	if self.state == "hidden" then
		local spot = self.arena.spots[self.spotIndex]
		if spot then
			-- adentro del escondite: pose quieta y a esperar
			local cf = CFrame.lookAt(self.pos, self.pos + self.facing)
			self.rig:update(cf, {
				phase = 0,
				legSwing = 0,
				headPitch = 0.2 + math.sin(self.stateTime * 1.6) * 0.15,
			})
		end

		self:sense(dt, players)
		self.hideTimer = self.hideTimer - dt

		-- El hambre puede mas: si hay fruta puesta, sale del escondite a comer
		self.baitTimer = self.baitTimer - dt
		if self.baitTimer &lt;= 0 and not (self.threat and self.threatDist &lt;= self:panicRadius()) then
			self.baitTimer = Config.Trampa.temptEvery
			local best = self:findBait(players, baits)
			if best then
				self:leaveForBait(best)
				return
			end
		end

		if self.threat and self.threatDist &lt;= self:panicRadius() then
			self:flush()
		elseif self.hideTimer &lt;= 0 then
			self:leaveSpot()
		end
		return
	end

	if self.state == "sedated" then
		self.sedateLeft = self.sedateLeft - dt
		self:sleepPose()
		if self.sedateLeft &lt;= 0 then
			self:wake()
		end
		return
	end

	self:sense(dt, players)
	self:staminaUpdate(dt)

	if self.state ~= "flee" and self.state ~= "tired" then
		if self.alert &gt;= 1 or (self.threat and self.threatDist &lt;= self.cfg.flushBase) then
			self:startFlee(self.threat)
		end
	end

	if self.trapScare &gt; 0 then
		self.trapScare = self.trapScare - dt
	end

	-- Hambre: de vez en cuando el kiwi huele las frutas trampa (mire donde mire)
	self.baitTimer = self.baitTimer - dt
	if self.state == "wander" and not self.goalBait and self.baitTimer &lt;= 0 then
		self.baitTimer = Config.Trampa.temptEvery
		local best = self:findBait(players, baits)
		if best then
			self.goalBait = best
			self.goalSpot = nil
			self.goalPos = best.pos
			self.travelTime = 0
		end
	end

	-- Si pasa bien cerca de una fruta, cae igual (sin importar a donde iba)
	if self.state == "wander" and not self.goalBait and baits then
		for _, bait in ipairs(baits) do
			if bait.armed and (bait.pos - self.pos).Magnitude &lt; Config.Trampa.catchDist then
				self:emit("trapcatch", { bait = bait, pos = self.pos })
				return
			end
		end
	end

	if self.goalBait then
		local bait = self.goalBait
		if not bait.armed or self.alert &gt;= 0.95 then
			self.goalBait = nil
			self:goWander()
		end
	end

	local speed = self:currentSpeed()
	self.travelTime = self.travelTime + dt
	if self.travelTime &gt; 26 then
		-- Se trabo en el camino (cerco, rocas, etc): cambia de plan
		self:goWander()
		return
	end

	local reached = self:moveToward(self.goalPos, speed, dt)

	-- Animacion de las patas proporcional a la velocidad
	local walkFactor = clamp(speed / 20, 0.25, 1.2)
	self.animPhase = self.animPhase + dt * (6 + speed * 0.55)
	local headPitch = 0.12 + (1 - self.alert) * 0.22 + math.sin(self.stateTime * 1.4) * 0.06
	local cf = CFrame.lookAt(self.pos, self.pos + self.facing)
	self.rig:update(cf, {
		phase = self.animPhase,
		legSwing = walkFactor * 0.7,
		headPitch = headPitch,
	})

	if reached then
		if self.goalBait then
			local bait = self.goalBait
			self.goalBait = nil
			self:emit("trapcatch", { bait = bait, pos = self.pos })
		elseif self.goalSpot and self.noHideTimer &lt;= 0 then
			self:hide(self.goalSpot)
		else
			self:goWander()
		end
	end
end

-- ===============================================================
-- Kiwi gigante (modo colosal): patrulla, huele a los cazadores y los atrapa
-- ===============================================================
function KiwiController:applyGiantLook()
	self.rig:setColorTint(Color3.fromRGB(92, 66, 50))
	for _, eye in ipairs(self.rig.eyes) do
		eye.Color = Color3.fromRGB(228, 60, 44)
		eye.Material = Enum.Material.Neon
	end
	local glow = self.rig.head:FindFirstChild("FuriaKiwi")
	if not glow then
		glow = Instance.new("PointLight")
		glow.Name = "FuriaKiwi"
		glow.Color = Color3.fromRGB(230, 70, 50)
		glow.Range = 26
		glow.Brightness = 1.6
		glow.Parent = self.rig.head
	end
end

--[[
	Ralentizador (Kiwi Colosal): el gigante no se duerme, se frena.
	Se marca con un tinte frio, ojos celestes y un cartel bien visible.
]]
function KiwiController:slow(factor, seconds)
	if self.defeated then
		return false
	end
	self.slowFactor = factor or 0.5
	self.slowLeft = seconds or 6

	if self.brain == "seeker" then
		self.rig:setColorTint(Color3.fromRGB(110, 150, 175))
		for _, eye in ipairs(self.rig.eyes) do
			eye.Color = Color3.fromRGB(140, 220, 240)
		end
	end

	local body = self.rig.body
	if body and not body:FindFirstChild("LetreroLento") then
		local gui = Instance.new("BillboardGui")
		gui.Name = "LetreroLento"
		gui.Size = UDim2.fromScale(9, 2.4)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 4.6 * (self.rig.scale or 1), 0)
		gui.AlwaysOnTop = true
		gui.Parent = body

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(140, 220, 240)
		label.TextStrokeTransparency = 0.2
		label.Text = "¡RALENTIZADO!"
		label.Parent = gui
	end

	self:emit("slow", { pos = self.pos })
	return true
end

function KiwiController:slowEnd()
	if self.brain == "seeker" then
		self:applyGiantLook()
	end
	local body = self.rig.body
	if body then
		local gui = body:FindFirstChild("LetreroLento")
		if gui then
			gui:Destroy()
		end
	end
	self:emit("slowend", { pos = self.pos })
end

function KiwiController:goPatrol()
	self.goalSpot = nil
	self.goalBait = nil
	self.goalPos = self:randomPointInArena()
	self.travelTime = 0
	self:setState("patrol")
end

--[[
	El jugador salio del escondite mientras el kiwi husmeaba: el premio
	es suyo, pero el gigante le sale al paso al instante (el "casi").
]]
function KiwiController:sniffMiss(chasePos)
	if self.state ~= "sniff" then
		return
	end
	local index = self.sniffIndex
	self.sniffIndex = nil
	self.sniffStep = 0
	self:setState("patrol")
	if chasePos then
		self:goHuntZone(chasePos)
	end
	self:emit("sniffmiss", { pos = self.pos, index = index })
end

--[[
	Busqueda inteligente: escondites cerca de una posicion, para husmear
	cuando el kiwi pierde el rastro de un cazador.
]]
function KiwiController:spotsNear(position, radius, maxCount)
	local list = {}
	for _, spot in ipairs(self.arena.spots) do
		local d = (spot.hidePoint - position).Magnitude
		if d &lt;= radius then
			table.insert(list, { spot = spot, d = d })
		end
	end
	table.sort(list, function(a, b)
		return a.d &lt; b.d
	end)
	local out = {}
	for index = 1, math.min(maxCount, #list) do
		table.insert(out, list[index].spot)
	end
	return out
end

--[[
	El kiwi no entra a la zona segura: ronda su borde esperando.
]]
function KiwiController:avoidSafeZone()
	local zone = self.arena and self.arena.safeZone
	if not zone or not zone.active then
		return
	end
	local offset = flat(self.pos - zone.center)
	local radius = zone.radius + 1.5
	if offset.Magnitude &lt; radius then
		local dir = offset.Magnitude &gt; 0.1 and offset.Unit or flat(self.facing)
		if dir.Magnitude &lt; 0.1 then
			dir = Vector3.new(1, 0, 0)
		end
		self.pos = Vector3.new(zone.center.X + dir.X * radius, self.pos.Y, zone.center.Z + dir.Z * radius)
	end
end

--[[
	Atraccion al refugio (el cazador esta cargando la zona segura).
]]
function KiwiController:goHuntZone(position)
	if self.defeated or self.state == "eat" then
		return
	end
	if self.state ~= "hunt" then
		self:setState("hunt")
		self.roarAt = 0
		self:emit("hunt", { pos = self.pos })
	end
	self.huntUntil = self.stateTime + 6
	self.goalPos = position
	self.searchQueue = nil
end

function KiwiController:stepSeeker(dt, players)
	local cfg = self.cfg

	if self.state == "eat" then
		-- Mordiscos de verdad: se yergue, se lanza hacia adelante y pica
		local t = self.stateTime
		local cycle = 0.86
		local phase = (t % cycle) / cycle
		local rear, strikeA = 0, 0
		if phase &lt; 0.38 then
			rear = phase / 0.38
		elseif phase &lt; 0.62 then
			strikeA = (phase - 0.38) / 0.24
		else
			strikeA = 1 - (phase - 0.62) / 0.38
		end

		local biteIndex = math.floor(t / cycle)
		if biteIndex ~= self.biteIndex then
			self.biteIndex = biteIndex
			self:emit("chomp", { pos = self.pos })
		end

		if self.eatTarget then
			local toTarget = flat(self.eatTarget - self.pos)
			local dist = toTarget.Magnitude
			if toTarget.Magnitude &gt; 0.5 then
				self.facing = toTarget.Unit
			end
			if dist &gt; 3.2 then
				self.pos = self.pos + toTarget.Unit * math.min(dist - 3.2, strikeA * 3.4 * dt)
			end
		end

		local lean = -0.30 * rear + 1.05 * strikeA
		local lift = 0.26 * rear - 0.20 * strikeA
		local base = self.pos + Vector3.new(0, lift, 0)
		local cf = CFrame.lookAt(base, base + self.facing)
		cf = cf * CFrame.Angles(lean, 0, math.sin(t * 24) * 0.05)
		self.rig:update(cf, {
			phase = 0,
			legSwing = 0.20 * strikeA,
			headPitch = 0.10 + 0.75 * strikeA,
			beak = 0.7 * strikeA,
		})

		if t &gt; (Config.Round.EatHold or 2.6) then
			self.eatTarget = nil
			self.biteIndex = 0
			self:goPatrol()
		end
		return
	end

	if self.state == "sniff" then
		local spot = self.arena.spots[self.sniffIndex]
		local done = self.stateTime &gt;= self.sniffUntil

		-- Se acerca al escondite y husmea pegado a la salida
		local toSpot = spot and flat(spot.hidePoint - self.pos) or Vector3.zero
		if toSpot.Magnitude &gt; 3.4 then
			self.pos = self.pos + toSpot.Unit * math.min(toSpot.Magnitude - 3.4, 11 * dt)
		end
		if toSpot.Magnitude &gt; 0.6 then
			self.facing = toSpot.Unit
		end

		local sniffCF = CFrame.lookAt(self.pos, self.pos + self.facing)
		sniffCF = sniffCF * CFrame.Angles(0, math.sin(self.stateTime * 7) * 0.10, 0)
		self.rig:update(sniffCF, {
			phase = 0,
			legSwing = 0.14 + 0.18 * math.sin(self.stateTime * 9),
			headPitch = 0.75 + math.sin(self.stateTime * 5.5) * 0.12,
			beak = 0.25 + math.max(0, math.sin(self.stateTime * 6)) * 0.4,
		})

		self.sniffStep = self.sniffStep + dt
		if self.sniffStep &gt;= 0.9 then
			self.sniffStep = 0
			self:emit("sniff", { pos = self.pos, index = self.sniffIndex })
		end

		if done then
			local entered = spot and spot.enter
			local wasIndex = self.sniffIndex
			self.sniffIndex = nil
			self.sniffStep = 0
			if entered and spot.occupied then
				-- Sigue escondido: lo encuentra y se lo come
				self.eatTarget = (entered.exit and entered.exit.Position) or spot.hidePoint
				self.biteIndex = 0
				self:setState("eat")
				self:emit("sniffcatch", { pos = self.pos, index = wasIndex, player = spot.occupied })
			else
				self:emit("sniffmiss", { pos = self.pos, index = wasIndex })
				self:goPatrol()
			end
		end
		return
	end

	-- Huele un escondite ocupado cerca: se queda husmeando un rato
	if self.state ~= "busy" and not self.defeated then
		for index, spot in ipairs(self.arena.spots) do
			if spot.enter and spot.occupied then
				local cooling = spot.sniffCooldownUntil and spot.sniffCooldownUntil &gt; os.clock()
				local zone = self.arena.safeZone
				local inZone = zone and zone.active and flat(spot.hidePoint - zone.center).Magnitude &lt; zone.radius + 4
				if not cooling and not inZone and (spot.hidePoint - self.pos).Magnitude &lt;= spot.radius + 6.5 then
					spot.sniffCooldownUntil = os.clock() + Config.Hide.sniffCooldown + Config.Hide.sniffTime
					self.sniffIndex = index
					self.sniffUntil = Config.Hide.sniffTime
					self.sniffStep = 0
					self.searchQueue = nil
					self.goalPos = self.pos
					self:setState("sniff")
					self:emit("sniffstart", { pos = self.pos, index = index, player = spot.occupied })
					break
				end
			end
		end
	end

	if self.state == "busy" then
		if self.stateTime &gt; 4 then
			self:goPatrol()
		else
			local cf = CFrame.lookAt(self.pos, self.pos + self.facing)
			self.rig:update(cf, { phase = 0, legSwing = 0, headPitch = -0.1 })
			return
		end
	end

	-- Percibe a los cazadores: menos distancia y mas ruido = mas facil de oler.
	-- Al jugador escondido no lo huele: hay que husmear el escondite.
	local target, targetDist = nil, math.huge
	local detect = cfg.detectRadius or 80
	local noiseRange = cfg.noiseRadius or 130
	for _, p in ipairs(players) do
		if not p.hidden then
			local d = (p.pos - self.pos).Magnitude
			local range = detect + (p.noise or 0) * (noiseRange - detect)
			if d &lt; range and d &lt; targetDist then
				target, targetDist = p, d
			end
		end
	end

	if target then
		if self.state ~= "hunt" then
			self:setState("hunt")
			self.roarAt = 0
			self:emit("hunt", { pos = self.pos })
		end
		self.huntUntil = self.stateTime + (cfg.loseInterest or 7)
		self.goalPos = target.pos
		self.searchQueue = nil
	elseif self.state == "hunt" and self.stateTime &gt; self.huntUntil then
		self:goPatrol()
	end

	if self.state == "hunt" and target then
		if self.stateTime &gt;= self.roarAt then
			self.roarAt = self.stateTime + (cfg.roarEvery or 18)
			self:emit("roar", { pos = self.pos })
		end
		if targetDist &lt;= (cfg.catchDist or 7) then
			self.eatTarget = target.pos
			self.biteIndex = 0
			local toVictim = flat(target.pos - self.pos)
			if toVictim.Magnitude &gt; 0.5 then
				self.facing = toVictim.Unit
			end
			self.goalPos = self.pos
			self:setState("eat")
			self.travelTime = 0
			self:emit("catch", { player = target.player, pos = self.pos })
			return
		end
	end

	local speed = self:currentSpeed()
	self.travelTime = self.travelTime + dt
	if self.travelTime &gt; 40 then
		self:goPatrol()
		return
	end

	local reached = self:moveToward(self.goalPos, speed, dt)
	self:avoidSafeZone()

	if reached and self.state == "hunt" then
		-- Perdio el rastro: husmea los escondites cercanos antes de rendirse
		if not self.searchQueue then
			self.searchQueue = self:spotsNear(self.goalPos, 170, 3)
		end
		local nextSpot = table.remove(self.searchQueue, 1)
		if nextSpot then
			self.goalPos = nextSpot.hidePoint
			self.travelTime = math.min(self.travelTime, 25)
		else
			self.searchQueue = nil
			self:goPatrol()
		end
	end

	local walkFactor = clamp(speed / 26, 0.3, 1.3)
	self.animPhase = self.animPhase + dt * (5 + speed * 0.5)
	local cf = CFrame.lookAt(self.pos, self.pos + self.facing)
	self.rig:update(cf, {
		phase = self.animPhase,
		legSwing = walkFactor * 0.85,
		headPitch = 0.10,
	})

	if reached and self.state == "patrol" then
		self:goPatrol()
	end
end

function KiwiController:sleepPose()
	local roll = math.sin(self.stateTime * 2) * 0.04
	local cf = CFrame.lookAt(self.pos - Vector3.new(0, 0.5, 0), self.pos - Vector3.new(0, 0.5, 0) + self.facing)
		* CFrame.Angles(0, 0, math.rad(72) + roll)
	self.rig:update(cf, {
		phase = 0,
		legSwing = 0,
		legFold = 1,
		headPitch = 0.5,
	})
end

function KiwiController:destroy()
	self:setRustle(self.spotIndex, false)
	if self.touchConn then
		self.touchConn:Disconnect()
		self.touchConn = nil
	end
	self.rig:destroy()
end

return KiwiController
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX016">
					<Properties>
						<string name="Name">ToolService</string>
						<ProtectedString name="Source">--[[
	ToolService.lua  (servidor)
	Fabrica las herramientas del cazador (red, rifle, rastreador,
trampa de fruta y rifle de pintura),
	se las entrega a los jugadores cuando arranca una partida y controla
	los tiempos de recarga de cada una.

	Las herramientas se guardan como plantillas en ServerStorage y se
	clonan al Backpack: asi nadie las tiene en el lobby.
--]]

local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local ToolService = {}

local TEMPLATE_FOLDER = "KiwiTools"
ToolService.cooldowns = {}

local function newHandle(props)
	props.Name = "Handle"
	props.Anchored = false
	props.CanCollide = false
	props.Massless = true
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	return Util.makePart(props)
end

-- Pieza extra pegada al mango (se mueve con el arma)
local function weldPiece(handle, props)
	props.Anchored = false
	props.CanCollide = false
	props.Massless = true
	props.TopSurface = Enum.SurfaceType.Smooth
	props.BottomSurface = Enum.SurfaceType.Smooth
	local piece = Util.makePart(props)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = piece
	weld.Parent = handle
	return piece
end

local function buildNet(parent)
	local tool = Instance.new("Tool")
	tool.Name = Config.Tools.red.name
	tool.ToolTip = Config.Tools.red.tooltip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ToolId", "red")
	tool.Grip = CFrame.new(0, -1.6, 0)

	local handle = newHandle({
		Size = Vector3.new(0.24, 4.6, 0.24),
		Color = Color3.fromRGB(140, 108, 70),
		Material = Enum.Material.Wood,
		Parent = tool,
	})

	-- Aro de la red
	weldPiece(handle, {
		Name = "Aro",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, 7, 7),
		CFrame = handle.CFrame * CFrame.new(0, 2.6, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(96, 160, 220),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.25,
		Parent = tool,
	})

	weldPiece(handle, {
		Name = "Malla",
		Size = Vector3.new(6.4, 0.18, 6.4),
		CFrame = handle.CFrame * CFrame.new(0, 2.6, 0),
		Color = Color3.fromRGB(232, 238, 245),
		Material = Enum.Material.Fabric,
		Transparency = 0.45,
		Parent = tool,
	})

	tool.Parent = parent
	return tool
end

local function buildRifle(parent)
	local tool = Instance.new("Tool")
	tool.Name = Config.Tools.rifle.name
	tool.ToolTip = Config.Tools.rifle.tooltip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ToolId", "rifle")
	tool.Grip = CFrame.new(0, -0.35, 0.5) * CFrame.Angles(math.rad(-90), 0, 0)

	local handle = newHandle({
		Size = Vector3.new(0.4, 0.7, 2.4),
		Color = Color3.fromRGB(94, 74, 54),
		Material = Enum.Material.Wood,
		Parent = tool,
	})

	weldPiece(handle, {
		Name = "Canon",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2.6, 0.28, 0.28),
		CFrame = handle.CFrame * CFrame.new(0, 0.22, -0.4) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(58, 60, 64),
		Material = Enum.Material.Metal,
		Parent = tool,
	})

	weldPiece(handle, {
		Name = "Mira",
		Size = Vector3.new(0.18, 0.5, 0.5),
		CFrame = handle.CFrame * CFrame.new(0, 0.6, -0.5),
		Color = Color3.fromRGB(210, 180, 90),
		Material = Enum.Material.Metal,
		Parent = tool,
	})

	weldPiece(handle, {
		Name = "Cargador",
		Size = Vector3.new(0.4, 1.1, 0.4),
		CFrame = handle.CFrame * CFrame.new(0, -0.7, 0.3),
		Color = Color3.fromRGB(74, 78, 84),
		Material = Enum.Material.Metal,
		Parent = tool,
	})

	tool.Parent = parent
	return tool
end

