	}, top)

	-- Vida grande abajo a la izquierda (estilo Counter)
	parts.hpBig = new("TextLabel", {
		Name = "VidaGrande",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -14),
