			BorderSizePixel = 0,
		}, tools)
		corner(6, chip)
		local name = new("TextLabel", {
			Name = "Nombre",
			Position = UDim2.new(0, 8, 0, 0),
			Size = UDim2.new(1, -70, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = info.color,
			Text = info.name,
		}, chip)
		local state = new("TextLabel", {
			Name = "Estado",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.new(0, 60, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = COLOR.muted,
			Text = "Listo",
		}, chip)
		local fill = new("Frame", {
			Name = "Carga",
			Position = UDim2.new(0, 0, 1, -3),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = info.color,
			BorderSizePixel = 0,
		}, chip)
		parts.toolChips[toolId] = { chip = chip, state = state, fill = fill }
		parts.toolChips[toolId].name = name
	end

	-- Brujula del rastreador
	local compass = new("Frame", {
		Name = "Brujula",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 100),
		Size = UDim2.new(0, 150, 0, 150),
		BackgroundTransparency = 1,
		Visible = false,
	}, hud)
	parts.compass = compass

	local ring = new("Frame", {
		Name = "Anillo",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLOR.panel,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
	}, compass)
	corner(999, ring)
	stroke(COLOR.accent, 2, 0.25, ring)

	-- Rosa de los vientos: las letras y marcas giran con la camara
	local marks = {}
	for _, entry in ipairs({ { "N", 0 }, { "E", 90 }, { "S", 180 }, { "O", 270 } }) do
		local label = new("TextLabel", {
			Name = "Cardinal" .. entry[1],
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 18, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = entry[1] == "N" and Color3.fromRGB(232, 108, 100) or COLOR.text,
			Text = entry[1],
		}, ring)
		table.insert(marks, { gui = label, azimuth = entry[2] })
	end
	for _, azimuth in ipairs({ 45, 135, 225, 315 }) do
		local tick = new("Frame", {
			Name = "Marca" .. azimuth,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 3, 0, 10),
			BackgroundColor3 = COLOR.muted,
			BorderSizePixel = 0,
		}, ring)
		table.insert(marks, { gui = tick, azimuth = azimuth })
	end
	parts.compassMarks = marks

	local needle = new("Frame", {
		Name = "Aguja",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 8, 0, 84),
		BackgroundColor3 = Color3.fromRGB(158, 165, 174),
		BorderSizePixel = 0,
		Rotation = 0,
	}, ring)
	corner(4, needle)
	local tip = new("Frame", {
		Name = "Punta",
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = COLOR.accent,
		BorderSizePixel = 0,
	}, needle)
	corner(4, tip)
	parts.needle = needle
	parts.needleTip = tip

	local hub = new("Frame", {
		Name = "Centro",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 12, 0, 12),
		BackgroundColor3 = Color3.fromRGB(30, 36, 44),
		BorderSizePixel = 0,
	}, ring)
	corner(999, hub)

	local distanceLabel = new("TextLabel", {
		Name = "Distancia",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 8),
		Size = UDim2.new(1, 40, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = COLOR.accent,
		Text = "",
	}, compass)
	parts.compassDistance = distanceLabel

	return hud
end

-- ===============================================================
-- MIRA ESTILO COUNTER (clic derecho)
-- El francotirador usa "vidrio": pantalla oscura con un circulo grande
-- y limpio. El tamaño se calcula segun la pantalla (poco negro).
-- ===============================================================
local function buildScope(parent)
	local scope = new("Frame", {
		Name = "Mira",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
	}, parent)
	parts.scope = scope

	-- Vidrio: cuatro barras oscuras redondeadas; el hueco central queda
	-- del tamaño del circulo (lo calcula layoutScope con la pantalla real)
	local vignette = new("Frame", {
		Name = "Vidrio",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 1,
	}, scope)
	parts.scopeVignette = vignette
	local bars = {}
	local function glassBar(name, key)
		local bar = new("Frame", {
			Name = name,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.12,
			BorderSizePixel = 0,
		}, vignette)
		corner(300, bar)
		bars[key] = bar
	end
	glassBar("Arriba", "up")
	glassBar("Abajo", "down")
	glassBar("Izquierda", "left")
	glassBar("Derecha", "right")
	parts.scopeBars = bars

	local ring = new("Frame", {
		Name = "Anillo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 180, 0, 180),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, scope)
	corner(999, ring)
	stroke(Color3.fromRGB(235, 240, 245), 2, 0.2, ring)
	parts.scopeRing = ring

	local ticks = {}
	local function tick(name, side)
		local item = new("Frame", {
			Name = name,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 2, 0, 30),
			BackgroundColor3 = Color3.fromRGB(235, 240, 245),
			BackgroundTransparency = 0.12,
			BorderSizePixel = 0,
		}, ring)
		table.insert(ticks, { frame = item, side = side })
	end
	tick("Arriba", "up")
	tick("Abajo", "down")
	tick("Izquierda", "left")
	tick("Derecha", "right")
	parts.scopeTicks = ticks

	local dot = new("Frame", {
		Name = "Punto",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 4, 0, 4),
		BackgroundColor3 = Color3.fromRGB(245, 250, 255),
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	}, ring)
	corner(999, dot)
	parts.scopeDot = dot

	-- Aumento actual de la telescopica (5x / 10x)
	parts.scopeZoom = new("TextLabel", {
		Name = "Aumento",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 104),
		Size = UDim2.new(0, 140, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = Color3.fromRGB(235, 240, 245),
		TextTransparency = 0.1,
		Text = "",
	}, scope)

	parts.scopeHint = new("TextLabel", {
		Name = "Etiqueta",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 126),
		Size = UDim2.new(0, 260, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(200, 210, 220),
		TextTransparency = 0.25,
		Text = "MIRA - clic derecho para cambiar / salir",
	}, scope)

	return scope
end

-- La mira se arma segun la pantalla: circulo grande y hueco del mismo
-- tamaño (bastante mas vision que antes, sin tanto negro)
local function layoutScope()
	local camera = workspace.CurrentCamera
	local vp = (camera and camera.ViewportSize) or Vector2.new(1920, 1080)
	local d = math.clamp(math.floor(math.min(vp.X, vp.Y) * 0.64), 320, 760)
	local half = d * 0.5

	if parts.scopeRing then
		parts.scopeRing.Size = UDim2.new(0, d, 0, d)
	end

	if parts.scopeBars then
		local thickY = math.clamp(0.5 - half / vp.Y, 0.04, 0.48)
		local thickX = math.clamp(0.5 - half / vp.X, 0.04, 0.48)
		local bars = parts.scopeBars
		bars.up.Size = UDim2.new(1, 0, thickY, 0)
		bars.up.Position = UDim2.new(0, 0, 0, 0)
		bars.down.Size = UDim2.new(1, 0, thickY, 0)
		bars.down.Position = UDim2.new(0, 0, 1 - thickY, 0)
		bars.left.Size = UDim2.new(thickX, 0, 1, 0)
		bars.left.Position = UDim2.new(0, 0, 0, 0)
		bars.right.Size = UDim2.new(thickX, 0, 1, 0)
		bars.right.Position = UDim2.new(1 - thickX, 0, 0, 0)
	end

	local off = math.floor(d * 0.40)
	local len = math.max(18, math.floor(d * 0.10))
	local thick = math.max(2, math.floor(d * 0.0075))
	for _, item in ipairs(parts.scopeTicks or {}) do
		local t = item.frame
		if item.side == "up" then
			t.Position = UDim2.new(0.5, 0, 0.5, -off)
			t.Size = UDim2.new(0, thick, 0, len)
		elseif item.side == "down" then
			t.Position = UDim2.new(0.5, 0, 0.5, off)
			t.Size = UDim2.new(0, thick, 0, len)
		elseif item.side == "left" then
			t.Position = UDim2.new(0.5, -off, 0.5, 0)
			t.Size = UDim2.new(0, len, 0, thick)
		else
			t.Position = UDim2.new(0.5, off, 0.5, 0)
			t.Size = UDim2.new(0, len, 0, thick)
		end
	end

	if parts.scopeDot then
		local dotSize = math.max(3, math.floor(d * 0.007))
		parts.scopeDot.Size = UDim2.new(0, dotSize, 0, dotSize)
	end

	if parts.scopeZoom then
		parts.scopeZoom.Position = UDim2.new(0.5, 0, 0.5, math.floor(half) + 16)
	end
	if parts.scopeHint then
		parts.scopeHint.Position = UDim2.new(0.5, 0, 0.5, math.floor(half) + 38)
	end
end

