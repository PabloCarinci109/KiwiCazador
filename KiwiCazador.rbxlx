	-- en el centro REAL de la pantalla.
	local cross = new("Frame", {
		Name = "PuntoMira",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 2, 0, 2),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
