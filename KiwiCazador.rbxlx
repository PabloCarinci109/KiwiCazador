		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 1.25, 1.25),
		CFrame = handle.CFrame * CFrame.new(0, 0.9, 0.75) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(48, 50, 46),
