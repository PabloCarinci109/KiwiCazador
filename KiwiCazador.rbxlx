	},
	trampa = {
		id = "trampa",
		name = "Trampa de Fruta",
		tooltip = "Click: deja una fruta trampa. El kiwi hambriento cae solo.",
		color = Color3.fromRGB(238, 130, 150),
	},
	pintura = {
		id = "pintura",
		name = "Rifle de Pintura",
