end

local function buildFlash()
	local model = { pieces = {} }
	piece(model, Vector3.new(0.38, 0.6, 0.38), CFrame.new(0, 0, 0), Color3.fromRGB(206, 208, 214))
	piece(model, Vector3.new(0.3, 0.16, 0.3), CFrame.new(0, 0.38, 0), Color3.fromRGB(120, 124, 132))
	piece(model, Vector3.new(0.12, 0.12, 0.12), CFrame.new(0, 0.52, 0), Color3.fromRGB(90, 94, 102))
	model.muzzle = Vector3.new(0, 0.4, -0.2)
	return model
end

local BUILDERS = {
	rifle = function() return buildRifle(nil, nil) end,
	pintura = function() return buildRifle(Color3.fromRGB(120, 84, 108), Color3.fromRGB(230, 120, 190)) end,
	relente = function() return buildRifle(Color3.fromRGB(96, 116, 126), Color3.fromRGB(110, 220, 235)) end,
	sniper = buildSniper,
	revolver = buildRevolver,
	arco = buildArco,
	cuchillo = buildCuchillo,
	lanzallamas = buildLanzallamas,
	cohete = buildCohete,
	-- Arsenal Counter Blox
	ak = buildAK,
	m4 = buildM4,
	mp5 = buildMP5,
	glock = buildGlock,
	escopeta = buildEscopeta,
	-- Granadas del pack de los baúles
	frag = buildFrag,
	humo = buildHumo,
	molotov = buildMolotov,
	flash = buildFlash,
}

-- ===============================================================
-- Carpeta viva (se recrea si cambia la camara)
-- ===============================================================
local function ensureFolder()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	if folder and folder.Parent ~= camera then
		folder:Destroy()
		folder = nil
		models = {}
		current = nil
		currentId = nil
		reparentDirty = true
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "VistaArmas"
		folder.Parent = camera
	end
	return folder
end

-- ===============================================================
-- API
-- ===============================================================
function ViewModel.setWeapon(id)
	if not id then
		if currentId then
			reparentDirty = true
		end
		currentId = nil
		current = nil
		return
	end
	if id == currentId then
		return
	end
	reparentDirty = true
	currentId = id
	current = nil
	if not BUILDERS[id] then
		return
	end
	ensureFolder()
	if not folder then
		return
	end
	if not models[id] then
		models[id] = BUILDERS[id]()
	end
	current = models[id]
	-- Al sacar el cuchillo mariposa se abre con un giro (estilo CS2)
	if id == "cuchillo" then
		FX = { kind = "draw", t = 0, dur = 0.85 }
		knifeOpen = 0
	end
	-- Fogonazo: una bolita neon en la boca del canon
	if current and not current.flash then
		local flash = piece(current, Vector3.new(0.72, 0.5, 0.5),
			CFrame.new(current.muzzle or Vector3.new(0, 0, -2)) * CFrame.Angles(0, math.rad(90), 0),
			Color3.fromRGB(255, 236, 168), Enum.Material.Neon, Enum.PartType.Cylinder)
		flash.Transparency = 1
		flash.CastShadow = false
		current.flash = flash
	end
	-- Deja la pose ya lista para que no se vea saltar
	ads = adsGoal
end

function ViewModel.setVisible(value)
	value = value and true or false
	if visible ~= value then
		visible = value
		reparentDirty = true
	end
end

function ViewModel.setAds(goal)
	adsGoal = math.clamp(goal or 0, 0, 1)
end

function ViewModel.setHidden(value)
	value = value and true or false
	if hiddenByScope ~= value then
		hiddenByScope = value
		reparentDirty = true
	end
end

function ViewModel.recoil(amount)
	recoil = math.min(1.2, recoil + (amount or 0.5))
	recoilRoll = (math.random() * 2 - 1) * 0.13 * (amount or 0.5)
end

-- Patada de camara estilo Counter Blox: sube de golpe y vuelve sola
function ViewModel.kickCamera(pitch, yaw)
	camKick = Vector2.new(camKick.X + (pitch or 0), camKick.Y + (yaw or 0))
end

function ViewModel.flash()
	flashTimer = 0.055
end

-- Inspeccion (tecla F): la mariposa da dos vueltas en la mano
function ViewModel.spin()
	if currentId == "cuchillo" and visible and not hiddenByScope then
		FX = { kind = "inspect", t = 0, dur = 1.1 }
	end
end

-- Zarpazo: el cuchillo barre de costado al atacar
function ViewModel.slash()
	if currentId == "cuchillo" and visible and not hiddenByScope then
		FX = { kind = "slash", t = 0, dur = 0.24 }
	end
end

-- Lanzar granada: el brazo va para adelante y suelta la granada
function ViewModel.toss()
	if visible and not hiddenByScope then
		FX = { kind = "toss", t = 0, dur = 0.3 }
	end
end

function ViewModel.hasWeapon(id)
	return BUILDERS[id or currentId] ~= nil
end

function ViewModel.getMuzzle()
	local camera = workspace.CurrentCamera
	if not camera or not current then
		return nil
	end
	local base = camera.CFrame * HIP:Lerp(ADS_POSES[currentId] or ADS, ads)
	local world = base * (current.muzzle or Vector3.new(0, 0, -2))
	return world, camera.CFrame.LookVector
end

-- ===============================================================
-- Bucle (despues de que la camara se mueve, asi no tiembla)
-- ===============================================================
local function stepUnbound(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	ads = ads + (adsGoal - ads) * math.min(dt * 11, 1)
	recoil = recoil * math.max(0, 1 - dt * 10)
	flashTimer = math.max(0, flashTimer - dt)

	local show = visible and current and not hiddenByScope
	-- Reacomodar piezas SOLO cuando algo cambio (no recorrer todo cada frame)
	if reparentDirty then
		reparentDirty = false
		for _, model in pairs(models) do
			local parent = (model == current and show) and folder or nil
			for _, item in ipairs(model.pieces) do
				if item.part.Parent ~= parent then
					item.part.Parent = parent
				end
			end
		end
	end

	local camCF = camera.CFrame

	-- Patada de camara (se aplica despues de que la camara se movio)
	if math.abs(camKick.X) &gt; 0.00002 or math.abs(camKick.Y) &gt; 0.00002 then
		local kicked = camCF * CFrame.Angles(camKick.X, camKick.Y, 0)
		camera.CFrame = kicked
		camCF = kicked
		camKick = camKick * math.max(0, 1 - dt * 10.5)
	end

	if not (current and show) then
		lastCamCF = camCF
		return
	end

	-- Inercia: el arma se atrasa un poco cuando giras la vista
	if lastCamCF then
		local look = camCF.LookVector
		local lastLook = lastCamCF.LookVector
		local yaw = math.atan2(look.X, look.Z) - math.atan2(lastLook.X, lastLook.Z)
		if yaw &gt; math.pi then
			yaw = yaw - math.pi * 2
		elseif yaw &lt; -math.pi then
			yaw = yaw + math.pi * 2
		end
		local pitch = math.asin(math.clamp(look.Y, -1, 1)) - math.asin(math.clamp(lastLook.Y, -1, 1))
		local interesting = Vector2.new(
			math.clamp(yaw * 6, -0.09, 0.09),
			math.clamp(pitch * 6, -0.09, 0.09))
		sway = sway:Lerp(interesting, math.min(dt * 9, 1))
	else
		sway = Vector2.new(0, 0)
	end

	-- Bamboleo al caminar
	local speed = 0
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local v = root.AssemblyLinearVelocity
		speed = math.sqrt(v.X * v.X + v.Z * v.Z)
	end
	bobPhase = bobPhase + dt * (4 + speed * 0.85)
	local bobAmt = math.clamp(speed / 16, 0, 1) * (1 - ads * 0.75)
	local bobX = math.cos(bobPhase) * 0.05 * bobAmt
	local bobY = math.abs(math.sin(bobPhase)) * 0.045 * bobAmt

	local base = camCF * HIP:Lerp(ADS_POSES[currentId] or ADS, ads)
		* CFrame.new(bobX + sway.X * 2.6, bobY + sway.Y * 2.2, recoil * 0.4)
	local final = base * CFrame.Angles(-sway.Y * 2.4 - recoil * 0.14, -sway.X * 2.4, recoilRoll * recoil * 1.3)

	-- Animacion del cuchillo mariposa: apertura al equipar, giro (F) y zarpazo
	local animCF = nil
	if FX.kind then
		FX.t = FX.t + dt
		local raw = math.clamp(FX.t / FX.dur, 0, 1)
		if FX.kind == "draw" then
			-- Apertura de mariposa: sale desde abajo, la muneca gira y la
			-- hoja se abre de un latigazo con un rebote corto al final
			local e = 1 - (1 - raw) ^ 2.2
			local rebote = math.sin(math.pi * math.min(raw * 1.6, 1)) * (1 - raw)
			animCF = CFrame.Angles(math.rad(8) * (1 - e), 0,
					math.rad(560) * (1 - e) + math.rad(18) * rebote)
				* CFrame.new(0, -0.44 * (1 - e) + 0.10 * math.sin(math.pi * e), 0.32 * (1 - e))
			local abre = math.clamp(e * 1.9, 0, 1)
			knifeOpen = math.min(1, abre + math.sin(abre * math.pi) * 0.14)
		elseif FX.kind == "slash" then
			local swipe = math.sin(math.pi * raw)
			animCF = CFrame.Angles(math.rad(-16 * swipe), math.rad(-150 * swipe), math.rad(30 * swipe))
				* CFrame.new(0, 0.05 * swipe, -0.35 * swipe)
		elseif FX.kind == "toss" then
			-- Tiro de granada: el brazo sube y va para adelante
			local swipe = math.sin(math.pi * raw)
			animCF = CFrame.Angles(math.rad(-52 * swipe), 0, math.rad(-18 * swipe))
				* CFrame.new(0, 0.12 * swipe, -0.5 * swipe)
		elseif FX.kind == "inspect" then
			-- Molinete: la mariposa da una vuelta y media, se pliega a mitad
			-- de giro (truco clasico) y se vuelve a abrir en la atajada
			local e = raw * raw * (3 - 2 * raw)
			local pliegue = math.sin(math.pi * raw)
			animCF = CFrame.Angles(0, math.rad(16) * math.sin(math.pi * 2 * raw),
					math.rad(540) * (1 - e))
				* CFrame.new(0, 0.16 * math.sin(math.pi * raw), 0.06 * pliegue)
			knifeOpen = 1 - pliegue * 0.9
		end
		if raw &gt;= 1 then
			FX.kind = nil
		end
	end
	-- Si un zarpazo interrumpio la apertura, la hoja termina de abrirse sola
	if FX.kind ~= "draw" and knifeOpen &lt; 1 then
		knifeOpen = math.min(1, knifeOpen + dt * 5)
	end

	-- El cuchillo abierto se mece apenas en la mano (vida propia)
	if currentId == "cuchillo" and not animCF and knifeOpen &gt;= 1 then
		animCF = CFrame.Angles(0, 0, math.rad(2.0) * math.sin(bobPhase * 0.45))
	end

	local posed = animCF and final * animCF or final
	for _, item in ipairs(current.pieces) do
		local cf = item.cf
		local anim = item.anim
		if anim and knifeOpen &lt; 1 then
			local rot = anim.closed:Lerp(CFrame.new(), knifeOpen)
			cf = CFrame.new(anim.pivot) * rot * CFrame.new(-anim.pivot) * cf
		end
		item.part.CFrame = posed * cf
	end

	-- Fogonazo: se ve un instante al disparar
	if current.flash then
		if flashTimer &gt; 0 then
			local s = 0.5 + math.random() * 0.4
			current.flash.Size = Vector3.new(0.72 * s, s, s)
			current.flash.Transparency = 0
		elseif current.flash.Transparency ~= 1 then
			current.flash.Transparency = 1
		end
	end

	lastCamCF = camCF
end

RunService:BindToRenderStep("KiwiVistaArmas", Enum.RenderPriority.Camera.Value + 1, stepUnbound)

return ViewModel
</ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX028">
						<Properties>
							<string name="Name">WeatherFX</string>
							<ProtectedString name="Source">--[[
	WeatherFX.lua  (cliente)
	Dibuja el clima del lado del jugador:

		- lluvia: rayas finas que caen alrededor de la camara
		  (parts locales: no viajan al servidor)
		- nieve: copos con particulas (textura de estrella)

	Lee los atributos que publica el servidor en el workspace:
		"Clima" (sol | lluvia | nieve) y "ClimaFuerza" (0 a 1).

	La luz, la niebla y la nieve acumulada del piso las maneja el
	servidor en Lighting; aca solo se ven los copos y las gotas.
--]]

local RunService = game:GetService("RunService")

local WeatherFX = {}

local RAIN_MAX = 90
local RAIN_RADIUS = 27    -- radio alrededor de la camara donde cae la lluvia
local RAIN_TOP = 22       -- altura sobre la camara donde nace la gota
local RAIN_BOTTOM = -9    -- a esta altura bajo la camara, la gota se recicla

local RAIN_COLOR = Color3.fromRGB(168, 190, 216)
local RAIN_TRANSPARENCY = 0.35

local started = false
local gotas = {}
local nube
local copos
local fuerza = 0

-- ===============================================================
-- Lluvia (rayas)
-- ===============================================================
local function nacimientoGota(g)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local base = camera.CFrame.Position
	local angulo = math.random() * math.pi * 2
	local radio = math.sqrt(math.random()) * RAIN_RADIUS
	g.parte.Position = Vector3.new(
		base.X + math.cos(angulo) * radio,
		base.Y + RAIN_TOP + math.random() * 10,
		base.Z + math.sin(angulo) * radio
	)
end

local function nuevaGota()
	local parte = Instance.new("Part")
	parte.Name = "GotaLluvia"
	parte.Size = Vector3.new(0.07, 0.8 + math.random() * 0.7, 0.07)
	parte.Color = RAIN_COLOR
	parte.Material = Enum.Material.SmoothPlastic
	parte.Transparency = 1
	parte.Anchored = true
	parte.CanCollide = false
	parte.CanQuery = false
	parte.CanTouch = false
	parte.CastShadow = false
	parte.Position = Vector3.new(0, -600, 0)
	parte.Parent = workspace
	local g = { parte = parte, vy = 80 + math.random() * 30 }
	nacimientoGota(g)
	return g
end

-- ===============================================================
-- Nieve (copos de particulas)
-- ===============================================================
local function armarNube()
	if nube and nube.Parent then
		return
	end
	nube = Instance.new("Part")
	nube.Name = "ClimaNube"
	nube.Size = Vector3.new(64, 2, 64) -- el "techo" del que caen los copos
	nube.Transparency = 1
	nube.Anchored = true
	nube.CanCollide = false
	nube.CanQuery = false
	nube.CanTouch = false
	nube.CastShadow = false
	nube.Parent = workspace

	copos = Instance.new("ParticleEmitter")
	copos.Name = "Copos"
	copos.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	copos.LightEmission = 0.35
	copos.LightInfluence = 0.45
	copos.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	copos.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.42),
		NumberSequenceKeypoint.new(1, 0.6),
	})
	copos.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12),
		NumberSequenceKeypoint.new(0.85, 0.4),
		NumberSequenceKeypoint.new(1, 0.85),
	})
	copos.Lifetime = NumberRange.new(7, 12)
	copos.Rate = 0
	copos.Speed = NumberRange.new(2.5, 5)
	copos.SpreadAngle = Vector2.new(14, 14)
	copos.Acceleration = Vector3.new(2.4, -2.2, 1.6)
	copos.Drag = 0.35
	copos.Rotation = NumberRange.new(0, 360)
	copos.RotSpeed = NumberRange.new(-42, 42)
	copos.VelocityInheritance = 0.05
	copos.EmissionDirection = Enum.NormalId.Bottom
	copos.Shape = Enum.ParticleEmitterShape.Box
	copos.Enabled = false
	copos.Parent = nube
end

-- ===============================================================
-- Cuadro a cuadro
-- ===============================================================
local function paso(dt)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local kind = workspace:GetAttribute("Clima") or "sol"
	local objetivo = workspace:GetAttribute("ClimaFuerza") or 0
	if kind == "sol" then
		objetivo = 0
	end
	fuerza = fuerza + (objetivo - fuerza) * math.min(1, dt * 4)

	-- Lluvia
	local activas = 0
	if kind == "lluvia" then
		activas = math.floor(RAIN_MAX * math.clamp(fuerza, 0, 1) + 0.5)
	end
	for i = 1, RAIN_MAX do
		local g = gotas[i]
		if not g then
			g = nuevaGota()
			gotas[i] = g
		end
		local parte = g.parte
		if i &lt;= activas then
			if parte.Transparency ~= RAIN_TRANSPARENCY then
				parte.Transparency = RAIN_TRANSPARENCY
			end
			parte.Position = parte.Position + Vector3.new(2.2 * dt, -g.vy * dt, 1.2 * dt)
			if parte.Position.Y &lt; camera.CFrame.Position.Y + RAIN_BOTTOM then
				nacimientoGota(g)
			end
		elseif parte.Transparency ~= 1 then
			parte.Transparency = 1
		end
	end

	-- Nieve
	if kind == "nieve" and fuerza &gt; 0.02 then
		armarNube()
		if nube and copos then
			nube.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 26, 0))
			copos.Enabled = true
			copos.Rate = 160 * math.clamp(fuerza, 0, 1)
		end
	elseif copos and copos.Enabled then
		copos.Enabled = false
		copos.Rate = 0
	end
end

function WeatherFX.start()
	if started then
		return
	end
	started = true
	RunService.RenderStepped:Connect(paso)
end

return WeatherFX
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
