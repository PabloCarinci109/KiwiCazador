	piece(model, Vector3.new(0.34, 0.8, 0.5), CFrame.new(0, -0.62, 0.28) * CFrame.Angles(math.rad(-16), 0, 0),
		Color3.fromRGB(96, 66, 42), Enum.Material.Wood)
