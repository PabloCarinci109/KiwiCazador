		Size = Vector3.new(1.7, 0.2, 0.2),
		CFrame = handle.CFrame * CFrame.new(0, 0.45, -0.75) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(184, 186, 200),
		Material = Enum.Material.Metal,
