		uses = 2,
		cooldown = 0.8,
		speed = 84, lift = 0.30,
		fuse = 1.5,
		-- Pide mas alcance y 5 segundos: radio 45, ceguera plena 5 s
		radius = 45, maxTime = 5,
	},
}

-- Lo que suelta cada baúl ademas del arma (el pack pedido):
-- 1 fragmentación, 1 humo, 1 molotov y 2 flashes
