-- Cuchillo mariposa: va de fabrica para todos (no es arma de baul).
-- Modelo abierto de balisong: dos mangos de acero alineados y la hoja
-- saliendo del pivote. La animacion estilo CS2 vive en la vista del cliente.
local function buildKnifeTool(parent)
	local tool = Instance.new("Tool")
	tool.Name = Config.Weapons.cuchillo.name
	tool.ToolTip = "Cuchillo mariposa: zarpazo corto. F para girarlo"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ToolId", "cuchillo")
	tool.Grip = CFrame.new(0, -0.4, 0.15) * CFrame.Angles(math.rad(-90), 0, 0)
	local acero = Color3.fromRGB(198, 204, 214)
	local aceroOscuro = Color3.fromRGB(132, 138, 150)

	-- Mango en la mano (el Handle) y el gemelo pegado al lado
	local handle = newHandle({
		Size = Vector3.new(0.18, 0.85, 0.36),
		Color = aceroOscuro,
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "MangoB",
		Size = Vector3.new(0.18, 0.85, 0.36),
		CFrame = handle.CFrame * CFrame.new(0.24, 0, 0),
		Color = aceroOscuro,
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Pivote",
		Size = Vector3.new(0.46, 0.12, 0.4),
		CFrame = handle.CFrame * CFrame.new(0.12, 0.5, 0),
		Color = acero,
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Hoja",
		Size = Vector3.new(0.12, 1.7, 0.3),
		CFrame = handle.CFrame * CFrame.new(0.12, 1.42, 0),
		Color = Color3.fromRGB(228, 234, 244),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Punta",
		Size = Vector3.new(0.44, 0.44, 0.3),
		CFrame = handle.CFrame * CFrame.new(0.12, 2.42, 0) * CFrame.Angles(0, 0, math.rad(45)),
		Color = Color3.fromRGB(228, 234, 244),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Filo",
		Size = Vector3.new(0.1, 1.5, 0.1),
		CFrame = handle.CFrame * CFrame.new(0.2, 1.35, 0),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.Neon,
		Parent = tool,
	})
	-- El cuchillo tambien entra a la carpeta de plantillas: era el unico
	-- que se quedaba afuera y por eso no aparecia de fabrica
	tool.Parent = parent
	return tool
end

-- Mochila de combustible: se ve en la espalda (tercera persona) mientras
-- usas el lanzallamas y se puede disparar: si le pegan, explota.
local function tankPiece(character, name, props)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = props.size
	part.Color = props.color
	part.Shape = props.shape or Enum.PartType.Block
	part.Material = props.material or Enum.Material.Metal
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = true
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Tanque", true)
	part.CFrame = props.cframe
	part.Parent = character
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = props.torso
	weld.Part1 = part
	weld.Parent = part
	return part
end

local function attachFuelTank(character)
	if character:FindFirstChild("TanqueCombustible") then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	local cf = torso.CFrame
	-- Local +Z mira para atras: la mochila va pegada a la espalda
	tankPiece(character, "TanqueCombustible", {
		torso = torso,
		size = Vector3.new(0.92, 1.15, 0.34),
		color = Color3.fromRGB(140, 60, 48),
		cframe = cf * CFrame.new(0, 0.12, 0.62),
	})
	tankPiece(character, "TanqueCombustible_Tanque", {
		torso = torso,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.95, 0.5, 0.5),
		color = Color3.fromRGB(178, 76, 58),
		cframe = cf * CFrame.new(0, 0.12, 0.85),
	})
	tankPiece(character, "TanqueCombustible_Valvula", {
		torso = torso,
		shape = Enum.PartType.Ball,
		size = Vector3.new(0.2, 0.2, 0.2),
		color = Color3.fromRGB(96, 220, 140),
		material = Enum.Material.Neon,
		cframe = cf * CFrame.new(0.3, 0.55, 0.8),
	})
end

local function detachFuelTank(character)
	if not character then
		return
	end
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") and part:GetAttribute("Tanque") then
			part:Destroy()
		end
	end
end

ToolService.attachTank = attachFuelTank
ToolService.detachTank = detachFuelTank

-- La mochila se engancha al clon que recibe el jugador (las conexiones no se
-- copian al clonar la plantilla)
local function wireTool(tool)
	if tool:GetAttribute("ToolId") ~= "lanzallamas" then
		return
	end
	local worn = nil
	tool.Equipped:Connect(function()
		local parent = tool.Parent
		if parent and parent:IsA("Model") then
			worn = parent
			attachFuelTank(parent)
		end
	end)
	tool.Unequipped:Connect(function()
		if worn then
			detachFuelTank(worn)
			worn = nil
		end
	end)
	tool.Destroying:Connect(function()
		if worn then
			detachFuelTank(worn)
			worn = nil
		end
	end)
end

local function buildFlamethrowerTool(id)
	local cfg = Config.Weapons[id]
	local tool = prepareLootTool(id)
	tool.Grip = CFrame.new(0, -0.35, 0.3) * CFrame.Angles(math.rad(-90), 0, 0)
	local handle = newHandle({
		Size = Vector3.new(0.3, 0.8, 0.5),
		Color = Color3.fromRGB(70, 70, 66),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Tubo",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.6, 0.34, 0.34),
		CFrame = handle.CFrame * CFrame.new(0, 0.55, -1.4) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(96, 96, 90),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Boquilla",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 0.6, 0.6),
		CFrame = handle.CFrame * CFrame.new(0, 0.55, -3.2) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(52, 52, 50),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Piloto",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.42, 0.42, 0.42),
		CFrame = handle.CFrame * CFrame.new(0, 0.55, -3.7),
		Color = cfg.color,
		Material = Enum.Material.Neon,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Mochila",
		Size = Vector3.new(1.5, 2.0, 0.8),
		CFrame = handle.CFrame * CFrame.new(0, -0.2, 0.7),
		Color = Color3.fromRGB(140, 60, 48),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "TanqueA",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 0.6, 0.6),
		CFrame = handle.CFrame * CFrame.new(-0.36, 0.35, 0.75) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(178, 76, 58),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "TanqueB",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 0.6, 0.6),
		CFrame = handle.CFrame * CFrame.new(0.36, 0.35, 0.75) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(178, 76, 58),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	return tool
end

-- Armas estilo Counter Blox (AK, M4, MP5, Glock, escopeta): cuerpo,
-- cañon, culata y cargador simples, como el resto de las armas de baul.
local COUNTER_TOOLS = {
	ak = {
		color = Color3.fromRGB(150, 104, 62), body = Vector3.new(0.24, 0.34, 1.5),
		len = 1.5, bore = 0.17, wood = true, stock = Color3.fromRGB(126, 90, 58),
	},
	m4 = {
		color = Color3.fromRGB(64, 70, 82), body = Vector3.new(0.24, 0.32, 1.6),
		len = 1.7, bore = 0.15,
	},
	mp5 = {
		color = Color3.fromRGB(58, 62, 72), body = Vector3.new(0.22, 0.30, 1.1),
		len = 1.0, bore = 0.15, stockY = 0.35,
	},
	glock = {
		color = Color3.fromRGB(70, 72, 80), body = Vector3.new(0.14, 0.24, 0.8),
		len = 0.55, bore = 0.13, stockY = 0.22,
	},
	escopeta = {
		color = Color3.fromRGB(96, 74, 54), body = Vector3.new(0.24, 0.32, 1.5),
		len = 1.7, bore = 0.22, wood = true, stock = Color3.fromRGB(118, 80, 50),
	},
}

local function buildCounterTool(id)
	local spec = COUNTER_TOOLS[id]
	local tool = prepareLootTool(id)
	tool.Grip = CFrame.new(0, -0.2, 0.35) * CFrame.Angles(math.rad(-90), 0, 0)
	local handle = newHandle({
		Size = Vector3.new(0.26, 0.85, 0.4),
		Color = Color3.fromRGB(52, 56, 64),
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Cuerpo",
		Size = spec.body,
		CFrame = handle.CFrame * CFrame.new(0, 0.55, -0.6),
		Color = spec.color,
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Canon",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(spec.len, spec.bore, spec.bore),
		CFrame = handle.CFrame * CFrame.new(0, 0.62, -(spec.len * 0.5 + 0.35)) * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(38, 40, 46),
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	-- M4A1: silenciador bien largo al frente del cañón (tiros casi mudos)
	if id == "m4" then
		weldPiece(handle, {
			Name = "Silenciador",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.95, spec.bore + 0.14, spec.bore + 0.14),
			CFrame = handle.CFrame * CFrame.new(0, 0.62, -(spec.len + 0.8)) * CFrame.Angles(0, math.rad(90), 0),
			Color = Color3.fromRGB(30, 32, 38),
			Material = Enum.Material.Metal,
			Parent = tool,
		})
	end
	weldPiece(handle, {
		Name = "Culata",
		Size = Vector3.new(0.22, spec.stockY or 0.42, 0.85),
		CFrame = handle.CFrame * CFrame.new(0, 0.42, 0.35),
		Color = spec.stock or spec.color,
		Material = spec.wood and Enum.Material.Wood or Enum.Material.Metal,
		Parent = tool,
	})
	weldPiece(handle, {
		Name = "Cargador",
		Size = Vector3.new(0.16, 0.5, 0.3),
		CFrame = handle.CFrame * CFrame.new(0, 0.12, -0.5) * CFrame.Angles(math.rad(-14), 0, 0),
		Color = spec.color,
		Material = Enum.Material.Metal,
		Parent = tool,
	})
	return tool
end

-- Granadas del pack de los baúles (frag, humo, molotov y flash):
-- cuerpo chico con palanca y, en el molotov, la botella con el trapo.
local function buildNadeTool(id)
	local cfg = Config.Grenades[id]
	local tool = Instance.new("Tool")
	tool.Name = cfg.name
	tool.ToolTip = cfg.tooltip or "Granada de baúl: usos limitados"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, -0.15, 0.5) * CFrame.Angles(math.rad(-90), 0, 0)
	tool:SetAttribute("ToolId", id)
	tool:SetAttribute("Loot", true)
	tool:SetAttribute("Uses", cfg.uses)

	local handle = newHandle({
		Size = Vector3.new(0.2, 0.5, 0.2),
		Color = cfg.color,
		Material = Enum.Material.Metal,
		Parent = tool,
	})

	if id == "molotov" then
		weldPiece(handle, {
			Name = "Botella",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.0, 0.48, 0.48),
			CFrame = handle.CFrame * CFrame.new(0, 0.7, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color = cfg.color,
			Material = Enum.Material.Glass,
			Parent = tool,
		})
		weldPiece(handle, {
			Name = "Trapo",
			Size = Vector3.new(0.22, 0.22, 0.3),
			CFrame = handle.CFrame * CFrame.new(0, 1.28, 0),
			Color = Color3.fromRGB(255, 176, 70),
			Material = Enum.Material.Neon,
			Parent = tool,
		})
	else
		weldPiece(handle, {
			Name = "Cuerpo",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.62, 0.62, 0.62),
			CFrame = handle.CFrame * CFrame.new(0, 0.66, 0),
			Color = cfg.color,
			Material = Enum.Material.Metal,
			Parent = tool,
		})
		weldPiece(handle, {
			Name = "Palanca",
			Size = Vector3.new(0.42, 0.07, 0.09),
			CFrame = handle.CFrame * CFrame.new(0.06, 1.02, 0),
			Color = Color3.fromRGB(184, 188, 194),
			Material = Enum.Material.Metal,
			Parent = tool,
		})
		if id == "flash" then
			weldPiece(handle, {
				Name = "Agujeros",
				Size = Vector3.new(0.4, 0.09, 0.4),
				CFrame = handle.CFrame * CFrame.new(0, 0.99, 0),
				Color = Color3.fromRGB(58, 60, 66),
				Material = Enum.Material.Metal,
				Parent = tool,
			})
		end
	end
	return tool
end

local function buildLootTool(parent, id)
	if not Config.Weapons[id] and not (Config.Grenades and Config.Grenades[id]) then
		return nil
	end

	local tool
	if Config.Grenades and Config.Grenades[id] then
		tool = buildNadeTool(id)
	elseif id == "revolver" then
		tool = buildRevolverTool(id)
	elseif id == "arco" then
		tool = buildBowTool(id)
	elseif id == "sniper" then
		tool = buildSniperTool(id)
	elseif id == "lanzallamas" then
		tool = buildFlamethrowerTool(id)
	elseif COUNTER_TOOLS[id] then
		tool = buildCounterTool(id)
	else
		tool = buildRocketTool(id)
	end

	tool.Parent = parent
	return tool
end

local function buildLootTools(parent)
	for _, entry in ipairs(Config.Loot.weapons) do
		buildLootTool(parent, entry.id)
	end
	-- Las granadas del pack también viven en la carpeta de plantillas
	for _, entry in ipairs(Config.GrenadePack or {}) do
		buildLootTool(parent, entry.id)
	end
end

function ToolService.build()
	local existing = ServerStorage:FindFirstChild(TEMPLATE_FOLDER)
	if existing then
		existing:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = TEMPLATE_FOLDER
	folder.Parent = ServerStorage

	buildNet(folder)
	buildRifle(folder)
	buildTracker(folder)
	buildTrap(folder)
	buildPaintRifle(folder)
	buildRelente(folder)
	buildKnifeTool(folder)
	buildLootTools(folder)

	ToolService.folder = folder
	return folder
end

-- ===============================================================
-- Entrega de herramientas
-- ===============================================================
function ToolService.give(player, only)
	local folder = ToolService.folder
	if not folder or not player.Parent then
		return
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	local allow
	if only then
		allow = {}
		for _, id in ipairs(only) do
			allow[id] = true
		end
	end

	-- Limpia lo que haya quedado de la partida anterior
	ToolService.clear(player)

	-- Se clona en orden: la red atrapa kiwis va 1, el cuchillo mariposa 2 y
	-- despues el resto. La barra de Roblox sigue el orden de la mochila, asi
	-- que con clonarlos en esta secuencia queda ordenada de una.
	local resto, red, cuchillo = {}, nil, nil
	for _, template in ipairs(folder:GetChildren()) do
		local toolId = template:GetAttribute("ToolId")
		-- pintura, relente y las armas de baul solo se entregan cuando toca
		-- (el cuchillo mariposa si va de fabrica para todos)
		local locked = toolId == "pintura" or toolId == "relente"
		if not locked then
			for _, entry in ipairs(Config.Loot.weapons) do
				if entry.id == toolId then
					locked = true
					break
				end
			end
		end
		local allowed
		if allow then
			allowed = allow[toolId] == true
		else
			allowed = not locked
		end
		if allowed then
			if toolId == "cuchillo" then
				cuchillo = cuchillo or template
			elseif toolId == "red" then
				red = red or template
			else
				table.insert(resto, template)
			end
		end
	end

	-- Blindaje: el cuchillo mariposa va de fabrica SIEMPRE (en todos los
	-- modos y para todos los personajes), aunque la lista del modo lo olvide.
	if not cuchillo then
		for _, template in ipairs(folder:GetChildren()) do
			if template:GetAttribute("ToolId") == "cuchillo" then
				cuchillo = template
				break
			end
		end
	end

	local orden = {}
	if red then
		table.insert(orden, red)
		if cuchillo then
			table.insert(orden, cuchillo)
		end
	elseif cuchillo then
		-- Sin red (Defensores, colosal, multi): el cuchillo queda primero
		table.insert(orden, cuchillo)
	end
	for _, template in ipairs(resto) do
		table.insert(orden, template)
	end
	for _, template in ipairs(orden) do
		local clone = template:Clone()
		wireTool(clone)
		clone.Parent = backpack
	end

	ToolService.cooldowns[player] = {}
end

function ToolService.clear(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute("ToolId") then
				item:Destroy()
			end
		end
	end

	local character = player.Character
	if character then
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") and item:GetAttribute("ToolId") then
				item:Destroy()
			end
		end
	end

	ToolService.cooldowns[player] = nil
end

-- Entrega (o saca) UNA herramienta suelta, sin tocar el resto
function ToolService.giveTool(player, toolId)
	local folder = ToolService.folder
	if not folder then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local containers = { backpack, player.Character }
	for _, container in ipairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					return
				end
			end
		end
	end
	for _, template in ipairs(folder:GetChildren()) do
		if template:GetAttribute("ToolId") == toolId then
			local clone = template:Clone()
			wireTool(clone)
			clone.Parent = backpack
			return
		end
	end
end

function ToolService.giveLoot(player, toolId, uses)
	ToolService.giveTool(player, toolId)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					item:SetAttribute("Uses", uses)
				end
			end
		end
	end
end

-- Pack de granadas del baúl: deja el arsenal completo en la mochila
-- (1 fragmentación, 1 humo, 1 molotov y 2 flashes)
function ToolService.giveNadePack(player)
	for _, entry in ipairs(Config.GrenadePack or {}) do
		ToolService.giveLoot(player, entry.id, entry.uses)
	end
end

function ToolService.addLootUses(player, toolId, amount)
	local cap = Config.Loot.uses
	local total = 0
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					total = math.min(cap, (item:GetAttribute("Uses") or 0) + (amount or 1))
					item:SetAttribute("Uses", total)
				end
			end
		end
	end
	return total
end

function ToolService.lootUses(player, toolId)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					return item:GetAttribute("Uses") or 0
				end
			end
		end
	end
	return 0
end

function ToolService.consumeLoot(player, toolId)
	local left = 0
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					left = math.max(0, (item:GetAttribute("Uses") or 0) - 1)
					if left &lt;= 0 then
						item:Destroy()
					else
						item:SetAttribute("Uses", left)
					end
				end
			end
		end
	end
	return left
end

function ToolService.takeTool(player, toolId)
	local found = false
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in ipairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					found = true
					item:Destroy()
				end
			end
		end
	end
	return found
end

-- ¿El arma es de baul? (las de baul se gastan: "Uses" / consumeLoot)
function ToolService.isLoot(player, toolId)
	for _, container in ipairs({ player:FindFirstChildOfClass("Backpack"), player.Character }) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					return item:GetAttribute("Loot") == true
				end
			end
		end
	end
	return false
end

function ToolService.hasTools(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false
	end
	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") and item:GetAttribute("ToolId") then
			return true
		end
	end
	return false
end

-- ===============================================================
-- Recargas
-- ===============================================================
function ToolService.startCooldown(player, toolId, seconds)
	if not ToolService.cooldowns[player] then
		ToolService.cooldowns[player] = {}
	end
	ToolService.cooldowns[player][toolId] = os.clock() + seconds
end

function ToolService.getRemaining(player, toolId)
	local list = ToolService.cooldowns[player]
	if not list or not list[toolId] then
		return 0
	end
	return math.max(0, list[toolId] - os.clock())
end

function ToolService.reset(player)
	ToolService.cooldowns[player] = {}
end

Players.PlayerRemoving:Connect(function(player)
	ToolService.cooldowns[player] = nil
end)

return ToolService
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX017">
					<Properties>
						<string name="Name">Actions</string>
						<ProtectedString name="Source">--[[
	Actions.lua  (servidor)
	Resuelve lo que pasa cuando un jugador usa una herramienta:
		red          -&gt; lanzar la red (captura o espanta)
		rifle        -&gt; disparar un dardo tranquilizante (proyectil real)
		rastreador   -&gt; ping con la direccion del kiwi
		trampa       -&gt; dejar una fruta trampa para el kiwi
		pintura      -&gt; disparar pintura a otros jugadores

	Todo se valida aca: distancias, conos de vision, recargas y estado
	del kiwi. El cliente solo pide la accion, nunca decide el resultado.
--]]

local Players = game:GetService("Players")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local ToolService = require(script.Parent.ToolService)
local Destruction = require(script.Parent.Destruction)

local Actions = {}

local DART_LENGTH = 0.9
local DART_THICKNESS = 0.22
local NET_HALF_ANGLE = math.rad(55)   -- medio cono de la red
local AIM_TOLERANCE = math.rad(75)    -- cuanto puede desviarse la mira del dardo

-- Dispersion estilo Counter Blox (licencia MIT, ver LICENSE-CB.md):
--   error = spread del arma + velocidad * vel
--   con la mira puesta: error = spread * adsDiv (el sniper es perfecto)
--   si el error queda por debajo del minimo, el disparo sale perfecto
-- En asedio no se lastima (ni se prende fuego) al propio equipo
local function friendlyShot(session, shooter, victim)
	if not session.isAsedio or not session.teamOf or not shooter or not victim or shooter == victim then
		return false
	end
	local mine = session.teamOf[shooter]
	local theirs = session.teamOf[victim]
	return mine ~= nil and mine == theirs
end

function Actions.spreadError(weaponId, root, data)
	local shoot = Config.Shoot or {}
	local cfg = (shoot.weapons or {})[weaponId] or {}
	local speed = 0
	if root then
		local velocity = root.AssemblyLinearVelocity
		speed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
	end

	local error = math.max(cfg.spread or 0, 0) + speed * (cfg.vel or 0)
	-- Agachado (Ctrl) el arma se afirma, como en Counter
	if data and data.sneak and not (data and data.scoped) then
		error = error / ((Config.Shoot and Config.Shoot.crouchDiv) or 1.6)
	end
	if data and data.scoped then
		if cfg.adsPerfect then
			error = 0
		else
			error = error * (shoot.adsDiv or 0.35)
		end
	end
	local dead = cfg.dead or shoot.dead or 0
	if error &lt; dead then
		error = 0
	end
	return error
end

-- Igual que Fire() de Counter Blox: el error se convierte en grados, el
-- vertical siempre patea hacia arriba (salvo armas con randomX) y el
-- horizontal/roll sale al azar. Devuelve direccion nueva y grados.
function Actions.applySpread(dir, weaponId, root, data)
	local error = Actions.spreadError(weaponId, root, data)
	if error &lt;= 0 then
		return dir, 0
	end
	local shoot = Config.Shoot or {}
	local cfg = (shoot.weapons or {})[weaponId] or {}
	local grados = error / (shoot.div or 6)
	local rnd = math.random
	local pitch = cfg.randomX and ((rnd() * 2 - 1) * grados) or grados
	local yaw = (rnd() * 2 - 1) * grados
	local roll = (rnd() * 2 - 1) * grados
	local spread = CFrame.Angles(math.rad(pitch), math.rad(yaw), math.rad(roll))
	return (CFrame.lookAt(Vector3.new(), dir) * spread).LookVector, grados
end

-- Abre un cono al azar alrededor de una direccion (perdigones de escopeta)
function Actions.coneDirection(dir, halfAngleDeg)
	local up = math.abs(dir.Y) &lt; 0.99 and Vector3.new(0, 1, 0) or Vector3.new(1, 0, 0)
	local right = dir:Cross(up).Unit
	local realUp = right:Cross(dir).Unit
	local ax = (math.random() * 2 - 1) * math.rad(halfAngleDeg)
	local ay = (math.random() * 2 - 1) * math.rad(halfAngleDeg)
	return (dir + right * math.tan(ax) + realUp * math.tan(ay)).Unit
end

-- ===============================================================
-- Utilidades
-- ===============================================================
local function getRoot(player)
	local character = player.Character
	if not character then
		return nil, nil
	end
	return character, character:FindFirstChild("HumanoidRootPart")
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDistance(a, b)
	return flat(a - b).Magnitude
end

-- Direccion "hacia donde mira" el jugador: usamos la mira que manda el
-- cliente, pero saneada (nunca detras del personaje y con largo fijo).
local function aimDirection(player, root, data)
	local muzzle = root.Position + Vector3.new(0, 1.1, 0)
	local aim = data and data.aim
	local dir
	if typeof(aim) == "Vector3" and (aim - muzzle).Magnitude &gt; 0.2 then
		dir = (aim - muzzle).Unit
	else
		dir = root.CFrame.LookVector
	end

	-- Si el cliente manda una direccion ridicula, cae a la del personaje
	local look = root.CFrame.LookVector
	if flat(dir):Dot(flat(look)) &lt; math.cos(AIM_TOLERANCE) then
		dir = look
	end
	return muzzle, dir
end

function Actions.makeDartParams(character, dartPart)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, dartPart }
	params.IgnoreWater = true
	return params
end

-- ===============================================================
-- RED DE CAPTURA
-- ===============================================================
function Actions.net(session, player, data)
	local cfg = session.diff.red
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "red") &gt; 0 then
		return
	end
	ToolService.startCooldown(player, "red", cfg.cooldown)

	local muzzle, dir = aimDirection(player, root, data)
	session:event("netswing", { pos = root.Position, userId = player.UserId })

	local kiwi = session.kiwi
	if not kiwi or kiwi.defeated then
		return
	end

	local kiwiPos = kiwi:getPosition()

	-- 1) El kiwi esta escondido: buscamos en el escondite mas cercano
	if kiwi:isHidden() then
		local spot = session.arena:nearestSpot(root.Position, cfg.range + 8)
		if not spot then
			session:notify(player, Config.Text.FlushFail, Color3.fromRGB(180, 180, 180))
			return
		end

		local toSpot = flat(spot.hidePoint - root.Position)
		local inCone = toSpot.Magnitude &lt; 0.1 or flat(dir):Dot(toSpot.Unit) &gt; math.cos(NET_HALF_ANGLE)
		if inCone and kiwi.spotIndex == spot.id then
			kiwi:flush()
			session:notify(player, Config.Text.Flushed, Color3.fromRGB(255, 210, 120))
		else
			session:notify(player, Config.Text.FlushFail, Color3.fromRGB(180, 180, 180))
			session:event("rustle", { pos = spot.hidePoint })
		end
		return
	end

	-- 2) Kiwi a la vista: hay que estar cerca y apuntando
	local toKiwi = kiwiPos - (root.Position + Vector3.new(0, 1.1, 0))
	local distance = toKiwi.Magnitude
	local inCone = distance &lt; 0.1 or dir:Dot(toKiwi.Unit) &gt; math.cos(NET_HALF_ANGLE)

	if distance &gt; cfg.range or not inCone then
		return
	end

	if kiwi:isSedated() then
		session:capture(player, "red")
		return
	end

	if session.rng:NextNumber() &lt;= cfg.chance then
		session:capture(player, "red")
	else
		session:notify(player, Config.Text.NetMiss, Color3.fromRGB(255, 150, 140))
		kiwi:flush()
	end
end

-- ===============================================================
-- RIFLE TRANQUILIZANTE (estilo Counter: rayo instantaneo con dispersion;
-- quieto o con la mira puesto es preciso, corriendo disparando no)
-- ===============================================================
function Actions.rifle(session, player, data)
	local cfg = session.diff.rifle
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "rifle") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)
	dir = Actions.applySpread(dir, "rifle", root, data)

	local range = cfg.range or 170
	local params = Actions.makeDartParams(character)
	local hit = workspace:Raycast(muzzle, dir * range, params)

	if hit then
		local kiwi = session.kiwi
		local other = hit.Instance:FindFirstAncestorOfClass("Model")
		local victim = other and Players:GetPlayerFromCharacter(other)
		if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
			if kiwi:sedate(session.diff.kiwi.sedateTime, player) then
				session:notify(player, Config.Text.DartHit, Color3.fromRGB(160, 230, 170))
				session:event("darthit", { pos = hit.Position })
			end
		elseif victim and victim ~= player and not friendlyShot(session, player, victim) then
			-- Dardo a un cazador rival: lo deja inmovil unos segundos
			local stunTime = (Config.Tranq and Config.Tranq.stunTime) or 3
			if session:stun(victim, stunTime, player) then
				local vname = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
				session:notify(player, string.format(Config.Text.TranqHit, vname), Color3.fromRGB(160, 230, 170))
				session:notify(victim, Config.Text.TranqVictim, Color3.fromRGB(160, 230, 170))
				session:event("darthit", { pos = hit.Position })
			end
		else
			session:event("dartmiss", { pos = hit.Position, normal = hit.Normal })
			session:notify(player, Config.Text.DartMiss, Color3.fromRGB(200, 200, 200))
			ToolService.startCooldown(player, "rifle", cfg.cooldownOnMiss)
		end
	end

	ToolService.startCooldown(player, "rifle", cfg.cooldown)
	session:event("dartshot", { pos = muzzle, dir = dir, tracer = true, weapon = "rifle" })
end

--[[
	RIFLE RALENTIZADOR (Kiwi Colosal): no lo duerme, lo frena unos segundos.
]]
function Actions.relente(session, player, data)
	local cfg = Config.Relente
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "relente") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)

	local dartPart = Util.makePart({
		Name = "Aguja",
		ClassName = "Part",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(DART_LENGTH, DART_THICKNESS, DART_THICKNESS),
		Color = Config.Tools.relente.color,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.lookAt(muzzle + dir * 1.2, muzzle + dir * 2.2) * CFrame.Angles(0, math.rad(90), 0),
		Parent = workspace,
	})
	Util.destroyAfter(dartPart, 6)

	local dart = {
		kind = "slow",
		part = dartPart,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		params = Actions.makeDartParams(character, dartPart),
	}

	table.insert(session.projectiles, dart)
	ToolService.startCooldown(player, "relente", cfg.cooldown)
	session:event("dartshot", { pos = muzzle, dir = dir, weapon = "relente" })
end

-- ===============================================================
-- ARMAS DE BAUL (lanzamisiles, revolver, arco): proyectiles con empujon
-- ===============================================================
-- Un disparo suelto de arma de baul (lo usan los 3 tiros de la Glock).
-- extraCone: grados de apertura extra para los tiros 2 y 3 de la rafaga.
function Actions.spawnWeaponDart(session, player, weaponId, cfg, root, data, extraCone)
	local character = player.Character
	if not character or not root then
		return
	end
	local muzzle, dir = aimDirection(player, root, data)
	dir = Actions.applySpread(dir, weaponId, root, data)
	if extraCone and extraCone &gt; 0 then
		dir = Actions.coneDirection(dir, extraCone)
	end

	local dartPart = Util.makePart({
		Name = "Proyectil",
		ClassName = "Part",
		Size = cfg.size or Vector3.new(0.4, 0.4, 1.6),
		Color = cfg.color,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.lookAt(muzzle + dir * 1.2, muzzle + dir * 2.2),
		Parent = workspace,
	})
	Util.destroyAfter(dartPart, 6)

	table.insert(session.projectiles, {
		kind = "weapon",
		weaponId = weaponId,
		part = dartPart,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		params = Actions.makeDartParams(character, dartPart),
	})

	session:event("dartshot", { pos = muzzle, dir = dir, weapon = weaponId })
	session:event("weaponfx", { weapon = weaponId, pos = muzzle, dir = dir })
end

function Actions.fireWeapon(session, player, weaponId, data)
	local nadeCfg = Config.Grenades and Config.Grenades[weaponId]
	local cfg = Config.Weapons[weaponId]
	if not cfg and not nadeCfg then
		return
	end

	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, weaponId) &gt; 0 then
		return
	end

	-- Solo las armas de baul se gastan por uso; el cuchillo mariposa
	-- de fabrica no lleva "Uses" y no se consume.
	local loot = ToolService.isLoot(player, weaponId)
	if loot and ToolService.lootUses(player, weaponId) &lt;= 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)

	-- Granadas del pack de los baules: se lanzan con arco y detonan solas
	if nadeCfg then
		Actions.throwNade(session, player, weaponId, nadeCfg, muzzle, dir)
		return
	end

	-- Cuchillo: zarpazo cuerpo a cuerpo (sin proyectil)
	if cfg.melee then
		Actions.melee(session, player, weaponId, cfg, muzzle, dir)
		ToolService.startCooldown(player, weaponId, cfg.cooldown)
		if loot then
			ToolService.consumeLoot(player, weaponId)
		end
		return
	end

	-- Lanzallamas: chorro continuo en cono (los usos se gastan por tick)
	if cfg.flame then
		Actions.flame(session, player, weaponId, cfg, muzzle, dir)
		ToolService.startCooldown(player, weaponId, cfg.cooldown)
		return
	end

	-- Francotirador: bala instantanea estilo Counter. Con la telescopica
	-- puesta es letal; sin mira es un noscope impreciso.
	if weaponId == "sniper" then
		Actions.sniperShot(session, player, cfg, muzzle, dir, data)
		ToolService.startCooldown(player, weaponId, cfg.cooldown)
		ToolService.consumeLoot(player, weaponId)
		return
	end

	-- Glock-18 en ráfaga de 3 (estilo CS2): el clic derecho manda
	-- data.burst y salen tres tiros en cadencia corta por gatillo.
	if weaponId == "glock" and data.burst then
		local burst = cfg.burst or {}
		local shots = math.max(2, burst.shots or 3)
		Actions.spawnWeaponDart(session, player, weaponId, cfg, root, data, 0)
		for i = 2, shots do
			task.delay((burst.gap or 0.07) * (i - 1), function()
				if session.phase ~= "playing" or not player.Parent then
					return
				end
				local _, nowRoot = getRoot(player)
				if nowRoot then
					Actions.spawnWeaponDart(session, player, weaponId, cfg, nowRoot, data,
						(burst.cone or 1.2) * (i - 1))
				end
			end)
		end
		ToolService.startCooldown(player, weaponId, burst.cooldown or 0.95)
		ToolService.consumeLoot(player, weaponId)
		return
	end

	-- Dispersion estilo Counter tambien en los tiros del baul
	dir = Actions.applySpread(dir, weaponId, root, data)

	-- Escopeta: varios perdigones abriendo el cono (mira y agachado lo cierran)
	local pellets = math.max(1, cfg.pellets or 1)
	local half = (cfg.spreadHalf or 0) * (data.scoped and 0.55 or 1) * (data.sneak and 0.8 or 1)
	for _ = 1, pellets do
		local shotDir = dir
		if pellets &gt; 1 and half &gt; 0 then
			shotDir = Actions.coneDirection(dir, half)
		end

		local dartPart = Util.makePart({
			Name = "Proyectil",
			ClassName = "Part",
			Size = cfg.size or Vector3.new(0.4, 0.4, 1.6),
			Color = cfg.color,
			Material = Enum.Material.Neon,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.lookAt(muzzle + shotDir * 1.2, muzzle + shotDir * 2.2),
			Parent = workspace,
		})
		Util.destroyAfter(dartPart, 6)

		table.insert(session.projectiles, {
			kind = "weapon",
			weaponId = weaponId,
			part = dartPart,
			pos = muzzle + shotDir * 1.2,
			dir = shotDir,
			speed = cfg.speed,
			life = cfg.life,
			player = player,
			params = Actions.makeDartParams(character, dartPart),
		})
	end

	ToolService.startCooldown(player, weaponId, cfg.cooldown)
	ToolService.consumeLoot(player, weaponId)
	session:event("dartshot", { pos = muzzle, dir = dir, weapon = weaponId })
	session:event("weaponfx", { weapon = weaponId, pos = muzzle, dir = dir })
end

-- Cuchillo: golpe corto; al kiwi solo lo frena, a los cazadores los hiere.
function Actions.melee(session, player, weaponId, cfg, muzzle, dir)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = true

	local reach = cfg.reach or 8
	local hit = workspace:Raycast(muzzle, dir * reach, params)
	local pos = muzzle + dir * reach
	local victim = nil
	if hit then
		pos = hit.Position
		local character = hit.Instance:FindFirstAncestorOfClass("Model")
		victim = character and Players:GetPlayerFromCharacter(character)
	end

	if victim and victim ~= player then
		session:damagePlayer(victim, player, cfg.name, cfg.damage, pos)
		local _, vroot = getRoot(victim)
		if vroot then
			local push = flat(dir).Unit * (cfg.knockback or 24)
			vroot.AssemblyLinearVelocity = Vector3.new(push.X, 14, push.Z)
		end
	end

	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated then
		if (kiwi:getPosition() - pos).Magnitude &lt;= reach then
			if kiwi:slow(cfg.slowFactor or 0.5, cfg.slowTime or 1.2) then
				session:notify(player, string.format(Config.Text.BoomHit, cfg.name), cfg.color, 3)
			end
		end
	end

	session:event("weaponfx", { weapon = weaponId, pos = muzzle, dir = dir, hit = victim ~= nil })
end

-- Francotirador: rayo instantaneo estilo Counter. Con la mira es letal;
-- sin mira, noscope impreciso. Al kiwi solo lo frena (nunca lo hiere).
function Actions.sniperShot(session, player, cfg, muzzle, dir, data)
	-- Dispersion estilo Counter Blox: sin telescopica el disparo es un
	-- noscope bien impreciso; con la mira puesta sale perfecto.
	local _, root = getRoot(player)
	dir = Actions.applySpread(dir, "sniper", root, data)

	local character = player.Character
	local params = Actions.makeDartParams(character)
	local range = (Config.Shoot and Config.Shoot.sniperRange) or 700
	local hit = workspace:Raycast(muzzle, dir * range, params)
	local pos = muzzle + dir * range
	local victim = nil
	local hitKiwi = false

	if hit then
		pos = hit.Position
		local other = hit.Instance:FindFirstAncestorOfClass("Model")
		victim = other and Players:GetPlayerFromCharacter(other)
		local kiwi = session.kiwi
		hitKiwi = kiwi ~= nil and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model)
	end

	-- Si le dio a la mochila de combustible: explota y se lleva el 80%
	if victim and victim ~= player and hit and hit.Instance:GetAttribute("Tanque") then
		if not friendlyShot(session, player, victim) then
			Actions.blowTank(session, victim, player, pos)
			session:event("dartshot", { pos = muzzle, dir = dir, weapon = "sniper" })
			session:event("weaponfx", { weapon = "sniper", pos = muzzle, dir = dir, hit = true })
			return
		end
	end

	if victim and victim ~= player then
		-- El francotirador noquea de un solo disparo al rival (regla pedida)
		local damage = cfg.oneShot and 999 or cfg.damage
		session:damagePlayer(victim, player, cfg.name, damage, pos)
		local _, vroot = getRoot(victim)
		if vroot then
			local push = flat(dir).Unit * (cfg.knockback or 58)
			vroot.AssemblyLinearVelocity = Vector3.new(push.X, 16, push.Z)
		end
	elseif hitKiwi then
		local kiwi = session.kiwi
		if kiwi:slow(cfg.slowFactor or 0.3, cfg.slowTime or 2) then
			session:notify(player, string.format(Config.Text.BoomHit, cfg.name), cfg.color, 3)
		end
	elseif hit then
		session:event("dartmiss", { pos = pos, normal = hit.Normal })
	end

	session:event("dartshot", { pos = muzzle, dir = dir, weapon = "sniper" })
	session:event("weaponfx", { weapon = "sniper", pos = muzzle, dir = dir, hit = victim ~= nil or hitKiwi })
end

-- Lanzallamas: cono corto que hiere jugadores con linea de vista y frena al kiwi.
-- Lanzallamas: chorro continuo mientras mantenes el clic. Cada segundo
-- (tick) saca 10% de la vida maxima a quien este dentro del cono. Si el
-- chorro pasa de 10 segundos seguidos, el que lo usa tambien se quema:
-- la unica salida es soltar el gatillo.
function Actions.flame(session, player, weaponId, cfg, muzzle, dir)
	local now = os.clock()
	session.flame = session.flame or {}
	local state = session.flame[player]
	if not state then
		state = { last = now, streak = 0, dmg = 0, fx = 0 }
		session.flame[player] = state
	end

	-- Tiempo desde el ultimo pedido: si hubo un bache, el chorro se corto
	local dt = math.clamp(now - state.last, 0, 0.5)
	state.last = now
	if dt &gt; 0.35 then
		state.streak = 0
		state.dmg = 0
	end
	state.streak = state.streak + dt

	-- Chorro visible para todos (4 avisos por segundo alcanzan: el rig
	-- del cliente sigue emitiendo entre avisos)
	if now - state.fx &gt;= 0.25 then
		state.fx = now
		session:event("weaponfx", { weapon = weaponId, pos = muzzle, dir = dir, user = player.UserId })
	end

	-- El chorro prende fuego donde pega: paredes, objetos y personajes.
	-- Esa llama queda ardiendo y, si sigue viva a los 5 segundos, empieza a
	-- quemar a quien este cerca: tambien a vos, que la encendiste.
	local reach = cfg.reach or 17
	local damage = Config.Player.maxHealth * (cfg.damagePercent or 10) / 100
	local fireRadius = cfg.fireRadius or 4.5

	session.firePatches = session.firePatches or {}
	local mine = session.firePatches[player]
	if not mine then
		mine = {}
		session.firePatches[player] = mine
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = true
	local hit = workspace:Raycast(muzzle, dir * reach, params)
	if hit then
		local spot = nil
		for _, p in ipairs(mine) do
			if (p.pos - hit.Position).Magnitude &lt;= fireRadius then
				spot = p
				break
			end
		end
		if spot then
			spot.pos = hit.Position
			spot.lastHeat = now
		else
			if #mine &gt;= 6 then
				table.remove(mine, 1)
			end
			table.insert(mine, { pos = hit.Position, born = now, lastHeat = now, nextTick = now })
		end
	end

	-- Llama vieja: sin alimentarla se apaga; con 5+ segundos encendida quema
	for index = #mine, 1, -1 do
		local spot = mine[index]
		if now - spot.lastHeat &gt; 4 then
			table.remove(mine, index)
		elseif now - spot.born &gt;= (cfg.fireHot or 5) and now - spot.lastHeat &lt;= 2
			and now &gt;= spot.nextTick then
			spot.nextTick = now + (cfg.tickTime or 1)
			for _, other in ipairs(session.players) do
				local _, otherRoot = getRoot(other)
				if otherRoot and (otherRoot.Position - spot.pos).Magnitude &lt;= fireRadius then
					if other == player then
						session:damagePlayer(player, player, cfg.name, damage, spot.pos,
							"El fuego que dejaste te esta quemando")
					elseif not friendlyShot(session, player, other) then
						session:damagePlayer(other, player, cfg.name, damage, spot.pos)
					end
				end
			end
		end
	end

	-- Un tick de daño por segundo (el chorro en cono)
	local tickTime = cfg.tickTime or 1
	state.dmg = state.dmg + dt
	if state.dmg &lt; tickTime then
		return
	end
	state.dmg = state.dmg - tickTime

	-- Combustible: cada tick gasta un uso (12 usos = 12 segundos de chorro)
	if ToolService.consumeLoot(player, weaponId) &lt;= 0 then
		return
	end

	local cosLimit = math.cos(math.rad(cfg.coneAngle or 32))
	local aimFlat = flat(dir).Unit

	for _, other in ipairs(session.players) do
		local _, otherRoot = getRoot(other)
		if otherRoot and other ~= player then
			local to = otherRoot.Position - muzzle
			local dist = to.Magnitude
			if dist &lt;= reach and dist &gt; 0.5 then
				local toFlat = flat(to)
				if toFlat.Magnitude &gt; 0.1 and toFlat.Unit:Dot(aimFlat) &gt;= cosLimit then
					-- El chorro no atraviesa paredes: linea de vista real
					-- (el params del impacto se reusa: sin tablas nuevas por tick)
					local los = workspace:Raycast(muzzle, to, params)
					if los == nil or los.Instance:IsDescendantOf(other.Character) then
						session:damagePlayer(other, player, cfg.name, damage, otherRoot.Position)
						local push = toFlat.Unit * (cfg.knockback or 8)
						otherRoot.AssemblyLinearVelocity = Vector3.new(push.X, 8, push.Z)
					end
				end
			end
		end
	end

	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated then
		local to = kiwi:getPosition() - muzzle
		if to.Magnitude &lt;= reach then
			local toFlat = flat(to)
			if toFlat.Magnitude &gt; 0.1 and toFlat.Unit:Dot(aimFlat) &gt;= cosLimit then
				if kiwi:slow(cfg.slowFactor or 0.6, cfg.slowTime or 1.0) then
					session:notify(player, string.format(Config.Text.BoomHit, cfg.name), cfg.color, 3)
				end
			end
		end
	end

	-- Sobrecalentado: mas de 10 segundos de chorro seguido = te quemas vos
	if state.streak &gt; (cfg.overheat or 10) then
		local _, myRoot = getRoot(player)
		session:damagePlayer(player, player, cfg.name, damage,
			myRoot and myRoot.Position or muzzle, "Te estas quemando con tu propio lanzallamas")
	end
end

-- Le dispararon a la mochila de combustible del lanzallamas: explota, el
-- arma se pierde y su dueño se come el 80% de su vida maxima.
function Actions.blowTank(session, victim, attacker, pos)
	local weaponCfg = Config.Weapons.lanzallamas
	local character = victim.Character
	if character then
		ToolService.detachTank(character)
	end
	ToolService.takeTool(victim, "lanzallamas")

	local damage = Config.Player.maxHealth * (weaponCfg.tankDamagePercent or 80) / 100
	session:damagePlayer(victim, attacker, weaponCfg.name, damage, pos,
		"Te volaron el tanque de combustible")
	session:event("boom", { pos = pos, weapon = "lanzallamas", tank = true })

	local aname = "El mapa"
	if attacker and attacker ~= victim then
		aname = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
	end
	local vname = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
	session:notifyAll(string.format(Config.Text.TankBoom, aname, vname), weaponCfg.color, 4)
end

-- Flecha clavada: queda en el mundo con un cartel para recuperarla (+1 uso).
function Actions.stickArrow(session, dart, pos, normal)
	local cfg = Config.Weapons.arco
	local dir = dart.dir

	local arrow = Util.makePart({
		Name = "FlechaClavada",
		Size = Vector3.new(0.14, 0.14, 2.8),
		Color = cfg.color,
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CFrame = CFrame.lookAt(pos - dir * 0.6, pos + dir * 2.2),
		Parent = workspace,
	})
	local tip = Util.makePart({
		Name = "PuntaFlecha",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.34, 0.34, 0.34),
		Color = Color3.fromRGB(230, 236, 244),
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		Position = pos + dir * 0.85,
		Parent = workspace,
	})
	local back = pos - dir * 1.7
	local feathers = {}
	for _, side in ipairs({ -1, 1 }) do
		table.insert(feathers, Util.makePart({
			Name = "Pluma",
			Size = Vector3.new(0.55, 0.06, 0.5),
			Color = Color3.fromRGB(240, 240, 228),
			Material = Enum.Material.Fabric,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CFrame = CFrame.lookAt(back, back + dir) * CFrame.Angles(0, 0, math.rad(side * 38)),
			Parent = workspace,
		}))
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RecogerFlecha"
	prompt.ActionText = "Recoger"
	prompt.ObjectText = "Flecha"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = cfg.pickupRange or 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = arrow

	local pickup = { parts = { arrow, tip, feathers[1], feathers[2] }, dead = false }

	local function clear()
		if pickup.dead then
			return
		end
		pickup.dead = true
		for _, piece in ipairs(pickup.parts) do
			if piece and piece.Parent then
				piece:Destroy()
			end
		end
	end

	prompt.Triggered:Connect(function(player)
		if pickup.dead then
			return
		end
		local _, root = getRoot(player)
		if not root or (root.Position - arrow.Position).Magnitude &gt; (cfg.pickupRange or 12) + 3 then
			return
		end
		if ToolService.lootUses(player, "arco") &lt;= 0 then
			session:notify(player, Config.Text.ArrowNoBow, Color3.fromRGB(200, 200, 200), 3)
			return
		end
		ToolService.addLootUses(player, "arco", 1)
		session:notify(player, Config.Text.ArrowPickup, cfg.color, 3)
		session:event("arrowpick", { pos = arrow.Position })
		clear()
	end)

	task.delay(cfg.pickupLife or 60, clear)
	session.arrowPickups = session.arrowPickups or {}
	table.insert(session.arrowPickups, pickup)
end

-- Limpieza de flechas clavadas al terminar la ronda.
function Actions.clearPickups(session)
	if not session.arrowPickups then
		return
	end
	for _, pickup in ipairs(session.arrowPickups) do
		pickup.dead = true
		for _, piece in ipairs(pickup.parts) do
			if piece and piece.Parent then
				piece:Destroy()
			end
		end
	end
	session.arrowPickups = {}
end

function Actions.weaponHit(session, dart, pos, victim, hitPart)
	local cfg = Config.Weapons[dart.weaponId]
	if not cfg then
		return
	end

	-- Le dispararon a la mochila de combustible del lanzallamas: explota
	if hitPart and victim and victim ~= dart.player and hitPart:GetAttribute("Tanque") then
		if not friendlyShot(session, dart.player, victim) then
			Actions.blowTank(session, victim, dart.player, pos)
			return
		end
	end

	-- El kiwi NO recibe daño: solo queda relentizado si le da cerca
	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated then
		local reach = math.max(cfg.blast or 0, 8)
		if (kiwi:getPosition() - pos).Magnitude &lt;= reach then
			if kiwi:slow(cfg.slowFactor or 0.4, cfg.slowTime or 2) then
				session:notify(dart.player, string.format(Config.Text.BoomHit, cfg.name), cfg.color, 3)
			end
		end
	end

	local damage = cfg.damage or 0
	local headshot = false

	-- Caida de daño con la distancia (como Counter): de lejos pega menos
	if victim and (cfg.falloff or 0) &gt; 0 then
		local _, shooterRoot = getRoot(dart.player)
		if shooterRoot then
			local dist = (pos - shooterRoot.Position).Magnitude
			local loss = math.max(0, dist / 1.9 - 1) * cfg.falloff
			damage = math.max(cfg.minDamage or damage * 0.5, damage - loss)
		end
	end

	-- Tiro a la cabeza (estilo Counter): se lleva mucho mas daño
	if victim and cfg.headMult and hitPart then
		local parent = hitPart.Parent
		if hitPart.Name == "Head" or (parent and parent.Name == "Head") then
			damage = damage * cfg.headMult
			headshot = true
		end
	end

	-- Golpe directo: el cazador alcanzado se lleva el daño completo
	if victim and victim ~= dart.player and damage &gt; 0 then
		local label = cfg.name
		if headshot then
			label = Config.Text.Headshot or cfg.name
		end
		session:damagePlayer(victim, dart.player, label, damage, pos)
		if headshot then
			session:notify(dart.player, Config.Text.Headshot, Color3.fromRGB(255, 210, 90), 2.5)
			session:event("headshot", { pos = pos, userId = victim.UserId })
		end
	end

	-- Onda expansiva: empuja a todos (tambien al que disparo) y hiere un poco
	if (cfg.blast or 0) &gt; 0 then
		for _, other in ipairs(session.players) do
			local _, otherRoot = getRoot(other)
			if otherRoot then
				local away = otherRoot.Position - pos
				local distance = away.Magnitude
				if distance &lt;= cfg.blast and distance &gt; 0.05 then
					local push = away.Unit * (cfg.knockback or 30)
					otherRoot.AssemblyLinearVelocity = Vector3.new(push.X, 24, push.Z)
					if damage &gt; 0 and other ~= dart.player and other ~= victim then
						local falloff = math.clamp(1 - (distance / cfg.blast) * 0.65, 0.35, 1)
						session:damagePlayer(other, dart.player, cfg.name, damage * falloff, pos)
					end
				end
			end
		end
	end

	-- El lanzamisiles destroza el mapa: casas, autos, trenes y arboles
	if dart.weaponId == "cohete" then
		Destruction.explosivo(pos, (cfg.blast or 12) + 10, (cfg.knockback or 60) * 0.72)
	end

	session:event("boom", { pos = pos, weapon = dart.weaponId })
	local shooterName = dart.player.DisplayName ~= "" and dart.player.DisplayName or dart.player.Name
	if (cfg.blast or 0) &gt;= 10 then
		session:notifyAll(string.format(Config.Text.BoomShout, shooterName, cfg.name), cfg.color, 3)
	end
end

-- ===============================================================
-- GRANADAS DEL PACK (fragmentacion, humo, molotov y flash)
-- ===============================================================
local GRENADE_GRAVITY = (Config.World and Config.World.Gravity) or 165

-- Nube de humo: esferas ancladas que tapan la vista pero dejan pasar los
-- tiros (los rayos las ignoran). Se disipa sola a los pocos segundos.
local function smokeCloud(pos)
	local cfg = Config.Grenades.humo
	local parts = {}
	for i = 1, 20 do
		local angle = math.random() * math.pi * 2
		local dist = math.sqrt(math.random()) * cfg.radius
		local size = math.random(80, 150) / 10
		local part = Util.makePart({
			Name = "Humo",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			Color = Color3.fromRGB(212, 216, 220),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.42,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.new(pos + Vector3.new(math.cos(angle) * dist, math.random(0, 9) - 1, math.sin(angle) * dist)),
			Parent = workspace,
		})
		table.insert(parts, part)
	end
	task.delay(cfg.time, function()
		for _ = 1, 12 do
			task.wait(0.12)
			for _, p in ipairs(parts) do
				if p and p.Parent then
					p.Transparency = math.min(1, p.Transparency + 0.05)
				end
			end
		end
		for _, p in ipairs(parts) do
			if p and p.Parent then
				p:Destroy()
			end
		end
	end)
end

-- Molotov: lengua de fuego en el piso que quema a quien se quede adentro.
-- Tres capas (brasa roja, llama naranja y punta amarilla) que suben y
-- titilan cada una a su ritmo: se ve como fuego de verdad, no bolitas.
local function fireZone(session, thrower, pos)
	local cfg = Config.Grenades.molotov
	local flames = {}
	local function capa(cantidad, radio, altura, tamano, color, transparencia)
		for i = 1, cantidad do
			local angle = math.random() * math.pi * 2
			local dist = math.sqrt(math.random()) * radio
			local size = tamano * (0.72 + math.random() * 0.56)
			local alto = altura * (0.8 + math.random() * 0.4)
			local base = pos + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			local part = Util.makePart({
				Name = "Llama",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(size, size, size),
				Color = color,
				Material = Enum.Material.Neon,
				Transparency = transparencia,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CFrame = CFrame.new(base + Vector3.new(0, alto * 0.4, 0)),
				Parent = workspace,
			})
			table.insert(flames, {
				part = part, base = base, alto = alto, tamano = size, trans = transparencia,
				speed = 1.6 + math.random() * 2.2, fase = math.random() * 6.28,
			})
		end
	end
	capa(14, cfg.radius * 0.78, 1.2, 2.5, Color3.fromRGB(168, 44, 16), 0.2)
	capa(18, cfg.radius * 0.66, 2.0, 1.9, Color3.fromRGB(255, 116, 30), 0.12)
	capa(10, cfg.radius * 0.44, 2.8, 1.2, Color3.fromRGB(255, 214, 96), 0.08)

	-- Luz calida: de noche la fogata se ve desde lejos
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 138, 58)
	glow.Brightness = 3.2
	glow.Range = math.max(24, cfg.radius * 2)
	glow.Parent = flames[1].part

	local endsAt = os.clock() + cfg.time
	local nextBurn = 0
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() &lt; endsAt do
			task.wait(0.09)
			local t = os.clock() - t0
			for _, f in ipairs(flames) do
				local p = f.part
				if p and p.Parent then
					-- Cada lengua late distinto y se estira hacia arriba
					local onda = math.sin(t * f.speed * 3.1 + f.fase)
					local subida = (math.sin(t * f.speed + f.fase) * 0.5 + 0.5) * f.alto
					local alto = f.alto * (0.75 + math.random() * 0.5)
					p.CFrame = CFrame.new(f.base + Vector3.new(0, alto * 0.4 + subida * 0.5, 0))
					p.Size = Vector3.new(f.tamano * (0.9 + onda * 0.12), alto * 1.6, f.tamano * (0.9 + onda * 0.12))
					p.Transparency = math.clamp(f.trans + math.abs(onda) * 0.08 + math.random() * 0.06, 0, 0.7)
				end
			end
			if os.clock() &gt;= nextBurn then
				nextBurn = os.clock() + cfg.burnEvery
				for _, other in ipairs(session.players) do
					local _, otherRoot = getRoot(other)
					if otherRoot and not session.knocked[other] then
						local away = otherRoot.Position - pos
						local flatAway = Vector3.new(away.X, 0, away.Z)
						if math.abs(away.Y) &lt; 8 and flatAway.Magnitude &lt;= cfg.radius then
							if other == thrower or not friendlyShot(session, thrower, other) then
								session:damagePlayer(other, thrower, cfg.name, cfg.burnDamage, pos)
							end
						end
					end
				end
			end
		end
		for _, f in ipairs(flames) do
			if f.part and f.part.Parent then
				f.part:Destroy()
			end
		end
	end)
end

-- Flashbang: pantalla blanca para quienes la ven sin pared en el medio.
-- Radio grande y 5 segundos de ceguera plena de cerca; una pared solo
-- amortigua la luz, no la anula del todo.
local function flashBlast(session, pos)
	local cfg = Config.Grenades.flash
	local core = cfg.radius * 0.45
	for _, other in ipairs(session.players) do
		local _, otherRoot = getRoot(other)
		if otherRoot then
			local away = otherRoot.Position - pos
			local dist = away.Magnitude
			if dist &lt;= cfg.radius then
				local params = Actions.makeDartParams(other.Character)
				local blocked = workspace:Raycast(pos, away, params)
				local dur
				if blocked then
					-- Detras de una pared igual queda un velo corto
					dur = 1
				elseif dist &lt;= core then
					-- De cerca se lleva los 5 segundos completos
					dur = cfg.maxTime
				else
					dur = math.max(1.2, cfg.maxTime * (1 - (dist - core) / (cfg.radius - core)))
				end
				Net.get("WorldEvent"):FireClient(other, "flash", { dur = dur, pos = pos })
			end
		end
	end
end

-- Fragmentación: daño con caída y empujón (también frena al kiwi)
local function fragBlast(session, thrower, pos)
	local cfg = Config.Grenades.frag
	for _, other in ipairs(session.players) do
		local _, otherRoot = getRoot(other)
		if otherRoot then
			local away = otherRoot.Position - pos
			local dist = away.Magnitude
			if dist &lt;= cfg.radius then
				local falloff = math.clamp(1 - (dist / cfg.radius) * 0.6, 0.4, 1)
				if other == thrower or not friendlyShot(session, thrower, other) then
					-- El que la tiró se lleva menos (55%) si se quedó encima
					local amount = cfg.damage * falloff * (other == thrower and 0.55 or 1)
					session:damagePlayer(other, thrower, cfg.name, amount, pos)
				end
				local pushDir = away.Magnitude &gt; 0.05 and away.Unit or Vector3.new(0, 1, 0)
				local push = pushDir * (cfg.knockback * falloff)
				otherRoot.AssemblyLinearVelocity = Vector3.new(push.X, 22, push.Z)
			end
		end
	end

	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated and (kiwi:getPosition() - pos).Magnitude &lt;= cfg.radius then
		kiwi:slow(cfg.slowFactor or 0.5, cfg.slowTime or 1.2)
	end
end

-- Detona la granada según su tipo y avisa a los clientes del efecto
local function grenadeBoom(session, nade)
	local pos = nade.pos
	if nade.tipo == "frag" then
		fragBlast(session, nade.player, pos)
	elseif nade.tipo == "humo" then
		smokeCloud(pos)
	elseif nade.tipo == "molotov" then
		fireZone(session, nade.player, pos)
	elseif nade.tipo == "flash" then
		flashBlast(session, pos)
	end
	session:event("nade", { pos = pos, tipo = nade.tipo })
end

-- Paso de una granada voladora: gravedad, rebotes y mecha
function Actions.stepGrenade(session, nade, dt)
	nade.vel = nade.vel + Vector3.new(0, -GRENADE_GRAVITY * dt, 0)
	local move = nade.vel * dt
	local pop = false
	local pos = nade.pos + move
	local hit = workspace:Raycast(nade.pos, move, nade.params)
	if hit then
		pos = hit.Position
		if nade.rompe then
			-- El molotov se rompe al primer golpe
			pop = true
		else
			local n = hit.Normal
			local v = nade.vel
			nade.vel = (v - 2 * v:Dot(n) * n) * 0.4
			pos = hit.Position + n * 0.3
		end
	end

	nade.pos = pos
	nade.fuse = (nade.fuse or 1.6) - dt
	nade.spin = (nade.spin or 0) + dt * 9
	if nade.part and nade.part.Parent then
		nade.part.CFrame = CFrame.new(pos) * CFrame.Angles(nade.spin, nade.spin * 0.7, nade.spin * 1.3)
	end

	if nade.fuse &lt;= 0 or pop then
		grenadeBoom(session, nade)
		nade.done = true
	end
end

-- Lanzar una granada del pack: sale de la mano con un arco y cae sola
function Actions.throwNade(session, player, weaponId, cfg, muzzle, dir)
	local character = player.Character
	if not character then
		return
	end
	local startPos = muzzle + dir * 1.1 + Vector3.new(0, 0.15, 0)
	local nade = Util.makePart({
		Name = cfg.name,
		ClassName = "Part",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.52, 0.52, 0.52),
		Color = cfg.color,
		Material = Enum.Material.Metal,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(startPos),
		Parent = workspace,
	})
	Util.destroyAfter(nade, (cfg.fuse or 2) + 2)

	local vel = (dir + Vector3.new(0, cfg.lift or 0.3, 0)).Unit * (cfg.speed or 80)
	table.insert(session.projectiles, {
		kind = "grenade",
		tipo = weaponId,
		rompe = weaponId == "molotov",
		part = nade,
		pos = startPos,
		vel = vel,
		fuse = cfg.fuse or 2.2,
		spin = 0,
		player = player,
		params = Actions.makeDartParams(character, nade),
	})

	ToolService.startCooldown(player, weaponId, cfg.cooldown or 0.9)
	ToolService.consumeLoot(player, weaponId)
	session:event("nadethrow", { pos = startPos, tipo = weaponId })
end

function Actions.stepProjectiles(session, dt)
	local projectiles = session.projectiles
	for i = #projectiles, 1, -1 do
		local dart = projectiles[i]

		-- Las granadas del pack vuelan aparte: gravedad, rebotes y mecha
		if dart.kind == "grenade" then
			Actions.stepGrenade(session, dart, dt)
			if dart.done then
				if dart.part and dart.part.Parent then
					dart.part:Destroy()
				end
				table.remove(projectiles, i)
			end
		else
			local stepLen = dart.speed * dt
			dart.life = dart.life - dt

			local hit = workspace:Raycast(dart.pos, dart.dir * stepLen, dart.params)
			local remove = false

			if hit then
				remove = true
				if dart.kind == "paint" then
					local character = hit.Instance:FindFirstAncestorOfClass("Model")
					local victim = character and Players:GetPlayerFromCharacter(character)
					Actions.resolvePaint(session, dart, hit, victim)
				elseif dart.kind == "slow" then
					local kiwi = session.kiwi
					if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
						kiwi:slow(Config.Relente.factor, Config.Relente.time)
						local shooterName = dart.player.DisplayName ~= "" and dart.player.DisplayName or dart.player.Name
						session:notify(dart.player, string.format(Config.Text.SlowHit, Config.Relente.time), Config.Tools.relente.color)
						session:notifyAll(string.format(Config.Text.SlowAll, shooterName), Config.Tools.relente.color)
						session:event("slowhit", { pos = hit.Position })
					else
						session:event("dartmiss", { pos = hit.Position, normal = hit.Normal })
						session:notify(dart.player, Config.Text.SlowMiss, Color3.fromRGB(200, 200, 200))
					end
				elseif dart.kind == "weapon" then
					local character = hit.Instance:FindFirstAncestorOfClass("Model")
					local victim = character and Players:GetPlayerFromCharacter(character)
					local cfg = Config.Weapons[dart.weaponId]
					if cfg and cfg.stick then
						-- La flecha queda clavada donde pego (se puede recoger)
						Actions.stickArrow(session, dart, hit.Position, hit.Normal)
					end
					Actions.weaponHit(session, dart, hit.Position, victim, hit.Instance)
				else
					local kiwi = session.kiwi
					if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
						if kiwi:sedate(session.diff.kiwi.sedateTime, dart.player) then
							session:notify(dart.player, Config.Text.DartHit, Color3.fromRGB(160, 230, 170))
							session:event("darthit", { pos = hit.Position })
						end
					else
						session:event("dartmiss", { pos = hit.Position, normal = hit.Normal })
						session:notify(dart.player, Config.Text.DartMiss, Color3.fromRGB(200, 200, 200))
						ToolService.startCooldown(dart.player, "rifle", session.diff.rifle.cooldownOnMiss)
					end
				end
			else
				dart.pos = dart.pos + dart.dir * stepLen
				if dart.life &lt;= 0 then
					-- Flechas: si se les acaba el vuelo, caen y se clavan en el piso
					local cfg = dart.weaponId and Config.Weapons[dart.weaponId]
					if cfg and cfg.stick then
						local ground = workspace:Raycast(dart.pos, Vector3.new(0, -90, 0), dart.params)
						if ground then
							Actions.stickArrow(session, dart, ground.Position, ground.Normal)
						end
					end
					remove = true
				elseif dart.kind == "paint" then
					dart.part.CFrame = CFrame.new(dart.pos)
				elseif dart.kind == "weapon" then
					dart.part.CFrame = CFrame.lookAt(dart.pos, dart.pos + dart.dir)
				else
					dart.part.CFrame = CFrame.lookAt(dart.pos, dart.pos + dart.dir) * CFrame.Angles(0, math.rad(90), 0)
				end
			end

			if remove then
				dart.part:Destroy()
				table.remove(projectiles, i)
			end
		end
	end
end

-- ===============================================================
-- RIFLE DE PINTURA (molesta a otros jugadores)
-- ===============================================================
function Actions.paint(session, player, data)
	local cfg = Config.PaintRifle
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "pintura") &gt; 0 then
		return
	end

	local muzzle, dir = aimDirection(player, root, data)
	local color = Config.Tools.pintura.color

	local ball = Util.makePart({
		Name = "BolaPintura",
		ClassName = "Part",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.34, 0.34, 0.34),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(muzzle + dir * 1.2),
		Parent = workspace,
	})
	Util.destroyAfter(ball, 6)

	local shot = {
		kind = "paint",
		part = ball,
		pos = muzzle + dir * 1.2,
		dir = dir,
		speed = cfg.speed,
		life = cfg.life,
		player = player,
		color = color,
		params = Actions.makeDartParams(character, ball),
	}

	table.insert(session.projectiles, shot)
	ToolService.startCooldown(player, "pintura", cfg.cooldown)
	session:event("paintshot", { pos = muzzle, dir = dir })
end

-- Mancha brillante visible a traves de las paredes (marca al pintado)
function Actions.markCharacter(character, color, duration, labelText, scale)
	if not character or not character.Parent then
		return
	end

	local oldHighlight = character:FindFirstChild("MarcaPintura")
	if oldHighlight then
		oldHighlight:Destroy()
	end
	local oldTag = character:FindFirstChild("EtiquetaPintura")
	if oldTag then
		oldTag:Destroy()
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MarcaPintura"
	highlight.FillColor = color or Config.Tools.pintura.color
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.35
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = character

	local anchor = character:FindFirstChild("Head") or character.PrimaryPart or character:FindFirstChildWhichIsA("BasePart")
	local tag
	if anchor then
		tag = Instance.new("BillboardGui")
		tag.Name = "EtiquetaPintura"
		tag.Size = UDim2.fromScale(3.6 * (scale or 1), 1.2 * (scale or 1))
		tag.StudsOffsetWorldSpace = Vector3.new(0, 3.4 * (scale or 1), 0)
		tag.AlwaysOnTop = true
		tag.Parent = anchor

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBlack
		text.TextScaled = true
		text.TextColor3 = color or Config.Tools.pintura.color
		text.TextStrokeTransparency = 0.25
		text.Text = labelText or "¡PINTADO!"
		text.Parent = tag
	end

	task.delay(duration, function()
		if highlight.Parent then
			highlight:Destroy()
		end
		if tag and tag.Parent then
			tag:Destroy()
		end
	end)
end

function Actions.paintPlayer(session, victim, shooter, pos, color)
	local character = victim.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid:SetAttribute("Pintado", true)
		humanoid.WalkSpeed = Config.Player.sprintSpeed * Config.PaintRifle.slowFactor
		task.delay(Config.PaintRifle.slowTime, function()
			if humanoid.Parent then
				humanoid:SetAttribute("Pintado", false)
				humanoid.WalkSpeed = Config.Player.sprintSpeed
			end
		end)
	end

	Actions.markCharacter(character, color, Config.PaintRifle.markTime)

	local function nameOf(target)
		return target.DisplayName ~= "" and target.DisplayName or target.Name
	end

	session:notify(shooter, string.format(Config.Text.PaintHit, nameOf(victim)), color)
	session:notify(victim, string.format(Config.Text.PaintVictim, nameOf(shooter)), color)
end

function Actions.resolvePaint(session, shot, hit, victim)
	-- Al kiwi lo deja marcado un rato: mas facil de seguir
	local kiwi = session.kiwi
	if kiwi and not kiwi.defeated and hit.Instance:IsDescendantOf(kiwi.model) then
		Actions.markCharacter(kiwi.model, shot.color, Config.PaintRifle.kiwiMarkTime, "¡KIWI PINTADO!", 1)
		session:event("painthit", { pos = hit.Position, color = Util.colorToTable(shot.color) })
		session:notify(shot.player, Config.Text.PaintKiwiMark, Config.Tools.pintura.color)
		return
	end

	if victim and victim ~= shot.player and session.stats[victim] then
		Actions.paintPlayer(session, victim, shot.player, hit.Position, shot.color)
		session:event("painthit", { pos = hit.Position, color = Util.colorToTable(shot.color) })
		-- Manchazo en la cabeza: le tapa la vista unos segundos (ceguera)
		if hit.Instance and hit.Instance.Name == "Head" then
			Net.get("WorldEvent"):FireClient(victim, "paintblind", {
				dur = Config.PaintRifle.blindTime or 4,
				color = Util.colorToTable(shot.color),
			})
			session:notify(victim, Config.Text.PaintBlind, shot.color, 4)
		end
		-- En Asedio la pintura tambien lastima un poco (el fuego amigo sigue bloqueado)
		if session.isAsedio then
			session:damagePlayer(victim, shot.player, "pintura", Config.Asedio.paintDamage or 11, hit.Position)
		end
		return
	end

	-- Si le pegaste a algo (piso, pared), solo queda la mancha
	session:event("paintmiss", { pos = hit.Position, normal = hit.Normal, color = Util.colorToTable(shot.color) })
end

-- ===============================================================
-- TRAMPA DE FRUTA
-- ===============================================================
function Actions.makeTrapModel(pos)
	local model = Instance.new("Model")
	model.Name = "TrampaDeFruta"
	model.Parent = workspace

	local base = Util.makePart({
		Name = "Base",
		Size = Vector3.new(2.0, 0.22, 2.0),
		Color = Color3.fromRGB(120, 92, 60),
		Material = Enum.Material.Wood,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.11, 0)),
		Parent = model,
	})

	for i = 1, 4 do
		local angle = math.rad(45 + (i - 1) * 90)
		Util.makePart({
			Name = "Varilla" .. i,
			Size = Vector3.new(0.14, 2.1, 0.14),
			Color = Color3.fromRGB(150, 118, 80),
			Material = Enum.Material.Wood,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CFrame = CFrame.new(pos + Vector3.new(math.cos(angle) * 0.85, 1.0, math.sin(angle) * 0.85))
				* CFrame.Angles(math.rad(18), 0, math.rad(-18)),
			Parent = model,
		})
	end

	Util.makePart({
		Name = "Fruta",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.7, 0.7, 0.7),
		Color = Color3.fromRGB(226, 70, 80),
		Material = Enum.Material.SmoothPlastic,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CFrame = CFrame.new(pos + Vector3.new(0, 0.55, 0)),
		Parent = model,
	})

	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 130, 120)
	glow.Range = 10
	glow.Brightness = 0.8
	glow.Parent = base

	return model
end

function Actions.trap(session, player, data)
	local cfg = Config.Trampa
	local character, root = getRoot(player)
	if not root then
		return
	end

	if ToolService.getRemaining(player, "trampa") &gt; 0 then
		return
	end

	local muzzle = root.Position + Vector3.new(0, 1.1, 0)
	local aim = data and data.aim
	local target
	if typeof(aim) == "Vector3" then
		target = aim
	else
		target = muzzle + root.CFrame.LookVector * 10
	end

	local toTarget = flat(target - muzzle)
	if toTarget.Magnitude &gt; cfg.placeRange then
		toTarget = toTarget.Unit * cfg.placeRange
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { session.arena.ground }
	params.IgnoreWater = true

	local probe = root.Position + toTarget + Vector3.new(0, 12, 0)
	local groundHit = workspace:Raycast(probe, Vector3.new(0, -90, 0), params)

	local groundPos
	if groundHit then
		groundPos = groundHit.Position
	else
		local fallback = root.Position + flat(root.CFrame.LookVector) * 8
		groundPos = Vector3.new(fallback.X, session.arena.floorY, fallback.Z)
	end
	groundPos = session.arena:clampToBounds(groundPos)

	ToolService.startCooldown(player, "trampa", cfg.cooldown)
	session:placeTrap(player, groundPos)
	session:notify(player, Config.Text.TrapPlaced, Config.Tools.trampa.color)
	session:event("trap", { pos = groundPos, userId = player.UserId })
end

-- ===============================================================
-- RASTREADOR
-- ===============================================================
function Actions.tracker(session, player)
	local trackerCfg = Config.Tracker
	if ToolService.getRemaining(player, "rastreador") &gt; 0 then
		return
	end

	ToolService.startCooldown(player, "rastreador", trackerCfg.cooldown)

	local kiwi = session.kiwi
	local _, root = getRoot(player)
	if not kiwi or kiwi.defeated or not root then
		session:notify(player, Config.Text.TrackerNothing, Color3.fromRGB(200, 200, 200))
		return
	end

	local kiwiPos = kiwi:getPosition()
	local distance = flatDistance(kiwiPos, root.Position)
	if distance &gt; trackerCfg.range then
		session:notify(player, Config.Text.TrackerNothing, Color3.fromRGB(200, 200, 200))
		return
	end

	Net.get("TrackerPing"):FireClient(player, {
		pos = kiwiPos,
		hidden = kiwi:isHidden(),
		state = session.diff.showKiwiState and kiwi:getStateHint() or nil,
		distance = distance,
		duration = trackerCfg.duration,
	})

	session:notify(player, Config.Text.TrackerFound, Color3.fromRGB(120, 220, 170))
	session:event("ping", { pos = kiwiPos, userId = player.UserId })
end

-- ===============================================================
-- Punto de entrada
-- ===============================================================
local function hasTool(player, toolId)
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in ipairs(containers) do
		if container then
			for _, item in ipairs(container:GetChildren()) do
				if item:IsA("Tool") and item:GetAttribute("ToolId") == toolId then
					return true
				end
			end
		end
	end
	return false
end

function Actions.run(session, player, toolId, data)
	if session.phase ~= "playing" then
		return
	end

	local alive, root = getRoot(player)
	if not root or not alive:FindFirstChildOfClass("Humanoid") then
		return
	end

	if not hasTool(player, toolId) then
		return
	end

	data = data or {}

	if toolId == "red" then
		Actions.net(session, player, data)
	elseif toolId == "rifle" then
		Actions.rifle(session, player, data)
	elseif toolId == "rastreador" then
		Actions.tracker(session, player, data)
	elseif toolId == "trampa" then
		Actions.trap(session, player, data)
	elseif toolId == "pintura" then
		Actions.paint(session, player, data)
	elseif toolId == "relente" then
		Actions.relente(session, player, data)
	elseif Config.Weapons[toolId] or (Config.Grenades and Config.Grenades[toolId]) then
		-- Armas de baúl y granadas del pack comparten el mismo caño de salida
		Actions.fireWeapon(session, player, toolId, data)
	end
end

return Actions
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX018">
					<Properties>
						<string name="Name">Weather</string>
						<ProtectedString name="Source">--[[
	Weather.lua  (servidor)
	Clima y paso del tiempo.

	- El reloj del mundo avanza solo: amanece, atardece y se hace de
	  noche (la luz del mapa se va apagando con el correr de la
	  partida).
	- Cada tanto el clima cambia al azar: sol, lluvia o nieve.
	- Cuando nieva, el mapa se va tapando de blanco (la nieve se
	  acumula en el piso) y cuando para, se derrite de a poco.
	- El estado viaja al cliente por atributos del workspace
	  ("Clima", "ClimaFuerza", "Nieve"): el cliente dibuja la lluvia
	  y los copos, y aca se compone la luz y la niebla.

	GameManager llama a Weather.setBase(preset) cada vez que cambia
	de arena/modo; de ahi en mas la luz final la compone este modulo
	(preset + hora + clima + nieve acumulada).
--]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local Weather = {}

local SNOW = Config.Weather.snowColor

-- Luau no permite multiplicar Color3 por un numero: se escala a mano.
local function escala(color, k)
	return Color3.new(color.R * k, color.G * k, color.B * k)
end

local state = {
	clock = 14,      -- hora del mundo (0 a 24)
	kind = "sol",    -- sol | lluvia | nieve
	force = 0,       -- 0 a 1: que tan metido esta el clima
	accum = 0,       -- 0 a 1: nieve acumulada en el piso
	painted = 0,     -- ultimo accum que se pinto en el mapa
	nextAt = 0,      -- cuando vuelve a sortear el clima
	base = nil,      -- preset de luz de la arena (sin clima)
}

local world
local painting = false
local snapshot = setmetatable({}, { __mode = "k" }) -- parte -&gt; color original

local CLIMA_COLOR = {
	sol = Color3.fromRGB(252, 220, 128),
	lluvia = Color3.fromRGB(128, 168, 220),
	nieve = Color3.fromRGB(224, 236, 250),
}

-- ===============================================================
-- Hora del mundo
-- ===============================================================
-- Cuanta luz queda segun la hora: 1 = pleno dia, de noche queda Config.Weather.night
local function dayLum(clock)
	local w = Config.Weather
	if clock &gt;= w.dawnEnd and clock &lt;= w.duskStart then
		return 1
	end
	if clock &gt; w.duskStart and clock &lt; w.duskStart + 3 then
		return 1 - (1 - w.night) * ((clock - w.duskStart) / 3)
	end
	if clock &gt;= w.duskStart + 3 or clock &lt;= 5 then
		return w.night
	end
	return w.night + (1 - w.night) * ((clock - 5) / (w.dawnEnd - 5))
end

-- ===============================================================
-- Luz compuesta: preset de la arena + hora + clima + nieve acumulada
-- ===============================================================
function Weather.apply()
	local w = Config.Weather
	local preset = state.base or Config.LightDefault
	local lum = dayLum(state.clock)
	local f = state.force

	local ambient = escala(preset.ambient, 0.35 + 0.65 * lum)
	local outdoor = escala(preset.outdoor, 0.35 + 0.65 * lum)
	local brightness = preset.brightness * (0.40 + 0.60 * lum)
	local fog = escala(preset.fog, 0.45 + 0.55 * lum)
	local fogStart = preset.fogStart
	local fogEnd = preset.fogEnd

	if state.kind == "lluvia" then
		ambient = escala(ambient, 1 - 0.25 * f)
		outdoor = escala(outdoor, 1 - 0.30 * f)
		brightness = brightness * (1 - 0.35 * f)
		fog = fog:Lerp(Color3.fromRGB(100, 108, 122), 0.60 * f)
		fogStart = fogStart * (1 - 0.45 * f)
		fogEnd = fogEnd * (1 - 0.55 * f)
	elseif state.kind == "nieve" then
		ambient = ambient:Lerp(Color3.fromRGB(172, 180, 196), 0.50 * f)
		outdoor = outdoor:Lerp(Color3.fromRGB(200, 208, 224), 0.55 * f)
		brightness = brightness * (1 - 0.18 * f)
		fog = fog:Lerp(w.snowFog, 0.75 * f)
		fogStart = fogStart * (1 - 0.40 * f)
		fogEnd = fogEnd * (1 - 0.60 * f)
	end

	-- El piso nevado devuelve luz
	if state.accum &gt; 0 then
		ambient = escala(ambient, 1 + 0.25 * state.accum)
		outdoor = escala(outdoor, 1 + 0.20 * state.accum)
	end

	Lighting.Ambient = ambient
	Lighting.OutdoorAmbient = outdoor
	Lighting.Brightness = brightness
	Lighting.FogColor = fog
	Lighting.FogStart = fogStart
	Lighting.FogEnd = fogEnd
	Lighting.ClockTime = state.clock

	-- Con mal tiempo la atmosfera se espesa
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = 0.28 + 0.22 * f
		atmosphere.Haze = 1.1 + 1.3 * f
	end
end

-- ===============================================================
-- Nieve acumulada (el mapa se pinta de blanco de a poco)
-- ===============================================================
local function pintarParte(part, target, raiz)
	local material = part.Material
	if material == Enum.Material.Neon or material == Enum.Material.Glass
		or material == Enum.Material.ForceField then
		return
	end
	if part.Transparency &gt;= 0.95 then
		return
	end
	-- Lo marcado con NoNieve no se tapa (el kiwi, por ejemplo)
	local nodo = part
	while nodo and nodo ~= raiz do
		if nodo:GetAttribute("NoNieve") then
			return
		end
		nodo = nodo.Parent
	end
	local base = snapshot[part]
	if not base then
		if target &lt;= 0 then
			return
		end
		base = part.Color
		snapshot[part] = base
	end
	part.Color = base:Lerp(SNOW, target * Config.Weather.snowWhite)
end

-- Pinta todo el mapa de a tandas para no trabar el servidor
function Weather.paint(target)
	if painting or not world then
		return false
	end
	painting = true
	task.spawn(function()
		local roots = {}
		if world.lobby and world.lobby.folder then
			table.insert(roots, world.lobby.folder)
		end
		for _, arena in ipairs(world.arenas or {}) do
			if arena.folder then
				table.insert(roots, arena.folder)
			end
		end
		local n = 0
		for _, root in ipairs(roots) do
			for _, part in ipairs(root:GetDescendants()) do
				if part:IsA("BasePart") then
					pintarParte(part, target, root)
					n = n + 1
					if n &gt;= 400 then
						n = 0
						task.wait()
					end
				end
			end
		end
		painting = false
	end)
	return true
end

-- ===============================================================
-- Clima
-- ===============================================================
local function sortear()
	local w = Config.Weather
	local total = 0
	for _, peso in pairs(w.weights) do
		total = total + peso
	end
	local sorteo = math.random() * total
	local elegido = "sol"
	for id, peso in pairs(w.weights) do
		sorteo = sorteo - peso
		if sorteo &lt;= 0 then
			elegido = id
			break
		end
	end
	-- No repite el clima anterior: siempre hay un cambio a la vista
	if elegido == state.kind then
		if state.kind == "sol" then
			elegido = math.random() &lt; 0.5 and "lluvia" or "nieve"
		elseif state.kind == "lluvia" then
			elegido = math.random() &lt; 0.5 and "sol" or "nieve"
		else
			elegido = math.random() &lt; 0.5 and "sol" or "lluvia"
		end
	end

	local rango = w.changeEvery
	state.nextAt = os.clock() + math.random(rango[1], rango[2])

	if elegido ~= state.kind then
		state.kind = elegido
		local texto = Config.Text.ClimaSol
		if elegido == "lluvia" then
			texto = Config.Text.ClimaLluvia
		elseif elegido == "nieve" then
			texto = Config.Text.ClimaNieve
		end
		for _, player in ipairs(Players:GetPlayers()) do
			Net.get("Notify"):FireClient(player, texto, Util.colorToTable(CLIMA_COLOR[elegido]), 5)
		end
	end
end

local function publicar(nombre, valor)
	if workspace:GetAttribute(nombre) ~= valor then
		workspace:SetAttribute(nombre, valor)
	end
end

function Weather.publish()
	publicar("Clima", state.kind)
	publicar("ClimaFuerza", math.floor(state.force * 50 + 0.5) / 50)
	publicar("Nieve", math.floor(state.accum * 50 + 0.5) / 50)
end

function Weather.tick(dt)
	local w = Config.Weather

	-- Paso del tiempo: un dia completo cada w.dayLength segundos
	state.clock = (state.clock + dt * 24 / w.dayLength) % 24

	if os.clock() &gt;= state.nextAt then
		sortear()
	end

	local goal = (state.kind == "sol") and 0 or 1
	local step = dt / math.max(w.blend, 0.1)
	state.force = state.force + math.clamp(goal - state.force, -step, step)

	if state.kind == "nieve" and state.force &gt; 0.35 then
		state.accum = math.min(1, state.accum + dt * w.snowGrow * state.force)
	elseif state.accum &gt; 0 then
		state.accum = math.max(0, state.accum - dt * w.snowMelt)
	end

	Weather.apply()

	if math.abs(state.accum - state.painted) &gt;= 0.035
		or (state.accum &lt;= 0 and state.painted &gt; 0) then
		if Weather.paint(state.accum) then
			state.painted = state.accum
		end
	end

	Weather.publish()
end

-- ===============================================================
-- API
-- ===============================================================
-- GameManager avisa que preset de luz corresponde (arena / lobby / modo)
function Weather.setBase(preset)
	if not preset then
		return
	end
	state.base = preset
	Weather.apply()
end

-- Solo para pruebas (AutoTest): clava un clima ya mismo
function Weather.force(kind)
	if kind ~= "sol" and kind ~= "lluvia" and kind ~= "nieve" then
		return
	end
	state.kind = kind
	state.force = (kind == "sol") and 0 or 1
	state.nextAt = os.clock() + 600
	Weather.apply()
	Weather.publish()
end

-- Arranca el reloj y el sorteo de clima (lo llama GameManager.init)
function Weather.start(gameWorld)
	world = gameWorld
	state.base = Config.LightDefault
	state.clock = Config.Weather.startClock or 15
	state.kind = "sol"
	state.force = 0
	state.accum = 0
	state.painted = 0
	local primero = Config.Weather.firstChange or Config.Weather.changeEvery
	state.nextAt = os.clock() + math.random(primero[1], primero[2])

	Weather.apply()
	Weather.publish()

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local now = os.clock()
			local dt = now - last
			last = now
			local ok, err = pcall(Weather.tick, dt)
			if not ok then
				warn("[Kiwi Cazador] clima: " .. tostring(err))
			end
		end
	end)
end

return Weather
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX019">
					<Properties>
						<string name="Name">GameManager</string>
						<ProtectedString name="Source">--[[
	GameManager.lua  (servidor)
	Maneja las partidas: quien entra, en que arena, fases de la ronda
	(cuenta regresiva / caza / resultados), el kiwi de cada sesion, los
	premios y el regreso al lobby.

	Modos:
		facil / normal / dificil  -&gt; individual, hay que atrapar N kiwis
		colosal                   -&gt; sobrevive al kiwi gigante escondiéndote
		multi                     -&gt; todos juntos, gana el primero
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Shared = require(script.Parent.Shared)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local WorldBuilder = require(script.Parent.WorldBuilder)
local KiwiController = require(script.Parent.KiwiController)
local ToolService = require(script.Parent.ToolService)
local Actions = require(script.Parent.Actions)
local Weather = require(script.Parent.Weather)

local GameManager = {}

local Session = {}
Session.__index = Session

local world
local sessions = {}
local playerSession = {}
local rematchInvites = {}
local sessionCounter = 0

local COLOR = {
	good = Color3.fromRGB(102, 209, 130),
	bad = Color3.fromRGB(232, 108, 100),
	warn = Color3.fromRGB(238, 196, 92),
	info = Color3.fromRGB(200, 214, 226),
	fx = Color3.fromRGB(160, 200, 255),
}

-- ===============================================================
-- Iluminacion (cambia segun el mapa y se restaura al salir)
-- ===============================================================
local function applyLighting(preset)
	if not preset then
		return
	end
	-- La luz final la compone Weather: preset de la arena + hora + clima
	Weather.setBase(preset)
end

local function applyZoneLighting(arena)
	local zone = arena and arena.zone
	local preset = zone and Config.ZoneLight[zone.theme or "bosque"]
	applyLighting(preset or Config.LightDefault)
end

-- ===============================================================
-- Utilidades de jugador
-- ===============================================================
local function getRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function setFrozen(player, frozen)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = frozen and 0 or Config.Player.sprintSpeed
		humanoid.JumpPower = frozen and 0 or 50
		humanoid.UseJumpPower = true
	end
end

-- Oculta el cuerpo entero dentro de un escondite (invisible para todos)
local function setBodyHidden(player, hidden)
	local character = player.Character
	if not character then
		return
	end
	for _, item in ipairs(character:GetDescendants()) do
		if item:IsA("BasePart") then
			if hidden then
				if item:GetAttribute("HideT") == nil then
					item:SetAttribute("HideT", item.Transparency)
					item.Transparency = 1
				end
			else
				local saved = item:GetAttribute("HideT")
				if saved ~= nil then
					item.Transparency = saved
					item:SetAttribute("HideT", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = hidden and Enum.HumanoidDisplayDistanceType.None
			or Enum.HumanoidDisplayDistanceType.Viewer
	end
end

local function leaderstatsFor(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end

	local function stat(name, default)
		local value = stats:FindFirstChild(name)
		if not value then
			value = Instance.new("IntValue")
			value.Name = name
			value.Value = default
			value.Parent = stats
		end
		return value
	end

	return {
		stats = stats,
		caught = stat("Kiwis", 0),
		coins = stat("Monedas", 0),
	}
end

local function addCoins(player, amount)
	local stats = leaderstatsFor(player)
	stats.coins.Value = stats.coins.Value + amount
	return stats.coins.Value
end

local function addCaught(player, amount)
	local stats = leaderstatsFor(player)
	stats.caught.Value = stats.caught.Value + amount
end

-- ===============================================================
-- SESION
-- ===============================================================
function Session.new(modeId, rng, opts)
	local self = setmetatable({}, Session)
	sessionCounter = sessionCounter + 1
	self.id = sessionCounter
	self.rng = rng or Random.new()
	self.modeId = modeId
	self.players = {}
	self.stats = {}
	self.projectiles = {}
	self.finished = false
	self.needRespawn = false
	self.respawnAt = 0
	self.kiwi = nil
	self.winner = nil
	self.arena = nil
	self.updateTimer = 0
	self.traps = {}
	self.hidden = {}
	self.hideSpot = {}
	self.isColosal = modeId == "colosal"
	self.isAsedio = modeId == "asedio"
	self.mapVote = {}
	self.chosenMap = nil
	self.voteDone = false
	self.knocked = {}
	self.looted = {}       -- quien ya saco su arma del baul de equipo (asedio)
	self.fort = nil        -- castillo del asedio (se destruye al terminar)
	self.fortChests = nil

	if modeId == "asedio" then
		self.isMulti = false
		self.diff = Config.Difficulties[Config.Asedio.baseDifficulty]
		self.name = Config.Asedio.name
		self.tag = Config.Asedio.tag
		self.color = Config.Asedio.color
		self.timeLimit = Config.Asedio.roundTime
		self.teamOf = {}
		self.teams = { attack = {}, defend = {} }
		self.teamScore = { attack = 0, defend = 0 }
		self.asedioRound = 1
		self.teamsReady = false
		self.carry = nil
		self.wipeSince = nil
		-- Como el multijugador: entre todos votan el mapa y arranca.
		self.phase = "vote"
		self.phaseEnds = os.clock() + Config.Vote.multiTime
	elseif modeId == "multi" then
		self.isMulti = true
		self.diff = Config.Difficulties[Config.Multiplayer.baseDifficulty]
		self.name = Config.Multiplayer.name
		self.tag = Config.Multiplayer.tag
		self.color = Config.Multiplayer.color
		self.timeLimit = Config.Multiplayer.timeLimit
		-- La espera inicial es la votacion de mapa: votan todos y arranca.
		self.phase = "vote"
		self.phaseEnds = os.clock() + Config.Vote.multiTime
	else
		self.isMulti = false
		self.diff = Config.Difficulties[modeId] or Config.Difficulties.normal
		self.name = self.diff.name
		self.tag = self.diff.tag
		self.color = self.diff.color
		self.timeLimit = self.diff.round.timeLimit
		-- Modo solo: elige el mapa el jugador y arranca enseguida.
		self.phase = "vote"
		self.phaseEnds = os.clock() + Config.Vote.soloTime
	end

	-- Revancha: si pidieron una arena puntual y esta libre, arranca ahi
	-- mismo (mismo modo, misma arena, sin votacion)
	if opts and opts.mapId then
		for _, arena in ipairs(world.arenas) do
			if not arena.busy and arena.mapId == opts.mapId then
				self:allocateArena(opts.mapId)
				self:startCountdown()
				break
			end
		end
	end

	return self
end

function Session:modeColorTable()
	return Util.colorToTable(self.color)
end

function Session:notify(player, text, color, duration)
	Net.get("Notify"):FireClient(player, text, Util.colorToTable(color or COLOR.info), duration or 4)
end

function Session:notifyAll(text, color, duration)
	for _, player in ipairs(self.players) do
		self:notify(player, text, color, duration)
	end
end

function Session:event(kind, data)
	Net.get("WorldEvent"):FireAllClients(kind, data)
end

-- ---------------- herramientas / trampas ----------------
-- Entrega las herramientas segun el modo (colosal solo el rastreador,
-- multijugador suma el rifle de pintura).
function Session:giveTools(player)
	if self.isAsedio then
		local side = self:asedioSide(player)
		local only = side == "defend" and Config.Asedio.toolsDefend or Config.Asedio.toolsAttack
		ToolService.give(player, only)
		-- Pistola de equipo: revolver con balas de sobra (estilo Counter)
		ToolService.giveLoot(player, "revolver", Config.Asedio.revolverUses or 40)
		return
	end
	local only = self.diff.tools
	if self.isMulti then
		only = Config.Multiplayer.tools
	end
	ToolService.give(player, only)
	if not only and not self.isColosal and not self.isMulti and #self.players &gt;= 2 then
		ToolService.giveTool(player, "pintura")
	end
end

function Session:placeTrap(player, pos)
	if self.isColosal then
		return
	end

	local cfg = Config.Trampa
	local mine = {}
	for _, trap in ipairs(self.traps) do
		if trap.owner == player then
			table.insert(mine, trap)
		end
	end

	if #mine &gt;= cfg.maxActive then
		self:removeTrap(mine[1])
	end

	local trap = {
		model = Actions.makeTrapModel(pos),
		pos = Vector3.new(pos.X, pos.Y, pos.Z),
		owner = player,
		armed = true,
	}
	table.insert(self.traps, trap)
end

function Session:removeTrap(trap)
	for index, other in ipairs(self.traps) do
		if other == trap then
			table.remove(self.traps, index)
			break
		end
	end
	trap.armed = false
	if trap.model then
		trap.model:Destroy()
		trap.model = nil
	end
end

function Session:removeTrapsOf(player)
	for index = #self.traps, 1, -1 do
		local trap = self.traps[index]
		if trap.owner == player then
			self:removeTrap(trap)
		end
	end
end

function Session:clearTraps()
	for _, trap in ipairs(self.traps) do
		trap.armed = false
		if trap.model then
			trap.model:Destroy()
			trap.model = nil
		end
	end
	self.traps = {}
end

-- ---------------- kiwi gigante ----------------
function Session:giantCatch(player)
	if not player or self.phase ~= "playing" or not self.stats[player] then
		return
	end

	self.eaten = self.eaten or {}
	if self.eaten[player] then
		return
	end
	self.eaten[player] = true

	local name = player.DisplayName ~= "" and player.DisplayName or player.Name
	self:notifyAll(string.format(Config.Text.GiantEaten, name), COLOR.bad, 5)
	self:notify(player, Config.Text.DeathSubtitle, COLOR.bad, 4)
	self:event("giantcatch", { pos = self.kiwi and self.kiwi:getPosition(), userId = player.UserId })

	-- Queda "siendo comido" dos segundos (congelado) antes de volver al lobby
	setFrozen(player, true)

	task.delay(Config.Round.EatHold, function()
		self.eaten[player] = nil
		if self.stats[player] then
			setFrozen(player, false)
			self:removePlayer(player, true)
			-- De vuelta al lobby con el menu a la vista: asi elige otro modo facil
			Net.get("SessionUpdate"):FireClient(player, { active = false })
			Net.get("Notify"):FireClient(player, Config.Text.EatenMenu, Util.colorToTable(COLOR.info), 5)
		end
	end)
end

function Session:trapCatch(bait)
	if not bait then
		return
	end

	local owner = bait.owner
	self:removeTrap(bait)

	if not owner or not self.stats[owner] then
		self:notifyAll(Config.Text.TrapEaten, COLOR.info)
		return
	end

	local name = owner.DisplayName ~= "" and owner.DisplayName or owner.Name
	self:notifyAll(string.format(Config.Text.TrapStuck, name, Config.Trampa.holdTime), COLOR.good)
	self:event("trapcatch", { pos = bait.pos })

	if self.kiwi and not self.kiwi.defeated then
		self.kiwi:trapHold(Config.Trampa.holdTime)
	end
end

-- ---------------- daño entre cazadores ----------------
-- Las armas de baul hieren a los jugadores. Al kiwi SOLO lo relentizan.
-- sourceLabel: cuando el daño no viene de un cazador (auto, tren, kiwi...)
-- se usa ese texto en lugar del mensaje de "te dio con X".
function Session:damagePlayer(victim, attacker, weaponName, amount, pos, sourceLabel)
	if not self.stats[victim] or self.phase ~= "playing" then
		return
	end
	if self.knocked[victim] then
		return
	end

	-- Asedio: no hay fuego amigo entre companeros de equipo
	if self.isAsedio and attacker and attacker ~= victim then
		local mine = self.teamOf[attacker]
		local theirs = self.teamOf[victim]
		if mine and theirs and mine == theirs then
			self:notify(attacker, "¡Es de tu equipo!", COLOR.warn, 3)
			return
		end
	end

	local data = self.stats[victim]
	amount = math.max(1, math.floor(amount + 0.5))
	data.hp = math.max(0, (data.hp or Config.Player.maxHealth) - amount)
	data.lastHurt = os.clock()

	local msg
	if sourceLabel then
		msg = string.format(Config.Text.HurtGeneric, sourceLabel, amount)
	else
		local attackerName = "el mapa"
		if attacker and attacker ~= victim then
			attackerName = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
		end
		msg = string.format(Config.Text.HurtMsg, attackerName, weaponName, amount)
	end
	self:notify(victim, msg, COLOR.bad, 3)
	self:event("hurt", { pos = pos, userId = victim.UserId, amount = amount })
	self:sendUpdate(victim)

	if data.hp &lt;= 0 then
		self:knockout(victim, attacker)
	end
end

-- Dardo tranquilizante: deja inmovil al cazador unos segundos. El estado
-- viaja como atributo "Dormido" en el Humanoid: asi el gobernador de
-- velocidad (cliente y servidor) lo respeta y no puede esquivarlo.
function Session:stun(victim, seconds, attacker)
	if not self.stats[victim] or self.knocked[victim] then
		return false
	end
	local character = victim.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return false
	end

	seconds = seconds or (Config.Tranq and Config.Tranq.stunTime) or 3
	humanoid:SetAttribute("Dormido", true)
	setFrozen(victim, true)

	task.delay(seconds, function()
		if humanoid.Parent then
			humanoid:SetAttribute("Dormido", false)
			if not self.knocked[victim] then
				setFrozen(victim, false)
			end
		end
	end)

	local vname = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
	if attacker and attacker ~= victim then
		local aname = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
		self:notifyAll(string.format(Config.Text.TranqShout, aname, vname), Color3.fromRGB(160, 230, 170), 3)
	else
		self:notifyAll(string.format(Config.Text.TranqShout, "El dardo", vname), Color3.fromRGB(160, 230, 170), 3)
	end
	return true
end

function Session:knockout(victim, attacker)
	if self.knocked[victim] or not self.stats[victim] then
		return
	end
	self.knocked[victim] = true

	local vname = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
	local aname = "la reserva"
	if attacker and attacker ~= victim then
		aname = attacker.DisplayName ~= "" and attacker.DisplayName or attacker.Name
	end
	self:notifyAll(string.format(Config.Text.KoedAll, aname, vname), COLOR.warn, 5)
	self:event("ko", { userId = victim.UserId })
	setFrozen(victim, true)

	-- Asedio: los noqueados vuelven a su spawn despues de unos segundos
	if self.isAsedio then
		self:notify(victim, string.format(Config.Text.AsedioRespawnWait, Config.Asedio.respawn), COLOR.warn, Config.Asedio.respawn)
		task.delay(Config.Asedio.respawn, function()
			self.knocked[victim] = nil
			if self.stats[victim] and not self.finished and self.phase ~= "ended" then
				self:asedioRespawn(victim)
			end
		end)
		return
	end

	task.delay(Config.Round.KoHold, function()
		self.knocked[victim] = nil
		if self.stats[victim] then
			setFrozen(victim, false)
			self:removePlayer(victim, true)
			-- Igual que cuando te come el kiwi: al lobby con el menu listo
			Net.get("SessionUpdate"):FireClient(victim, { active = false })
			Net.get("Notify"):FireClient(victim, Config.Text.KoMenu, Util.colorToTable(COLOR.info), 5)
			-- Revancha anotada: si no elige otro modo, vuelve a la misma arena
			GameManager.setRematch(victim, self)
		end
	end)
end

function Session:stepHealth(dt)
	local max = Config.Player.maxHealth
	local now = os.clock()
	for _, player in ipairs(self.players) do
		local data = self.stats[player]
		if data and data.hp and data.hp &lt; max and now - (data.lastHurt or 0) &gt;= Config.Player.regenDelay then
			data.hp = math.min(max, data.hp + Config.Player.regen * dt)
		end
	end
end

-- ---------------- asedio (5 vs 5) ----------------
-- Cazadores (entran por el kiwi) y Defensores (lo cuidan en su casa).
local teamAttackCache, teamDefendCache

local function ensureTeams()
	local Teams = game:GetService("Teams")
	if teamAttackCache and teamAttackCache.Parent then
		return
	end
	teamAttackCache = Teams:FindFirstChild(Config.Asedio.teamAttack) or Instance.new("Team")
	teamAttackCache.Name = Config.Asedio.teamAttack
	teamAttackCache.TeamColor = BrickColor.new(Config.Asedio.colorAttack)
	teamAttackCache.AutoAssignable = false
	teamAttackCache.Parent = Teams

	teamDefendCache = Teams:FindFirstChild(Config.Asedio.teamDefend) or Instance.new("Team")
	teamDefendCache.Name = Config.Asedio.teamDefend
	teamDefendCache.TeamColor = BrickColor.new(Config.Asedio.colorDefend)
	teamDefendCache.AutoAssignable = false
	teamDefendCache.Parent = Teams
end

function Session:asedioSide(player)
	return self.teamOf[player] or "attack"
end

-- Un jugador que entra a mitad de partida se suma al equipo con menos gente
function Session:asedioAddToTeam(player)
	if self.teamOf[player] then
		return
	end
	local side = #self.teams.attack &lt;= #self.teams.defend and "attack" or "defend"
	self.teamOf[player] = side
	table.insert(self.teams[side], player)
	ensureTeams()
	player.Neutral = false
	player.Team = side == "attack" and teamAttackCache or teamDefendCache
	local text = side == "attack" and Config.Text.AsedioTeamAttack or Config.Text.AsedioTeamDefend
	self:notify(player, text, side == "attack" and Config.Asedio.colorAttack or Config.Asedio.colorDefend, 8)
end

-- Reparte los equipos al azar, mitad y mitad, al arrancar la partida
function Session:assignTeams()
	if not self.isAsedio then
		return
	end
	ensureTeams()
	local list = {}
	for _, player in ipairs(self.players) do
		table.insert(list, player)
	end
	for i = #list, 2, -1 do
		local j = self.rng:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	self.teamOf = {}
	self.teams = { attack = {}, defend = {} }
	local counts = { attack = 0, defend = 0 }
	for _, player in ipairs(list) do
		local side = counts.attack &lt;= counts.defend and "attack" or "defend"
		counts[side] = counts[side] + 1
		self.teamOf[player] = side
		table.insert(self.teams[side], player)
		player.Neutral = false
		player.Team = side == "attack" and teamAttackCache or teamDefendCache
	end
	self.teamsReady = true
	for _, player in ipairs(list) do
		local side = self.teamOf[player]
		local text = side == "attack" and Config.Text.AsedioTeamAttack or Config.Text.AsedioTeamDefend
		self:notify(player, text, side == "attack" and Config.Asedio.colorAttack or Config.Asedio.colorDefend, 8)
	end
end

-- El kiwi del asedio no come cazadores: da un picotazo y los tira lejos
function Session:asedioPounce(victim, pos)
	if not victim or not self.stats[victim] or self.phase ~= "playing" then
		return
	end
	local root = getRoot(victim)
	if root and pos then
		local away = root.Position - pos
		away = Vector3.new(away.X, 0, away.Z)
		if away.Magnitude &lt; 0.5 then
			away = Vector3.new(0, 0, 1)
		end
		away = away.Unit * 42
		root.AssemblyLinearVelocity = Vector3.new(away.X, 18, away.Z)
	end
	self:event("peck", { pos = pos, userId = victim.UserId })
	self:damagePlayer(victim, nil, "picotazo", Config.KiwiPeck.damage, pos, Config.Text.AsedioPounce)
end

-- Vuelve al combate al noqueado (spawn de su equipo, vida llena y armas)
function Session:asedioRespawn(player)
	if not self.arena or not self.stats[player] then
		return
	end
	local data = self.stats[player]
	data.hp = Config.Player.maxHealth
	self:teleportToArena(player)
	self:giveTools(player)
	setFrozen(player, false)
	self:notify(player, Config.Text.AsedioBack, COLOR.good, 4)
	self:sendUpdate(player)
end

-- Limpia la ronda (kiwi, proyectiles, vida) antes de la siguiente
function Session:asedioReset()
	self.carry = nil
	self.wipeSince = nil
	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end
	for _, dart in ipairs(self.projectiles) do
		dart.part:Destroy()
	end
	self.projectiles = {}
	self:clearTraps()
	Actions.clearPickups(self)
	for _, player in ipairs(self.players) do
		if self.hideSpot[player] then
			self:exitSpot(player, true)
		end
		local data = self.stats[player]
		if data then
			data.hp = Config.Player.maxHealth
		end
		self.knocked[player] = nil
	end
end

-- Punto para un equipo: si llega a las rondas necesarias, se termina
function Session:asedioScore(side, reason)
	if not self.isAsedio or self.phase ~= "playing" then
		return
	end
	local score = self.teamScore
	score[side] = (score[side] or 0) + 1
	local attackName = Config.Asedio.teamAttack
	local defendName = Config.Asedio.teamDefend

	if reason == "capture" then
		self:notifyAll(string.format(Config.Text.AsedioCapture, attackName), Config.Asedio.colorAttack, 6)
	elseif reason == "wipe" then
		local loseName = side == "attack" and defendName or attackName
		local winName = side == "attack" and attackName or defendName
		self:notifyAll(string.format(Config.Text.AsedioWipe, loseName, winName), Config.Asedio.colorAttack, 6)
	else
		self:notifyAll(string.format(Config.Text.AsedioTimeout, defendName), Config.Asedio.colorDefend, 6)
	end
	self:notifyAll(string.format("Marcador: %s %d - %d %s", attackName, score.attack, score.defend, defendName), COLOR.info, 6)

	if score.attack &gt;= Config.Asedio.roundsToWin or score.defend &gt;= Config.Asedio.roundsToWin then
		self.asedioWinner = score.attack &gt;= Config.Asedio.roundsToWin and "attack" or "defend"
		local winnerName = self.asedioWinner == "attack" and attackName or defendName
		self:notifyAll(string.format(Config.Text.AsedioMatch, winnerName), COLOR.good, 8)
		self:endRound(nil, "teamwin")
		return
	end

	-- Siguiente ronda: descanso corto y vuelta a empezar en la casa
	self.asedioRound = (self.asedioRound or 1) + 1
	self:asedioReset()
	self:startCountdown()
	self.phaseEnds = os.clock() + Config.Asedio.breakTime
	self:notifyAll(string.format(Config.Text.AsedioNext, self.asedioRound), COLOR.info, Config.Asedio.breakTime)
	self:sendUpdates(true)
end

-- Asedio: al atrapar al kiwi los Cazadores lo alzan en brazos y tienen que
-- llevarlo a la ZONA DE EXTRACCION (marcada con un haz de luz afuera del
-- castillo). Ahi hay que aguantarlo 2 minutos; los Defensores lo rescatan
-- acercandose (al portador o al piso donde quedo).
function Session:asedioCarryStart(player)
	local nombre = player.DisplayName ~= "" and player.DisplayName or player.Name
	self.carry = {
		captor = player,
		by = player,
		hold = 0,
		inZona = false,
		warned = {},
	}
	self:notifyAll(string.format(Config.Text.AsedioCarry, nombre), Config.Asedio.colorAttack, 8)
	self:sendUpdates(true)
end

-- El portador cayo: el kiwi queda en el piso, ahi donde estaba
function Session:asedioCarryDrop()
	local carry = self.carry
	if not carry or not carry.by then
		return
	end
	carry.by = nil
	if self.kiwi then
		self.kiwi:dropHold()
	end
	self:notifyAll(Config.Text.AsedioDropped, COLOR.warn, 5)
	self:sendUpdates(true)
end

-- Un Defensor que llega hasta el kiwi capturado lo rescata: vuelve al nido
function Session:asedioRecover()
	if not self.carry then
		return false
	end
	self.carry = nil
	self:notifyAll(string.format(Config.Text.AsedioRecovered, Config.Asedio.teamDefend), Config.Asedio.colorDefend, 6)
	-- El kiwi vuelve a su nido, sano y salvo
	self:spawnKiwi()
	self:sendUpdates(true)
	return true
end

-- Pose del kiwi en brazos: adelante del pecho del portador
local function carryPose(root)
	return root.CFrame * CFrame.new(0, 1.3, -3.0) * CFrame.Angles(0, math.rad(180), 0)
end

-- Paso de la extraccion: el kiwi sigue al portador o queda en el piso, se
-- recoge al toque, los Defensores rescatan por cercania y los 2 minutos
-- dentro de la zona marcada le dan la ronda a los Cazadores.
function Session:stepCarry(dt, now)
	local carry = self.carry
	local kiwi = self.kiwi
	if not carry or not kiwi then
		return
	end
	-- Mientras el kiwi esta capturado, el reloj de la ronda se pausa
	self.startedAt = self.startedAt + dt

	-- 1) En brazos: sigue al portador (si lo noquean, queda en el piso)
	if carry.by then
		local root = getRoot(carry.by)
		if root and self.stats[carry.by] and not self.knocked[carry.by] then
			kiwi:holdAt(carryPose(root))
		else
			self:asedioCarryDrop()
		end
	end

	-- 2) Recogida: un Cazador que llega hasta el kiwi en el piso lo levanta
	if not carry.by then
		local kpos = kiwi:getPosition()
		if kpos then
			for _, player in ipairs(self.players) do
				if not self.knocked[player] and self:asedioSide(player) == "attack" then
					local root = getRoot(player)
					if root and (root.Position - kpos).Magnitude &lt;= 7 then
						carry.by = player
						local nombre = player.DisplayName ~= "" and player.DisplayName or player.Name
						self:notifyAll(string.format(Config.Text.AsedioPickup, nombre), Config.Asedio.colorAttack, 4)
						kiwi:holdAt(carryPose(root))
						break
					end
				end
			end
		end
	end

	local kpos = kiwi:getPosition()
	if not kpos then
		return
	end

	-- 3) Rescate: un Defensor que se acerca al kiwi lo libera
	local rango = Config.Asedio.recoveryRange or 7
	for _, player in ipairs(self.players) do
		if not self.knocked[player] and self:asedioSide(player) == "defend" then
			local root = getRoot(player)
			if root and (root.Position - kpos).Magnitude &lt;= rango then
				self:asedioRecover()
				return
			end
		end
	end

	-- 4) Extraccion: los 2 minutos cuentan adentro de la zona marcada
	local zona = self.fort and self.fort.zone
	if zona and (kpos - zona.pos).Magnitude &lt;= (zona.radius or 9) then
		if not carry.inZona then
			carry.inZona = true
			self:notifyAll(string.format(Config.Text.AsedioZoneIn, Config.Asedio.recoveryTime or 120), Config.Asedio.colorAttack, 5)
		end
		carry.hold = carry.hold + dt
		local tiempo = Config.Asedio.recoveryTime or 120
		local left = tiempo - carry.hold
		for _, marca in ipairs({ 30, 10, 5 }) do
			if left &lt;= marca and not carry.warned[marca] then
				carry.warned[marca] = true
				self:notifyAll(string.format(Config.Text.AsedioHoldWarn, marca), COLOR.warn, 3)
			end
		end
		if carry.hold &gt;= tiempo then
			local captor = carry.captor
			self.carry = nil
			-- Recien aca el Cazador que lo atrapo cobra las monedas
			local data = captor and self.stats[captor]
			if data then
				data.caught = (data.caught or 0) + 1
				addCaught(captor, 1)
				addCoins(captor, Config.Asedio.reward or 60)
			end
			self:asedioScore("attack", "capture")
		end
	else
		carry.inZona = false
	end
end

-- Si a un equipo lo noquean entero a la vez, el otro se lleva la ronda
function Session:stepWipe(now)
	if self.asedioWinner or not self.teams then
		return
	end
	local gente, enPie = {}, {}
	for _, side in ipairs({ "attack", "defend" }) do
		gente[side], enPie[side] = 0, 0
		for _, player in ipairs(self.teams[side] or {}) do
			if self.stats[player] then
				gente[side] = gente[side] + 1
				if not self.knocked[player] then
					enPie[side] = enPie[side] + 1
				end
			end
		end
	end
	local barrido
	if gente.attack &gt; 0 and enPie.attack == 0 and enPie.defend &gt; 0 then
		barrido = "attack"
	elseif gente.defend &gt; 0 and enPie.defend == 0 and enPie.attack &gt; 0 then
		barrido = "defend"
	end
	if not barrido then
		self.wipeSince = nil
		return
	end
	-- Se exige un momento de barrida completa (evita falsos por un parpadeo)
	self.wipeSince = self.wipeSince or now
	if now - self.wipeSince &lt; 1.2 then
		return
	end
	self.wipeSince = nil
	self:asedioScore(barrido == "attack" and "defend" or "attack", "wipe")
end

-- ---------------- trafico de la ciudad ----------------
-- Autos, colectivo y tren (solo en el mapa Ciudad). Se mueven por caminos
-- fijos y atropellan a los cazadores: mitad de la vida y empujon.
local function vehiclePose(veh, s)
	local pts, cum = veh.pts, veh.cum
	for i = 1, #pts - 1 do
		if s &lt;= cum[i + 1] or i == #pts - 1 then
			local segLen = math.max(cum[i + 1] - cum[i], 0.001)
			local t = math.clamp((s - cum[i]) / segLen, 0, 1)
			local pos = pts[i]:Lerp(pts[i + 1], t)
			local dir = (pts[i + 1] - pts[i]).Unit
			if veh.dir &lt; 0 then
				dir = -dir
			end
			return pos, dir
		end
	end
	return pts[1], Vector3.new(0, 0, 1)
end

local function placeVehicle(veh)
	-- Vehiculo destrozado por un cohete: no se mueve hasta repararse
	if veh.model and veh.model:GetAttribute("KiwiRoto") then
		return
	end
	local s = veh.dist
	if veh.dir &lt; 0 then
		s = veh.total - s
	end
	local pos, dir = vehiclePose(veh, math.clamp(s, 0, veh.total))
	pos = Vector3.new(pos.X, veh.baseY or pos.Y, pos.Z)
	local cf = CFrame.lookAt(pos, pos + dir)
	veh.model:PivotTo(cf)
	veh.pose = cf
end

function Session:resetTraffic()
	local arena = self.arena
	if not arena or not arena.traffic then
		return
	end
	for _, veh in ipairs(arena.traffic) do
		veh.dist = veh.startDist or 0
		veh.dir = 1
		veh.waitUntil = 0
		veh.lastHit = {}
		placeVehicle(veh)
	end
end

function Session:stepTraffic(dt)
	local arena = self.arena
	if not arena or not arena.traffic or #arena.traffic == 0 then
		return
	end

	local now = os.clock()

	-- Semaforos: ciclo verde -&gt; amarillo -&gt; rojo (decorativo)
	if arena.semaphores then
		local phase = now % 11
		local active = "green"
		if phase &gt;= 4.5 and phase &lt; 6 then
			active = "yellow"
		elseif phase &gt;= 6 then
			active = "red"
		end
		for _, sem in ipairs(arena.semaphores) do
			for name, part in pairs(sem) do
				local on = name == active
				part.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
				part.Transparency = on and 0 or 0.55
			end
		end
	end

	for _, veh in ipairs(arena.traffic) do
		local roto = veh.model and veh.model:GetAttribute("KiwiRoto")
		if not roto and (not veh.waitUntil or now &gt;= veh.waitUntil) then
			veh.dist = veh.dist + veh.speed * dt
			if veh.dist &gt;= veh.total then
				if veh.shuttle then
					veh.dist = 0
					veh.dir = -veh.dir
					veh.waitUntil = now + (veh.wait or 4)
				else
					veh.dist = veh.dist - veh.total
				end
			end
		end
		placeVehicle(veh)
		veh.lastHit = veh.lastHit or {}

		-- Atropello: si un cazador queda dentro del vehiculo pierde la mitad
		-- de la vida y sale volando.
		for _, player in ipairs(self.players) do
			local data = self.stats[player]
			local root = getRoot(player)
			if data and root and not self.knocked[player]
				and not (veh.model and veh.model:GetAttribute("KiwiRoto")) then
				if now - (veh.lastHit[player] or 0) &gt;= Config.City.hitCooldown then
					local localPos = veh.pose:PointToObjectSpace(root.Position)
					if math.abs(localPos.X) &lt;= veh.halfW + 2.2
						and math.abs(localPos.Z) &lt;= veh.halfL + 2.2
						and math.abs(localPos.Y) &lt;= 7 then
						veh.lastHit[player] = now
						local away = root.Position - veh.pose.Position
						away = Vector3.new(away.X, 0, away.Z)
						if away.Magnitude &lt; 0.5 then
							away = veh.pose.LookVector
						end
						away = away.Unit * 62
						root.AssemblyLinearVelocity = Vector3.new(away.X, 24, away.Z)
						self:damagePlayer(player, nil, "atropello", Config.City.damage,
							veh.pose.Position, veh.label or "Te atropellaron")
					end
				end
			end
		end
	end
end

-- ---------------- jugadores ----------------
function Session:isFull()
	if self.isAsedio then
		return #self.players &gt;= Config.Asedio.maxPlayers
	end
	if not self.isMulti then
		return #self.players &gt;= 1
	end
	return #self.players &gt;= Config.Multiplayer.maxPlayers
end

function Session:addPlayer(player)
	if self.stats[player] then
		return
	end

	self.stats[player] = { caught = 0, hp = Config.Player.maxHealth }
	table.insert(self.players, player)
	playerSession[player] = self
	ToolService.reset(player)
	if self.isAsedio and self.teamsReady then
		self:asedioAddToTeam(player)
	end

	if self.phase == "vote" then
		if self.voteDone then
			self:notify(player, "Entraste a la partida. Está por comenzar...", COLOR.good, 5)
		else
			self:notify(player, "Entraste a la partida. Vota el mapa para arrancar.", COLOR.good, 6)
		end
	elseif self.phase == "countdown" then
		local seconds = math.floor(self.phaseEnds - os.clock())
		self:notify(player, string.format("Entraste a la partida. Comienza en %d s", math.max(0, seconds)), COLOR.good)
		self:teleportToArena(player)
		self:giveTools(player)
	elseif self.phase ~= "ended" then
		self:teleportToArena(player)
		self:giveTools(player)
		if not self.isColosal then
			for _, other in ipairs(self.players) do
				if other ~= player then
					ToolService.giveTool(other, "pintura")
					self:notify(other, Config.Text.PvpRifleOn, Config.Tools.pintura.color, 6)
				end
			end
		end
		self:notify(player, "¡Te uniste a una partida en curso!", COLOR.warn)
	end

	self:sendUpdate(player)
end

function Session:removePlayer(player, silent)
	if not self.stats[player] then
		return
	end

	if self.hideSpot[player] then
		self:exitSpot(player, true)
	end

	self.stats[player] = nil
	if self.isAsedio and self.teamOf and self.teamOf[player] then
		local side = self.teamOf[player]
		self.teamOf[player] = nil
		local list = self.teams and self.teams[side]
		if list then
			for index, other in ipairs(list) do
				if other == player then
					table.remove(list, index)
					break
				end
			end
		end
	end
	for index, other in ipairs(self.players) do
		if other == player then
			table.remove(self.players, index)
			break
		end
	end

	if playerSession[player] == self then
		playerSession[player] = nil
	end

	self:removeTrapsOf(player)
	ToolService.clear(player)
	GameManager.returnToLobby(player, not silent)

	if not self.isColosal and not self.isMulti then
		for _, other in ipairs(self.players) do
			if ToolService.takeTool(other, "pintura") then
				self:notify(other, Config.Text.PvpRifleOff, COLOR.info, 4)
			end
		end
	end

	-- Multijugador: si solo queda uno, es el ganador de la ronda
	if self.isMulti and self.phase == "playing" then
		if #self.players == 1 then
			local last = self.players[1]
			local lastName = last.DisplayName ~= "" and last.DisplayName or last.Name
			self:notifyAll(string.format(Config.Text.LastAlive, lastName), COLOR.good, 6)
			self:endRound(last, "last")
		elseif #self.players == 0 then
			self:endRound(nil, "timeout")
		end
	end

	-- Votacion: si se fue un jugador y ya votaron todos, arranca la partida
	if self.phase == "vote" and not self.voteDone and #self.players &gt; 0 and self:allVoted() then
		self:pickVoteWinner()
	end
end

function Session:prunePlayers()
	for index = #self.players, 1, -1 do
		local player = self.players[index]
		if not self.stats[player] then
			table.remove(self.players, index)
		end
	end
end

-- ---------------- votacion de mapa ----------------
local function zoneById(id)
	for _, zone in ipairs(Config.Zones) do
		if zone.id == id then
			return zone
		end
	end
	return nil
end

function Session:allVoted()
	if #self.players == 0 then
		return false
	end
	for _, player in ipairs(self.players) do
		if not self.mapVote[player] then
			return false
		end
	end
	return true
end

function Session:castVote(player, mapId)
	if self.phase ~= "vote" or self.voteDone or not self.stats[player] then
		return
	end
	if mapId ~= "random" and not zoneById(mapId) then
		return
	end
	self.mapVote[player] = mapId
	self:sendUpdate(player)
	if self:allVoted() then
		self:pickVoteWinner()
	end
end

function Session:pickVoteWinner()
	if self.voteDone then
		return
	end
	self.voteDone = true

	local counts = {}
	local leader, leaderCount = nil, 0
	for _, player in ipairs(self.players) do
		local pick = self.mapVote[player]
		if pick then
			counts[pick] = (counts[pick] or 0) + 1
			if counts[pick] &gt; leaderCount then
				leader, leaderCount = pick, counts[pick]
			end
		end
	end

	-- Empate: se decide al azar entre los mas votados
	if leader then
		local top = {}
		for id, count in pairs(counts) do
			if count == leaderCount then
				table.insert(top, id)
			end
		end
		leader = top[self.rng:NextInteger(1, #top)]
	end

	local zone = zoneById(leader)
	if not zone then
		zone = Config.Zones[self.rng:NextInteger(1, #Config.Zones)]
	end

	self.chosenMap = zone.id
	self.phaseEnds = os.clock() + Config.Vote.revealTime
	self:notifyAll(string.format(Config.Text.MapPickNotify, zone.name), COLOR.good, 4)
	self:sendUpdates(true)
end

-- ---------------- arenas ----------------
function Session:allocateArena(mapId)
	if self.arena then
		return true
	end
	local fallback
	for _, arena in ipairs(world.arenas) do
		if not arena.busy then
			if not fallback then
				fallback = arena
			end
			if not mapId or arena.mapId == mapId then
				arena.busy = true
				self.arena = arena
				return true
			end
		end
	end
	if fallback then
		fallback.busy = true
		self.arena = fallback
		return true
	end
	return false
end

-- Arma el bunker de los Defensores (solo asedio, una vez por partida)
function Session:buildFort()
	if self.fort or not self.arena or not self.arena.nest then
		return
	end
	local ok, fort = pcall(WorldBuilder.buildAsedioFort, self.arena)
	if not ok or not fort then
		warn("[Kiwi Cazador] no se pudo armar el bunker del asedio: " .. tostring(fort))
		return
	end
	self.fort = fort
	self.fortChests = fort.chests
	for side, chest in pairs(fort.chests) do
		chest.team = side
		chest.teamName = side == "attack" and Config.Asedio.teamAttack or Config.Asedio.teamDefend
		chest.prompt.Triggered:Connect(function(who)
			local session = playerSession[who]
			if session then
				session:openChest(who, chest)
			end
		end)
	end
end

function Session:spawnsFor(player)
	-- Asedio: cada equipo aparece alrededor de la casa del kiwi
	if self.isAsedio and self.arena and self.arena.nest then
		local nest = self.arena.nest.pos
		local side = self:asedioSide(player)
		local list = self.teams[side] or {}
		local index = 1
		for i, other in ipairs(list) do
			if other == player then
				index = i
				break
			end
		end
		local count = math.max(1, #list)
		local angle = (index - 1) / count * math.pi * 2
		-- Los Defensores aparecen adentro del castillo, cerca de la casa
		local radius = math.min(24, (self.fort and self.fort.half or 34) - 10)
		if side == "attack" then
			radius = math.min(Config.Asedio.attackSpawn, (self.arena.halfSize or 150) - 34)
			-- Los Cazadores aparecen afuera, repartidos frente al porton
			local frente = self.fort and self.fort.front
			if frente then
				local base = math.atan2(frente.Z, frente.X)
				angle = base + (index - (count + 1) / 2) * 0.3
			else
				angle = angle + 0.7
			end
		end

		-- Busca suelo firme en ese angulo (avisa si el punto esta tapado)
		local function punto(radio)
			local p = nest + Vector3.new(math.cos(angle) * radio, 0, math.sin(angle) * radio)
			p = self.arena:clampToBounds(p)
			local params = RaycastParams.new()
			params.IgnoreWater = true
			local ray = workspace:Raycast(Vector3.new(p.X, nest.Y + 70, p.Z), Vector3.new(0, -220, 0), params)
			if ray then
				local dy = ray.Position.Y - nest.Y
				if dy &gt;= -1 and dy &lt;= 2.5 then
					return ray.Position, true
				end
			end
			return Vector3.new(p.X, self.arena.floorY or nest.Y, p.Z), false
		end

		local point, limpio = punto(radius)
		if side == "defend" and not limpio then
			-- El punto cayo sobre la casa de arriba: se corre hacia la muralla
			point = punto(math.min(30, (Config.Asedio.bunkerHalf or 34) - 4))
		end
		-- OJO: devuelve CFrame (lo usa character:PivotTo); antes daba Vector3
		return CFrame.lookAt(point + Vector3.new(0, 4, 0), Vector3.new(nest.X, point.Y + 4, nest.Z))
	end

	local index = 1
	for i, other in ipairs(self.players) do
		if other == player then
			index = i
			break
		end
	end
	local spawns = self.arena.spawns
	local spawn = spawns[((index - 1) % #spawns) + 1]
	return spawn + Vector3.new(0, 4, 0)
end

function Session:teleportToArena(player)
	if not self.arena then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local target = self:spawnsFor(player)
	if typeof(target) == "Vector3" then
		target = CFrame.new(target)
	end
	character:PivotTo(target)
	local root = getRoot(player)
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end

function Session:returnAllToLobby()
	for _, player in ipairs(self.players) do
		GameManager.returnToLobby(player)
	end
end

-- ---------------- fases ----------------
function Session:startCountdown()
	if self.isAsedio and not self.teamsReady then
		self:assignTeams()
	end
	if self.isAsedio then
		self:buildFort()
	end
	self.phase = "countdown"
	self.phaseEnds = os.clock() + Config.Round.Countdown

	for _, player in ipairs(self.players) do
		self:teleportToArena(player)
		self:giveTools(player)
		setFrozen(player, true)
	end

	self:event("countdown", { pos = self.arena.spawns[1].Position, phase = self.phase })
	self:notifyAll(string.format("Partida %s en %s", self.name, self.arena.name), self.color, Config.Round.Countdown)
	self:sendUpdates(true)
end

function Session:startPlaying()
	self.phase = "playing"
	self.startedAt = os.clock()
	self.safeAttract = 0
	applyZoneLighting(self.arena)
	local enterList = self.arena and self.arena.enterList
	if enterList then
		for _, spot in ipairs(enterList) do
			spot.occupied = nil
			spot.sniffCooldownUntil = nil
		end
	end
	local chests = self.arena and self.arena.chests
	if chests then
		for _, chest in ipairs(chests) do
			chest.used = false
			chest.lid.CFrame = chest.lidClosed
			chest.light.Brightness = 1.4
			chest.prompt.Enabled = true
		end
	end
	-- Baules de equipo del asedio: se recargan para todos cada ronda
	self.looted = {}
	if self.fortChests then
		for _, chest in pairs(self.fortChests) do
			chest.lid.CFrame = chest.lidClosed
			chest.light.Brightness = 1.4
		end
	end
	local zone = self.arena and self.arena.safeZone
	if zone then
		zone.active = false
		if zone.ring then
			zone.ring.Color = Color3.fromRGB(90, 110, 130)
			zone.ring.Transparency = 0.4
		end
		if zone.beam then
			zone.beam.Transparency = 0.85
		end
		if zone.light then
			zone.light.Brightness = 0
		end
		if zone.label then
			zone.label.Text = "ZONA SEGURA (se activa mas tarde)"
			zone.label.TextColor3 = Color3.fromRGB(150, 200, 220)
		end
	end
	self:spawnKiwi()
	self:resetTraffic()
	self:sendUpdates(true)
	for _, player in ipairs(self.players) do
		setFrozen(player, false)
		if self.isAsedio then
			local side = self:asedioSide(player)
			self:notify(player, string.format(Config.Text.AsedioRound, self.asedioRound or 1,
				Config.Asedio.teamAttack, Config.Asedio.teamDefend,
				self.teamScore.attack or 0, self.teamScore.defend or 0),
				side == "attack" and Config.Asedio.colorAttack or Config.Asedio.colorDefend, 7)
		elseif self.isColosal or self.isMulti then
			self:notify(player, "¡Escóndete! El kiwi gigante ya salió a buscar.", COLOR.warn, 6)
		else
			self:notify(player, "¡A cazar al kiwi!", COLOR.good)
		end
	end
	if self.isAsedio and self.fort then
		self:notifyAll(Config.Text.AsedioChests, COLOR.info, 7)
	end
	self:event("start", { pos = self.arena.spawns[1].Position })
end

function Session:endRound(winner, reason)
	if self.phase == "ended" then
		return
	end

	self.phase = "ended"
	self.phaseEnds = os.clock() + Config.Round.EndScreen
	self.winner = winner
	self.reason = reason

	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end
	for _, dart in ipairs(self.projectiles) do
		dart.part:Destroy()
	end
	self.projectiles = {}
	self:clearTraps()
	Actions.clearPickups(self)

	for _, player in ipairs(self.players) do
		if self.hideSpot[player] then
			self:exitSpot(player, true)
		end
		setFrozen(player, true)
		Net.get("SessionEnd"):FireClient(player, self:buildResult(player))
	end
end

function Session:buildResult(player)
	local data = self.stats[player] or { caught = 0 }
	local lines = {}
	local title, subtitle
	local won = false
	local coins = data.caught * self.diff.round.reward

	if self.isMulti then
		if self.reason == "last" and self.winner then
			local winnerName = self.winner.DisplayName ~= "" and self.winner.DisplayName or self.winner.Name
			title = "¡Ganó " .. winnerName .. "!"
			subtitle = "Último cazador en pie: el kiwi gigante se comió a los demás."
			won = (self.winner == player)
			if won then
				coins = coins + self.diff.round.winBonus
			end
		elseif self.winner then
			local winnerName = self.winner.DisplayName ~= "" and self.winner.DisplayName or self.winner.Name
			title = "Ganó " .. winnerName
			subtitle = "Ronda terminada."
			won = (self.winner == player)
			if won then
				coins = coins + self.diff.round.winBonus
			end
		else
			title = "Sobrevivieron los últimos"
			subtitle = "Se acabó el tiempo y el kiwi gigante no llegó a terminarlos."
			won = true
			coins = coins + self.diff.round.reward
		end
	elseif self.isAsedio then
		local side = self:asedioSide(player)
		local won = self.asedioWinner == side
		local attackName = Config.Asedio.teamAttack
		local defendName = Config.Asedio.teamDefend
		local score = self.teamScore or { attack = 0, defend = 0 }
		title = won and "¡Ganó tu equipo!" or "Perdiste la partida"
		subtitle = string.format("%s %d - %d %s", attackName, score.attack or 0, score.defend or 0, defendName)
		if won then
			coins = coins + (Config.Asedio.winBonus or 240)
		end
		table.insert(lines, string.format("Tu equipo: %s", side == "attack" and attackName or defendName))
		table.insert(lines, string.format("Capturas: %d", data.caught or 0))
	elseif self.isColosal then
		if self.reason == "safe" then
			title = "¡Llegaste al refugio!"
			subtitle = "Esquivaste al kiwi y entraste a la zona segura."
			won = true
			coins = coins + self.diff.round.reward + self.diff.round.winBonus
			table.insert(lines, string.format("Recompensa del refugio: %d monedas",
				self.diff.round.reward + self.diff.round.winBonus))
		elseif self.reason == "timeout" then
			title = "¡Sobreviviste!"
			subtitle = Config.Text.GiantSafe
			won = true
			coins = coins + self.diff.round.reward + self.diff.round.winBonus
			table.insert(lines, string.format("Recompensa por sobrevivir: %d monedas",
				self.diff.round.reward + self.diff.round.winBonus))
		else
			title = "El kiwi gigante te encontró"
			subtitle = "La próxima vez, escóndete mejor."
		end
	else
		local quota = self.diff.round.quota
		if self.reason == "quota" then
			title = "¡Cacería completada!"
			subtitle = string.format("Atrapaste %d de %d kiwis", data.caught, quota)
			won = true
			coins = coins + self.diff.round.winBonus
			local bonus = self:remainingSeconds()
			if bonus &gt; 0 then
				coins = coins + math.floor(bonus * self.diff.round.timeBonus)
				table.insert(lines, string.format("Bono por tiempo: +%d monedas", math.floor(bonus * self.diff.round.timeBonus)))
			end
		else
			title = "Se escapó el kiwi"
			subtitle = string.format("Atrapaste %d de %d kiwis antes de que se acabara el tiempo", data.caught, quota)
		end
	end

	table.insert(lines, string.format("Kiwis atrapados: %d", data.caught))
	table.insert(lines, string.format("Monedas ganadas: %d", coins))

	local ranking = {}
	for _, other in ipairs(self.players) do
		local otherStats = self.stats[other]
		table.insert(ranking, {
			name = other.DisplayName ~= "" and other.DisplayName or other.Name,
			caught = otherStats and otherStats.caught or 0,
			isWinner = other == self.winner,
			isSelf = other == player,
		})
	end

	addCoins(player, coins)

	return {
		title = title,
		subtitle = subtitle,
		won = won,
		lines = lines,
		ranking = ranking,
		color = Util.colorToTable(won and COLOR.good or COLOR.bad),
		modeName = self.name,
		arenaName = self.arena and self.arena.name or "?",
	}
end

function Session:remainingSeconds()
	if self.phase == "playing" then
		return math.max(0, self.startedAt + self.timeLimit - os.clock())
	elseif self.phase == "vote" or self.phase == "countdown" or self.phase == "ended" then
		return math.max(0, self.phaseEnds - os.clock())
	end
	return 0
end

function Session:finish()
	if self.finished then
		return
	end
	self.finished = true
	applyLighting(Config.LightDefault)

	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end
	for _, dart in ipairs(self.projectiles) do
		dart.part:Destroy()
	end
	self.projectiles = {}
	self:clearTraps()
	Actions.clearPickups(self)

	if self.fort then
		-- self.fort es la tabla del castillo { folder = ..., chests = ... }:
		-- hay que destruir la carpeta, no la tabla
		if self.fort.folder then
			self.fort.folder:Destroy()
		end
		self.fort = nil
		self.fortChests = nil
	end

	if Config.Round.HubReturn then
		self:returnAllToLobby()
	end
	for _, player in ipairs(self.players) do
		-- Revancha: se anota el modo y la arena para volver a la misma
		GameManager.setRematch(player, self)
		if self.isAsedio then
			player.Team = nil
			player.Neutral = true
		end
		ToolService.clear(player)
		Net.get("SessionUpdate"):FireClient(player, { active = false })
		if playerSession[player] == self then
			playerSession[player] = nil
		end
	end

	if self.arena then
		self.arena.busy = false
		self.arena = nil
	end
end

-- ---------------- kiwi ----------------
function Session:spawnKiwi()
	if self.kiwi then
		self.kiwi:destroy()
		self.kiwi = nil
	end

	local cfg = self.diff.kiwi
	local opts
	if self.isAsedio then
		-- El kiwi vive en su casa: no se aleja del nido (modo 5 vs 5)
		opts = { brain = "hider" }
		local nest = self.arena and self.arena.nest
		if nest then
			opts.spawn = nest.pos
			opts.leash = { pos = nest.pos, radius = Config.Asedio.nestRadius }
		end
	elseif self.isColosal or self.isMulti then
		if self.isMulti then
			cfg = Config.Difficulties.colosal.kiwi
		end
		opts = { brain = "seeker", scale = cfg.scale or 4 }
	end

	self.kiwi = KiwiController.new(self.arena, cfg, self.rng, {
		onEvent = function(kind, data)
			self:onKiwiEvent(kind, data)
		end,
		onTouchCapture = function(kiwi, player)
			self:onKiwiTouch(kiwi, player)
		end,
	}, opts)
end

function Session:onKiwiEvent(kind, data)
	local pos = data and (data.pos or (data.spot and data.spot.hidePoint))
	if kind == "flush" then
		self:notifyAll(Config.Text.KiwiRunning, COLOR.warn)
		self:event("flush", { pos = pos })
	elseif kind == "sedate" then
		self:notifyAll(Config.Text.KiwiSleeping, COLOR.good)
		self:event("sedate", { pos = pos })
	elseif kind == "wake" then
		self:notifyAll(Config.Text.WakeUp, COLOR.bad)
		self:event("wake", { pos = pos })
	elseif kind == "tired" then
		self:notifyAll("¡El kiwi está agotado!", COLOR.info)
	elseif kind == "capture" then
		self:event("captured", { pos = pos })
	elseif kind == "trapcatch" then
		self:trapCatch(data and data.bait)
	elseif kind == "trapescape" then
		self:notifyAll(Config.Text.TrapEscaped, COLOR.warn)
		self:event("trapescape", { pos = pos })
	elseif kind == "slowend" then
		self:notifyAll(Config.Text.SlowEnd, COLOR.info)
	elseif kind == "hunt" then
		self:notifyAll("¡El kiwi gigante te escuchó! Corre.", COLOR.bad, 4)
		self:event("hunt", { pos = pos })
	elseif kind == "roar" then
		self:event("roar", { pos = pos })
	elseif kind == "chomp" then
		self:event("chomp", { pos = pos })
	elseif kind == "sniffstart" then
		self:event("sniffstart", { pos = pos, index = data and data.index })
		local victim = data and data.player
		if victim and self.stats[victim] then
			self:notify(victim, "¡El kiwi te está husmeando! Sal con E y corre", COLOR.bad, 4)
		end
	elseif kind == "sniff" then
		self:event("sniff", { pos = pos, index = data and data.index })
	elseif kind == "sniffmiss" then
		self:event("sniffmiss", { pos = pos, index = data and data.index })
	elseif kind == "sniffcatch" then
		local victim = data and data.player
		if victim and self.stats[victim] and self.hidden[victim] then
			self:exitSpot(victim, true)
			local name = victim.DisplayName ~= "" and victim.DisplayName or victim.Name
			self:notifyAll(string.format(Config.Text.SniffCaught, name), COLOR.bad, 5)
		end
		self:event("sniffcatch", { pos = pos, index = data and data.index })
		if victim and self.stats[victim] then
			if self.isAsedio then
				self:asedioPounce(victim, pos)
			else
				self:giantCatch(victim)
			end
		end
	elseif kind == "peck" then
		-- Kiwi acorralado: picotazo a quien lo tiene arrinconado
		local victim = data and data.player
		if victim and self.stats[victim] and self.phase == "playing" then
			local root = getRoot(victim)
			if root and pos then
				local away = root.Position - pos
				away = Vector3.new(away.X, 0, away.Z)
				if away.Magnitude &lt; 0.5 then
					away = Vector3.new(0, 0, 1)
				end
				away = away.Unit * Config.KiwiPeck.knockback
				root.AssemblyLinearVelocity = Vector3.new(away.X, 16, away.Z)
			end
			self:event("peck", { pos = pos, userId = victim.UserId })
			self:damagePlayer(victim, nil, "picotazo", Config.KiwiPeck.damage, pos, Config.Text.PeckHit)
		end
	elseif kind == "catch" then
		local victim = data and data.player
		if self.isAsedio then
			self:asedioPounce(victim, pos)
		else
			self:giantCatch(victim)
		end
	end
end

function Session:onKiwiTouch(kiwi, player)
	if self.phase ~= "playing" or self.kiwi ~= kiwi then
		return
	end
	if not self.stats[player] then
		return
	end
	if kiwi.state == "trapped" then
		self:capture(player, "fruta")
	else
		self:capture(player, "manos")
	end
end

function Session:capture(player, method)
	if self.phase ~= "playing" or not self.kiwi or self.kiwi.defeated then
		return
	end
	local data = self.stats[player]
	if not data then
		return
	end

	-- Asedio: solo los Cazadores capturan; si toca un Defensor, no pasa nada
	if self.isAsedio then
		if self:asedioSide(player) ~= "attack" then
			self:notify(player, "¡Ese es tu kiwi! Cuídenlo de los Cazadores.", COLOR.warn, 4)
			return
		end
		self.kiwi:capture(player)
		self:event("captured", { pos = self.kiwi and self.kiwi:getPosition() })
		-- No hay punto instantaneo: el kiwi queda en brazos y hay que
		-- llevarlo a la zona de extraccion y aguantarlo ahi 2 minutos
		self:asedioCarryStart(player)
		return
	end

	self.kiwi:capture(player)
	data.caught = data.caught + 1
	addCaught(player, 1)
	addCoins(player, self.diff.round.reward)

	local name = player.DisplayName ~= "" and player.DisplayName or player.Name
	if method == "manos" then
		self:notifyAll(name .. " atrapó al kiwi dormido!", COLOR.good)
	elseif method == "trampa" then
		self:notifyAll(string.format(Config.Text.TrapCaptured, name), COLOR.good)
	elseif method == "fruta" then
		self:notifyAll(name .. " aprovechó que estaba enganchado en la fruta!", COLOR.good)
	else
		self:notifyAll(name .. " atrapó al kiwi con la red!", COLOR.good)
	end
	self:event("captured", { pos = self.kiwi and self.kiwi:getPosition() })

	if self.isMulti then
		self:endRound(player, "captured")
		return
	end

	if data.caught &gt;= self.diff.round.quota then
		self:endRound(player, "quota")
	else
		self.needRespawn = true
		self.respawnAt = os.clock() + Config.Round.KiwiRespawnDelay
		self:notify(player, string.format("Tienes %d de %d. El próximo kiwi ya casi aparece...", data.caught, self.diff.round.quota), COLOR.info)
	end
end

-- ---------------- escondites de jugador ----------------
function Session:enterSpot(player, index)
	if self.phase ~= "playing" then
		return
	end
	local arena = self.arena
	local spot = arena and arena.enterList and arena.enterList[index]
	if not spot or not spot.enter then
		return
	end

	local character = player.Character
	local root = getRoot(player)
	if not character or not root or self.hidden[player] then
		return
	end

	if spot.occupied and spot.occupied ~= player then
		self:notify(player, Config.Text.HideBusy, COLOR.warn, 3)
		return
	end

	if (root.Position - spot.enter.inside.Position).Magnitude &gt; Config.Hide.enterRange then
		return
	end

	spot.occupied = player
	self.hidden[player] = true
	self.hideSpot[player] = index

	local prompt = spot.enter.prompt
	if prompt then
		prompt.ActionText = "Salir"
	end

	setFrozen(player, true)
	setBodyHidden(player, true)
	root.CFrame = spot.enter.inside
	root.AssemblyLinearVelocity = Vector3.zero
	if spot.enter.door and spot.enter.doorOpen then
		spot.enter.door.CFrame = spot.enter.doorOpen
	end

	local kiwi = self.kiwi
	if kiwi and kiwi.state == "sniff" and kiwi.sniffIndex == index then
		self:notify(player, "¡El kiwi ya estaba husmeando aquí! Aguanta o sal y corre", COLOR.bad, 4)
	end

	self:event("hidestart", { pos = spot.hidePoint, index = index })
	self:sendUpdate(player)
end

function Session:exitSpot(player, caught)
	local index = self.hideSpot[player]
	if not index then
		return
	end
	local arena = self.arena
	local spot = arena and arena.enterList and arena.enterList[index]

	self.hideSpot[player] = nil
	self.hidden[player] = nil
	if spot then
		spot.occupied = nil
		if spot.enter.door and spot.enter.doorClosed then
			spot.enter.door.CFrame = spot.enter.doorClosed
		end
		if spot.enter.wobble and spot.enter.wobbleCF then
			spot.enter.wobble.CFrame = spot.enter.wobbleCF
		end
		if spot.enter.prompt then
			spot.enter.prompt.ActionText = "Esconderse"
		end
	end

	setBodyHidden(player, false)
	local root = getRoot(player)
	if root and spot and spot.enter.exit then
		root.CFrame = spot.enter.exit
		root.AssemblyLinearVelocity = Vector3.zero
	end

	local kiwi = self.kiwi
	local sniffed = kiwi and kiwi.state == "sniff" and kiwi.sniffIndex == index
	if caught then
		setFrozen(player, true)
		return
	end

	setFrozen(player, false)
	self:event("hidestop", { index = index, pos = spot and spot.hidePoint })
	if sniffed then
		-- Salio justo mientras lo husmeaban: premio y el kiwi le sale
		-- al paso al instante (el "casi" clasico del escondite)
		addCoins(player, Config.Hide.escapeCoins)
		self:notify(player, string.format(Config.Text.HideEscape, Config.Hide.escapeCoins), COLOR.good, 4)
		kiwi:sniffMiss(root and root.Position or nil)
	end
	self:sendUpdate(player)
end

-- ---------------- baules de armas ----------------
-- Reparte un arma de baul (lo usan los baules comunes y los de equipo)
function Session:lootChest(player, chest)
	local weapons = Config.Loot.weapons
	local total = 0
	for _, entry in ipairs(weapons) do
		total = total + (entry.weight or 1)
	end

	-- Mas aleatorio: se evita repetir la ultima arma que saco ESE jugador
	-- (hasta 3 intentos), asi no toca siempre lo mismo.
	local stats = self.stats[player]
	local last = stats and stats.lastLoot
	local pick = weapons[1]
	for _ = 1, 3 do
		local roll = self.rng:NextInteger(1, math.max(total, 1))
		pick = weapons[1]
		for _, entry in ipairs(weapons) do
			roll = roll - (entry.weight or 1)
			if roll &lt;= 0 then
				pick = entry
				break
			end
		end
		if pick.id ~= last then
			break
		end
	end
	if stats then
		stats.lastLoot = pick.id
	end

	-- Un arma de baul a la vez: la anterior se pierde
	for _, entry in ipairs(weapons) do
		ToolService.takeTool(player, entry.id)
	end
	ToolService.giveLoot(player, pick.id, pick.uses or Config.Loot.uses)

	-- Ademas del arma, cada baul suelta el pack de granadas
	ToolService.giveNadePack(player)

	local cfg = Config.Weapons[pick.id]
	self:notify(player, string.format(Config.Text.ChestLoot, cfg.name, pick.uses or Config.Loot.uses), cfg.color, 5)
	self:notify(player, Config.Text.ChestPack, Color3.fromRGB(188, 198, 210), 5)
	self:event("chestopen", { pos = chest.center })
	self:sendUpdate(player)
end

function Session:openChest(player, chest)
	if not chest then
		return
	end
	if self.phase ~= "playing" or self.hidden[player] then
		return
	end
	local root = getRoot(player)
	if not root or (root.Position - chest.center).Magnitude &gt; Config.Loot.pickupRange + 2 then
		return
	end

	-- Baul de equipo (asedio): cada jugador saca UNA sola arma por ronda
	if chest.team then
		local side = self.teamOf[player] or "attack"
		if side ~= chest.team then
			self:notify(player, string.format(Config.Text.ChestTeamWrong, chest.teamName or chest.team), COLOR.warn, 4)
			return
		end
		if self.looted[player] then
			self:notify(player, Config.Text.ChestTeamDone, COLOR.warn, 4)
			return
		end
		self.looted[player] = true
		-- La tapa se abre y se vuelve a cerrar: el baul queda para el resto
		chest.lid.CFrame = chest.lidOpen
		task.delay(1.1, function()
			if chest.lid and chest.lid.Parent then
				chest.lid.CFrame = chest.lidClosed
			end
		end)
		self:lootChest(player, chest)
		return
	end

	if chest.used then
		return
	end
	chest.used = true
	chest.lid.CFrame = chest.lidOpen
	chest.light.Brightness = 0
	chest.prompt.Enabled = false
	self:lootChest(player, chest)
end

-- ---------------- bucle ----------------
function Session:buildPlayerList()
	local list = {}
	for _, player in ipairs(self.players) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health &gt; 0 then
			local hidden = self.hidden[player] == true
			local indoor = false
			if not hidden and self.arena and self.arena.indoors then
				for _, room in ipairs(self.arena.indoors) do
					local rel = room.cf:PointToObjectSpace(root.Position)
					if math.abs(rel.X) &lt;= room.size.X * 0.5
						and math.abs(rel.Z) &lt;= room.size.Z * 0.5
						and rel.Y &gt;= -2 and rel.Y &lt;= room.size.Y + 3 then
						indoor = true
						break
					end
				end
			end
			local velocity = root.AssemblyLinearVelocity
			local speed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z)
			local noise = math.clamp((speed - 6) / 14, 0, 1)
			if humanoid.FloorMaterial == Enum.Material.Air then
				noise = math.min(1, noise + 0.35)
			end
			if indoor then
				noise = noise * Config.Hide.smellIndoor
			end
			table.insert(list, {
				player = player,
				pos = root.Position,
				noise = noise,
				speed = speed,
				hidden = hidden,
				indoor = indoor,
			})
		end
	end
	return list
end

function Session:stepSafeZone(dt)
	local zone = self.arena and self.arena.safeZone
	if not zone then
		return
	end

	if not zone.active then
		local elapsed = os.clock() - (self.startedAt or os.clock())
		if elapsed &gt;= Config.SafeZone.activateAfter then
			zone.active = true
			if zone.ring then
				zone.ring.Color = Color3.fromRGB(120, 255, 190)
				zone.ring.Transparency = 0.1
			end
			if zone.beam then
				zone.beam.Transparency = 0.35
			end
			if zone.light then
				zone.light.Brightness = 2.6
			end
			if zone.label then
				zone.label.Text = "¡ENTRA PARA GANAR!"
				zone.label.TextColor3 = Color3.fromRGB(150, 255, 200)
			end
			self.safeAttract = 0
			self:notifyAll(Config.Text.SafeActive, COLOR.good, 6)
			self:event("safeactive", { pos = zone.center })
		end
		return
	end

	local player = self.players[1]
	local root = player and getRoot(player)
	if not player or not root then
		return
	end

	-- Llego al refugio: gana al instante
	local offset = zone.center - root.Position
	offset = Vector3.new(offset.X, 0, offset.Z)
	if offset.Magnitude &lt;= zone.radius then
		self:endRound(player, "safe")
		return
	end

	-- El kiwi le corta el paso: se planta entre el cazador y el refugio
	self.safeAttract = (self.safeAttract or 0) - dt
	if self.safeAttract &lt;= 0 and self.kiwi and not self.kiwi.defeated then
		self.safeAttract = Config.SafeZone.attractEvery
		local blockPoint = root.Position
		if offset.Magnitude &gt; 0.1 then
			blockPoint = root.Position + offset.Unit * math.min(offset.Magnitude * 0.5, 22)
		end
		self.kiwi:goHuntZone(blockPoint)
	end
end

function Session:step(dt)
	local now = os.clock()
	self:prunePlayers()

	if #self.players == 0 and self.phase ~= "ended" then
		self:finish()
		return
	end

	if self.phase == "vote" then
		if not self.voteDone then
			if self:allVoted() or now &gt;= self.phaseEnds then
				self:pickVoteWinner()
			end
		elseif now &gt;= self.phaseEnds then
			if self:allocateArena(self.chosenMap) then
				if self.chosenMap and self.arena.mapId ~= self.chosenMap then
					self:notifyAll(string.format(Config.Text.MapFallback, self.arena.name), COLOR.warn, 5)
				end
				self:startCountdown()
			else
				self.phaseEnds = now + 6
				self:notifyAll(Config.Text.NoArena, COLOR.warn, 5)
			end
		end
	elseif self.phase == "countdown" then
		if now &gt;= self.phaseEnds then
			self:startPlaying()
		end
	elseif self.phase == "playing" then
		if self.isAsedio and self.carry then
			-- Kiwi capturado: sigue al portador, rescate y cuenta de la zona
			self:stepCarry(dt, now)
		end
		if self.isAsedio and self.phase == "playing" then
			-- Equipo eliminado entero: punto para el rival
			self:stepWipe(now)
		end
		if self.timeLimit and not self.carry and self.phase == "playing" and now &gt;= self.startedAt + self.timeLimit then
			if self.isAsedio then
				-- Se acabó el tiempo: punto para los Defensores
				self:asedioScore("defend", "timeout")
			else
				self:notifyAll("¡Se acabó el tiempo!", COLOR.bad)
				self:endRound(nil, "timeout")
			end
		else
			self:stepHealth(dt)
			self:stepTraffic(dt)
			if self.isColosal then
				self:stepSafeZone(dt)
			end
			if self.phase == "playing" then
				if self.needRespawn and now &gt;= self.respawnAt then
					self.needRespawn = false
					self:spawnKiwi()
				end
				if self.kiwi then
					self.kiwi:step(dt, self:buildPlayerList(), self.traps)
				end
				Actions.stepProjectiles(self, dt)
			end
		end
	elseif self.phase == "ended" then
		if now &gt;= self.phaseEnds then
			self:finish()
		end
	end

	self.updateTimer = self.updateTimer + dt
	if self.updateTimer &gt;= Config.Round.UpdateInterval then
		self:sendUpdates()
	end
end

-- ---------------- estado hacia el cliente ----------------
function Session:sendUpdate(player)
	if not self.stats[player] then
		return
	end

	local data = self.stats[player]
	local quota = self.isMulti and 1 or self.diff.round.quota
	local objective
	local progressText
	if self.phase == "vote" then
		if self.isMulti or self.isAsedio then
			objective = "¡Voten el mapa de la partida!"
		else
			objective = "¡Elige el mapa de la partida!"
		end
		progressText = self.voteDone and "¡Arrancando!" or string.format("Votación: %d s",
			math.max(0, math.ceil(self.phaseEnds - os.clock())))
	elseif self.isMulti then
		objective = "Sobrevive al kiwi gigante: gana el último en pie"
		local kiwi = self.kiwi
		local root = getRoot(player)
		if kiwi and not kiwi.defeated and root and (kiwi:getPosition() - root.Position).Magnitude &lt; 70 then
			progressText = "¡El kiwi gigante está cerca de ti!"
		else
			progressText = string.format("Cazadores vivos: %d", #self.players)
		end
	elseif self.isAsedio then
		local side = self:asedioSide(player)
		local root = getRoot(player)
		if self.carry then
			local zona = self.fort and self.fort.zone
			local kpos = self.kiwi and self.kiwi:getPosition()
			local enZona = zona and kpos and (kpos - zona.pos).Magnitude &lt;= (zona.radius or 9)
			if side == "attack" then
				if enZona then
					local left = math.max(0, math.ceil((Config.Asedio.recoveryTime or 120) - (self.carry.hold or 0)))
					objective = "¡Aguanten la extracción!"
					progressText = string.format("Extracción: %d s", left)
				elseif self.carry.by then
					objective = "¡Lleven al kiwi a la ZONA marcada!"
					progressText = "Sigan el haz de luz frente al castillo"
				else
					objective = "¡Levanten al kiwi del piso!"
					progressText = "Quedó donde cayó el portador"
				end
			else
				objective = "¡Rescaten al kiwi!"
				if root and kpos then
					progressText = string.format("Kiwi a %d studs", (kpos - root.Position).Magnitude)
				else
					progressText = "Corran hasta el kiwi"
				end
			end
		else
			local kiwi = self.kiwi
			local near = kiwi and not kiwi.defeated and root
				and (kiwi:getPosition() - root.Position).Magnitude &lt; 40
			if side == "attack" then
				objective = "Atrapa al kiwi y llévalo a la ZONA marcada"
				progressText = near and "¡El kiwi está cerca! Atrapalo" or "Entra al castillo: portón, ductos, subsuelo o techo"
			else
				objective = "Cuida al kiwi en su castillo"
				progressText = near and "¡El kiwi está contigo! Cúbrelo" or "El kiwi está en su castillo"
			end
		end
	elseif self.isColosal then
		local zone = self.arena and self.arena.safeZone
		if zone and zone.active then
			objective = "¡Corre a la ZONA SEGURA!"
			local kiwi = self.kiwi
			local root = getRoot(player)
			if kiwi and not kiwi.defeated and root and (kiwi:getPosition() - root.Position).Magnitude &lt; 45 then
				progressText = "¡El kiwi te corta el paso! Frénalo y esquívalo"
			else
				progressText = "Entra al círculo para ganar"
			end
		else
			objective = "Escóndete del kiwi gigante"
			local kiwi = self.kiwi
			local root = getRoot(player)
			if kiwi and not kiwi.defeated and root then
				local distance = (kiwi:getPosition() - root.Position).Magnitude
				if distance &lt; 70 then
					progressText = "¡Está muy cerca de ti!"
				else
					progressText = string.format("Cazadores escondidos: %d", #self.players)
				end
			else
				progressText = "¡Corre y escóndete!"
			end
		end
	else
		objective = string.format("Atrapa %d kiwis", quota)
	end

	if self.hidden[player] then
		progressText = "Escondido: pulsa E para salir"
	end

	local voteCounts = nil
	if self.phase == "vote" then
		voteCounts = {}
		for _, other in ipairs(self.players) do
			local pick = self.mapVote[other]
			if pick then
				voteCounts[pick] = (voteCounts[pick] or 0) + 1
			end
		end
	end

	local ranking = {}
	for _, other in ipairs(self.players) do
		local otherStats = self.stats[other]
		table.insert(ranking, {
			name = other.DisplayName ~= "" and other.DisplayName or other.Name,
			caught = otherStats and otherStats.caught or 0,
			isSelf = other == player,
			team = self.isAsedio and self.teamOf[other] or nil,
		})
	end
	table.sort(ranking, function(a, b)
		if a.caught == b.caught then
			return a.name &lt; b.name
		end
		return a.caught &gt; b.caught
	end)

	Net.get("SessionUpdate"):FireClient(player, {
		active = true,
		modeId = self.modeId,
		modeName = self.name,
		modeTag = self.tag,
		modeColor = self:modeColorTable(),
		phase = self.phase,
		timeLeft = self:remainingSeconds(),
		objective = objective,
		caught = data.caught,
		quota = quota,
		kiwiState = self.diff.showKiwiState and self.kiwi and self.kiwi:getStateHint() or nil,
		arenaName = self.arena and self.arena.name or nil,
		players = ranking,
		playerCount = #self.players,
		isMulti = self.isMulti,
		isAsedio = self.isAsedio or nil,
		team = self.isAsedio and self:asedioSide(player) or nil,
		teamScore = self.isAsedio and { attack = self.teamScore.attack, defend = self.teamScore.defend } or nil,
		round = self.isAsedio and self.asedioRound or nil,
		roundsToWin = self.isAsedio and Config.Asedio.roundsToWin or nil,
		waiting = self.phase == "vote",
		vote = self.phase == "vote" and {
			done = self.voteDone or false,
			chosen = self.chosenMap,
			mine = self.mapVote[player],
			total = #self.players,
			left = math.max(0, math.ceil(self.phaseEnds - os.clock())),
			counts = voteCounts,
		} or nil,
		hp = math.floor(data.hp or Config.Player.maxHealth),
		maxHp = Config.Player.maxHealth,
		progressText = progressText,
		hidden = self.hidden[player] == true or nil,
		hideSpot = self.hideSpot[player] or nil,
		limitedTools = self.isAsedio
			and (self:asedioSide(player) == "defend" and Config.Asedio.toolsDefend or Config.Asedio.toolsAttack)
			or self.diff.tools,
		paint = self.isAsedio or (not self.isColosal and (self.isMulti or #self.players &gt;= 2)),
	})
end

function Session:sendUpdates(forced)
	if forced then
		self.updateTimer = 0
	end
	for _, player in ipairs(self.players) do
		self:sendUpdate(player)
	end
end

-- ===============================================================
-- GAME MANAGER
-- ===============================================================
function GameManager.init()
	Net.init()
	world = WorldBuilder.build(Config)
	ToolService.build()
	Weather.start(world)

	workspace.Gravity = Config.World.Gravity

	GameManager.world = world

	Players.PlayerAdded:Connect(function(player)
		GameManager.setupPlayer(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		GameManager.setupPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local session = playerSession[player]
		if session then
			session:removePlayer(player, true)
		end
		playerSession[player] = nil
	end)

	Net.get("RequestJoin").OnServerEvent:Connect(function(player, modeId)
		GameManager.requestJoin(player, modeId)
	end)

	Net.get("RequestLeave").OnServerEvent:Connect(function(player)
		GameManager.requestLeave(player)
	end)

	Net.get("RequestState").OnServerEvent:Connect(function(player)
		local session = playerSession[player]
		if session then
			session:sendUpdate(player)
		else
			Net.get("SessionUpdate"):FireClient(player, { active = false })
		end
	end)

	Net.get("VoteMap").OnServerEvent:Connect(function(player, mapId)
		local session = playerSession[player]
		if session and type(mapId) == "string" then
			session:castVote(player, mapId)
		end
	end)

	Net.get("ToolAction").OnServerEvent:Connect(function(player, toolId, data)
		local session = playerSession[player]
		if not session or type(toolId) ~= "string" then
			return
		end
		-- Noqueado: no puede disparar ni usar herramientas hasta volver
		if session.knocked[player] then
			return
		end
		if toolId ~= "red" and toolId ~= "rifle" and toolId ~= "rastreador"
			and toolId ~= "trampa" and toolId ~= "pintura" and toolId ~= "relente"
			and Config.Weapons[toolId] == nil
			and (Config.Grenades == nil or Config.Grenades[toolId] == nil) then
			return
		end
		local ok, err = pcall(Actions.run, session, player, toolId, data)
		if not ok then
			warn("[Kiwi Cazador] error en herramienta: " .. tostring(err))
		end
	end)

	-- Escondites y baules: cada arena conecta los avisos de sus prompts
	for _, arena in ipairs(world.arenas) do
		for _, spot in ipairs(arena.enterList or {}) do
			local prompt = spot.enter and spot.enter.prompt
			if prompt then
				local spotIndex = spot.enterIndex
				prompt.Triggered:Connect(function(who)
					local session = playerSession[who]
					if not session then
						return
					end
					if session.hideSpot[who] == spotIndex then
						session:exitSpot(who)
					elseif not session.hidden[who] then
						session:enterSpot(who, spotIndex)
					end
				end)
			end
		end
		for _, chest in ipairs(arena.chests or {}) do
			chest.prompt.Triggered:Connect(function(who)
				local session = playerSession[who]
				if session then
					session:openChest(who, chest)
				end
			end)
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		GameManager.step(dt)
	end)

	print("[Kiwi Cazador] iniciado con " .. #world.arenas .. " arenas")
end

function GameManager.setupPlayer(player)
	leaderstatsFor(player)

	local function onCharacter(character)
		local session = playerSession[player]
		task.wait(0.6)
		if session and playerSession[player] == session then
			if session.hideSpot[player] then
				session:exitSpot(player, true)
			end
			if session.phase == "playing" or session.phase == "countdown" then
				session:teleportToArena(player)
				session:giveTools(player)
				setFrozen(player, session.phase == "countdown")
			else
				GameManager.sendToLobbySpawn(player)
			end
			session:sendUpdate(player)
		else
			GameManager.sendToLobbySpawn(player)
		end
	end

	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	-- Estado inicial del menu
	Net.get("SessionUpdate"):FireClient(player, { active = false })
end

function GameManager.sendToLobbySpawn(player)
	local character = player.Character
	if not character then
		return
	end
	local spawn = world.lobby.spawn
	character:PivotTo(CFrame.new(spawn.Position + Vector3.new(0, 3, 0)))
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end

function GameManager.returnToLobby(player, keepInPlace)
	if player.Parent then
		ToolService.clear(player)
		if not keepInPlace then
			GameManager.sendToLobbySpawn(player)
		end
	end
end

function GameManager.requestJoin(player, modeId)
	-- Elegir a mano cancela la revancha automatica
	rematchInvites[player] = nil
	return GameManager.joinMode(player, modeId)
end

-- Une al jugador a una partida del modo pedido. Si viene de una revancha
-- y la arena esta libre, arranca directo en el mismo mapa.
function GameManager.joinMode(player, modeId, mapId)
	local current = playerSession[player]
	if current then
		if current.phase == "ended" then
			current:removePlayer(player, true)
		else
			Net.get("Notify"):FireClient(player, Config.Text.AlreadyIn, Util.colorToTable(COLOR.warn), 4)
			return nil
		end
	end

	if modeId == "multi" then
		local session
		for _, candidate in ipairs(sessions) do
			if candidate.modeId == "multi" and not candidate.finished
				and candidate.phase ~= "ended" and not candidate:isFull() then
				session = candidate
				break
			end
		end
		if not session then
			session = Session.new("multi", Random.new(), mapId and { mapId = mapId } or nil)
			table.insert(sessions, session)
		end
		session:addPlayer(player)
		return session
	end

	if modeId == "asedio" then
		local session
		for _, candidate in ipairs(sessions) do
			if candidate.modeId == "asedio" and not candidate.finished
				and candidate.phase ~= "ended" and not candidate:isFull() then
				session = candidate
				break
			end
		end
		if not session then
			session = Session.new("asedio", Random.new(), mapId and { mapId = mapId } or nil)
			table.insert(sessions, session)
		end
		session:addPlayer(player)
		return session
	end

	if not Config.Difficulties[modeId] then
		return nil
	end

	local session = Session.new(modeId, Random.new(), mapId and { mapId = mapId } or nil)
	table.insert(sessions, session)
	session:addPlayer(player)
	session:sendUpdate(player)
	return session
end

-- Revancha: se anota el modo y la arena para que, al terminar la partida
-- (o al caer noqueado), puedas volver a la misma sin votar mapa de nuevo.
function GameManager.setRematch(player, session)
	if not session or not session.arena then
		return
	end
	local wait = Config.Round.RematchTime or 12
	rematchInvites[player] = {
		modeId = session.modeId,
		mapId = session.arena.mapId,
		name = session.name,
		at = os.clock() + wait,
	}
	Net.get("Notify"):FireClient(
		player,
		string.format(Config.Text.RematchOffer, session.name, wait),
		Util.colorToTable(session.color or COLOR.info),
		wait
	)
end

function GameManager.getRematch(player)
	return rematchInvites[player]
end

function GameManager.requestLeave(player)
	local session = playerSession[player]
	if not session then
		return
	end
	session:removePlayer(player, true)
	Net.get("SessionUpdate"):FireClient(player, { active = false })
end

function GameManager.step(dt)
	dt = math.min(dt, 0.1)

	for index = #sessions, 1, -1 do
		local session = sessions[index]
		local ok, err = pcall(function()
			session:step(dt)
		end)
		if not ok then
			warn("[Kiwi Cazador] error en la sesion " .. tostring(session.id) .. ": " .. tostring(err))
		end
		if session.finished then
			table.remove(sessions, index)
		end
	end

	-- Revancha: si no eligio otro modo, vuelve solo a la misma arena
	for player, invite in pairs(rematchInvites) do
		if not player.Parent or playerSession[player] then
			rematchInvites[player] = nil
		elseif os.clock() &gt;= invite.at then
			rematchInvites[player] = nil
			if GameManager.joinMode(player, invite.modeId, invite.mapId) then
				Net.get("Notify"):FireClient(
					player,
					string.format(Config.Text.RematchStart, invite.name),
					Util.colorToTable(COLOR.good),
					5
				)
			end
		end
	end

	-- Rescate de jugadores que caen al vacio
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getRoot(player)
		if root and root.Position.Y &lt; Config.World.VoidY then
			local session = playerSession[player]
			if session and session.phase ~= "ended" then
				session:teleportToArena(player)
			else
				GameManager.sendToLobbySpawn(player)
			end
		end
	end
end

function GameManager.getSession(player)
	return playerSession[player]
end

return GameManager
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX020">
					<Properties>
						<string name="Name">Destruction</string>
						<ProtectedString name="Source">--[[
	Destruction.lua  (servidor)
	Objetos rompibles del mapa: casas, graneros, autos, colectivo, tren
	y arboles. El lanzamisiles es lo unico que los destroza: al impacto,
	las partes marcadas dentro del radio se sueltan (Anchored = false) y
	salen despedidas. A los ~32 segundos el mapa se recompone solo, asi
	la partida sigue jugable ronda tras ronda.

	WorldBuilder marca las partes al construir
	(Destruction.marcar / registrarLista / registrarModelo) y Actions
	dispara Destruction.explosivo cuando estalla un cohete.
--]]

local Destruction = {}

local REPARACION = 32    -- segundos hasta que las partes vuelven a su lugar
local MAX_PARTES = 260   -- tope de partes sueltas por explosion (fisica sana)

local grupos = {}        -- { {tipo, partes = {{p, cf, anc}}, model, roto, suma, n} }

local function grupoNuevo(tipo, model)
	local g = {
		tipo = tipo, model = model, partes = {}, roto = false,
		suma = Vector3.new(0, 0, 0), n = 0,
	}
	table.insert(grupos, g)
	return g
end

local function sumarParte(g, p)
	if not p or not p:IsA("BasePart") then
		return
	end
	g.n = g.n + 1
	g.suma = g.suma + p.Position
	table.insert(g.partes, { p = p, cf = p.CFrame, anc = p.Anchored })
end

-- Una parte suelta (casas: se marca cada pared, piso, mueble, etc.)
function Destruction.marcar(p, tipo)
	local g = grupoNuevo(tipo or "casa")
	sumarParte(g, p)
end

-- Varias partes que vuelan juntas (arboles: tronco + copas)
function Destruction.registrarLista(tipo, lista)
	local g = grupoNuevo(tipo)
	for _, p in ipairs(lista) do
		sumarParte(g, p)
	end
end

-- Un modelo entero (autos, colectivo, tren)
function Destruction.registrarModelo(model, tipo)
	local g = grupoNuevo(tipo, model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			sumarParte(g, d)
		end
	end
end

-- Cuantas partes rompibles hay en el mapa (lo usa el AutoTest)
function Destruction.count()
	local total = 0
	for _, g in ipairs(grupos) do
		total = total + #g.partes
	end
	return total
end

function Destruction.limpiar()
	grupos = {}
end

local function romper(g, pos, potencia, radio)
	g.roto = true
	local vehiculo = g.tipo == "vehiculo" and g.model
	if vehiculo and vehiculo.Parent then
		vehiculo:SetAttribute("KiwiRoto", true)
	end
	for _, e in ipairs(g.partes) do
		local p = e.p
		if p.Parent then
			p.Anchored = false
			local away = p.Position - pos
			if away.Magnitude &lt; 0.8 then
				away = Vector3.new(0, 1, 0)
			end
			local fuerza = math.clamp(1 - (away.Magnitude / (radio + 6)), 0.35, 1)
			p.AssemblyLinearVelocity = away.Unit * potencia * fuerza
				+ Vector3.new(0, potencia * 0.32 * fuerza, 0)
			p.AssemblyAngularVelocity = Vector3.new(
				(math.random() - 0.5) * 12,
				(math.random() - 0.5) * 12,
				(math.random() - 0.5) * 12)
		end
	end

	-- Se recompone solo: el mapa no queda roto para siempre
	task.delay(REPARACION, function()
		for _, e in ipairs(g.partes) do
			local p = e.p
			if p.Parent then
				p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				p.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				p.CFrame = e.cf
				p.Anchored = e.anc
			end
		end
		if vehiculo and vehiculo.Parent then
			vehiculo:SetAttribute("KiwiRoto", false)
		end
		g.roto = false
	end)
end

-- Estallido del lanzamisiles: rompe lo marcado dentro del radio
function Destruction.explosivo(pos, radio, potencia)
	radio = radio or 24
	potencia = math.clamp(potencia or 60, 20, 90)
	local candidatos = {}
	for _, g in ipairs(grupos) do
		if not g.roto and g.n &gt; 0 then
			local centro = g.suma / g.n
			local d = (centro - pos).Magnitude
			if d &lt;= radio then
				table.insert(candidatos, { g = g, d = d })
			end
		end
	end
	table.sort(candidatos, function(a, b)
		return a.d &lt; b.d
	end)
	local partes = 0
	for _, c in ipairs(candidatos) do
		if partes + #c.g.partes &gt; MAX_PARTES then
			break
		end
		partes = partes + #c.g.partes
		romper(c.g, pos, potencia, radio)
	end
end

return Destruction
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX021">
		<Properties>
			<string name="Name">StarterPlayer</string>
			<float name="CharacterWalkSpeed">16</float>
			<bool name="EnableMouseLockOption">true</bool>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX022">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX023">
				<Properties>
					<string name="Name">KiwiClient</string>
				</Properties>
				<Item class="LocalScript" referent="RBX024">
					<Properties>
						<string name="Name">Main</string>
						<ProtectedString name="Source">--[[
	Main.client.lua  (cliente)
	Une todo del lado del jugador:
		- menu del lobby y HUD
		- teclas de caminar (Shift) y sigilo (Ctrl)
		- uso de las herramientas (red, rifle, rastreador, trampa, pintura)
		- efectos, sonidos y brujula del rastreador
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("KiwiShared", 30)
if not Shared then
	error("[Kiwi Cazador] Falta ReplicatedStorage.KiwiShared (revisa el README)")
end

local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local HUD = require(script.Parent.modules.HUD)
local ViewModel = require(script.Parent.modules.ViewModel)
local WeatherFX = require(script.Parent.modules.WeatherFX)

local player = Players.LocalPlayer
local remotes = Net.init()

-- Lluvia y nieve: efectos locales que siguen a la camara
WeatherFX.start()

local state = { active = false, phase = "none", diff = nil }
local sprinting = false
local sneaking = false
local glockBurst = false -- la Glock-18 arranca tiro a tiro; el clic derecho la pone en ráfaga
local shotBloom = 0 -- el punto de mira se abre un toque al disparar
local speedFov = nil -- al correr la camara abre un poco el FOV (se siente mas rapido)
local cooldowns = {
	red = { left = 0, total = 1 },
	rifle = { left = 0, total = 1 },
	rastreador = { left = 0, total = 1 },
	trampa = { left = 0, total = 1 },
	pintura = { left = 0, total = 1 },
	relente = { left = 0, total = 1 },
}
local eatCam = nil

-- ===============================================================
-- Sonidos y efectos
-- ===============================================================
local function soundAt(soundId, position, volume, pitch)
	if not soundId or soundId == "" then
		return
	end

	local holder = Instance.new("Part")
	holder.Name = "FxSonido"
	holder.Size = Vector3.new(1, 1, 1)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Position = position
	holder.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 1
	sound.RollOffMaxDistance = 260
	sound.RollOffMinDistance = 8
	if pitch then
		sound.PlaybackSpeed = pitch
	end
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 5)
end

local function sound2D(soundId, volume, pitch)
	if not soundId or soundId == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 1
	sound.Parent = player:FindFirstChildOfClass("PlayerGui") or workspace
	if pitch then
		sound.PlaybackSpeed = pitch
	end
	sound:Play()
	Debris:AddItem(sound, 5)
end

-- ===============================================================
-- Pasos: solo se escuchan al correr. Con Shift (caminar) o agachado
-- no haces ruido. Ademas se apaga el sonido de pasos por defecto.
-- ===============================================================
local pasoAcumulado = {}

local function sonidoPaso(position, volume, pitch)
	local holder = Instance.new("Part")
	holder.Name = "FxPaso"
	holder.Size = Vector3.new(1, 1, 1)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Position = position
	holder.Parent = workspace

	local sound = Instance.new("Sound")
	sound.SoundId = Config.Sounds.steps
	sound.Volume = volume
	sound.RollOffMinDistance = 5
	sound.RollOffMaxDistance = 85
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 3)
end

local function updatePasos(dt)
	local umbral = (Config.Footsteps and Config.Footsteps.runSpeed) or 19
	for _, other in ipairs(Players:GetPlayers()) do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		-- Apaga el "Running" que trae Roblox por defecto: asi solo suenan
		-- nuestros pasos, y solo cuando corresponde
		if root then
			local porDefecto = root:FindFirstChild("Running")
			if not porDefecto then
				local emisor = root:FindFirstChildOfClass("AudioEmitter")
				porDefecto = emisor and emisor:FindFirstChild("Running")
			end
			if porDefecto and (porDefecto:IsA("Sound") or porDefecto:IsA("AudioPlayer")) then
				porDefecto.Volume = 0
			end
		end

		local pisa = root and humanoid and humanoid.Health &gt; 0
			and humanoid.FloorMaterial ~= Enum.Material.Air
		if pisa then
			local v = root.AssemblyLinearVelocity
			local rapidez = math.sqrt(v.X * v.X + v.Z * v.Z)
			if rapidez &gt;= umbral then
				local acumulado = (pasoAcumulado[other] or 0) + dt
				local intervalo = math.clamp(10.5 / math.max(rapidez, 1), 0.24, 0.6)
				if acumulado &gt;= intervalo then
					acumulado = 0
					-- Un tono distinto por jugador para no sonar todos igual
					local tono = 0.94 + (other.UserId % 4) * 0.03
					sonidoPaso(root.Position + Vector3.new(0, -1.7, 0), other == player and 0.4 or 0.5, tono)
				end
				pasoAcumulado[other] = acumulado
			else
				pasoAcumulado[other] = nil
			end
		else
			pasoAcumulado[other] = nil
		end
	end
end

-- ===============================================================
-- Disparos armados por capas (los sonidos de Roblox no traen balas)
-- Cada estilo mezcla un golpe grave distorsionado (boom), un chasquido
-- seco (crack) y una cola corta del estampido. Los Sound se reutilizan
-- de un pool para no crear instancias en cada rafaga automatica.
-- ===============================================================
local GUN_SHOT = {
	-- estilo = { { sonido, volumen, tono, distorsion }, ... }
	pistol = { { "gunBoom", 0.50, 1.15, 0.30 }, { "gunCrack", 0.45, 1.55, 0.50 }, { "gunTail", 0.15, 1.65, 0.00 } },
	smg = { { "gunBoom", 0.45, 1.25, 0.30 }, { "gunCrack", 0.42, 1.65, 0.45 }, { "gunTail", 0.13, 1.75, 0.00 } },
	rifle = { { "gunBoom", 0.62, 0.95, 0.45 }, { "gunCrack", 0.50, 1.30, 0.55 }, { "gunTail", 0.26, 1.40, 0.00 } },
	heavy = { { "gunBoom", 0.72, 0.85, 0.50 }, { "gunCrack", 0.54, 1.20, 0.60 }, { "gunTail", 0.36, 1.30, 0.05 } },
	shotgun = { { "gunBoom", 0.80, 0.72, 0.55 }, { "gunCrack", 0.50, 1.05, 0.60 }, { "gunTail", 0.50, 1.05, 0.10 } },
	sniper = { { "gunBoom", 0.82, 0.82, 0.50 }, { "gunCrack", 0.62, 1.15, 0.65 }, { "gunTail", 0.45, 1.15, 0.15 } },
	dart = { { "gunCrack", 0.30, 1.45, 0.15 }, { "dartShot", 0.30, 1.30, 0.00 } },
	rocket = { { "gunBoom", 0.70, 0.60, 0.25 }, { "gunCrack", 0.25, 0.85, 0.10 }, { "dartShot", 0.35, 0.55, 0.00 } },
}

-- Arma -&gt; estilo de sonido
local GUN_STYLE = {
	revolver = "pistol", glock = "pistol",
	mp5 = "smg",
	ak = "rifle", m4 = "rifle",
	rifle = "dart", pintura = "dart", relente = "dart",
	escopeta = "shotgun",
	sniper = "sniper",
	cohete = "rocket",
}

local GUN_POOL_SIZE = 16
local gunPool = {}
local gunPoolIndex = 0

local function gunPlay(soundId, volume, pitch, distortion)
	local slot = (gunPoolIndex % GUN_POOL_SIZE) + 1
	gunPoolIndex = gunPoolIndex + 1
	local entry = gunPool[slot]
	if not entry then
		local sound = Instance.new("Sound")
		sound.Parent = player:FindFirstChildOfClass("PlayerGui") or workspace
		local dist = Instance.new("DistortionSoundEffect")
		dist.Level = distortion or 0
		dist.Parent = sound
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 5
		eq.MidGain = -2
		eq.HighGain = 2
		eq.Parent = sound
		entry = { sound = sound, dist = dist, lastId = nil }
		gunPool[slot] = entry
	end
	local sound = entry.sound
	if entry.lastId ~= soundId then
		sound.SoundId = soundId
		entry.lastId = soundId
	end
	sound.Volume = volume
	sound.PlaybackSpeed = pitch or 1
	entry.dist.Level = distortion or 0
	sound.TimePosition = 0
	sound:Play()
end

local function gunshot(style)
	local layers = GUN_SHOT[style]
	if not layers then
		return
	end
	for _, layer in ipairs(layers) do
		local id = Config.Sounds[layer[1]]
		if id then
			gunPlay(id, layer[2], layer[3], layer[4])
		end
	end
end

local function burst(position, color, count)
	local holder = Instance.new("Part")
	holder.Name = "FxParticulas"
	holder.Size = Vector3.new(1, 1, 1)
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Position = position
	holder.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.6),
		NumberSequenceKeypoint.new(1, 0.15),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.35, 0.75)
	emitter.Speed = NumberRange.new(10, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.LightEmission = 0.3
	emitter.Parent = holder
	emitter:Emit(count or 22)

	Debris:AddItem(holder, 2)
end

-- ===============================================================
-- Lanzallamas: chorro de fuego visible (todo por codigo, sin assets)
-- ===============================================================
local flameRigs = {}

local function getFlameRig(key)
	local rig = flameRigs[key]
	if rig then
		return rig
	end
	local part = Instance.new("Part")
	part.Name = "ChorroLlama"
	part.Size = Vector3.new(0.4, 0.4, 0.4)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Llama"
	emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 180)),
		ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 150, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 40, 12)),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.75, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.4),
		NumberSequenceKeypoint.new(1, 4.6),
	})
	emitter.Lifetime = NumberRange.new(0.4, 0.65)
	emitter.Speed = NumberRange.new(20, 30)
	emitter.SpreadAngle = Vector2.new(6, 6)
	emitter.Acceleration = Vector3.new(0, 4.5, 0)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = 70
	emitter.Enabled = false
	emitter.Parent = part

	local light = Instance.new("PointLight")
	light.Name = "LuzLlama"
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 18
	light.Brightness = 1.8
	light.Shadows = false
	light.Enabled = false
	light.Parent = part

	rig = { part = part, emitter = emitter, light = light, until_ = 0 }
	flameRigs[key] = rig
	return rig
end

-- Enciende (o refresca) el chorro en esa posicion y direccion
local function flameAt(key, position, direction)
	local rig = getFlameRig(key)
	local look = direction.Magnitude &gt; 0.01 and direction.Unit or Vector3.new(0, 0, -1)
	rig.part.CFrame = CFrame.lookAt(position, position + look)
	rig.emitter.Enabled = true
	rig.light.Enabled = true
	rig.until_ = os.clock() + 0.4
end

-- Fuego que queda prendido donde pega el chorro (paredes, objetos, gente):
-- se apaga solo si dejás de alimentarlo
local fireSpots = {}

local function getFireSpot(key)
	local spot = fireSpots[key]
	if spot then
		return spot
	end
	local part = Instance.new("Part")
	part.Name = "FuegoImpacto"
	part.Size = Vector3.new(0.4, 0.4, 0.4)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Llamas"
	emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 150)),
		ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 120, 45)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(130, 26, 8)),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 2.4),
	})
	emitter.Lifetime = NumberRange.new(0.45, 0.85)
	emitter.Speed = NumberRange.new(3, 8)
	emitter.SpreadAngle = Vector2.new(32, 32)
	emitter.Acceleration = Vector3.new(0, 9, 0)
	emitter.Rate = 28
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Enabled = false
	emitter.Parent = part

	local light = Instance.new("PointLight")
	light.Name = "LuzFuego"
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 11
	light.Brightness = 1.1
	light.Shadows = false
	light.Enabled = false
	light.Parent = part

	spot = { part = part, emitter = emitter, light = light, until_ = 0 }
	fireSpots[key] = spot
	return spot
end

-- Prende (o refresca) una llama pegada a la superficie donde choco el chorro
local function fireSpotAt(key, position, normal)
	local spot = getFireSpot(key)
	local up = normal and normal.Magnitude &gt; 0.01 and normal.Unit or Vector3.new(0, 1, 0)
	local base = position + up * 0.25
	spot.part.CFrame = CFrame.lookAt(base, base + up)
	spot.emitter.Enabled = true
	spot.light.Enabled = true
	spot.until_ = os.clock() + 1.1
end

-- Raycast del chorro (se reusa: nada de tablas nuevas por frame)
local flameSpotParams = RaycastParams.new()
flameSpotParams.FilterType = Enum.RaycastFilterType.Exclude
flameSpotParams.IgnoreWater = true

-- Apaga los chorros y el fuego prendido que quedo sin refrescar (lo llama el Heartbeat)
local function flameCleanup()
	local now = os.clock()
	for _, rig in pairs(flameRigs) do
		if rig.emitter.Enabled and now &gt; rig.until_ then
			rig.emitter.Enabled = false
			rig.light.Enabled = false
		end
	end
	for _, spot in pairs(fireSpots) do
		if spot.emitter.Enabled and now &gt; spot.until_ then
			spot.emitter.Enabled = false
			spot.light.Enabled = false
		end
	end
end

-- Soplete: sonido en loop mientras sale el chorro
local flameSound = nil
local function setFlameSound(on)
	if on then
		if not flameSound then
			flameSound = Instance.new("Sound")
			flameSound.Name = "Soplete"
			flameSound.SoundId = Config.Sounds.flame
			flameSound.Looped = true
			flameSound.Volume = 0.42
			flameSound.PlaybackSpeed = 0.42
			flameSound.Parent = player:FindFirstChildOfClass("PlayerGui") or workspace
		end
		if not flameSound.IsPlaying then
			flameSound:Play()
		end
	elseif flameSound and flameSound.IsPlaying then
		flameSound:Stop()
	end
end

-- Trazadora estilo Counter: una linea neon que se apaga al instante
local function tracer(from, dir, length, color, thickness)
	local beam = Instance.new("Part")
	beam.Name = "FxTrazadora"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = color or Color3.fromRGB(255, 240, 190)
	beam.Size = Vector3.new(thickness or 0.1, thickness or 0.1, length)
	local center = from + dir * (length * 0.5)
	beam.CFrame = CFrame.lookAt(center, center + dir)
	beam.Transparency = 0.2
	beam.Parent = workspace
	Debris:AddItem(beam, 0.09)
end

local function distanceToLocal(position)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

-- ===============================================================
-- Velocidad y estado del personaje
-- ===============================================================
local function humanoid()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local hiddenNow = false -- escondido en un armario/barril/pajar: no te moves
local scoped = false
local scopeLevel = 0
local equippedId = nil

local function applySpeed()
	local hum = humanoid()
	if not hum then
		return
	end

	-- Escondido en un escondite: quieto hasta que salgas con E
	if hiddenNow then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	-- Manchado de pintura: el servidor controla la velocidad lenta
	if hum:GetAttribute("Pintado") then
		return
	end

	-- Dardo tranquilizante: dormido unos segundos, no te podes mover
	if hum:GetAttribute("Dormido") then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	if not state.active then
		if hum.WalkSpeed ~= Config.Player.sprintSpeed then
			hum.WalkSpeed = Config.Player.sprintSpeed
		end
		return
	end

	if state.phase ~= "playing" then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	-- Noqueado (asedio y otros modos): quieto hasta volver al combate
	if state.hp and state.hp &lt;= 0 then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.UseJumpPower = true
		return
	end

	hum.JumpPower = 50
	hum.UseJumpPower = true
	if sneaking then
		hum.WalkSpeed = Config.Player.sneakSpeed
	elseif sprinting then
		-- Shift apretado: caminar despacio
		hum.WalkSpeed = Config.Player.walkSpeed
	else
		-- Por defecto el personaje corre
		hum.WalkSpeed = Config.Player.sprintSpeed
	end

	-- Apuntando se camina mas lento (estilo Counter)
	if scoped then
		hum.WalkSpeed = math.min(hum.WalkSpeed, Config.Player.walkSpeed * 0.55)
	end

	-- Agachado la camara baja un poco (estilo Counter)
	local offset = sneaking and Vector3.new(0, -1.1, 0) or Vector3.new(0, 0, 0)
	if hum.CameraOffset ~= offset then
		hum.CameraOffset = offset
	end
end

-- ===============================================================
-- Mira del rifle (clic derecho para apuntar)
-- ===============================================================
local function applyCameraMode()
	-- Estilo Counter Blox: durante la partida se juega SIEMPRE en primera
	-- persona; en el lobby y la votacion la vista queda libre.
	local round = state.active and (state.phase == "playing" or state.phase == "countdown")
	local first = scoped or round
	local mode = first and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
	if player.CameraMode ~= mode then
		player.CameraMode = mode
	end
end

-- Al apuntar se oculta el arma para ver limpio por la mira
local function setWeaponHidden(hidden)
	local character = player.Character
	if not character then
		return
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			for _, part in ipairs(child:GetDescendants()) do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = hidden and 1 or 0
				end
			end
		end
	end
end

-- Armas que apuntan (y que por lo tanto muestran la vista de arma).
-- La Glock-18 no tiene mira (solo los rifles apuntan): su clic derecho
-- sirve para cambiar a ráfaga de 3.
local SCOPE_WEAPONS = {
	rifle = true, pintura = true, relente = true,
	arco = true, sniper = true, lanzallamas = true, cohete = true,
	ak = true, m4 = true, mp5 = true,
}

-- Vista de arma estilo Counter: se ve en primera persona y al apuntar.
-- Con la telescopica puesta el arma se esconde (solo queda la mira).
local function refreshViewmodel()
	local round = state.active and (state.phase == "playing" or state.phase == "countdown")
	local armed = equippedId ~= nil and ViewModel.hasWeapon(equippedId)
	local show = round and armed and not hiddenNow
	ViewModel.setWeapon(equippedId)
	ViewModel.setVisible(show)
	ViewModel.setAds(scoped and equippedId ~= "sniper" and 1 or 0)
	ViewModel.setHidden(scoped and equippedId == "sniper")
	-- En primera persona el arma "de verdad" del personaje no se usa:
	-- manda la vista estilo Counter (asi no se cruza con la cara)
	setWeaponHidden(round or scoped)
end

local function scopeFov(id, level)
	local weapons = Config.Scope.weapons or {}
	if id == "sniper" then
		return (level or 1) &gt;= 2 and (weapons.sniper2 or 7) or (weapons.sniper or 14)
	end
	return weapons[id] or Config.Scope.fov
end

-- En partida (primera persona) el mouse queda oculto y centrado
local function inRoundNow()
	return state.active and (state.phase == "playing" or state.phase == "countdown")
end

local function setScope(enabled, level)
	enabled = enabled and true or false
	local lvl = enabled and math.max(1, level or 1) or 0
	if scoped == enabled and scopeLevel == lvl then
		return
	end
	scoped = enabled
	scopeLevel = lvl

	-- Telescopica del francotirador: pantalla negra con circulo (Counter).
	-- Las demas armas apuntan con el puntito central, sin aro encima.
	local sniperScope = scoped and equippedId == "sniper"
	HUD.setScope(sniperScope, sniperScope)
	if sniperScope then
		HUD.setScopeZoom(lvl &gt;= 2 and "10x" or "5x")
	end

	refreshViewmodel()
	UserInputService.MouseIconEnabled = not scoped and not inRoundNow()

	local hum = humanoid()
	if hum then
		hum.AutoRotate = not scoped
	end

	local camera = workspace.CurrentCamera
	if camera then
		local goal = scoped and scopeFov(equippedId, lvl) or 70
		TweenService:Create(camera, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			FieldOfView = goal,
		}):Play()
	end

	-- Apuntando se pasa a primera persona: la mira ya no tapa la cabeza
	UserInputService.MouseBehavior = (scoped or inRoundNow())
		and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
	applyCameraMode()
	applySpeed()

	sound2D(Config.Sounds.ui, 0.25, scoped and 1.5 or 1.1)
end

-- Que herramienta tiene el jugador en la mano ahora mismo
local function refreshEquipped()
	local found = nil
	local character = player.Character
	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ToolId") then
				found = child:GetAttribute("ToolId")
				break
			end
		end
	end
	equippedId = found
	if not SCOPE_WEAPONS[equippedId] then
		setScope(false)
	end
	refreshViewmodel()
end

-- ===============================================================
-- Herramientas
-- ===============================================================
local function diffFor(modeId)
	if modeId == "multi" then
		return Config.Difficulties[Config.Multiplayer.baseDifficulty]
	end
	return Config.Difficulties[modeId] or Config.Difficulties.normal
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	if scoped then
		-- Con la mira puesta, el objetivo es el centro de la camara
		return camera.CFrame.Position + camera.CFrame.LookVector * 260
	end

	if UserInputService.MouseEnabled then
		local mouse = player:GetMouse()
		if mouse and mouse.Hit then
			return mouse.Hit.Position
		end
	end

	return camera.CFrame.Position + camera.CFrame.LookVector * 220
end

-- Rafaga automatica estilo Counter: mantene apretado y sigue disparando
local holdingFire = false
local autoJob = nil
local startAutoFire
local lastFlameCrackle = 0

local function fireTool(toolId)
	if not state.active or state.phase ~= "playing" then
		sound2D(Config.Sounds.denied, 0.5)
		return
	end

	local cooldown = cooldowns[toolId]
	if cooldown and cooldown.left &gt; 0 then
		sound2D(Config.Sounds.denied, 0.4)
		return
	end

	remotes.ToolAction:FireServer(toolId, {
		aim = aimPoint(),
		scoped = scoped,
		sneak = sneaking,
		-- La ráfaga de la Glock viaja al servidor (3 tiros por gatillo)
		burst = (toolId == "glock") and glockBurst or nil,
	})

	local total = cooldown and cooldown.total or 1
	if cooldown then
		cooldown.left = total
	end

	-- Sonido del arma: capas de boom + chasquido + cola segun el estilo
	if Config.Grenades[toolId] then
		-- Granada: quien tira avisa con un silbido corto; la mecha corre sola
		sound2D(Config.Sounds.netSwing, 0.6, 1.35)
		ViewModel.toss()
	elseif toolId == "m4" then
		-- M4A1 con silenciador: apenas un tic seco (casi no se escucha)
		gunPlay(Config.Sounds.gunCrack, 0.14, 1.75, 0)
	elseif GUN_STYLE[toolId] then
		gunshot(GUN_STYLE[toolId])
	elseif toolId == "red" then
		sound2D(Config.Sounds.netSwing, 0.8)
	elseif toolId == "trampa" then
		sound2D(Config.Sounds.trapSet, 0.6, 0.8)
	elseif toolId == "arco" then
		sound2D(Config.Sounds.netSwing, 0.6, 1.4)
	elseif toolId == "cuchillo" then
		sound2D(Config.Sounds.netSwing, 0.55, 1.3)
	elseif toolId == "lanzallamas" then
		-- El soplete va en loop aparte; esto es un chisporroteo cada tanto
		local now = os.clock()
		if now - lastFlameCrackle &gt; 0.32 then
			lastFlameCrackle = now
			gunPlay(Config.Sounds.flame, 0.28, 0.62, 0.3)
		end
	end

	-- Patada del arma (estilo Counter)
	local RECOIL = {
		rifle = 0.25, pintura = 0.25, relente = 0.25, sniper = 0.6,
		revolver = 0.38, cohete = 0.55, arco = 0.28, cuchillo = 0.35, lanzallamas = 0.08,
		ak = 0.44, m4 = 0.38, mp5 = 0.28, glock = 0.28, escopeta = 0.52,
	}
	if toolId == "cuchillo" then
		-- Cuchillo mariposa: pega un zarpazo (sin fogonazo ni patada de arma)
		ViewModel.slash()
	elseif Config.Grenades[toolId] then
		-- La granada ya se tiró: sin patada de arma
	else
		ViewModel.recoil(RECOIL[toolId] or 0)
		ViewModel.flash()
	end

	-- Patada de camara estilo Counter Blox: 0.9 * (1 - control) grados
	-- (mas suave que la de Counter original: sube y vuelve sola)
	local shootCfg = Config.Shoot and Config.Shoot.weapons and Config.Shoot.weapons[toolId]
	local control = shootCfg and shootCfg.recoil or 72
	local kick = math.rad(0.9 * (1 - control / 100))
	ViewModel.kickCamera(kick * (1 + math.random() * 0.4), kick * (math.random() * 2 - 1))

	-- El chorro de fuego no abre la cruz como un balazo
	shotBloom = math.min(20, shotBloom + (toolId == "lanzallamas" and 2 or 8))

	-- Automaticas (AK, M4, MP5): si seguis apretando, la rafaga continua
	local wcfg = Config.Weapons[toolId]
	if wcfg and wcfg.auto and holdingFire then
		startAutoFire(toolId)
	end
end

startAutoFire = function(toolId)
	if autoJob then
		return
	end
	autoJob = toolId
	task.spawn(function()
		local wcfg = Config.Weapons[toolId]
		local step = (wcfg and wcfg.cooldown or 0.12) * 1.08
		while autoJob == toolId and holdingFire and equippedId == toolId
			and state.active and state.phase == "playing" do
			task.wait(step)
			if autoJob ~= toolId or not holdingFire then
				break
			end
			fireTool(toolId)
		end
		if autoJob == toolId then
			autoJob = nil
		end
	end)
end

local hookedTools = {}

local function hookTool(tool)
	if not tool:IsA("Tool") then
		return
	end
	local toolId = tool:GetAttribute("ToolId")
	if not toolId or hookedTools[tool] then
		return
	end
	hookedTools[tool] = true

	tool.Activated:Connect(function()
		fireTool(toolId)
	end)

	tool.Destroying:Connect(function()
		hookedTools[tool] = nil
	end)
end

local function hookContainer(container)
	if not container then
		return
	end
	for _, child in ipairs(container:GetChildren()) do
		hookTool(child)
	end
	container.ChildAdded:Connect(function(child)
		hookTool(child)
		refreshEquipped()
	end)
	container.ChildRemoved:Connect(refreshEquipped)
end

player.CharacterAdded:Connect(function(character)
	task.wait(0.2)
	hookContainer(player:FindFirstChildOfClass("Backpack"))
	hookContainer(character)
	refreshEquipped()
	applySpeed()
	remotes.RequestState:FireServer()
end)

-- ===============================================================
-- Teclas
-- ===============================================================
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdingFire = true
		local wcfg = equippedId and Config.Weapons[equippedId]
		if wcfg and wcfg.auto then
			startAutoFire(equippedId)
		end
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		-- La Glock-18 no tiene mira: su clic derecho pasa a ráfaga de 3
		-- tiros (estilo CS2) y avisa por el HUD.
		if equippedId == "glock" and state.active and state.phase == "playing" then
			glockBurst = not glockBurst
			HUD.notify(glockBurst and Config.Text.GlockBurstOn or Config.Text.GlockBurstOff,
				Color3.fromRGB(238, 196, 92), 3)
			sound2D(Config.Sounds.ui, 0.4, glockBurst and 1.5 or 1.05)
			return
		end
		-- Clic derecho: mira estilo Counter. El francotirador va ciclando
		-- la telescopica: 5x -&gt; 10x -&gt; sin mira.
		if SCOPE_WEAPONS[equippedId] and state.active and state.phase == "playing" then
			if equippedId == "sniper" then
				if not scoped then
					setScope(true, 1)
				elseif scopeLevel == 1 then
					setScope(true, 2)
				else
					setScope(false)
				end
			else
				setScope(not scoped, 1)
			end
		end
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		-- Shift: caminar despacio (por defecto el personaje corre)
		sprinting = true
		applySpeed()
	elseif input.KeyCode == Enum.KeyCode.F then
		-- Cuchillo mariposa: F lo hace dar vueltas en la mano (estilo CS2)
		ViewModel.spin()
	elseif input.KeyCode == Enum.KeyCode.Tab then
		HUD.setScoreboardVisible(true)
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftAlt
		or input.KeyCode == Enum.KeyCode.C then
		sneaking = true
		applySpeed()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdingFire = false
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprinting = false
		applySpeed()
	elseif input.KeyCode == Enum.KeyCode.Tab then
		HUD.setScoreboardVisible(false)
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftAlt
		or input.KeyCode == Enum.KeyCode.C then
		sneaking = false
		applySpeed()
	end
end)

-- ===============================================================
-- Punto de mira estilo Counter: se abre al moverse o disparar
-- ===============================================================
local function spreadErrorLocal(weaponId)
	local cfg = Config.Shoot and Config.Shoot.weapons and Config.Shoot.weapons[weaponId]
	if not cfg then
		return 0
	end
	local speed = 0
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local v = root.AssemblyLinearVelocity
		speed = math.sqrt(v.X * v.X + v.Z * v.Z)
	end
	local error = math.max(cfg.spread or 0, 0) + speed * (cfg.vel or 0)
	if scoped then
		error = cfg.adsPerfect and 0 or error * ((Config.Shoot and Config.Shoot.adsDiv) or 0.35)
	elseif sneaking then
		error = error / ((Config.Shoot and Config.Shoot.crouchDiv) or 1.6)
	end
	local dead = cfg.dead or (Config.Shoot and Config.Shoot.dead) or 0
	if error &lt; dead then
		error = 0
	end
	return error / ((Config.Shoot and Config.Shoot.div) or 6)
end

local lastCross = nil
local lastDot = nil
RunService.RenderStepped:Connect(function(dt)
	shotBloom = math.max(0, shotBloom - dt * 30)
	-- La telescopica del francotirador tapa la pantalla: ahi no va la cruz
	local sniperScope = scoped and equippedId == "sniper"
	local show = state.active and state.phase == "playing" and not hiddenNow
		and equippedId ~= nil and ViewModel.hasWeapon(equippedId)
		and not sniperScope
	if show ~= lastCross then
		lastCross = show
		HUD.setCrosshair(show, 4, 5, scoped)
	end
	if show then
		local grados = spreadErrorLocal(equippedId)
		-- Apuntando quedan las rayitas apagadas: manda el punto central
		HUD.setCrosshair(true, 3 + math.min(grados * 2.2, 12) + shotBloom * 0.35,
			4 + math.min(grados * 0.8, 4), scoped)
	end
	-- El punto central se ve SIEMPRE en partida, incluso sin armas
	local inRound = inRoundNow()
	local dotShow = inRound and not hiddenNow and not sniperScope
	if dotShow ~= lastDot then
		lastDot = dotShow
		HUD.setAimDot(dotShow)
	end

	-- Lanzallamas: mientras mantenes apretado sale el chorro de fuego
	local flaming = inRound and not hiddenNow and holdingFire and equippedId == "lanzallamas"
	setFlameSound(flaming)
	if flaming then
		local muzzlePos, look = ViewModel.getMuzzle()
		if muzzlePos and look then
			flameAt("local", muzzlePos, look)
			-- Donde pega el chorro queda fuego prendido
			flameSpotParams.FilterDescendantsInstances = player.Character and { player.Character } or {}
			local hit = workspace:Raycast(muzzlePos, look * 17, flameSpotParams)
			if hit then
				fireSpotAt("impact:local", hit.Position, hit.Normal)
			end
		end
	end

	-- En partida el mouse queda oculto y centrado: nada de manito sobre el punto
	if inRound then
		if UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = false
		end
		if not scoped and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	elseif not scoped then
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
end)

-- ===============================================================
-- Avisos del servidor
-- ===============================================================
remotes.SessionUpdate.OnClientEvent:Connect(function(newState)
	local wasActive = state.active
	local previousPhase = state.phase

	if not newState or not newState.active then
		state = { active = false, phase = "none", diff = nil }
		hiddenNow = false
		sprinting = false
		sneaking = false
		setScope(false)
		refreshViewmodel()
		HUD.hideResult()
		HUD.hideVote()
		HUD.setTeams(nil, nil, nil, nil)
		HUD.setMenuVisible(true)
		HUD.setMenuStatus("")
		HUD.fade(false, 0.5)
		applySpeed()
		return
	end

	state.active = true
	state.phase = newState.phase
	state.modeId = newState.modeId
	state.diff = diffFor(newState.modeId)
	state.hidden = newState.hidden == true
	state.hideSpot = newState.hideSpot
	state.hp = newState.hp
	if newState.vote then
		HUD.showVote(newState.vote)
	else
		HUD.hideVote()
	end
	applyCameraMode()
	if state.hidden ~= hiddenNow then
		hiddenNow = state.hidden
		if hiddenNow then
			setScope(false)
			sound2D(Config.Sounds.rustle, 0.5)
		else
			sound2D(Config.Sounds.ui, 0.35)
		end
		applyCameraMode()
		applySpeed()
	end
	refreshViewmodel()

	HUD.setMenuVisible(false)
	HUD.setMenuStatus("")

	if not wasActive or previousPhase ~= newState.phase then
		if newState.phase == "vote" then
			HUD.hideResult()
			HUD.fade(false, 0.4)
		elseif newState.phase == "countdown" then
			HUD.hideResult()
			HUD.fade(true, 0.25)
			task.delay(0.6, function()
				if state.phase == "countdown" or state.phase == "playing" then
					HUD.fade(false, 0.6)
				end
			end)
		elseif newState.phase == "playing" then
			HUD.hideResult()
			HUD.fade(false, 0.5)
		end
	end

	if state.diff then
		-- Algunos modos (Colosal) no tienen red ni rifle tranquilizante
		local redTotal = (state.diff.red and state.diff.red.cooldown) or 1
		local rifleTotal = (state.diff.rifle and state.diff.rifle.cooldown) or 1
		HUD.setToolTotals({
			red = redTotal,
			rifle = rifleTotal,
			rastreador = Config.Tracker.cooldown,
			trampa = Config.Trampa.cooldown,
			pintura = Config.PaintRifle.cooldown,
			relente = Config.Relente.cooldown,
		})
		cooldowns.red.total = redTotal
		cooldowns.rifle.total = rifleTotal
		cooldowns.rastreador.total = Config.Tracker.cooldown
		cooldowns.trampa.total = Config.Trampa.cooldown
		cooldowns.pintura.total = Config.PaintRifle.cooldown
		cooldowns.relente.total = Config.Relente.cooldown
	end

	HUD.updateState(newState)

	-- Asedio: marcador de equipos arriba (equipo propio, ronda y puntos)
	if newState.isAsedio and newState.teamScore then
		HUD.setTeams(newState.team, newState.teamScore, newState.round, newState.roundsToWin)
	else
		HUD.setTeams(nil, nil, nil, nil)
	end

	applySpeed()
end)

remotes.SessionEnd.OnClientEvent:Connect(function(result)
	HUD.showResult(result, Config.Round.EndScreen)
	sound2D(result.won and Config.Sounds.win or Config.Sounds.lose, 0.9)
	task.delay(1.5, function()
		HUD.fade(true, 1)
	end)
end)

remotes.Notify.OnClientEvent:Connect(function(text, colorTable, duration)
	HUD.notify(text, Util.colorFromTable(colorTable), duration)
end)

remotes.TrackerPing.OnClientEvent:Connect(function(data)
	HUD.setTracker(data)
	sound2D(Config.Sounds.ui, 0.5, 1.4)
end)

-- Ceguera de pintura: manchones que tapan toda la pantalla (golpe en la
-- cabeza con el rifle de pintura). Se arma 100% por codigo y se desvanece.
local paintBlindGui
local function paintBlind(duration, color)
	local plrGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui")
	if not paintBlindGui or not paintBlindGui.Parent then
		paintBlindGui = Instance.new("ScreenGui")
		paintBlindGui.Name = "KiwiPinturaCeguera"
		paintBlindGui.IgnoreGuiInset = true
		paintBlindGui.DisplayOrder = 60
		paintBlindGui.ResetOnSpawn = false
		paintBlindGui.Parent = plrGui
	end
	for _, child in ipairs(paintBlindGui:GetChildren()) do
		child:Destroy()
	end
	duration = math.max(duration or 4, 0.5)
	local base = color or Color3.fromRGB(230, 120, 190)
	local blobs = {}

	-- Fondo oscuro + dos manchones enormes al centro (no se ve la mira)
	local fondo = Instance.new("Frame")
	fondo.Size = UDim2.fromScale(1, 1)
	fondo.BackgroundColor3 = Color3.fromRGB(20, 10, 24)
	fondo.BackgroundTransparency = 0.3
	fondo.BorderSizePixel = 0
	fondo.ZIndex = 1
	fondo.Parent = paintBlindGui
	table.insert(blobs, fondo)

	for i = 1, 30 do
		local blob = Instance.new("Frame")
		blob.AnchorPoint = Vector2.new(0.5, 0.5)
		blob.Position = UDim2.fromScale(math.random(-8, 88) / 100, math.random(-8, 88) / 100)
		local size = math.random(170, 520)
		if i &lt;= 2 then
			size = math.random(620, 900)
			blob.Position = UDim2.fromScale(0.5, 0.5)
		end
		blob.Size = UDim2.fromOffset(size, size * (0.72 + math.random() * 0.6))
		blob.Rotation = math.random(0, 359)
		blob.BackgroundColor3 = base:Lerp(
			math.random() &lt; 0.5 and Color3.fromRGB(18, 8, 20) or Color3.fromRGB(255, 250, 255),
			math.random() * 0.45)
		blob.BackgroundTransparency = 0.05 + math.random() * 0.2
		blob.BorderSizePixel = 0
		blob.ZIndex = 2 + i
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = blob
		blob.Parent = paintBlindGui
		table.insert(blobs, blob)
	end

	-- Al final se escurre: se desvanece y se limpia
	task.delay(math.max(duration - 1.4, 0.1), function()
		for _, b in ipairs(blobs) do
			if b.Parent then
				TweenService:Create(b, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ BackgroundTransparency = 1 }):Play()
			end
		end
	end)
	task.delay(duration + 0.4, function()
		for _, b in ipairs(blobs) do
			if b.Parent then
				b:Destroy()
			end
		end
	end)
end

-- Flashbang: pantallazo blanco que se apaga solo (con el zumbido del ring)
local flashGui
local function flashBlind(duration)
	local plrGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui")
	if not flashGui or not flashGui.Parent then
		flashGui = Instance.new("ScreenGui")
		flashGui.Name = "KiwiFlash"
		flashGui.IgnoreGuiInset = true
		flashGui.DisplayOrder = 70
		flashGui.ResetOnSpawn = false
		flashGui.Parent = plrGui
	end
	for _, child in ipairs(flashGui:GetChildren()) do
		child:Destroy()
	end
	duration = math.max(duration or 2, 0.4)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.ZIndex = 1
	frame.Parent = flashGui
	-- Primero baja apenas (el flash de verdad), despues se aclara la vista
	TweenService:Create(frame, TweenInfo.new(duration * 0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.32,
	}):Play()
	task.delay(duration * 0.3, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(duration * 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end)
	task.delay(duration + 0.3, function()
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

remotes.WorldEvent.OnClientEvent:Connect(function(kind, data)
	data = data or {}
	local position = data.pos

	if kind == "countdown" then
		sound2D(Config.Sounds.countdown, 0.7)
	elseif kind == "start" then
		sound2D(Config.Sounds.start, 0.9)
		HUD.notify("A cazar al kiwi!", Color3.fromRGB(102, 209, 130), 3)
	elseif kind == "netswing" then
		if position and distanceToLocal(position) &lt; 90 then
			soundAt(Config.Sounds.netSwing, position, 0.7)
		end
	elseif kind == "nadethrow" then
		-- Alguien tiró una granada: silbido corto si estas cerca
		if position and distanceToLocal(position) &lt; 80 then
			soundAt(Config.Sounds.netSwing, position, 0.7, 1.45)
		end
	elseif kind == "nade" then
		-- Detonación de una granada del pack: cada tipo suena distinto
		local tipo = data.tipo
		if position then
			if tipo == "frag" then
				soundAt(Config.Sounds.gunBoom, position, 1, 0.55)
				burst(position, Color3.fromRGB(255, 180, 90), 46)
			elseif tipo == "humo" then
				soundAt(Config.Sounds.dartHit, position, 0.7, 0.6)
				burst(position, Color3.fromRGB(210, 214, 220), 36)
			elseif tipo == "molotov" then
				soundAt(Config.Sounds.gunBoom, position, 0.8, 0.9)
				soundAt(Config.Sounds.flame, position, 0.8, 0.75)
				burst(position, Color3.fromRGB(255, 140, 60), 34)
			elseif tipo == "flash" then
				soundAt(Config.Sounds.gunBoom, position, 0.9, 1.35)
				soundAt(Config.Sounds.flush, position, 0.7, 1.5)
				burst(position, Color3.fromRGB(255, 255, 240), 40)
			end
		end
	elseif kind == "flash" then
		-- Flashbang: te cegó (pantalla blanca + zumbido que se van solos)
		local dur = data.dur or 2
		flashBlind(dur)
		sound2D(Config.Sounds.flush, 0.5, 0.6)
		HUD.notify(string.format(Config.Text.FlashHit, math.max(1, math.floor(dur + 0.5))),
			Color3.fromRGB(245, 245, 245), math.max(1, dur))
	elseif kind == "dartshot" then
		if position then
			-- Sonido segun el arma: rifles graves, pistolas secas, dardos suaves
			local style = GUN_STYLE[data.weapon] or "rifle"
			if data.weapon == "m4" then
				-- M4A1 con silenciador: apenas se escucha (tic seco y corto)
				soundAt(Config.Sounds.gunCrack, position, 0.14, 1.75)
			elseif style == "dart" then
				soundAt(Config.Sounds.dartShot, position, 0.8, 1.15)
			elseif style == "shotgun" or style == "sniper" or style == "rocket" then
				soundAt(Config.Sounds.gunBoom, position, 0.9,
					style == "shotgun" and 0.78 or (style == "sniper" and 0.95 or 0.6))
			else
				soundAt(Config.Sounds.gunCrack, position, 0.8,
					style == "pistol" and 1.45 or (style == "smg" and 1.6 or 1.15))
			end
		end
		if position and data.tracer and data.dir then
			-- Estilo Counter: bala instantanea = trazadora, no proyectil
			tracer(position, data.dir, 240, Color3.fromRGB(255, 240, 190), 0.1)
		end
	elseif kind == "headshot" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 1, 1.35)
			burst(position, Color3.fromRGB(255, 210, 90), 30)
		end
	elseif kind == "darthit" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 1)
			burst(position, Color3.fromRGB(160, 240, 190), 26)
		end
	elseif kind == "dartmiss" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt("rbxasset://sounds/impact_water.mp3", position, 0.5, 1.6)
			burst(position, Color3.fromRGB(200, 200, 200), 8)
		end
	elseif kind == "flush" then
		if position then
			if distanceToLocal(position) &lt; 120 then
				soundAt(Config.Sounds.flush, position, 0.9)
			end
			burst(position, Color3.fromRGB(140, 180, 110), 18)
		end
		HUD.notify(Config.Text.KiwiRunning, Color3.fromRGB(238, 196, 92), 3)
	elseif kind == "rustle" then
		if position and distanceToLocal(position) &lt; 45 then
			soundAt(Config.Sounds.rustle, position, 0.6)
			burst(position, Color3.fromRGB(120, 160, 90), 10)
		end
	elseif kind == "sedate" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 0.6, 1.2)
			burst(position, Color3.fromRGB(180, 220, 255), 16)
		end
	elseif kind == "wake" then
		if position then
			soundAt(Config.Sounds.flush, position, 0.6, 1.2)
		end
	elseif kind == "captured" then
		if position then
			soundAt(Config.Sounds.netHit, position, 1)
			burst(position, Color3.fromRGB(255, 235, 160), 40)
		end
	elseif kind == "trap" then
		if position then
			soundAt(Config.Sounds.trapSet, position, 0.6, 0.8)
			burst(position, Color3.fromRGB(238, 170, 120), 12)
		end
	elseif kind == "trapcatch" then
		if position then
			soundAt(Config.Sounds.trapCatch, position, 1)
			burst(position, Color3.fromRGB(255, 120, 140), 34)
		end
	elseif kind == "trapescape" then
		if position then
			soundAt(Config.Sounds.trapCatch, position, 0.9, 0.7)
			burst(position, Color3.fromRGB(238, 170, 120), 18)
		end
	elseif kind == "paintshot" then
		soundAt(Config.Sounds.paintShot, position or Vector3.new(), 0.8)
	elseif kind == "painthit" then
		if position then
			soundAt(Config.Sounds.paintHit, position, 0.8)
			burst(position, Util.colorFromTable(data.color) or Color3.fromRGB(230, 120, 190), 26)
		end
	elseif kind == "paintblind" then
		-- Manchazo en la cara: no se ve nada unos segundos
		paintBlind(data.dur or 4, Util.colorFromTable(data.color))
	elseif kind == "slowhit" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 0.9, 1.15)
			burst(position, Config.Tools.relente.color, 30)
		end
	elseif kind == "chomp" then
		if position then
			soundAt(Config.Sounds.dartHit, position, 1, 0.6)
			burst(position, Color3.fromRGB(232, 108, 100), 14)
		end
		if eatCam then
			eatCam.shakeUntil = os.clock() + 0.35
		end
	elseif kind == "hidestart" then
		if position and distanceToLocal(position) &lt; 40 then
			soundAt(Config.Sounds.rustle, position, 0.7)
		end
	elseif kind == "hidestop" then
		if position and distanceToLocal(position) &lt; 40 then
			soundAt(Config.Sounds.rustle, position, 0.5, 0.9)
		end
	elseif kind == "sniffstart" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.rustle, position, 0.8, 0.7)
		end
		if state.hidden and data.index == state.hideSpot then
			HUD.notify("¡El kiwi te está husmeando! Sal con E y corre", Color3.fromRGB(238, 150, 100), 4)
			sound2D(Config.Sounds.denied, 0.7)
		end
	elseif kind == "sniff" then
		if position and distanceToLocal(position) &lt; 48 then
			soundAt(Config.Sounds.rustle, position, 0.5, 1.1)
			burst(position, Color3.fromRGB(198, 170, 86), 6)
		end
	elseif kind == "sniffmiss" then
		if position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.rustle, position, 0.4, 0.8)
		end
	elseif kind == "sniffcatch" then
		if position then
			soundAt(Config.Sounds.roar, position, 1, 0.5)
			burst(position, Color3.fromRGB(232, 108, 100), 30)
		end
	elseif kind == "boom" then
		if position then
			local cfg = data.weapon and Config.Weapons[data.weapon]
			-- El tanque de combustible hace una explosion mas grande
			local tank = data.tank == true
			soundAt(Config.Sounds.gunBoom, position, tank and 1.2 or 1, 0.5)
			soundAt(Config.Sounds.dartHit, position, 0.85, 0.75)
			burst(position, (cfg and cfg.color) or Color3.fromRGB(255, 186, 120), tank and 90 or 46)
			if distanceToLocal(position) &lt; (tank and 110 or 70) then
				sound2D(Config.Sounds.roar, tank and 0.75 or 0.5, 0.7)
			end
		end
	elseif kind == "weaponfx" then
		-- Animacion distinta para cada arma de baul
		local weapon = data.weapon
		local dir = data.dir or Vector3.new(0, 0, -1)
		if position and weapon == "sniper" then
			tracer(position, dir, 340, Color3.fromRGB(255, 246, 205), 0.13)
			burst(position + dir * 1.4, Color3.fromRGB(255, 232, 170), 8)
		elseif position and weapon == "revolver" then
			tracer(position, dir, 150, Color3.fromRGB(255, 224, 160), 0.09)
			burst(position + dir * 0.9, Color3.fromRGB(255, 208, 140), 6)
		elseif position and weapon == "cuchillo" then
			burst(position + dir * 3.2, Color3.fromRGB(230, 240, 250), data.hit and 16 or 7)
		elseif position and weapon == "lanzallamas" then
			-- Chorro continuo: cada aviso del servidor refresca el rig
			if data.user ~= player.UserId then
				local key = "r" .. tostring(data.user or 0)
				flameAt(key, position, dir)
				-- Y el fuego prendido donde pega su chorro
				local shooter = data.user and Players:GetPlayerByUserId(data.user)
				local rp = RaycastParams.new()
				rp.FilterType = Enum.RaycastFilterType.Exclude
				rp.FilterDescendantsInstances = shooter and shooter.Character and { shooter.Character } or {}
				rp.IgnoreWater = true
				local hit = workspace:Raycast(position, dir * 17, rp)
				if hit then
					fireSpotAt("impact:" .. key, hit.Position, hit.Normal)
				end
			end
		elseif position and weapon == "arco" then
			burst(position + dir * 1.2, Color3.fromRGB(180, 225, 150), 5)
		elseif position and weapon == "cohete" then
			burst(position + dir * 1.6, Color3.fromRGB(210, 205, 200), 10)
		end
	elseif kind == "arrowpick" then
		if position then
			burst(position, Color3.fromRGB(180, 230, 150), 12)
			if distanceToLocal(position) &lt; 90 then
				soundAt(Config.Sounds.ui, position, 0.6, 1.4)
			end
		end
	elseif kind == "peck" then
		if position then
			if distanceToLocal(position) &lt; 90 then
				soundAt(Config.Sounds.roar, position, 0.75, 1.7)
			end
			burst(position, Color3.fromRGB(240, 100, 90), 14)
		end
	elseif kind == "chestopen" then
		if position then
			soundAt(Config.Sounds.win, position, 0.7)
			burst(position, Color3.fromRGB(255, 214, 120), 40)
		end
	elseif kind == "safeactive" then
		sound2D(Config.Sounds.win, 0.8)
		if position then
			soundAt(Config.Sounds.countdown, position, 1)
			burst(position, Color3.fromRGB(140, 255, 200), 60)
		end
	elseif kind == "paintmiss" then
		if position and distanceToLocal(position) &lt; 70 then
			soundAt(Config.Sounds.paintHit, position, 0.35, 1.5)
			burst(position, Util.colorFromTable(data.color) or Color3.fromRGB(230, 120, 190), 8)
		end
	elseif kind == "hunt" then
		if position and distanceToLocal(position) &lt; 150 then
			soundAt(Config.Sounds.roar, position, 0.9, 0.55)
		end
	elseif kind == "roar" then
		if position then
			local distance = distanceToLocal(position)
			if distance &lt; 200 then
				soundAt(Config.Sounds.roar, position, math.clamp(1.1 - distance / 260, 0.2, 1), 0.45)
				HUD.notify("¡El kiwi gigante ruge cerca!", Color3.fromRGB(232, 108, 100), 2)
			end
		end
	elseif kind == "giantcatch" then
		if position then
			soundAt(Config.Sounds.roar, position, 1, 0.4)
			burst(position, Color3.fromRGB(232, 108, 100), 44)
		end
		if data.userId == player.UserId then
			sound2D(Config.Sounds.lose, 0.8)
			-- Camara en tercera persona para ver como te come
			setScope(false)
			local now = os.clock()
			eatCam = {
				start = now,
				until_ = now + (Config.Round.EatHold or 2.6) + 0.15,
				kiwiPos = position,
				shakeUntil = 0,
			}
			-- El cartel de muerte entra un poco despues, para no tapar la escena
			task.delay(1.05, function()
				if eatCam then
					HUD.death(Config.Text.DeathTitle, Config.Text.DeathSubtitle)
				end
			end)
		end
	elseif kind == "hurt" then
		if data.userId == player.UserId then
			HUD.hurt(data.amount)
			sound2D(Config.Sounds.paintHit, 0.5, 0.8)
		elseif position and distanceToLocal(position) &lt; 60 then
			soundAt(Config.Sounds.dartHit, position, 0.35, 1.4)
		end
	elseif kind == "ko" then
		if position then
			burst(position, Color3.fromRGB(232, 108, 100), 30)
		end
		if data.userId == player.UserId then
			setScope(false)
			sound2D(Config.Sounds.lose, 0.8)
			if state.modeId == "asedio" then
				HUD.death("¡TE NOQUEARON!", "Volvés al combate en unos segundos...")
			else
				HUD.death("¡TE NOQUEARON!", "Vuelves al lobby...")
			end
		end
	end
end)

-- ===============================================================
-- Botones del menu
-- ===============================================================
HUD.init(player:WaitForChild("PlayerGui"), {
	onJoin = function(modeId)
		sound2D(Config.Sounds.ui, 0.6)
		HUD.setMenuStatus("Entrando a la partida...", Color3.fromRGB(238, 196, 92))
		remotes.RequestJoin:FireServer(modeId)
	end,
	onVote = function(mapId)
		sound2D(Config.Sounds.ui, 0.5)
		remotes.VoteMap:FireServer(mapId)
	end,
	onLeave = function()
		sound2D(Config.Sounds.ui, 0.5)
		remotes.RequestLeave:FireServer()
	end,
})

-- ===============================================================
-- Bucle del cliente
-- ===============================================================
-- Tabla reutilizada: no crear basura nueva cada frame
local remainingCooldowns = {}
RunService.Heartbeat:Connect(function(dt)
	-- Si te esta comiendo el kiwi: camara de cine en tercera persona
	if eatCam then
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local now = os.clock()
		if camera and root and now &lt; eatCam.until_ then
			camera.CameraType = Enum.CameraType.Scriptable
			-- La camara se acerca de golpe: primer plano del kiwi comiendote
			local p = math.clamp((now - (eatCam.start or now)) / 0.55, 0, 1)
			local target = root.Position + Vector3.new(0, 1.5, 0)
			local away = target - (eatCam.kiwiPos or target)
			away = Vector3.new(away.X, 0, away.Z)
			if away.Magnitude &lt; 0.1 then
				away = Vector3.new(0, 0, 1)
			end
			local flatAway = away.Unit
			local cf = CFrame.lookAt(
				target + flatAway * (15 - 6.5 * p) + Vector3.new(0, 5.6 - 2.6 * p, 0),
				target + flatAway * 1.6 + Vector3.new(0, 0.4, 0))
			if now &lt; (eatCam.shakeUntil or 0) then
				cf = cf * CFrame.new((math.random() - 0.5) * 0.55, (math.random() - 0.5) * 0.45, 0)
			end
			camera.CFrame = cf
		else
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
			eatCam = nil
			applyCameraMode()
		end
	end

	-- Con la mira puesta, el personaje gira junto con la camara
	if scoped and state.active and state.phase == "playing" then
		local camera = workspace.CurrentCamera
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if camera and root then
			local look = camera.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			if flatLook.Magnitude &gt; 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook.Unit)
			end
		end
	end

	-- Efecto de velocidad: corriendo la camara abre un poco el FOV (se siente mas rapido)
	if state.active and state.phase == "playing" and not scoped then
		local character = player.Character
		local camera = workspace.CurrentCamera
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and camera then
			local v = root.AssemblyLinearVelocity
			local flatSpeed = math.sqrt(v.X * v.X + v.Z * v.Z)
			local goal = 70 + math.clamp((flatSpeed - Config.Player.walkSpeed) * 0.5, 0, 7)
			speedFov = speedFov or camera.FieldOfView
			speedFov = speedFov + (goal - speedFov) * math.min(1, dt * 6)
			camera.FieldOfView = speedFov
		end
	else
		speedFov = nil
	end

	-- Chorros de llama y fuegos que quedaron viejos
	flameCleanup()

	-- Pasos: correr suena; caminar con Shift o agachado, no
	updatePasos(dt)

	local remaining = remainingCooldowns
	for toolId, data in pairs(cooldowns) do
		data.left = math.max(0, data.left - dt)
		remaining[toolId] = data.left
	end
	HUD.setCooldowns(remaining)
	HUD.updateTracker()
end)

hookContainer(player:WaitForChild("Backpack"))
if player.Character then
	hookContainer(player.Character)
end
remotes.RequestState:FireServer()
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX025">
					<Properties>
						<string name="Name">modules</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX026">
						<Properties>
							<string name="Name">HUD</string>
							<ProtectedString name="Source">--[[
	HUD.lua  (cliente)
	Construye TODA la interfaz por codigo: menu del lobby, HUD de la
	partida, avisos, panel de resultados y brujula del rastreador.

	Nada de esto necesita que armes GUIs en Studio.
--]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("KiwiShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local HUD = {}

local player = Players.LocalPlayer
local gui
local parts = {}
local tracker = { active = false, until_ = 0, pos = nil, hidden = false }
local callbacks = {}

local COLOR = {
	panel = Color3.fromRGB(14, 16, 20),
	panelSoft = Color3.fromRGB(26, 30, 36),
	accent = Color3.fromRGB(102, 209, 130),
	text = Color3.fromRGB(238, 241, 244),
	muted = Color3.fromRGB(148, 156, 164),
}

local function new(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local function corner(radius, parent)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(color, thickness, transparency, parent)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function padding(px, parent)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	}, parent)
end

-- ===============================================================
-- MENU DEL LOBBY
-- ===============================================================
local function buildMenu(parent)
	local menu = new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 660, 0, 690),
		BackgroundColor3 = COLOR.panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, parent)
	corner(18, menu)
	stroke(COLOR.accent, 1.5, 0.45, menu)
	padding(22, menu)

	new("TextLabel", {
		Name = "Titulo",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = COLOR.text,
		Text = "KIWI CAZADOR",
	}, menu)

	new("TextLabel", {
		Name = "Subtitulo",
		Position = UDim2.new(0, 0, 0, 48),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 15,
		TextColor3 = COLOR.muted,
		Text = "Atrapa al kiwi de Nueva Zelanda antes de que se esconda otra vez",
	}, menu)

	local grid = new("Frame", {
		Name = "Modos",
		Position = UDim2.new(0, 0, 0, 82),
		Size = UDim2.new(1, 0, 0, 384),
		BackgroundTransparency = 1,
	}, menu)

	new("UIGridLayout", {
		CellSize = UDim2.new(0.485, 0, 0, 118),
		CellPadding = UDim2.new(0.03, 0, 0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)

	parts.modeButtons = {}
	for index, modeId in ipairs(Config.ModeOrder) do
		local info
		if modeId == "multi" then
			info = Config.Multiplayer
		else
			info = Config.Difficulties[modeId]
		end

		local button = new("TextButton", {
			Name = modeId,
			LayoutOrder = index,
			BackgroundColor3 = COLOR.panelSoft,
			BackgroundTransparency = 0.05,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, grid)
		corner(12, button)
		local border = stroke(info.color, 1.5, 0.35, button)

		new("TextLabel", {
			Name = "Nombre",
			Position = UDim2.new(0, 14, 0, 10),
			Size = UDim2.new(1, -28, 0, 24),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 19,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = info.color,
			Text = info.name,
		}, button)

		new("TextLabel", {
			Name = "Etiqueta",
			Position = UDim2.new(0, 14, 0, 34),
			Size = UDim2.new(1, -28, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = COLOR.muted,
			Text = info.tag,
		}, button)

		new("TextLabel", {
			Name = "Descripcion",
			Position = UDim2.new(0, 14, 0, 52),
			Size = UDim2.new(1, -28, 0, 56),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = COLOR.text,
			TextTransparency = 0.15,
			Text = info.blurb,
		}, button)

		if callbacks.onJoin then
			button.MouseButton1Click:Connect(function()
				callbacks.onJoin(modeId)
			end)
		end
		button.MouseEnter:Connect(function()
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(40, 46, 54) }):Play()
		end)
		button.MouseLeave:Connect(function()
			TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = COLOR.panelSoft }):Play()
		end)

		parts.modeButtons[modeId] = { button = button, border = border }
	end

	local status = new("TextLabel", {
		Name = "Estado",
		Position = UDim2.new(0, 0, 0, 470),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = COLOR.accent,
		Text = "",
	}, menu)
	parts.status = status

	local help = new("Frame", {
		Name = "Ayuda",
		Position = UDim2.new(0, 0, 0, 498),
		Size = UDim2.new(1, 0, 0, 138),
		BackgroundColor3 = COLOR.panelSoft,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	}, menu)
	corner(12, help)
	padding(14, help)

	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR.accent,
		Text = "CÓMO JUGAR",
	}, help)

	new("TextLabel", {
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 1, -22),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = COLOR.text,
		TextTransparency = 0.2,
		Text = "1) Red: atrapa al kiwi de cerca.\n"
			.. "2) Rifle tranquilizante: clic derecho para apuntar con la mira; lo duerme y lo recoges al tocarlo.\n"
			.. "3) Rastreador: te dice dirección y distancia.\n"
			.. "4) Trampa de fruta (1 por jugador): el kiwi queda atrapado 3 s; ve por él o disparale.\n"
			.. "5) Rifle de pintura: mancha, marca (se ve entre las paredes) y frena. Clic derecho: mira.\n"
			.. "En Kiwi Colosal llevas rastreador y rifle ralentizador (frena al gigante, no lo duerme).\n"
			.. "V: vista en primera persona. Corres siempre; con Shift caminas despacio (menos ruido) y con Ctrl vas en sigilo.\n"
			.. "F: con el cuchillo mariposa lo haces girar en la mano (todos lo llevan de fábrica). El clima cambia solo: sol, lluvia o nieve; si nieva, la nieve se acumula en el piso.",
	}, help)

	return menu
end

-- ===============================================================
-- HUD DE PARTIDA
-- ===============================================================
local function buildSessionHud(parent)
	local hud = new("Frame", {
		Name = "Partida",
		Size = UDim2.fromScale(1, 1),
