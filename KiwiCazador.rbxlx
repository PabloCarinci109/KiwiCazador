	local leave = new("TextButton", {
		Name = "Salir",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 40),
		Size = UDim2.new(0, 90, 0, 22),
		BackgroundColor3 = Color3.fromRGB(70, 40, 40),
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
